                                        <ui:Label text="ᚱ" class="pedestal-rune rune-right" />
                                    </ui:VisualElement>
                                    <ui:Label text="Alfil Clásico" class="variant-card-title pedestal-name" />
                                    <ui:Label text="Standard Bishop" class="variant-card-role pedestal-role" />
                                    <ui:VisualElement class="variant-card-divider pedestal-divider" />
                                    <ui:Label text="• Movimiento diagonal sin límite.&#10;• Sin habilidades mágicas." class="variant-card-desc pedestal-desc" />
                                    <ui:Button name="btn-equip-classic" text="✓ EN EL INVENTARIO" class="btn-variant-action pedestal-btn pedestal-btn-silver" />
                                </ui:VisualElement>

                                <!-- CARD 2: ALFIL NIGROMANTE — bloque obsidiana + esmeralda -->
                                <ui:VisualElement name="card-bishop-necro" class="piece-variant-card pedestal-card pedestal-card-necro">
                                    <ui:VisualElement class="pedestal-ribbon ribbon-emerald">
                                        <ui:Label name="lbl-status-necro" text="ACTIVO EN PARTIDA" class="variant-card-badge ribbon-label ribbon-label-emerald" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="variant-portrait pedestal-portrait pedestal-portrait-necro">
                                        <ui:VisualElement class="pedestal-glow glow-emerald" />
                                        <ui:VisualElement class="pedestal-stone stone-necro">
                                            <ui:VisualElement class="pedestal-stone-top top-necro" />
                                            <ui:VisualElement class="pedestal-stone-front front-necro" />
                                        </ui:VisualElement>
                                        <ui:Image name="img-bishop-necro" class="variant-portrait-img pedestal-figure" />
                                        <ui:Label text="ᛝ" class="pedestal-rune rune-left rune-emerald" />
                                        <ui:Label text="ᛝ" class="pedestal-rune rune-right rune-emerald" />
                                    </ui:VisualElement>
                                    <ui:Label text="Alfil Nigromante" class="variant-card-title pedestal-name text-emerald" />
                                    <ui:Label text="Necromancer Bishop" class="variant-card-role pedestal-role" />
                                    <ui:VisualElement class="variant-card-divider pedestal-divider" />
                                    <ui:Label text="• Cosecha de Almas: 0.35 por pieza aliada caída. Espectrales no cuentan.&#10;• Alzamiento Menor: 4 almas → Peón Espectral a 1-2 casillas en tu territorio, no atacada. Consume turno." class="variant-card-desc pedestal-desc" />
                                    <ui:Button name="btn-equip-necro" text="✓ EN USO" class="btn-variant-action pedestal-btn pedestal-btn-emerald" />
                                </ui:VisualElement>

                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="variant-section-container pedestal-section">
                            <ui:VisualElement class="pedestal-section-header">
                                <ui:VisualElement class="pedestal-header-line-left" />
