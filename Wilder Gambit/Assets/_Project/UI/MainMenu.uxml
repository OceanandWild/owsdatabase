                                </ui:VisualElement>

                                <!-- CARD 2: PEÓN LANCERO — pasiva «Lanza» -->
                                <ui:VisualElement name="card-pawn-lancer" class="piece-variant-card pedestal-card pedestal-card-classic pedestal-card-lancer">
                                    <ui:VisualElement class="pedestal-ribbon ribbon-gold">
