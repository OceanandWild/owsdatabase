{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaverNote",
  "mainBinaryName": "wavernote",
  "version": "1.1.0",
  "identifier": "com.oceanwildstudios.wavernote",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run sync:web",
    "beforeBuildCommand": "npm run sync:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WaverNote — Ocean & Wild Studios",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://owsdatabase.onrender.com https: data: blob:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; connect-src 'self' https://owsdatabase.onrender.com https:; media-src 'self' https: data: blob:; font-src 'self' https: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyNDA2RTQ1NzY5MkFBNjIKUldSaXFwSjJSVzVBQXQ0TG9xYjFWakJTaVdmcGpRWHJhT0p2THFqcUVjSDNhVXBmcndMYjdsTGsK",
      "endpoints": [
        "https://raw.githubusercontent.com/OceanandWild/owsdatabase/main/wavernote-update.json",
        "https://cdn.jsdelivr.net/gh/OceanandWild/owsdatabase@main/wavernote-update.json"
      ]
    }
  }
}
