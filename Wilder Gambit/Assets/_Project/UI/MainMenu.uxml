                            <ui:VisualElement class="variant-cards-row pedestal-row">

                                <!-- CARD 1: ALFIL CLÁSICO — bloque mármol -->
                                <ui:VisualElement name="card-bishop-classic" class="piece-variant-card pedestal-card pedestal-card-classic">
                                    <ui:VisualElement class="pedestal-ribbon ribbon-silver">
                                        <ui:Label name="lbl-status-classic" text="DISPONIBLE" class="variant-card-badge ribbon-label" />
