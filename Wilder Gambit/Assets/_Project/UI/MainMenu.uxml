                                        <ui:VisualElement class="pedestal-glow glow-silver" />
                                        <ui:VisualElement class="pedestal-stone">
                                            <ui:VisualElement class="pedestal-stone-top" />
                                            <ui:VisualElement class="pedestal-stone-front" />
                                        </ui:VisualElement>
                                        <ui:Image name="img-queen-classic" class="variant-portrait-img pedestal-figure" />
                                        <ui:Label text="ᚱ" class="pedestal-rune rune-left" />
                                        <ui:Label text="ᚱ" class="pedestal-rune rune-right" />
                                    </ui:VisualElement>
                                    <ui:Label text="Dama Clásica" class="variant-card-title pedestal-name" />
                                    <ui:Label text="Standard Queen" class="variant-card-role pedestal-role" />
                                    <ui:VisualElement class="variant-card-divider pedestal-divider" />
                                    <ui:Label text="• Rectas y diagonales sin límite.&#10;• Sin habilidades mágicas." class="variant-card-desc pedestal-desc" />
                                    <ui:Button name="btn-equip-queen-classic" text="✓ EN EL INVENTARIO" class="btn-variant-action pedestal-btn pedestal-btn-silver" />
                                </ui:VisualElement>

                                <!-- CARD 2: DAMA JINETE — pasiva «Cabalgada» -->
                                <ui:VisualElement name="card-queen-rider" class="piece-variant-card pedestal-card pedestal-card-classic pedestal-card-lancer">
                                    <ui:VisualElement class="pedestal-ribbon ribbon-gold">
                                        <ui:Label name="lbl-status-queen-rider" text="DISPONIBLE" class="variant-card-badge ribbon-label ribbon-label-gold" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="variant-portrait pedestal-portrait pedestal-portrait-classic">
                                        <ui:VisualElement class="pedestal-glow glow-gold" />
                                        <ui:VisualElement class="pedestal-stone stone-lancer">
                                            <ui:VisualElement class="pedestal-stone-top top-lancer" />
                                            <ui:VisualElement class="pedestal-stone-front front-lancer" />
                                        </ui:VisualElement>
                                        <ui:Image name="img-queen-rider" class="variant-portrait-img pedestal-figure" />
                                        <ui:Label text="ᚱ" class="pedestal-rune rune-left rune-gold" />
                                        <ui:Label text="ᚱ" class="pedestal-rune rune-right rune-gold" />
                                    </ui:VisualElement>
                                    <ui:Label text="Dama Jinete" class="variant-card-title pedestal-name text-gold" />
                                    <ui:Label text="Rider Queen" class="variant-card-role pedestal-role" />
                                    <ui:VisualElement class="variant-card-divider pedestal-divider" />
                                    <ui:Label text="• Pasiva «Cabalgada»: salta como Caballo 1×/partida.&#10;• Por lo demás, Dama clásica." class="variant-card-desc pedestal-desc" />
                                    <ui:Button name="btn-equip-queen-rider" text="✓ EN EL INVENTARIO" class="btn-variant-action pedestal-btn pedestal-btn-gold" />
                                </ui:VisualElement>

                                <!-- CARD 3: REINA VAMPIRA — pasiva «No Muerta» -->
                                <ui:VisualElement name="card-queen-vampire" class="piece-variant-card pedestal-card pedestal-card-classic pedestal-card-vampire">
                                    <ui:VisualElement class="pedestal-ribbon ribbon-blood">
                                        <ui:Label name="lbl-status-queen-vampire" text="DISPONIBLE" class="variant-card-badge ribbon-label ribbon-label-blood" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="variant-portrait pedestal-portrait pedestal-portrait-classic">
                                        <ui:VisualElement class="pedestal-glow glow-blood" />
                                        <ui:VisualElement class="pedestal-stone stone-vampire">
                                            <ui:VisualElement class="pedestal-stone-top top-vampire" />
                                            <ui:VisualElement class="pedestal-stone-front front-vampire" />
                                        </ui:VisualElement>
                                        <ui:Image name="img-queen-vampire" class="variant-portrait-img pedestal-figure" />
                                        <ui:Label text="ᛉ" class="pedestal-rune rune-left rune-blood" />
                                        <ui:Label text="ᛉ" class="pedestal-rune rune-right rune-blood" />
                                    </ui:VisualElement>
                                    <ui:Label text="Reina Vampira" class="variant-card-title pedestal-name text-blood" />
                                    <ui:Label text="Vampire Queen" class="variant-card-role pedestal-role" />
                                    <ui:VisualElement class="variant-card-divider pedestal-divider" />
                                    <ui:Label text="• Pasiva «No Muerta»: renace 1×/partida.&#10;• Por lo demás, Dama clásica." class="variant-card-desc pedestal-desc" />
                                    <ui:Button name="btn-equip-queen-vampire" text="✓ EN EL INVENTARIO" class="btn-variant-action pedestal-btn pedestal-btn-blood" />
                                </ui:VisualElement>

                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>

                    <!-- Footer — fijo abajo -->
                    <ui:VisualElement class="your-pieces-footer">
                        <ui:Button name="btn-close-your-pieces" text="VOLVER" class="btn-your-pieces-back vault-volver" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Divider vertical estilizado -->
                <ui:VisualElement class="dual-divider">
                    <ui:VisualElement class="dual-divider-cap" />
                    <ui:VisualElement class="dual-divider-line" />
                    <ui:VisualElement class="dual-divider-node">
                        <ui:VisualElement class="dual-divider-glow" />
                        <ui:VisualElement class="dual-divider-diamond" />
                        <ui:Label text="◆" class="dual-divider-rune" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dual-divider-line" />
                    <ui:VisualElement class="dual-divider-cap" />
                </ui:VisualElement>

                <!-- RIGHT: Enciclopedia — detalle mucho más que en partida -->
                <ui:VisualElement class="encyclopedia-side-panel">
                    <ui:VisualElement class="encyclopedia-header vault-header">
                        <ui:VisualElement class="vault-header-texts">
                            <ui:Label text="ENCICLOPEDIA" class="encyclopedia-title vault-title" />
                            <ui:Label text="Detalle completo de cada variante y pieza. Mucho más que el panel rápido de partida." class="encyclopedia-subtitle vault-subtitle" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="encyclopedia-filter-row">
                        <ui:Button name="ency-filter-all" text="TODAS" class="ency-filter-btn ency-filter-active" />
                        <ui:Button name="ency-filter-bishop" text="ALFIL" class="ency-filter-btn" />
                        <ui:Button name="ency-filter-pawn" text="PEONES" class="ency-filter-btn" />
                        <ui:Button name="ency-filter-others" text="OTRAS" class="ency-filter-btn" />
                    </ui:VisualElement>
                    <ui:ScrollView name="encyclopedia-scroll" class="encyclopedia-scroll" mode="Vertical">
                        <ui:VisualElement name="encyclopedia-grid" class="encyclopedia-grid" />
                    </ui:ScrollView>
                    <ui:Label text="💡 En partida usa el panel derecho ⚡ HABILIDADES para activar sin buscar la pieza." class="encyclopedia-tip" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 6: PROGRESO — BARRA DEL ATELIER DE 7 DÍAS      -->
        <!-- Misiones diarias/semanales, retos, logros y fuentes -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="progress-modal-view" class="shop2-root hidden">
            <ui:VisualElement class="shop2-backdrop">
                <ui:VisualElement class="shop2-window prog-window">

                    <!-- ── TOPBAR ── -->
                    <ui:VisualElement class="shop2-topbar">
                        <ui:VisualElement class="shop2-rail-header">
                            <ui:Button name="btn-close-progress" text="←  VOLVER" class="shop2-back-btn" />
                            <ui:VisualElement class="shop2-brand">
                                <ui:Label text="ATELIER" class="shop2-brand-kicker" />
                                <ui:Label text="PROGRESO" class="shop2-brand-title" />
                                <ui:VisualElement class="shop2-brand-line" />
                                <ui:Label text="Todo lo que juegas se convierte en Gambits. Aquí ves cuánto y de dónde." class="shop2-brand-subtitle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="shop2-rail-vault">
                            <ui:VisualElement class="shop2-vault-head">
                                <ui:Label text="BÓVEDA" class="shop2-vault-eyebrow" />
                                <ui:Label text="Gambits disponibles" class="shop2-vault-sub" />
                            </ui:VisualElement>
                            <ui:VisualElement class="shop2-vault-chips">
                                <ui:VisualElement name="prog-chip-gambits" class="shop2-chip chip-gambits">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-gambit">
                                        <ui:VisualElement class="shop2-chip-icon gambits-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="prog-gambits-label" text="0" class="shop2-chip-amount" />
                                        <ui:Label text="GAMBITS" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="prog-chip-rhythm" class="shop2-chip chip-rhythm">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-rhythm">
                                        <ui:Label text="◷" class="shop2-chip-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="prog-rhythm-label" text="Hoy: 0" class="shop2-chip-amount" />
                                        <ui:Label name="prog-rhythm-sub" text="RITMO DEL DÍA" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── CUERPO ── -->
                    <ui:ScrollView name="progress-scroll" class="prog-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                        <ui:VisualElement class="prog-content">

                            <!-- BARRA DEL ATELIER: 7 días -->
                            <ui:VisualElement name="prog-card-week" class="prog-card prog-week-card">
                                <ui:VisualElement class="prog-card-head">
                                    <ui:Label text="BARRA DEL ATELIER" class="prog-kicker" />
                                    <ui:Label text="SEMANA PERFECTA" class="prog-title" />
                                    <ui:Label name="prog-week-subtitle" text="Completa las 3 misiones de cada día para cobrar su recompensa. Los 7 días abren el cofre." class="prog-sub" />
                                </ui:VisualElement>

                                <ui:VisualElement name="prog-week-bar" class="prog-week-bar" />

                                <ui:VisualElement class="prog-week-foot">
                                    <ui:Label name="prog-week-status" text="0 / 7 días perfectos · faltan 7 para abrir el cofre" class="prog-week-status" />
                                    <ui:Label name="prog-week-reset" text="Se reinicia en 7 d" class="prog-week-reset" />
                                </ui:VisualElement>

                                <ui:VisualElement name="prog-chest" class="prog-chest">
                                    <!-- Escenario del cofre: las 8 capas de VFX y el sprite del cofre.
                                         Los dos contenedores están vacíos a propósito: los rellena
                                         ChestStage.cs, y el UXML sólo fija dónde van. -->
                                    <ui:VisualElement name="prog-chest-stage" class="prog-chest-stage">
                                        <ui:VisualElement name="prog-chest-fx" class="prog-chest-fx" picking-mode="Ignore" />
                                        <ui:VisualElement name="prog-chest-art" class="prog-chest-art" picking-mode="Ignore" />
                                        <ui:VisualElement name="prog-chest-fx-front" class="prog-chest-fx" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="prog-chest-texts">
                                        <ui:Label text="COFRE DEL ATELIER" class="prog-chest-kicker" />
                                        <ui:Label name="prog-chest-title" text="1.000 Gambits" class="prog-chest-title" />
                                        <ui:Label name="prog-chest-sub" text="Rellena los 7 días para reclamarlo. Encadena semanas perfectas y sube +200 cada vez." class="prog-chest-sub" />
                                    </ui:VisualElement>
                                    <ui:Button name="btn-claim-chest" text="🔒 COBRAR COFRE" class="prog-claim prog-claim-locked" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- MISIONES -->
                            <ui:VisualElement class="prog-columns">
                                <ui:VisualElement name="prog-card-daily" class="prog-card prog-col">
                                    <ui:VisualElement class="prog-card-head">
                                        <ui:Label text="MISIONES DIARIAS" class="prog-kicker" />
                                        <ui:Label name="prog-daily-timer" text="Se reinician en 7 h" class="prog-reset" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="prog-daily-list" class="prog-list" />
                                    <ui:Button name="btn-reroll-daily" text="CAMBIAR UNA MISIÓN" class="prog-ghost" />
                                </ui:VisualElement>

                                <ui:VisualElement name="prog-card-weekly" class="prog-card prog-col">
                                    <ui:VisualElement class="prog-card-head">
                                        <ui:Label text="MISIONES SEMANALES" class="prog-kicker" />
                                        <ui:Label name="prog-weekly-timer" text="Se reinician en 7 d" class="prog-reset" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="prog-weekly-list" class="prog-list" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- RETOS -->
                            <ui:VisualElement name="prog-card-challenges" class="prog-card">
                                <ui:VisualElement class="prog-card-head">
                                    <ui:Label text="RETOS DEL DÍA" class="prog-kicker" />
                                    <ui:Label text="Una posición diaria y 5 puzzles con premio. Después puedes seguir practicando todo lo que quieras." class="prog-sub" />
                                </ui:VisualElement>
                                <ui:VisualElement class="prog-challenges">
                                    <ui:VisualElement name="prog-challenge-daily" class="prog-challenge">
                                        <ui:VisualElement class="prog-challenge-icon-wrap">
                                            <ui:Label text="🎯" class="prog-challenge-icon" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="prog-challenge-texts">
                                            <ui:Label text="DESAFÍO DIARIO" class="prog-challenge-title" />
                                            <ui:Label name="prog-challenge-sub" text="Premio de hoy: 50 Gambits · cada día seguido sube el premio (hasta 100)" class="prog-challenge-sub" />
                                        </ui:VisualElement>
                                        <ui:Button name="btn-daily-challenge" text="JUGAR DESAFÍO" class="prog-claim" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="prog-challenge-training" class="prog-challenge">
                                        <ui:VisualElement class="prog-challenge-icon-wrap">
                                            <ui:Label text="🧩" class="prog-challenge-icon" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="prog-challenge-texts">
                                            <ui:Label text="ENTRENAMIENTO TÁCTICO" class="prog-challenge-title" />
                                            <ui:Label name="prog-training-sub" text="Tu rating: 1000 · 20–60 Gambits por puzzle · mejor racha: 0" class="prog-challenge-sub" />
                                        </ui:VisualElement>
                                        <ui:Button name="btn-training" text="ENTRENAR 5 PUZZLES" class="prog-claim" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- LOGROS -->
                            <ui:VisualElement name="prog-card-ach" class="prog-card">
                                <ui:VisualElement class="prog-card-head">
                                    <ui:Label text="LOGROS" class="prog-kicker" />
                                    <ui:Label name="prog-ach-progress" text="0 / 0 desbloqueados" class="prog-reset" />
                                </ui:VisualElement>
                                <ui:VisualElement name="prog-achievements-list" class="prog-ach-grid" />
                            </ui:VisualElement>

                            <!-- FUENTES -->
                            <ui:VisualElement name="prog-card-sources" class="prog-card">
                                <ui:VisualElement class="prog-card-head">
                                    <ui:Label text="FORMAS DE GANAR GAMBITS" class="prog-kicker" />
                                    <ui:Label name="prog-sources-note" text="Solo se ganan jugando. Cada fuente tiene su tope diario para que el ritmo sea sostenible." class="prog-sub" />
                                </ui:VisualElement>
                                <ui:VisualElement name="prog-sources-list" class="prog-sources" />
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>

                    <!-- Footer fijo -->
                    <ui:VisualElement class="prog-footer">
                        <ui:Label name="prog-footer-note" text="Los Gambits se abonan al instante y también viajan a tu cuenta de Ocean Pay." class="prog-footer-note" />
                        <ui:Button name="btn-close-progress-foot" text="VOLVER" class="shop2-back-btn prog-footer-btn" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 7: INVENTARIO — el ÚNICO sitio donde se equipa -->
        <!-- Variantes de pieza, skins y tableros en posesión     -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="inventory-modal-view" class="shop2-root hidden">
            <ui:VisualElement class="shop2-backdrop">
                <ui:VisualElement class="shop2-window inv-window">

                    <!-- Marca de agua: el macuto y su río de piezas (detrás del catálogo) -->
                    <ui:Image name="inv-watermark" class="inv-watermark" picking-mode="Ignore" />

                    <!-- ── TOPBAR ── -->
                    <ui:VisualElement class="shop2-topbar">
                        <ui:VisualElement class="shop2-rail-header">
                            <ui:Button name="btn-close-inventory" text="←  VOLVER" class="shop2-back-btn" />
                            <ui:VisualElement class="inv-crest">
                                <ui:Label name="inv-crest-fallback" text="🎒" class="inv-crest-icon" picking-mode="Ignore" />
                                <ui:Image name="inv-crest-art" class="inv-crest-art" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="shop2-brand">
                                <ui:Label text="INVENTARIO" class="shop2-brand-title" />
                                <ui:VisualElement class="shop2-brand-line" />
                                <ui:Label text="Tu colección. Aquí es donde se equipa todo lo que ya es tuyo." class="shop2-brand-subtitle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="shop2-rail-vault">
                            <ui:VisualElement class="shop2-vault-chips">
                                <ui:VisualElement class="shop2-chip chip-gambits">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-gambit">
                                        <ui:VisualElement class="shop2-chip-icon gambits-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="inv-chip-gambits" text="0" class="shop2-chip-amount" />
                                        <ui:Label text="GAMBITS" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="shop2-chip chip-owned">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-owned">
                                        <ui:Label text="✦" class="shop2-chip-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="inv-chip-owned" text="0 / 0" class="shop2-chip-amount" />
                                        <ui:Label name="inv-chip-owned-label" text="EN POSESIÓN" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── PESTAÑAS ── -->
                    <ui:VisualElement class="inv-tabs">
                        <ui:Button name="inv-tab-variants" class="shop2-tab shop2-nav-active">
                            <ui:Label text="VARIANTES" class="shop2-tab-label" />
                            <ui:Label name="inv-count-variants" text="0" class="shop2-tab-count" />
                        </ui:Button>
                        <ui:Button name="inv-tab-skins" class="shop2-tab">
                            <ui:Label text="SKINS" class="shop2-tab-label" />
                            <ui:Label name="inv-count-skins" text="0" class="shop2-tab-count" />
                        </ui:Button>
                        <ui:Button name="inv-tab-boards" class="shop2-tab">
                            <ui:Label text="TABLEROS" class="shop2-tab-label" />
                            <ui:Label name="inv-count-boards" text="0" class="shop2-tab-count" />
                        </ui:Button>
                        <ui:Label name="inv-tab-hint" text="Pulsa una carta para equiparla." class="inv-tab-hint" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <!-- ── FILTRO (solo pestaña de skins) ── -->
                    <ui:VisualElement name="inv-filter-row" class="inv-filter-row hidden">
                        <ui:Label text="FILTRAR" class="inv-filter-label" picking-mode="Ignore" />
                        <ui:Button name="inv-filter-all" text="TODAS" class="skin-filter-btn skin-filter-active" />
                        <ui:Button name="inv-filter-knight" text="CABALLO" class="skin-filter-btn" />
                        <ui:Button name="inv-filter-bishop" text="ALFIL" class="skin-filter-btn" />
                        <ui:Button name="inv-filter-queen" text="DAMA Y REY" class="skin-filter-btn" />
                        <ui:Button name="inv-filter-pawn" text="PEÓN" class="skin-filter-btn" />
                    </ui:VisualElement>

                    <!-- ── CATÁLOGO ── -->
                    <ui:ScrollView name="inv-scroll" class="inv-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                        <ui:VisualElement name="inv-grid" class="inv-grid" />
                    </ui:ScrollView>

                    <!-- ── PIE ── -->
                    <ui:VisualElement class="prog-footer">
                        <ui:Label name="inv-footer-note" text="Lo que compres en la tienda llega aquí para equiparse." class="prog-footer-note" />
                        <ui:Button name="btn-close-inventory-foot" text="VOLVER" class="shop2-back-btn prog-footer-btn" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 8: PASE DE TEMPORADA — pantalla completa       -->
        <!-- Hero con banner + título, barra ornamental y        -->
        <!-- medallones de nivel con doble vía de recompensas    -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="seasonpass-modal-view" class="shop2-root season-root hidden">
            <ui:VisualElement class="shop2-backdrop">
                <ui:VisualElement class="shop2-window season-window">

                    <!-- ── TOPBAR ── -->
                    <ui:VisualElement class="shop2-topbar season-topbar">
                        <ui:VisualElement class="shop2-rail-header">
                            <ui:Button name="btn-close-season" text="←  VOLVER" class="shop2-back-btn" />
                            <ui:VisualElement class="shop2-brand">
                                <ui:Label text="ATELIER" class="shop2-brand-kicker" />
                                <ui:Label text="PASE DE TEMPORADA" class="shop2-brand-title" />
                                <ui:VisualElement class="shop2-brand-line" />
                                <ui:Label text="Juega, sube de nivel y cobra las dos vías." class="shop2-brand-subtitle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="shop2-rail-vault">
                            <ui:VisualElement class="shop2-vault-chips">
                                <ui:VisualElement class="shop2-chip chip-gambits">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-gambit">
                                        <ui:VisualElement class="shop2-chip-icon gambits-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="season-level-label" text="NIVEL 0" class="shop2-chip-amount" />
                                        <ui:Label name="season-count-label" text="0/30 niveles" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="shop2-chip chip-owned">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-owned">
                                        <ui:Label text="✦" class="shop2-chip-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="season-xp-label" text="0 / 1.800 XP" class="shop2-chip-amount" />
                                        <ui:Label name="season-premium-badge" text="◇ GAMBITO LIBRE" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── HERO: banner del rey + título diseñado ── -->
                    <ui:VisualElement name="season-hero" class="season-hero">
                        <ui:VisualElement class="season-hero-scrim" picking-mode="Ignore" />
                        <ui:VisualElement class="season-hero-content">
                            <ui:VisualElement name="season-title-art" class="season-title-art" picking-mode="Ignore" />
                            <ui:Label name="season-season-label" text="TEMPORADA 1 · EL REY ÍGNEO" class="season-season-label" picking-mode="Ignore" />
                            <ui:Label name="season-timer-label" text="JUEGA MISIONES Y PARTIDAS PARA GANAR XP" class="season-timer-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Button name="btn-season-premium" text="DESBLOQUEAR GAMBITO REAL" class="season-premium-btn" />
                    </ui:VisualElement>

                    <!-- ── CUERPO: progreso + pista de niveles. Sin scroll
                         vertical: la pista se escala para caber (SeasonPassModal.FitTrack)
                         y solo se navega en horizontal. ── -->
                    <ui:VisualElement name="season-scroll" class="season-scroll">
                        <!-- ── BANNER VÍA LIBRE (peón acero, sobre la fila gratuita) ── -->
                        <ui:VisualElement name="season-lane-libre" class="season-side-banner season-side-libre">
                            <ui:VisualElement class="season-side-icon season-side-icon-libre" picking-mode="Ignore" />
                            <ui:Label text="GAMBITO LIBRE" class="season-side-title season-side-title-libre" picking-mode="Ignore" />
                            <ui:Label name="season-libre-hint" text="30 NIVELES · 60 XP CADA UNO · EL XP VIENE DE JUGAR" class="season-side-hint" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- ── PISTA DE NIVELES: solo scroll horizontal ── -->
                        <ui:VisualElement class="season-track-row">
                            <ui:Button name="btn-season-track-prev" text="←" class="season-track-nav season-track-nav-prev" />
                            <ui:ScrollView name="season-track-scroll" class="season-track-scroll" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden">
                                <ui:VisualElement name="season-track" class="season-track" />
                            </ui:ScrollView>
                            <ui:Button name="btn-season-track-next" text="→" class="season-track-nav season-track-nav-next" />
                        </ui:VisualElement>

                        <!-- ── BANNER GAMBITO REAL (rey dorado, bajo la fila premium) ── -->
                        <ui:VisualElement name="season-lane-real" class="season-side-banner season-side-real">
                            <ui:VisualElement class="season-side-icon season-side-icon-real" picking-mode="Ignore" />
                            <ui:Label text="GAMBITO REAL" class="season-side-title season-side-title-real" picking-mode="Ignore" />
                            <ui:Label text="SOLO CON EL PASE DESBLOQUEADO · RECLAMA LA VÍA DORADA" class="season-side-hint" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── PIE ── -->
                    <ui:VisualElement class="prog-footer season-footer">
                        <ui:Label text="Gambits, cambios de misión, piezas, variantes, animaciones, fondos y tableros. Todo se desbloquea al instante." class="prog-footer-note" />
                        <ui:Button name="btn-close-season-foot" text="VOLVER" class="shop2-back-btn prog-footer-btn" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ── MODAL DE COMPRA: Gambito Libre vs Gambito Real ──
                 Dos banners separados por un hr ornamental; el precio en
                 Tides lo pinta SeasonPassModal con el valor del servidor. ── -->
            <ui:VisualElement name="season-buy-view" class="season-buy hidden">
                <ui:VisualElement name="season-buy-window" class="season-buy-window">

                    <ui:VisualElement class="season-buy-head">
                        <ui:VisualElement class="season-buy-head-texts">
                            <ui:Label text="PASE DE TEMPORADA · TEMPORADA 1" class="season-buy-kicker" />
                            <ui:Label text="ELIGE TU VÍA" class="season-buy-title" />
                        </ui:VisualElement>
                        <ui:Button name="btn-season-buy-close" text="✕" class="season-buy-close" />
                    </ui:VisualElement>

                    <ui:VisualElement class="season-buy-body">

                        <!-- ── BANNER: GAMBITO LIBRE ── -->
                        <ui:VisualElement class="season-buy-banner season-buy-banner-libre">
                            <ui:VisualElement class="season-buy-banner-top">
                                <ui:VisualElement class="season-buy-icon season-side-icon-libre" picking-mode="Ignore" />
                                <ui:VisualElement class="season-buy-banner-names">
                                    <ui:Label text="GAMBITO LIBRE" class="season-buy-banner-title" />
                                    <ui:Label text="Vía estándar · siempre disponible" class="season-buy-banner-sub" />
                                </ui:VisualElement>
                                <ui:Label text="INCLUIDO" class="season-buy-tag season-buy-tag-libre" />
                            </ui:VisualElement>
                            <ui:Label text="30 niveles de recompensas básicas: Gambits, Dulces de la velada, skins de entrada, fondos y tableros. El XP se gana jugando partidas y misiones, sin gastar nada." class="season-buy-banner-text" />
                            <ui:Label text="GRATIS" class="season-buy-price season-buy-price-libre" />
                        </ui:VisualElement>

                        <!-- ── HR ORNAMENTAL entre las dos vías ── -->
                        <ui:VisualElement class="season-buy-hr">
                            <ui:VisualElement class="season-buy-hr-line" picking-mode="Ignore" />
                            <ui:Label text="◆" class="season-buy-hr-gem" picking-mode="Ignore" />
                            <ui:VisualElement class="season-buy-hr-line" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- ── BANNER: GAMBITO REAL ── -->
                        <ui:VisualElement class="season-buy-banner season-buy-banner-real">
                            <ui:VisualElement class="season-buy-banner-top">
                                <ui:VisualElement class="season-buy-icon season-side-icon-real" picking-mode="Ignore" />
                                <ui:VisualElement class="season-buy-banner-names">
                                    <ui:Label text="GAMBITO REAL" class="season-buy-banner-title" />
                                    <ui:Label text="Vía premium · pago único con Tides" class="season-buy-banner-sub" />
                                </ui:VisualElement>
                                <ui:Label text="PREMIUM" class="season-buy-tag season-buy-tag-real" />
                            </ui:VisualElement>
                            <ui:Label text="La vía dorada completa: skins legendarias, variantes (Lancero, Jinete, Nigromante y Fragua), animaciones, fondos, tableros exclusivos y la mayor ración de Dulces de la velada. Se abre al instante y dura toda la temporada." class="season-buy-banner-text" />
                            <ui:VisualElement class="season-buy-buyrow">
                                <ui:VisualElement class="season-buy-pricebox">
                                    <ui:Label text="PRECIO ÚNICO · SE DESCUENTA DE TU CUENTA" class="season-buy-pricelabel" />
                                    <ui:Label name="season-buy-price" text="💧 450 Tides" class="season-buy-price season-buy-price-real" />
                                </ui:VisualElement>
                                <ui:Button name="btn-season-buy-confirm" text="PAGAR 💧 450 TIDES" class="season-buy-confirm" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- ── PIE: cuenta Ocean Pay, saldo y acceso ── -->
                    <ui:VisualElement class="season-buy-foot">
                        <ui:VisualElement class="season-buy-account">
                            <ui:Label text="🌊" class="season-buy-account-dot" picking-mode="Ignore" />
                            <ui:Label name="season-buy-account-label" text="Inicia sesión con Ocean Pay para comprar el Gambito Real con Tides." class="season-buy-account-text" />
                            <ui:Label name="season-buy-balance" text="" class="season-buy-balance" />
                        </ui:VisualElement>
                        <ui:VisualElement name="season-buy-login" class="season-buy-login">
                            <ui:TextField name="season-buy-username" class="season-buy-input" placeholder-text="usuario Ocean Pay" />
                            <ui:TextField name="season-buy-password" class="season-buy-input" placeholder-text="contraseña" />
                            <ui:Button name="btn-season-buy-login" text="ENTRAR" class="season-buy-login-btn" />
                        </ui:VisualElement>
                        <ui:Label name="season-buy-error" text="" class="season-buy-error" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 9: PASE DE HALLOWEEN — la velada en vivo        -->
        <!-- Mini-pase paralelo a la temporada (20/10 → 2/11):    -->
        <!-- 20 niveles de 60 XP, dos vías (Luna gratis / Sangre  -->
        <!-- con Dulces), misiones diarias del evento y cobro a    -->
        <!-- mano. Estados: PRÓXIMAMENTE → ACTIVO → TERMINADO.     -->
        <!--                                                       -->
        <!-- Escritorio: carril HORIZONTAL como el Pase de        -->
        <!-- Temporada (columnas con carta Luna arriba, medallón   -->
        <!-- sobre la línea al medio y carta Sangre abajo).        -->
        <!-- Móvil en vertical: el mismo camino como lista         -->
        <!-- (medallón + carta Luna + carta Sangre por fila).      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="halloweenpass-modal-view" class="shop2-root halloween-root hidden">
            <ui:VisualElement class="shop2-backdrop">
                <ui:VisualElement class="shop2-window halloween-window">

                    <!-- ── TOPBAR: volver + marca + chips de progreso + tienda ── -->
                    <ui:VisualElement class="shop2-topbar halloween-topbar">
                        <ui:VisualElement class="shop2-rail-header">
                            <ui:Button name="btn-close-halloween" text="←  VOLVER" class="shop2-back-btn" />
                            <ui:VisualElement class="shop2-brand">
                                <ui:Label text="ATELIER" class="shop2-brand-kicker" />
                                <ui:Label text="PASE DE HALLOWEEN" class="shop2-brand-title" />
                                <ui:VisualElement class="shop2-brand-line" />
                                <ui:Label text="Una sola velada. Después, se apaga la vela." class="shop2-brand-subtitle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="shop2-rail-vault">
                            <ui:VisualElement class="shop2-vault-chips hw-chips">
                                <ui:VisualElement name="hw-chip-nivel" class="shop2-chip chip-gambits">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-gambit">
                                        <ui:VisualElement class="shop2-chip-icon gambits-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="hw-level-label" text="NIVEL 0" class="shop2-chip-amount" />
                                        <ui:Label name="hw-count-label" text="0/20 niveles" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="hw-sep" picking-mode="Ignore" />
                                <ui:VisualElement name="hw-chip-xp" class="shop2-chip chip-owned">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-owned">
                                        <ui:Label text="✦" class="shop2-chip-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="hw-xp-label" text="0 / 1.200 XP" class="shop2-chip-amount" />
                                        <ui:Label text="XP DE LA VELADA" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="hw-sep" picking-mode="Ignore" />
                                <ui:VisualElement name="hw-chip-dulces" class="shop2-chip chip-owned">
                                    <ui:VisualElement class="shop2-chip-icon-wrap shop2-chip-icon-wrap-owned">
                                        <ui:Label text="🍬" class="shop2-chip-icon" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-chip-texts">
                                        <ui:Label name="hw-dulces-label" text="0" class="shop2-chip-amount" />
                                        <ui:Label text="DULCES DE LA VELADA" class="shop2-chip-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="hw-sep" picking-mode="Ignore" />
                                <ui:Label name="hw-state-chip" text="PRÓXIMAMENTE" class="hw-state-chip" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="hw-topbar-actions">
                            <!-- MISIONES abre el modal del tablero de misiones (encima del pase). -->
                            <ui:Button name="btn-halloween-missions" text="MISIONES" class="hw-missions-btn" />
                            <ui:Button name="btn-halloween-shop" text="TIENDA" class="hw-shop-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── HERO: banner + título + estado + abrir Sangre ──
                         El estado cambia en vivo: cuenta atrás antes del 20/10,
                         «¡LA VELADA ESTÁ ABIERTA!» durante el evento y
                         «LAS PUERTAS SE CERRARON» después. -->
                    <ui:VisualElement class="halloween-hero">
                        <ui:VisualElement class="halloween-hero-scrim" picking-mode="Ignore" />
                        <ui:VisualElement name="halloween-banner-art" class="halloween-banner-art" picking-mode="Ignore" />
                        <ui:VisualElement class="halloween-hero-content">
                            <ui:VisualElement name="halloween-title-art" class="halloween-title-art" picking-mode="Ignore" />
                            <ui:Label name="halloween-hero-state" text="" class="halloween-hero-soon" picking-mode="Ignore" />
                            <ui:Label name="hw-timer-label" text="Abre el 20/10" class="hw-timer" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Button name="btn-halloween-sangre" text="ABRIR VÍA SANGRE" class="season-premium-btn hw-sangre-btn" />
                    </ui:VisualElement>

                    <!-- ── CUERPO ESCRITORIO: misiones + carril horizontal ──
                         Columna fija, sin scroll vertical: la pista se mide y
                         se escala para caber (HalloweenPassModal.FitTrack) y
                         solo se navega en horizontal. -->
                    <ui:VisualElement class="halloween-body-desk">
                        <ui:VisualElement class="hw-missions-block">
                            <ui:VisualElement class="hw-section-row">
                                <ui:Label text="MISIONES DE LA VELADA" class="hw-section-title" picking-mode="Ignore" />
                                <ui:VisualElement class="hw-section-line" picking-mode="Ignore" />
                                <ui:Label name="hw-missions-note-desk" text="" class="hw-section-note" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="hw-missions-desk" class="hw-missions" />
                        </ui:VisualElement>

                        <!-- ── BANNER VÍA LUNA (sobre la fila gratuita) ── -->
                        <ui:VisualElement class="hw-lane-banner hw-lane-banner-free">
                            <ui:Label text="🌙" class="hw-lane-icon" picking-mode="Ignore" />
                            <ui:Label text="VÍA LUNA" class="hw-lane-title hw-lane-title-free" picking-mode="Ignore" />
                            <ui:Label text="20 NIVELES · 60 XP CADA UNO · EL XP VIENE DE JUGAR" class="hw-lane-hint" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- ── PISTA DE NIVELES: solo scroll horizontal ── -->
                        <ui:VisualElement class="hw-track-row">
                            <ui:Button name="btn-hw-track-prev" text="←" class="hw-track-nav hw-track-nav-prev" />
                            <ui:ScrollView name="hw-track-scroll" class="hw-track-scroll" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden">
                                <ui:VisualElement name="hw-track-h" class="hw-track-h" />
                            </ui:ScrollView>
                            <ui:Button name="btn-hw-track-next" text="→" class="hw-track-nav hw-track-nav-next" />
                        </ui:VisualElement>

                        <!-- ── BANNER VÍA SANGRE (bajo la fila premium) ── -->
                        <ui:VisualElement class="hw-lane-banner hw-lane-banner-sangre">
                            <ui:Label text="🩸" class="hw-lane-icon" picking-mode="Ignore" />
                            <ui:Label text="VÍA SANGRE" class="hw-lane-title hw-lane-title-sangre" picking-mode="Ignore" />
                            <ui:Label name="hw-lane-hint-sangre" text="SE ABRE CON 🍬 150 DULCES DE LA VELADA" class="hw-lane-hint" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── CUERPO MÓVIL (vertical): misiones + lista de niveles
                         con scroll. Medallón + carta Luna + carta Sangre por
                         fila (20 filas). ── -->
                    <ui:ScrollView name="hw-body-scroll" class="halloween-body-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement class="halloween-body">

                            <!-- ── MISIONES DEL DÍA (3 por jornada, deterministas) ── -->
                            <ui:VisualElement class="hw-section-row">
                                <ui:Label text="MISIONES DE LA VELADA" class="hw-section-title" picking-mode="Ignore" />
                                <ui:VisualElement class="hw-section-line" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="hw-missions-mob" class="hw-missions" />
                            <ui:Label name="hw-missions-note-mob" text="" class="hw-mission-note" picking-mode="Ignore" />

                            <!-- ── PISTA: 20 niveles, dos vías (Luna / Sangre) ── -->
                            <ui:VisualElement class="hw-section-row">
                                <ui:Label text="CAMINO DE NIVELES" class="hw-section-title" picking-mode="Ignore" />
                                <ui:VisualElement class="hw-section-line" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="hw-track-v" class="hw-track-v" />

                        </ui:VisualElement>
                    </ui:ScrollView>

                    <!-- ── PIE ── -->
                    <ui:VisualElement class="prog-footer halloween-footer">
                        <ui:Label name="hw-footer-note" text="" class="prog-footer-note" picking-mode="Ignore" />
                        <ui:Button name="btn-close-halloween-foot" text="VOLVER" class="shop2-back-btn prog-footer-btn" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 10: MISIONES DE LA VELADA — modal del tablero  -->
        <!-- Se abre desde el pase (botón MISIONES del topbar o  -->
        <!-- las fichas de resumen). Dos pestañas:               -->
        <!--  · VÍA LUNA: las 3 misiones del día (pool de 25).   -->
        <!--  · VÍA SANGRE: 10 exclusivas de la edición, 5       -->
        <!--    libres y 5 premium (piden la vía abierta).       -->
        <!-- Fuera de la ventana de la velada se abre igual: se  -->
        <!-- ve qué viene, pero los cobros esperan.              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="halloween-missions-modal-view" class="shop2-root hwm-root hidden">
            <ui:VisualElement class="shop2-backdrop">
                <ui:VisualElement class="shop2-window hwm-window">

                    <!-- ── TOPBAR: volver + marca + chips ── -->
                    <ui:VisualElement class="shop2-topbar hwm-topbar">
                        <ui:VisualElement class="shop2-rail-header">
                            <ui:Button name="btn-close-hw-missions" text="←  VOLVER" class="shop2-back-btn" />
                            <ui:VisualElement class="shop2-brand">
                                <ui:Label text="ATELIER" class="shop2-brand-kicker" />
                                <ui:Label text="MISIONES DE LA VELADA" class="shop2-brand-title" />
                                <ui:VisualElement class="shop2-brand-line" />
                                <ui:Label text="El tablero de la velada: Luna, Sangre libre y Sangre premium." class="shop2-brand-subtitle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="hwm-chips">
                            <ui:VisualElement class="hwm-chip hwm-chip-xp">
                                <ui:Label text="✦" class="hwm-chip-icon" picking-mode="Ignore" />
                                <ui:Label name="hwm-xp-label" text="0 / 1.200 XP" class="hwm-chip-text" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="hwm-chip hwm-chip-dulces">
                                <ui:Label text="🍬" class="hwm-chip-icon" picking-mode="Ignore" />
                                <ui:Label name="hwm-dulces-label" text="0" class="hwm-chip-text" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label name="hwm-state-chip" text="PRÓXIMAMENTE" class="hw-state-chip" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── HERO: estado de la velada + pestañas ── -->
                    <ui:VisualElement class="hwm-hero">
                        <ui:VisualElement name="hwm-crest" class="hwm-crest" picking-mode="Ignore" />
                        <ui:VisualElement class="hwm-hero-texts">
                            <ui:Label text="LA VELADA PAGA EN XP Y DULCES" class="hwm-hero-kicker" picking-mode="Ignore" />
                            <ui:Label name="hwm-hero-note" text="" class="hwm-hero-note" picking-mode="Ignore" />
                            <ui:Label name="hwm-hero-timer" text="" class="hwm-hero-timer" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="hwm-tabs">
                            <ui:Button name="hwm-tab-luna" text="🌙 VÍA LUNA" class="hwm-tab hwm-tab-active" />
                            <ui:Button name="hwm-tab-sangre" text="🩸 VÍA SANGRE" class="hwm-tab hwm-tab-sangre" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── CUERPO: Luna (diarias) / Sangre (exclusivas) ── -->
                    <ui:ScrollView name="hwm-body-scroll" class="hwm-body-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement class="hwm-body">

                            <ui:VisualElement name="hwm-pane-luna" class="hwm-pane">
                                <ui:VisualElement class="hwm-section-row">
                                    <ui:Label text="MISIONES DE HOY" class="hwm-section-title" picking-mode="Ignore" />
                                    <ui:VisualElement class="hwm-section-line" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="hwm-note-luna" text="" class="hwm-section-note" picking-mode="Ignore" />
                                <ui:VisualElement name="hwm-list-luna" class="hwm-list" />
                                <ui:Label text="El progreso sale de tus partidas reales (dificultad, precisión, capturas, puzzles y desafío diario). Al cerrar el día, lo completado y sin cobrar se paga solo." class="hwm-hint" picking-mode="Ignore" />
                            </ui:VisualElement>

                            <ui:VisualElement name="hwm-pane-sangre" class="hwm-pane hidden">
                                <ui:VisualElement class="hwm-section-row">
                                    <ui:Label text="EXCLUSIVAS DE LA VÍA SANGRE" class="hwm-section-title hwm-section-title-sangre" picking-mode="Ignore" />
                                    <ui:VisualElement class="hwm-section-line hwm-section-line-sangre" picking-mode="Ignore" />
                                </ui:VisualElement>

                                <ui:VisualElement name="hwm-sangre-banner" class="hwm-banner">
                                    <ui:VisualElement class="hwm-banner-texts">
                                        <ui:Label name="hwm-sangre-banner-title" text="🔒 VÍA SANGRE" class="hwm-banner-title" picking-mode="Ignore" />
                                        <ui:Label name="hwm-sangre-banner-note" text="" class="hwm-banner-note" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Button name="hwm-btn-sangre" text="ABRIR" class="hwm-banner-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement class="hwm-section-row hwm-section-row-sub">
                                    <ui:Label text="SANGRE LIBRE" class="hwm-sub-title" picking-mode="Ignore" />
                                    <ui:VisualElement class="hwm-section-line" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="hwm-note-sangre-free" text="" class="hwm-section-note" picking-mode="Ignore" />
                                <ui:VisualElement name="hwm-list-sangre-free" class="hwm-list" />

                                <ui:VisualElement class="hwm-section-row hwm-section-row-sub">
                                    <ui:Label text="SANGRE PREMIUM" class="hwm-sub-title hwm-sub-title-premium" picking-mode="Ignore" />
                                    <ui:VisualElement class="hwm-section-line hwm-section-line-sangre" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="hwm-note-sangre-paid" text="" class="hwm-section-note" picking-mode="Ignore" />
                                <ui:VisualElement name="hwm-list-sangre-paid" class="hwm-list" />
                                <ui:Label text="Las 10 exclusivas de Sangre duran toda la velada y se cobran una sola vez. Las libres no piden nada; las premium esperan a que la Vía Sangre esté abierta." class="hwm-hint" picking-mode="Ignore" />
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>

                    <!-- ── PIE ── -->
                    <ui:VisualElement class="prog-footer hwm-footer">
                        <ui:Label name="hwm-footer-note" text="" class="prog-footer-note" picking-mode="Ignore" />
                        <ui:Button name="btn-close-hw-missions-foot" text="VOLVER" class="shop2-back-btn prog-footer-btn" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>


        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 11: TIENDA DE LA VELADA — el destino de los    -->
        <!-- Dulces. Tres pestañas: NIVELES (mini-pase +         -->
        <!-- completar todo el pase), SKINS esculpidas y         -->
        <!-- VARIANTES. La tienda vende; el inventario equipa.   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="halloween-shop-modal-view" class="shop2-root hwshop-root hidden">
            <ui:VisualElement class="shop2-backdrop">
                <ui:VisualElement class="shop2-window hwshop-window">

                    <!-- ── TOPBAR: volver + marca + chips ── -->
                    <ui:VisualElement class="shop2-topbar hwshop-topbar">
                        <ui:VisualElement class="shop2-rail-header">
                            <ui:Button name="btn-close-hw-shop" text="←  VOLVER" class="shop2-back-btn" />
                            <ui:VisualElement class="shop2-brand">
                                <ui:Label text="ATELIER" class="shop2-brand-kicker" />
                                <ui:Label text="TIENDA DE LA VELADA" class="shop2-brand-title" />
                                <ui:VisualElement class="shop2-brand-line" />
                                <ui:Label text="Los Dulces de Halloween se cambian aquí." class="shop2-brand-subtitle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="hwshop-chips">
                            <ui:VisualElement class="hwshop-chip hwshop-chip-dulces">
                                <ui:Label text="🍬" class="hwshop-chip-icon" picking-mode="Ignore" />
                                <ui:Label name="hwshop-dulces-label" text="0" class="hwshop-chip-text" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="hwshop-chip hwshop-chip-gambits">
                                <ui:VisualElement class="hwshop-chip-icon gambits-icon" picking-mode="Ignore" />
                                <ui:Label name="hwshop-gambits-label" text="0" class="hwshop-chip-text" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label name="hwshop-state-chip" text="PRÓXIMAMENTE" class="hw-state-chip" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── PESTAÑAS ── -->
                    <ui:VisualElement class="hwshop-tabs">
                        <ui:Button name="hwshop-tab-levels" text="✦ NIVELES" class="hwshop-tab hwshop-tab-active" />
                        <ui:Button name="hwshop-tab-skins" text="🕷️ SKINS" class="hwshop-tab" />
                        <ui:Button name="hwshop-tab-variants" text="🎃 VARIANTES" class="hwshop-tab" />
                    </ui:VisualElement>

                    <!-- ── CUERPO: una lista por pestaña ── -->
                    <ui:ScrollView name="hwshop-body-scroll" class="hwshop-body-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement class="hwshop-body">

                            <ui:VisualElement name="hwshop-pane-levels" class="hwshop-pane">
                                <ui:VisualElement class="hwshop-section-row">
                                    <ui:Label text="NIVELES DEL PASE" class="hwshop-section-title" picking-mode="Ignore" />
                                    <ui:VisualElement class="hwshop-section-line" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="hwshop-note-levels" text="" class="hwshop-section-note" picking-mode="Ignore" />
                                <ui:VisualElement name="hwshop-list-levels" class="hwshop-list" />
                                <ui:Label text="Cada nivel son 60 XP de la velada. Los niveles se venden solo con la velada abierta; «completar todo el pase» es el atajo caro para quien llegó tarde." class="hwshop-hint" picking-mode="Ignore" />
                            </ui:VisualElement>

                            <ui:VisualElement name="hwshop-pane-skins" class="hwshop-pane hidden">
                                <ui:VisualElement class="hwshop-section-row">
                                    <ui:Label text="SKINS ESCULPIDAS" class="hwshop-section-title" picking-mode="Ignore" />
                                    <ui:VisualElement class="hwshop-section-line" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="hwshop-note-skins" text="" class="hwshop-section-note" picking-mode="Ignore" />
                                <ui:VisualElement name="hwshop-list-skins" class="hwshop-list" />
                                <ui:Label text="Se compran aquí, se equipan en el inventario. Pertenecen a la velada: no salen en la tienda con Gambits." class="hwshop-hint" picking-mode="Ignore" />
                            </ui:VisualElement>

                            <ui:VisualElement name="hwshop-pane-variants" class="hwshop-pane hidden">
                                <ui:VisualElement class="hwshop-section-row">
                                    <ui:Label text="ESCULTURAS DE LA VELADA" class="hwshop-section-title" picking-mode="Ignore" />
                                    <ui:VisualElement class="hwshop-section-line" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="hwshop-note-variants" text="" class="hwshop-section-note" picking-mode="Ignore" />
                                <ui:VisualElement name="hwshop-list-variants" class="hwshop-list" />
                                <ui:Label text="Las variantes entran al tablero con su propia escultura y su habilidad. Se compran en la tienda y se equipan desde el inventario." class="hwshop-hint" picking-mode="Ignore" />
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>

                    <!-- ── PIE ── -->
                    <ui:VisualElement class="prog-footer hwshop-footer">
                        <ui:Label name="hwshop-footer-note" text="" class="prog-footer-note" picking-mode="Ignore" />
                        <ui:Button name="btn-close-hw-shop-foot" text="VOLVER" class="shop2-back-btn prog-footer-btn" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>


    </ui:VisualElement>
</ui:UXML>