/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   WILDER GAMBIT - MAIN MENU & DIFFICULTY SELECTOR STYLES (UI TOOLKIT / USS)
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */

/* â”€â”€â”€ ROOT CONTAINER â”€â”€â”€ */
.root-container {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #0c1220;
    justify-content: center;
    align-items: center;
    font-size: 16px;
    color: #ffffff;
}

/* -- Floating Particles (Polish) -- */
/* fire-embers-overlay deshabilitado temporalmente — raro, será reemplazado
.fire-embers-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0; top: auto;
    width: 100%;
    height: 42%;
    opacity: 0.52;
    -unity-background-scale-mode: scale-and-crop;
    background-position: center 100%;
    background-repeat: no-repeat;
}
*/

.main-menu-particles {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}
.particle {
    position: absolute;
    opacity: 0.5;
}

/* Tres planos de profundidad: lejano, medio y cercano (bokeh) */
.particle-far {
    background-color: rgba(212, 175, 55, 0.5);
    border-radius: 1px;
}

.particle-mid {
    background-color: rgba(200, 180, 130, 0.45);
    border-radius: 2px;
}

.particle-near {
    background-color: rgba(226, 196, 120, 0.4);
    border-radius: 5px;
}

/* Brasas de fuego (rework): MainMenuController repinta el color por frame
   (núcleo caliente -> naranja -> rojo frío al ascender); aquí va la base. */
.particle-ember-far,
.particle-ember-mid,
.particle-ember-near {
    border-radius: 12px;
    background-color: rgba(255, 138, 46, 0.75);
}

.particle-ember-mid {
    background-color: rgba(255, 116, 36, 0.85);
}

.particle-ember-near {
    border-radius: 16px;
    background-color: rgba(255, 96, 30, 0.7);
}

/* Chispas volátiles: núcleo casi blanco, trayectoria rápida */
.particle-spark {
    border-radius: 3px;
    background-color: rgba(255, 244, 190, 0.95);
}

/* Vignette cinematográfico — textura radial generada en MainMenuController */
.menu-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* â”€â”€â”€ VIEW PANELS â”€â”€â”€ */
.view-panel {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    justify-content: center;
    align-items: center;
    padding: 20px;
    opacity: 1;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.view-panel.hidden {
    display: none;
    opacity: 0;
}

.hidden {
    display: none;
    opacity: 0;
}

/* ─── HEADER & LOGO ─── */
.header-section {
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    position: relative;
    padding-top: 10px;
    padding-bottom: 10px;
}

/* Contenedor de piezas de ajedrez detrás del título */
.header-pieces-bg {
    position: absolute;
    top: 42%;
    left: 50%;
    translate: -50% -50%;
    width: 750px;
    height: 190px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    opacity: 0.22;
}

.bg-piece {
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(180, 160, 120, 0.7);
    margin-left: 12px;
    margin-right: 12px;
}

.bg-piece-rook-left {
    width: 60px;
    height: 75px;
    background-image: url("project://database/Assets/Resources/Pieces/White/Rook.png");
    opacity: 0.6;
    rotate: -6deg;
}

.bg-piece-knight-left {
    width: 78px;
    height: 95px;
    background-image: url("project://database/Assets/Resources/Pieces/White/Knight.png");
    opacity: 0.75;
    rotate: -3deg;
}

.bg-piece-king {
    width: 100px;
    height: 125px;
    background-image: url("project://database/Assets/Resources/Pieces/White/King.png");
    opacity: 0.85;
    -unity-background-image-tint-color: rgba(200, 180, 130, 0.8);
}

.bg-piece-queen {
    width: 95px;
    height: 120px;
    background-image: url("project://database/Assets/Resources/Pieces/White/Queen.png");
    opacity: 0.85;
    -unity-background-image-tint-color: rgba(200, 180, 130, 0.8);
}

.bg-piece-knight-right {
    width: 78px;
    height: 95px;
    background-image: url("project://database/Assets/Resources/Pieces/White/Knight.png");
    opacity: 0.75;
    rotate: 3deg;
    scale: -1 1;
}

.bg-piece-rook-right {
    width: 60px;
    height: 75px;
    background-image: url("project://database/Assets/Resources/Pieces/White/Rook.png");
    opacity: 0.6;
    rotate: 6deg;
}

/* Corona decorativa sobre el título */
.title-crown {
    font-size: 56px;
    color: #b8962e;
    -unity-text-align: middle-center;
    margin-bottom: -6px;
    opacity: 0.95;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
}

.main-title {
    font-size: 72px;
    -unity-font-style: bold;
    color: #c4a235;
    letter-spacing: 12px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

/* Halo dorado detrás del título (capa duplicada: USS solo admite una sombra de texto) */
.title-wrap {
    position: relative;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.title-wrap .main-title {
    margin-bottom: 0;
}

.title-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    color: #e9c960;
    text-shadow: 0 0 24px rgba(233, 201, 96, 0.9);
    opacity: 0.6;
}

/* Separador dorado decorativo entre título y subtítulo */
.title-separator {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 360px;
    height: 16px;
    margin-bottom: 8px;
}

.separator-line-left {
    flex-grow: 1;
    height: 2px;
    background-color: rgba(160, 130, 60, 0.7);
    margin-right: 10px;
}

.separator-diamond {
    width: 10px;
    height: 10px;
    background-color: #b8962e;
    rotate: 45deg;
    opacity: 0.9;
}

.separator-line-right {
    flex-grow: 1;
    height: 2px;
    background-color: rgba(160, 130, 60, 0.7);
    margin-left: 10px;
}

.main-subtitle {
    font-size: 15px;
    -unity-font-style: bold;
    color: #8a7e5a;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}

/* --- MENU PRINCIPAL - ETAPA EN TRES COLUMNAS ---
   El menu deja de ser un grupo de elementos sueltos: ahora es una ETAPA
   centrada (cabecera + cuerpo) y el cuerpo son TRES columnas que comparten
   una misma banda de 400px de alto:
     · izquierda  -> los pases (promos del Atelier), uno arriba y otro abajo
     · centro     -> las acciones del juego
     · derecha    -> la coleccion (INVENTARIO) y el saldo
   Todas empiezan y terminan a la misma altura, asi que la composicion se lee
   como un bloque y no como tres islas flotando. */
.menu-main {
    justify-content: center;
    align-items: center;
    padding: 24px 40px;
}
.menu-stage {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
}
.menu-columns {
    flex-direction: row;
    /* BANDA COMUN: las tres columnas se estiran al mismo alto y comparten
       techo y suelo. Antes cada rail se centraba por su cuenta y los tres
       bloques empezaban y terminaban a alturas distintas (ese era el
       desorden): ahora es un unico rectangulo invisible el que los guia. */
    align-items: stretch;
    justify-content: center;
    width: 100%;
    height: 400px;
    margin-top: 28px;
    /* Ni la cabecera ni el cuerpo deben encogerse: si el contenido no cabe,
       se desborda (se recorta abajo), pero el titulo no se deforma. */
    flex-shrink: 0;
}
.header-section { flex-shrink: 0; }
.menu-rail {
    width: 300px;
    flex-shrink: 0;
    justify-content: flex-start;
}
/* Los pases (izq.) y la coleccion (der.) se anclan a los extremos de la banda:
   arriba el primer elemento, abajo el ultimo. */
.menu-rail-left  { margin-right: 44px; justify-content: space-between; }
.menu-rail-right { margin-left: 44px;  justify-content: space-between; }

/* Columna central de acciones.
   Las cuatro piezas miden 104 + 88 + 80 + 80 = 352px. La banda mide 400px,
   así que space-between reparte exactamente 16px entre cada par: el mismo
   aire arriba, entre botones y abajo. */
.menu-actions {
    width: 540px;
    flex-shrink: 0;
    align-items: stretch;
    justify-content: space-between;
}
.menu-action-row {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    /* Las fichas llevan 8px de margen a cada lado. Como la fila sangra esos
       8px, la primera y la última ficha quedan a ras del borde de JUGAR y
       TUS PIEZAS (antes la rejilla entraba 8px respecto a los botones). */
    margin: 0 -8px;
}

/* Boton de media anchura (mitad de una fila de acciones) */
.menu-tile {
    flex: 1;
    height: 80px;
    border-radius: 10px;
    border-width: 2px;
    transition-property: scale, translate, background-color, border-color, color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* 8px por lado = 16px entre fichas: la placa de laton de los botones
       grandes no toca a la vecina y cada ficha se lee como una pieza suelta.
       El margen vertical se anula para que la fila mida lo mismo que la ficha
       (80px) y el ritmo de 16px no se rompa. */
    margin: 0 8px;
}
.menu-tile:hover {
    scale: 1.03 1.03;
    translate: 0 -2px;
}
.menu-tile:active {
    scale: 0.97 0.97;
    translate: 0 1px;
}

/* ═══ PLACAS DE LOS ATAJOS (CACERÍA · TIENDA · AJUSTES · PROGRESO · SALIR) ═══
   Cinco placas de latón pintadas a mano (Google Flow, Nano Banana) que
   sustituyen a los rectángulos planos de color. La textura llega a 2x del
   hueco por defecto (169×80 para las fichas de tres, 262×80 para las de
   dos), así que en 1080p entra con el doble de resolución y el bisel no se
   ve blando; `stretch-to-fill` la encaja en la caja sin deformar el dibujo
   porque la placa ya se generó con la misma proporción.

   La placa trae su propio marco: se anulan borde y radio para no recortar
   las esquinas de la filigrana, y el fondo queda transparente (si no, el
   color de la ficha asomaría por los cantos del PNG). El tint base va al
   92 % y sube a blanco pleno en hover: la placa "se enciende" sin tocar el
   resto de transiciones que ya tenía la ficha. */
.menu-tile.plate {
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(235, 235, 235, 1);
    transition-property: scale, translate, -unity-background-image-tint-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
.menu-tile.plate:hover {
    -unity-background-image-tint-color: rgba(255, 255, 255, 1);
}
.menu-tile.plate:active {
    -unity-background-image-tint-color: rgba(198, 198, 198, 1);
}

.plate-candy    { background-image: url("project://database/Assets/Resources/UI/Menu/wg_tile_candy.png"); }
.plate-shop     { background-image: url("project://database/Assets/Resources/UI/Menu/wg_tile_shop.png"); }
.plate-settings { background-image: url("project://database/Assets/Resources/UI/Menu/wg_tile_settings.png"); }
.plate-progress { background-image: url("project://database/Assets/Resources/UI/Menu/wg_tile_progress.png"); }
.plate-quit     { background-image: url("project://database/Assets/Resources/UI/Menu/wg_tile_quit.png"); }

/* AJUSTES pasa de latón a acero: el rótulo y el alfil se enfrían para no
   quedar en oro sobre una placa azul. */
.menu-tile.btn-secondary .btn-label-sm { color: #d3ddee; }
.menu-tile.btn-secondary .btn-deco-bishop {
    -unity-background-image-tint-color: rgba(214, 226, 244, 0.9);
}

/* â”€â”€â”€ COMMON BUTTON STYLES â”€â”€â”€ */
.menu-button {
    height: 72px;
    /* Sin margen propio: ocupa todo el ancho de la columna y el aire vertical
       lo reparte .menu-actions. El theme por defecto de UI Toolkit metía 3,8px
       a cada lado y JUGAR/TUS PIEZAS quedaban más angostos que las fichas. */
    margin: 0;
    border-radius: 12px;
    border-width: 3px;
    transition-property: scale, translate, background-color, border-color, color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Labels inside buttons */
.btn-label {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    margin-left: 10px;
    margin-right: 10px;
}

.btn-label-sm {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-left: 8px;
    margin-right: 8px;
}

/* ═══ DECORATIVE IMAGES INSIDE BUTTONS ═══ */
.btn-deco {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.btn-deco-sm {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

/* Knight sprite (JUGAR right) */
.btn-deco-knight {
    background-image: url("project://database/Assets/Resources/Pieces/White/Knight.png");
    -unity-background-image-tint-color: rgba(255, 240, 200, 0.85);
}

/* Knight sprite mirrored (JUGAR left) */
.btn-deco-knight-mirror {
    background-image: url("project://database/Assets/Resources/Pieces/White/Knight.png");
    -unity-background-image-tint-color: rgba(255, 240, 200, 0.85);
    scale: -1 1;
}

/* Pawn sprite (TUS PIEZAS) */
.btn-deco-pawn {
    background-image: url("project://database/Assets/Resources/Pieces/White/Pawn.png");
    -unity-background-image-tint-color: rgba(200, 255, 220, 0.85);
}

/* Rook sprite (TIENDA) */
.btn-deco-rook {
    background-image: url("project://database/Assets/Resources/Pieces/White/Rook.png");
    -unity-background-image-tint-color: rgba(212, 196, 168, 0.85);
}

/* Bishop sprite (AJUSTES) */
.btn-deco-bishop {
    background-image: url("project://database/Assets/Resources/Pieces/White/Bishop.png");
    -unity-background-image-tint-color: rgba(200, 184, 120, 0.85);
}

/* King sprite (TUS PIEZAS) */
.btn-deco-king {
    background-image: url("project://database/Assets/Resources/Pieces/White/King.png");
    -unity-background-image-tint-color: rgba(200, 255, 220, 0.85);
}

/* Queen sprite */
.btn-deco-queen {
    background-image: url("project://database/Assets/Resources/Pieces/White/Queen.png");
    -unity-background-image-tint-color: rgba(212, 160, 160, 0.7);
}

/* Primary Play Button */
.btn-primary {
    overflow: hidden;
    background-color: #8b6914;
    border-color: #c4a035;
    border-width: 3px;
    color: #fff3d0;
    /* 104px: junto a TUS PIEZAS (88), las dos filas de fichas (80 + 80) y
       tres aires de 16px, la columna suma los 400px de la banda. */
    height: 104px;
    margin-top: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.7);
}

.btn-primary .btn-label {
    font-size: 32px;
    letter-spacing: 7px;
}

.btn-primary:hover {
    scale: 1.04 1.04;
    translate: 0 -3px;
    background-color: #a07a18;
    border-color: #dbb840;
    color: #ffffff;
}

.btn-primary:active {
    scale: 0.97 0.97;
    translate: 0 1px;
    background-color: #6d520f;
    border-color: #9a7e28;
}

/* Barrido de brillo (shine) sobre el botón JUGAR — animado desde C# */
.btn-shine {
    position: absolute;
    left: -80px;
    top: -8px;
    bottom: -8px;
    width: 64px;
    rotate: 14deg;
    background-color: rgba(255, 244, 214, 0.42);
    opacity: 0;
}

/* Secondary Buttons */
.btn-secondary {
    background-color: #3d3520;
    border-color: #6b5d35;
    color: #c8b878;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.btn-secondary .btn-label-sm {
    /* color cascades from button */
}

.btn-secondary:hover {
    scale: 1.03 1.03;
    translate: 0 -2px;
    background-color: #4d4328;
    border-color: #8a7640;
    color: #ddd090;
}

.btn-secondary:active {
    scale: 0.97 0.97;
    translate: 0 1px;
    background-color: #302a18;
    border-color: #5a4e2d;
}

/* Danger / Quit Button — ahora es una ficha de media fila */
.btn-danger {
    background-color: #3d1616;
    border-color: #6b2c2c;
    color: #c08f8f;
    height: 80px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.btn-danger .btn-label-sm {
    color: #c9a0a0;
    letter-spacing: 3px;
}

.btn-danger:hover {
    background-color: #4d1c1c;
    border-color: #8c3838;
    color: #e8b8b8;
}

.btn-danger:active {
    background-color: #2e1010;
    border-color: #522222;
}

/* â”€â”€â”€ FOOTER â”€â”€â”€ */
.footer-badge {
    position: absolute;
    bottom: 16px;
    font-size: 11px;
    color: rgba(196, 186, 156, 0.6);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   DIFFICULTY SELECTOR VIEW (5 CARDS REWORK)
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */

.difficulty-header {
    align-items: center;
    margin-bottom: 20px;
}

.difficulty-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: #ffd700;
    letter-spacing: 3px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.difficulty-subtitle {
    font-size: 16px;
    color: #9ab0cf;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

/* ── Dynamic Difficulty Suggestion (Phase 8.2) ── */
.difficulty-suggestion {
    width: 860px;
    max-width: 92%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(201,168,74,0.12);
    border-width: 1.5px;
    border-color: #c9a84a;
    border-radius: 14px;
    padding: 12px 16px;
    margin-bottom: 16px;
}
.difficulty-suggestion.hidden { display: none; }
.difficulty-suggestion.suggestion-harder {
    background-color: rgba(231,76,60,0.12);
    border-color: #e74c3c;
}
.difficulty-suggestion.suggestion-easier {
    background-color: rgba(46,204,113,0.12);
    border-color: #2ecc71;
}
.suggestion-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgba(201,168,74,0.18);
    border-width: 1px;
    border-color: rgba(201,168,74,0.35);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
}
.suggestion-harder .suggestion-icon-wrap {
    background-color: rgba(231,76,60,0.18);
    border-color: rgba(231,76,60,0.35);
}
.suggestion-easier .suggestion-icon-wrap {
    background-color: rgba(46,204,113,0.18);
    border-color: rgba(46,204,113,0.35);
}
.suggestion-icon {
    font-size: 22px;
    -unity-text-align: middle-center;
}
.suggestion-texts {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: center;
}
.suggestion-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #f0d27a;
    margin-bottom: 2px;
}
.suggestion-harder .suggestion-title { color: #f87171; }
.suggestion-easier .suggestion-title { color: #34d399; }
.suggestion-subtitle {
    font-size: 12px;
    color: #d6deee;
    white-space: normal;
}
.suggestion-streak {
    font-size: 10px;
    color: #7a8ab0;
    margin-top: 2px;
}
.suggestion-actions {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
}
.btn-suggestion-accept {
    height: 36px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 8px;
    background-color: #c9a84a;
    border-width: 1.5px;
    border-color: #f0d27a;
    color: #1a1400;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    margin-right: 8px;
}
.btn-suggestion-accept:hover {
    background-color: #f0d27a;
    border-color: #ffffff;
}
.btn-suggestion-dismiss {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(255,255,255,0.06);
    border-width: 1px;
    border-color: rgba(122,138,176,0.22);
    color: #7a8ab0;
    font-size: 14px;
    -unity-text-align: middle-center;
}
.btn-suggestion-dismiss:hover {
    background-color: rgba(239,68,68,0.12);
    border-color: rgba(239,68,68,0.35);
    color: #f87171;
}

/* 5 Cards Row — PREMIUM VAULT (unified gold, glassmorphism) */
.difficulty-cards-row {
    flex-direction: row;
    width: 92%;
    max-width: 1180px;
    justify-content: center;
    align-items: stretch;
    margin-top: 8px;
    margin-bottom: 18px;
    flex-wrap: wrap;
}

/* Card Base — vidrio oscuro + borde sutil, sin neón */
.diff-card {
    position: relative;
    width: 200px;
    height: 300px;
    margin: 8px;
    border-radius: 16px;
    background-color: rgba(14, 19, 32, 0.52);
    border-width: 1.5px;
    border-color: rgba(122, 138, 176, 0.18);
    padding: 16px 12px 12px 12px;
    align-items: center;
    justify-content: flex-start;
    transition-property: border-color, background-color, scale, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.diff-card:hover {
    border-color: rgba(212, 179, 106, 0.32);
    background-color: rgba(22, 26, 42, 0.68);
    translate: 0 -4px;
}

/* Seleccionada — borde dorado + glow */
.diff-card-selected {
    border-color: #d4b36a;
    background-color: rgba(212, 179, 106, 0.10);
    border-width: 2px;
    scale: 1.02 1.02;
}
.diff-card-selected:hover {
    border-color: #f0d27a;
    background-color: rgba(212, 179, 106, 0.14);
}

/* Avatar — pieza dorada circular */
.diff-avatar-wrap {
    position: relative;
    width: 68px;
    height: 68px;
    border-radius: 34px;
    background-color: rgba(212, 179, 106, 0.08);
    border-width: 1.5px;
    border-color: rgba(212, 179, 106, 0.22);
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}
.diff-card-selected .diff-avatar-wrap {
    background-color: rgba(212, 179, 106, 0.16);
    border-color: #d4b36a;
}
.diff-avatar-img {
    width: 42px;
    height: 42px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #d4b36a;
}
.avatar-pawn { background-image: url("project://database/Assets/Resources/Pieces/White/Pawn.png"); }
.avatar-knight { background-image: url("project://database/Assets/Resources/Pieces/White/Knight.png"); }
.avatar-bishop { background-image: url("project://database/Assets/Resources/Pieces/White/Bishop.png"); }
.avatar-queen { background-image: url("project://database/Assets/Resources/Pieces/White/Queen.png"); }
.avatar-king { background-image: url("project://database/Assets/Resources/Pieces/White/King.png"); }

/* Nombre — sans limpio, uppercase tracking */
.diff-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: #d6deee;
    letter-spacing: 1.6px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}
.diff-card-selected .diff-name { color: #f0d27a; }

/* Recompensa en Gambits del modo — se crea desde MainMenuController (BindDifficultyCard) */
.diff-reward {
    font-size: 10px;
    -unity-font-style: bold;
    color: #f0d27a;
    letter-spacing: 0.4px;
    background-color: rgba(201, 168, 74, 0.10);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.28);
    border-radius: 8px;
    padding: 3px 10px;
    margin-top: 2px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.2s;
}
.diff-card-selected .diff-reward {
    color: #1a1400;
    background-color: #c9a84a;
    border-color: #f0d27a;
}
.diff-card:hover .diff-reward {
    background-color: rgba(201, 168, 74, 0.18);
    border-color: rgba(201, 168, 74, 0.45);
}

/* ELO — pill bronce sutil */
.diff-elo {
    font-size: 10px;
    -unity-font-style: bold;
    color: #b89a5a;
    background-color: rgba(212, 179, 106, 0.12);
    border-width: 1px;
    border-color: rgba(212, 179, 106, 0.18);
    border-radius: 6px;
    padding: 3px 8px;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}
.diff-card-selected .diff-elo {
    background-color: rgba(212, 179, 106, 0.18);
    border-color: #d4b36a;
    color: #f0d27a;
}

/* Descripción — sans legible */
.diff-desc {
    font-size: 11px;
    color: #9aa8c7;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
    justify-content: center;
    margin-bottom: 12px;
    padding: 0 4px;
}

/* Indicador de selección reemplazado por .diff-check sobre el avatar */

/* Ocultar viejos botones COMBATIR por tarjeta — ahora CTA único */
.diff-select-btn { display: none; }

/* Eliminar saturación neon — override tiers a glass unificado */
.tier-novice, .tier-apprentice, .tier-knight, .tier-master, .tier-grandmaster {
    border-color: rgba(122, 138, 176, 0.18);
    background-color: rgba(14, 19, 32, 0.52);
}
.tier-novice:hover, .tier-apprentice:hover, .tier-knight:hover, .tier-master:hover, .tier-grandmaster:hover {
    border-color: rgba(212, 179, 106, 0.32);
}
.tier-novice .diff-name, .tier-apprentice .diff-name, .tier-knight .diff-name, .tier-master .diff-name, .tier-grandmaster .diff-name { color: #d6deee; }
.tier-novice .diff-elo, .tier-apprentice .diff-elo, .tier-knight .diff-elo, .tier-master .diff-elo, .tier-grandmaster .diff-elo {
    background-color: rgba(212, 179, 106, 0.12);
    color: #b89a5a;
    border-color: rgba(212, 179, 106, 0.18);
}

/* Divisor sutil entre secciones */
.section-divider {
    width: 64%;
    height: 1px;
    background-color: rgba(148, 163, 184, 0.14);
    margin-top: 6px;
    margin-bottom: 16px;
    align-self: center;
}

/* Time Control — barra flotante definida */
.time-control-section {
    width: 88%;
    max-width: 1760px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 16px;
    padding: 0;
}
.time-control-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: #b89a5a;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}
.time-control-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
}
.time-btn {
    min-width: 132px;
    height: 52px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(255,255,255,0.04);
    border-width: 1.5px;
    border-color: rgba(122, 138, 176, 0.18);
    border-radius: 10px;
    padding: 8px 12px;
    margin: 4px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.18s;
}
.time-btn:hover {
    border-color: rgba(212, 179, 106, 0.28);
    background-color: rgba(255,255,255,0.06);
}
.time-btn-active {
    background-color: rgba(212, 179, 106, 0.14);
    border-color: #d4b36a;
    border-width: 2px;
}
.time-btn-icon {
    font-size: 16px;
    color: #b89a5a;
    margin-right: 8px;
    -unity-text-align: middle-center;
    width: 22px;
}
.time-btn-active .time-btn-icon { color: #f0d27a; }
.time-btn-texts {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex-grow: 1;
}
.time-btn-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #d6deee;
    letter-spacing: 0.8px;
}
.time-btn-active .time-btn-title { color: #f0d27a; }
.time-btn-subtitle {
    font-size: 10px;
    color: #7a8ab0;
    margin-top: 1px;
}
.time-btn-active .time-btn-subtitle { color: #b89a5a; }

/* CTA Único */
.cta-start {
    width: 460px;
    max-width: 92%;
    height: 56px;
    border-radius: 12px;
    background-color: #c9a84a;
    border-width: 2px;
    border-color: #f0d27a;
    color: #1a1400;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 0.18s;
}
.cta-start:hover {
    background-color: #f0d27a;
    border-color: #fff3b0;
    scale: 1.02 1.02;
}
.cta-start:active { scale: 0.98 0.98; }
.cta-disabled {
    background-color: rgba(122, 138, 176, 0.14);
    border-color: rgba(122, 138, 176, 0.22);
    color: #5a6a85;
    opacity: 0.72;
}
.cta-disabled:hover {
    background-color: rgba(122, 138, 176, 0.14);
    border-color: rgba(122, 138, 176, 0.22);
    scale: 1 1;
}

/* Bottom bar */
.bottom-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 4px;
}
.btn-back {
    width: 200px;
    height: 42px;
    border-radius: 10px;
    background-color: transparent;
    border-width: 1.5px;
    border-color: rgba(122, 138, 176, 0.22);
    color: #7a8ab0;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    -unity-text-align: middle-center;
    transition-property: border-color, color, background-color;
    transition-duration: 0.18s;
}
.btn-back:hover {
    border-color: rgba(212, 179, 106, 0.35);
    color: #d6deee;
    background-color: rgba(255,255,255,0.04);
}

/* Tipografía premium — título serif dorado */
.difficulty-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: #d4b36a;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}
.difficulty-subtitle {
    font-size: 12px;
    color: #8a9bb5;
    letter-spacing: 0.6px;
    -unity-text-align: middle-center;
    white-space: normal;
}


/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   SETTINGS MODAL VIEW
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 6, 14, 0.84);
    justify-content: center;
    align-items: center;
}

.modal-dialog {
    width: 520px;
    background-color: rgba(9, 14, 27, 0.98);
    border-width: 1px;
    border-color: rgba(212, 179, 106, 0.35);
    border-top-width: 3px;
    border-top-color: #e8c26a;
    border-radius: 18px;
    padding-top: 0px;
    padding-right: 0px;
    padding-bottom: 26px;
    padding-left: 0px;
    align-items: center;
}

.settings-modal-dialog {
    width: 680px;
    max-width: 92%;
}

/* Banda de encabezado a sangre con filo dorado */
.modal-title {
    width: 100%;
    padding-top: 24px;
    padding-right: 30px;
    padding-bottom: 18px;
    padding-left: 30px;
    background-color: rgba(212, 179, 106, 0.07);
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 179, 106, 0.30);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #f6e3ae;
    letter-spacing: 4px;
    -unity-text-align: middle-left;
}

/* Eyebrow en pastilla */
.settings-section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #5eead4;
    letter-spacing: 2.5px;
    align-self: flex-start;
    margin-top: 20px;
    margin-bottom: 12px;
    margin-left: 30px;
    padding-top: 5px;
    padding-right: 12px;
    padding-bottom: 5px;
    padding-left: 10px;
    background-color: rgba(94, 234, 212, 0.08);
    border-width: 1px;
    border-color: rgba(94, 234, 212, 0.25);
    border-radius: 6px;
}

/* Panel a sangre con filo dorado izquierdo */
.setting-card {
    width: 100%;
    background-color: rgba(13, 20, 36, 0.72);
    border-top-width: 1px;
    border-right-width: 0px;
    border-bottom-width: 1px;
    border-left-width: 3px;
    border-color: rgba(148, 163, 184, 0.12);
    border-left-color: #d4b36a;
    border-radius: 0px;
    padding-top: 4px;
    padding-right: 30px;
    padding-bottom: 6px;
    padding-left: 27px;
    margin-bottom: 0px;
}

.setting-item-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-top: 15px;
    padding-bottom: 15px;
}

.setting-text-col {
    flex: 1;
    padding-right: 22px;
    align-items: flex-start;
}

.setting-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: #f8fafc;
    letter-spacing: 0.3px;
    margin-bottom: 3px;
}

.setting-desc {
    font-size: 12px;
    color: #8296b0;
    letter-spacing: 0.2px;
    white-space: normal;
}

.music-picker-control {
    flex-direction: row;
    align-items: center;
    background-color: rgba(5, 9, 18, 0.92);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(94, 234, 212, 0.22);
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

.btn-picker-arrow {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.16);
    color: #93a4bd;
    -unity-text-align: middle-center;
    transition-property: color, border-color, scale;
    transition-duration: 0.12s;
}

.btn-picker-arrow:hover {
    color: #5eead4;
    border-color: rgba(94, 234, 212, 0.55);
    scale: 1.06 1.06;
}

.btn-picker-dropdown {
    height: 30px;
    min-width: 196px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 8px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    background-color: rgba(94, 234, 212, 0.10);
    border-width: 1px;
    border-color: rgba(94, 234, 212, 0.28);
    color: #7df0dd;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.btn-picker-dropdown:hover {
    background-color: rgba(94, 234, 212, 0.20);
    border-color: rgba(94, 234, 212, 0.55);
    color: #ffffff;
}

/* Toggle tipo píldora outline */
.btn-toggle {
    width: 158px;
    height: 36px;
    border-radius: 8px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    border-width: 1.5px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.2s;
}

.btn-toggle.active {
    background-color: rgba(16, 185, 129, 0.14);
    border-color: #34d399;
    color: #6ee7b7;
}

.btn-toggle.inactive {
    background-color: rgba(244, 63, 94, 0.12);
    border-color: #fb7185;
    color: #fda4af;
}

.btn-toggle:hover {
    scale: 1.03 1.03;
    translate: 0 -1px;
}

.btn-toggle.active:hover {
    background-color: rgba(16, 185, 129, 0.22);
    border-color: #6ee7b7;
}

.btn-toggle.inactive:hover {
    background-color: rgba(244, 63, 94, 0.20);
    border-color: #fda4af;
}

.btn-toggle:active {
    scale: 0.97 0.97;
    translate: 0 1px;
}

.btn-modal-close {
    width: 220px;
    height: 46px;
    border-radius: 12px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    background-color: rgba(212, 154, 24, 0.12);
    border-width: 1.5px;
    border-color: #e0b354;
    color: #ffd88a;
    transition-property: background-color, color, scale;
    transition-duration: 0.15s;
}

.btn-modal-close:hover {
    scale: 1.03 1.03;
    background-color: rgba(243, 178, 36, 0.24);
    color: #fff7e0;
}

/* â”€â”€â”€ POPUP BÃšSQUEDA DE MÃšSICA â”€â”€â”€ */

.music-search-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 6, 14, 0.9);
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.music-search-dialog {
    width: 480px;
    max-width: 95%;
    max-height: 90%;
    background-color: rgba(12, 18, 32, 0.98);
    border-color: #14b8a6;
    border-width: 2px;
    border-radius: 16px;
    padding: 22px 24px 18px 24px;
    align-items: center;
}

.music-search-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #14b8a6;
    letter-spacing: 2px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.music-search-subtitle {
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.music-search-input {
    width: 100%;
    margin-bottom: 12px;
}

.music-search-input > .unity-base-field__input {
    height: 40px;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: rgba(70, 85, 120, 0.5);
    background-color: rgba(18, 26, 44, 0.95);
    color: #ffffff;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 14px;
    -unity-text-align: middle-left;
}

.music-search-input:focus > .unity-base-field__input {
    border-color: #14b8a6;
}

.music-tracks-scroll {
    width: 100%;
    max-height: 240px;
    min-height: 120px;
    margin-bottom: 12px;
}

.track-item-card {
    width: 100%;
    height: 42px;
    border-radius: 8px;
    background-color: rgba(22, 32, 54, 0.8);
    border-color: rgba(70, 85, 120, 0.4);
    border-width: 1px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 6px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.track-item-card:hover {
    background-color: rgba(25, 45, 75, 0.95);
    border-color: #38bdf8;
    scale: 1.01 1.01;
}

.track-item-card.track-selected {
    background-color: rgba(20, 184, 166, 0.2);
    border-color: #14b8a6;
}

.track-item-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: #f1f5f9;
}

.track-item-card.track-selected .track-item-name {
    color: #5eead4;
}

.track-item-badge {
    font-size: 13px;
    color: #5eead4;
}

.btn-close-music-search {
    width: 160px;
    height: 38px;
    border-radius: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(40, 50, 75, 0.8);
    border-color: rgba(90, 110, 150, 0.5);
    border-width: 1.5px;
    color: #e2e8f0;
}

.btn-close-music-search:hover {
    background-color: rgba(60, 75, 110, 0.95);
    color: #ffffff;
}

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   SECONDARY ROW & SHOP BUTTON
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */

/* Shop / Tienda button â€” teal accent */
.btn-shop {
    background-color: #4a3728;
    border-color: #8b7355;
    color: #d4c4a8;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.btn-shop .btn-label-sm {
    /* color cascades from button */
}

.btn-shop:hover {
    scale: 1.03 1.03;
    translate: 0 -2px;
    background-color: #5a4530;
    border-color: #a08860;
    color: #e8dcc0;
}

.btn-shop:active {
    scale: 0.97 0.97;
    translate: 0 1px;
    background-color: #3a2c1e;
    border-color: #706040;
}

/* â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• 
   SHOP MODAL (PRÃ“XIMAMENTE)
   â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â•  */

/* â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• 
   FULLSCREEN SHOP VIEW (REWORK)
   â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â•  */


/* ═══════════════════════════════════════════════════════════
   SHOP 2.0 — ATELIER NOIR / VAULT EDITION
   Rework total: Split Rail + Cinematic Stage
   ═══════════════════════════════════════════════════════════ */

/* ── Root & Backdrop ── */
.shop2-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    background-color: rgba(3, 5, 12, 0.92);
    justify-content: center;
    align-items: center;
    padding: 12px;
    transition-property: opacity;
    transition-duration: 0.25s;
}
.shop2-root.hidden { display: none; }

.shop2-backdrop {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.shop2-window {
    width: 96%;
    max-width: 1280px;
    height: 92%;
    max-height: 860px;
    flex-direction: column;
    background-color: #070b18;
    border-width: 1.5px;
    border-color: #c9a84a;
    border-radius: 22px;
    overflow: hidden;
}

/* Legacy alias: old container class still used by ShopModal root query fallback */
.shop-fullscreen-view { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; background-color: rgba(3,5,12,0.92); justify-content: center; align-items: center; }
.shop-fullscreen-container { width: 96%; max-width: 1280px; height: 92%; max-height: 860px; flex-direction: row; background-color: #070b18; border-width: 1.5px; border-color: #c9a84a; border-radius: 22px; overflow: hidden; }

/* La barra se reparte el ancho del modal: las pestañas crecen como un rail
   y dejan de apiñarse a la izquierda. */
.shop2-tabs-bar {
    width: 100%;
    background-color: #080e1c;
    border-top-width: 1px;
    border-top-color: rgba(201, 168, 74, 0.06);
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 74, 0.22);
    flex-shrink: 0;
}
/* Scrollbar horizontal oculto: los tabs caben y el foco hace scroll automático */
.shop2-tabs-bar > .unity-scroll-view__horizontal-scroller,
.shop2-tabs-bar > .unity-scroll-view__content-container > .unity-scroll-view__horizontal-scroller {
    height: 0;
}
.shop2-tabs {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 64px;
    padding: 0 10px;
}
.shop2-tab {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 48px;
    /* 20 px deja el texto dentro del tramo central del chip: el borde
       9-slice ocupa ~13 px y el indice no debe montarse en el ornamento. */
    padding: 0 20px;
    margin: 0 4px;
    background-color: rgba(255, 255, 255, 0.02);
    border-width: 0;
    border-radius: 0;
    transition-property: background-color, scale, opacity;
    transition-duration: 0.18s;
}
/* Solo el rail de la tienda se reparte el ancho; en el inventario las
   pestañas usan un ancho minimo (ver .inv-tabs) y el hint sigue a la derecha. */
.shop2-tabs .shop2-tab {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 132px;
}
.shop2-tab:hover {
    background-color: rgba(201, 168, 74, 0.05);
    scale: 1.015 1.015;
}
/* Índice de catálogo (01, 02…): guiño al rail numerado del Atelier */
.shop2-tab-index {
    font-size: 9.5px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgba(201, 168, 74, 0.68);
    margin-right: 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.shop2-tab-label {
    flex-grow: 1;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.25px;
    color: #9aa6bd;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}
.shop2-tab-count {
    min-width: 23px;
    height: 19px;
    font-size: 9.5px;
    color: #dbe1f0;
    background-color: rgba(5, 9, 18, 0.72);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.4);
    border-radius: 9.5px;
    padding: 0 7px;
    margin-left: 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
/* Rombo de selección: cuelga del borde inferior de la pestaña activa */
.shop2-tab-indicator {
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 6px;
    height: 6px;
    translate: -50% 0;
    rotate: 45deg;
    background-color: #e8c46a;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}
/* Activo — ShopModal añade shop-tab-active + shop2-nav-active (ganamos en especificidad) */
.shop2-tab.shop-tab-active,
.shop2-tab.shop2-nav-active {
    background-color: rgba(201, 168, 74, 0.09);
    border-width: 0;
}
.shop2-tab.shop-tab-active .shop2-tab-index,
.shop2-tab.shop2-nav-active .shop2-tab-index { color: #e8c46a; }
.shop2-tab.shop-tab-active .shop2-tab-label,
.shop2-tab.shop2-nav-active .shop2-tab-label { color: #f4d98c; }
.shop2-tab.shop-tab-active .shop2-tab-count,
.shop2-tab.shop2-nav-active .shop2-tab-count {
    background-color: #d8b45c;
    border-color: #f0d27a;
    color: #14100a;
}
.shop2-tab.shop-tab-active .shop2-tab-indicator,
.shop2-tab.shop2-nav-active .shop2-tab-indicator { opacity: 1; }
/* Bloqueado — gris + candado dorado, no interactivos (picking-mode Ignore en UXML) */
.shop2-tab-locked {
    background-color: rgba(255, 255, 255, 0.015);
    opacity: 0.55;
}
.shop2-tab-locked .shop2-tab-label { color: #6b7488; }
.shop2-tab-lock {
    width: 13px;
    height: 16px;
    margin-left: 8px;
    background-image: url("project://database/Assets/_Project/Textures/UI/shop_lock.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.95;
}

/* ── BODY: catálogo + panel de detalle ── */
.shop2-body {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
    min-height: 0;
}
.shop2-catalog {
    position: relative; /* overlays de login/loading acotados al catálogo */
    flex-grow: 1;
    min-width: 0;
}

/* ── PANEL DE DETALLE (solo con selección) ── */
.shop2-detail {
    width: 38%;
    min-width: 320px;
    max-width: 470px;
    height: 100%;
    flex-direction: column;
    justify-content: flex-start; /* contenido anclado arriba */
    position: relative; /* ancla para el botón ✕ */
    background-color: #0c152b;
    border-left-width: 1.5px;
    border-left-color: rgba(201, 168, 74, 0.35);
    padding: 14px;
    overflow: hidden;
    flex-shrink: 0;
    opacity: 0;
    translate: 18px 0;
    transition-property: opacity, translate;
    transition-duration: 0.18s; /* colapsar */
}
.shop2-detail.shop2-detail-open {
    opacity: 1;
    translate: 0 0;
    transition-duration: 0.25s; /* abrir */
}
.shop2-detail .shop2-hero {
    height: 196px;
    min-height: 196px;
    margin-bottom: 12px;
}
/* Botón CERRAR del panel: anclado abajo, gradiente rojo→negro (textura en código)
   y texto amarillo — se pinta en ShopBackgroundSelector.ApplyCloseButtonGradient */
.shop2-detail-close {
    width: 100%;
    height: 40px;
    margin-top: 12px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: #c9a84a;
    color: #ffd75e;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: #4a1212; /* fallback mientras no hay textura */
    transition-property: border-color, scale;
    transition-duration: 0.18s;
}
.shop2-detail-close:hover {
    border-color: #ffe08a;
    scale: 1.01 1.01;
}
.shop2-detail-info {
    width: 100%;
    align-items: flex-start;
    flex-grow: 0; /* compacto: el contenido se apila arriba, sin huecos */
}
.shop2-detail-kicker {
    font-size: 9px;
    letter-spacing: 2.5px;
    color: #c9a84a;
    margin-bottom: 8px;
}
.shop2-detail-pricerow {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 10px;
}
.shop2-detail-price {
    font-size: 20px;
    -unity-font-style: bold;
    color: #f0d27a;
    margin-right: 10px;
}
.shop2-detail-stock {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: #8a9bb5;
    background-color: rgba(122, 138, 176, 0.12);
    border-radius: 10px;
    padding: 3px 9px;
}

/* ── Oferta de Halloween (Alfil Nigromante -20%) ──
   Distintivo en el panel de detalle y en la card de la variante. */
.shop2-detail-offer {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    color: #ffb86b;
    background-color: rgba(224, 124, 58, 0.18);
    border-width: 1px;
    border-color: rgba(224, 124, 58, 0.55);
    border-radius: 10px;
    padding: 3px 9px;
    margin-right: 8px;
    -unity-text-align: middle-center;
}
.shop2-price-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.shop2-discount-badge {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    color: #ffb86b;
    background-color: rgba(224, 124, 58, 0.18);
    border-width: 1px;
    border-color: rgba(224, 124, 58, 0.55);
    border-radius: 10px;
    padding: 3px 8px;
    margin-left: 6px;
    -unity-text-align: middle-center;
}
.shop2-detail-hint {
    font-size: 11px;
    color: #8a9bb5;
    white-space: normal;
}
.shop2-detail-actions {
    width: 100%;
    margin-top: 10px;
}
.shop2-detail .shop2-detail-cta {
    width: 100%;
    margin-right: 0;
}

/* ── SKELETON (estado de carga con cards fantasma, arriba del overlay) ── */
.shop2-skeleton-row {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
}
.shop2-skeleton-card {
    width: 150px;
    height: 180px;
    margin: 0 8px;
    border-radius: 14px;
    background-color: #0e1430;
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.12);
    padding: 8px;
    align-items: center;
    opacity: 0.7;
}
.shop2-skeleton-thumb {
    width: 100%;
    height: 100px;
    border-radius: 10px;
    background-color: rgba(122, 138, 176, 0.10);
    margin-bottom: 10px;
}
.shop2-skeleton-line {
    width: 80%;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(122, 138, 176, 0.14);
    margin-bottom: 6px;
}
.shop2-skeleton-line.short { width: 45%; }

/* ── TOPBAR SUPERIOR (reemplaza al rail izquierdo) ── */
.shop2-topbar {
    width: 100%;
    flex-direction: row;
    align-items: center;
    background-color: #0c152b;
    border-bottom-width: 1.5px;
    border-bottom-color: rgba(201, 168, 74, 0.35);
    padding: 12px 18px;
    flex-shrink: 0;
}

.shop2-topbar .shop2-rail-header {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-bottom: 0;
}
.shop2-topbar .shop2-back-btn {
    width: auto;
    padding: 0 14px;
    margin-bottom: 0;
}
.shop2-topbar .shop2-brand {
    flex-direction: row;
    align-items: center; /* USS no soporta 'baseline'; 'center' es el sustituto */
    margin-left: 18px;
    margin-bottom: 0;
}
.shop2-topbar .shop2-brand-title { font-size: 20px; margin-bottom: 0; margin-left: 8px; }
.shop2-topbar .shop2-brand-line { display: none; }
.shop2-topbar .shop2-brand-subtitle { display: none; }
/* Bóveda y usuario alineados a la derecha del topbar */
.shop2-topbar .shop2-rail-vault {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    margin-top: 0;
    padding: 0;
}
.shop2-topbar .shop2-vault-head { display: none; }
.shop2-topbar .shop2-vault-chips { flex-direction: row; align-items: center; }
/* Los chips del topbar llevan dos lineas de texto (cifra + rótulo): el
   padding antiguo de 6px cortaba el rótulo inferior contra el borde.
   min-height 60px + padding 10x18 da aire suficiente incluso al chip
   "Hoy", cuyo subtexto "HASTA 900 AL 100%" es la cadena más larga. */
.shop2-topbar .shop2-chip {
    margin-bottom: 0;
    margin-right: 10px;
    padding: 10px 18px;
    align-items: center;
    min-height: 60px;
}
.shop2-topbar .shop2-chip-texts { justify-content: center; }
.shop2-topbar .shop2-chip-amount { font-size: 19px; }
.shop2-topbar .shop2-chip-label { font-size: 10px; }
.shop2-topbar .shop2-balance-card { margin-bottom: 0; margin-right: 10px; }
.shop2-topbar .shop2-balance-slot { padding: 5px 12px 5px 8px; }
.shop2-topbar .shop2-balance-caption { font-size: 8px; letter-spacing: 1.6px; }
.shop2-topbar .shop2-profile-card { margin-top: 0; margin-left: 8px; padding: 4px 8px; }
.shop2-topbar .shop2-rail-footer { display: none; }

.shop2-back-btn {
    width: 100%;
    height: 36px;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.35);
    border-radius: 8px;
    color: #c9a84a;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.18s;
}
.shop2-back-btn:hover {
    background-color: rgba(201, 168, 74, 0.12);
    border-color: #c9a84a;
    color: #f0d27a;
}

.shop2-brand {
    align-items: flex-start;
}
.shop2-brand-kicker {
    font-size: 10px;
    letter-spacing: 4px;
    color: #7a8ab0;
    margin-bottom: 2px;
}
.shop2-brand-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: #f0d27a;
    letter-spacing: 3px;
    margin-bottom: 6px;
}
.shop2-brand-line {
    width: 48px;
    height: 2px;
    background-color: #c9a84a;
    margin-bottom: 10px;
    opacity: 0.9;
}
.shop2-brand-subtitle {
    font-size: 12px;
    color: #8a9bb5;
    white-space: normal;
    /* line-height removed for USS compatibility */
}

/* ── Nav ── */
.shop2-nav {
    margin-top: 18px;
    margin-bottom: 12px;
}
.shop2-nav-item {
    width: 100%;
    height: 62px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(122,138,176,0.18);
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 8px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.18s;
}
.shop2-nav-item:hover {
    background-color: rgba(201,168,74,0.08);
    border-color: rgba(201,168,74,0.35);
    scale: 1.01 1.01;
}
.shop2-nav-active {
    background-color: rgba(201,168,74,0.16);
    border-color: #c9a84a;
    border-left-width: 3px;
}
.shop2-nav-num {
    font-size: 11px;
    -unity-font-style: bold;
    color: #7a8ab0;
    margin-right: 12px;
    min-width: 20px;
    -unity-text-align: middle-center;
}
.shop2-nav-active .shop2-nav-num { color: #c9a84a; }
.shop2-nav-texts {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: center;
}
.shop2-nav-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: #d6deee;
    letter-spacing: 1px;
}
.shop2-nav-active .shop2-nav-label { color: #f0d27a; }
.shop2-nav-count {
    font-size: 11px;
    color: #7a8ab0;
    margin-top: 1px;
}
.shop2-nav-active .shop2-nav-count { color: #c9a84a; }
.shop2-nav-arrow {
    font-size: 14px;
    color: rgba(201,168,74,0.0);
    margin-left: 8px;
}
.shop2-nav-active .shop2-nav-arrow { color: #c9a84a; }
.shop2-nav-item:hover .shop2-nav-arrow { color: rgba(201,168,74,0.6); }

/* Legacy tab alias for old ShopModal active class */
.shop-category-tab { width: 100%; height: 62px; flex-direction: row; background-color: rgba(255,255,255,0.03); border-width: 1px; border-color: rgba(122,138,176,0.18); border-radius: 12px; }
.shop-tab-active { background-color: rgba(201,168,74,0.16); border-color: #c9a84a; border-left-width: 3px; }

/* ── Vault ── */
.shop2-rail-vault {
    background-color: rgba(0,0,0,0.22);
    border-width: 1px;
    border-color: rgba(122,138,176,0.15);
    border-radius: 14px;
    padding: 12px;
    margin-top: 6px;
}
.shop2-vault-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}
.shop2-vault-eyebrow {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #c9a84a;
}
.shop2-vault-sub {
    font-size: 10px;
    color: #5a6a85;
    letter-spacing: 0.5px;
}
.shop2-vault-chips {
    flex-direction: column;
}
.shop2-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255,255,255,0.04);
    border-width: 1px;
    border-color: rgba(122,138,176,0.16);
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 8px;
}
.chip-tides { border-color: rgba(42,154,214,0.25); background-color: rgba(42,154,214,0.07); }
.chip-gambits { border-color: rgba(201,168,74,0.28); background-color: rgba(201,168,74,0.08); }

.shop2-chip-icon-wrap {
    width: 36px; height: 36px;
    border-radius: 18px;
    background-color: rgba(42,154,214,0.18);
    border-width: 1px;
    border-color: rgba(42,154,214,0.35);
    align-items: center; justify-content: center;
    margin-right: 10px;
    padding: 0;
    flex-shrink: 0;
}
.shop2-chip-icon-wrap-gambit {
    background-color: rgba(201,168,74,0.18);
    border-color: rgba(201,168,74,0.45);
}
.shop2-chip-icon {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    align-self: center;
    font-size: 16px;
    color: #7dd3fc;
    -unity-text-align: middle-center;
}
.chip-gambits .shop2-chip-icon { color: #f0d27a; }
.shop2-chip-texts { flex-grow: 1; align-items: flex-start; }
.shop2-chip-amount {
    font-size: 18px;
    -unity-font-style: bold;
    color: #e6f0ff;
    letter-spacing: 0.5px;
}
.shop2-chip-label {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: #7a8ab0;
    margin-top: 1px;
}

/* ── BÓVEDA V2 ─────────────────────────────────────────────────────────
   Rework robusto anti-descentrado.
   Reglas de oro:
   1. La caja del icono tiene tamaño fijo y centra SOLO con flex
      (align-items + justify-content). El Label interior NUNCA lleva
      width/height 100% ni translate: es auto-size + middle-center.
   2. Todo en tamaño natural (flex-grow 0 / shrink 0): nada de basis 0
      ni min-width 0 dentro de un pill auto-width, eso colapsa Yoga
      y solapa iconos/textos.
   3. Divisor con altura fija (no %), align-self:center.
   4. Cantidades con nowrap (sin ellipsis/overflow que fuerzan shrink). */
.shop2-balance-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.22);
    border-radius: 12px;
    padding: 4px;
    margin-bottom: 0;
    margin-right: 10px;
    margin-top: 0;
    margin-left: 0;
    flex-shrink: 0;
}
.shop2-balance-slot {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
    padding: 6px 10px;
    margin: 0;
}
.shop2-balance-icon {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 1px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 9px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
}
.shop2-balance-icon--tides {
    background-color: rgba(42, 154, 214, 0.14);
    border-color: rgba(42, 154, 214, 0.30);
}
.shop2-balance-icon--gambits {
    background-color: rgba(201, 168, 74, 0.14);
    border-color: rgba(201, 168, 74, 0.38);
}
.shop2-balance-glyph {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.shop2-balance-icon--tides .shop2-balance-glyph {
    font-size: 14px;
    color: #7dd3fc;
}
.shop2-balance-icon--gambits .shop2-balance-glyph {
    font-size: 15px;
    color: #f0d27a;
}
.shop2-balance-texts {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}
.shop2-balance-amount {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 0.2px;
    color: #d9e9ff;
    white-space: nowrap;
    margin: 0;
    padding: 0;
    -unity-text-align: upper-left;
}
.shop2-balance-amount--tides { color: #d3ebff; }
.shop2-balance-amount--gambits { color: #ffeec2; }
.shop2-balance-caption {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.8px;
    color: rgba(122, 138, 176, 0.8);
    margin-top: 2px;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: upper-left;
}
.shop2-balance-divider {
    width: 1px;
    height: 28px;
    align-self: center;
    background-color: rgba(201, 168, 74, 0.20);
    flex-shrink: 0;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
}

/* ── PERFIL V2 ─────────────────────────────────────────────────────────
   Misma filosofía: avatar fijo centrado con flex, textos con ellipsis,
   botón con tamaño fijo y texto middle-center. Sin width/height 100%
   en Labels interiores, sin translate. */
.shop2-profile-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255,255,255,0.04);
    border-width: 1px;
    border-color: rgba(201,168,74,0.22);
    border-radius: 10px;
    padding: 8px 10px;
    margin-top: 6px;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    flex-shrink: 0;
}
.shop2-profile-card.hidden { display: none; }
.shop2-profile-avatar {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: #c9a84a;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
    border-width: 0;
}
.shop2-profile-avatar-letter {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: #1a1400;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.shop2-profile-texts {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    margin-right: 10px;
}
.shop2-profile-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f0d27a;
    white-space: nowrap;
    margin: 0;
    padding: 0;
}
.shop2-profile-handle {
    font-size: 10px;
    color: #7a8ab0;
    white-space: nowrap;
    margin: 0;
    padding: 0;
}
.shop2-profile-logout {
    width: 58px;
    height: 28px;
    flex-shrink: 0;
    background-color: rgba(220,38,38,0.12);
    border-width: 1px;
    border-color: rgba(239,68,68,0.35);
    border-radius: 7px;
    color: #fca5a5;
    font-size: 11px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}
.shop2-profile-logout:hover { background-color: rgba(220,38,38,0.22); border-color: #ef4444; color: #ffffff; }

/* Legacy header alias */
.shop-header-user-area { flex-direction: row; align-items: center; background-color: rgba(255,255,255,0.04); border-width: 1px; border-color: rgba(201,168,74,0.22); border-radius: 10px; padding: 8px 10px; }
.shop-header-avatar { width: 32px; height: 32px; border-radius: 16px; background-color: #c9a84a; align-items: center; justify-content: center; }
.shop-avatar-letter { font-size: 14px; -unity-font-style: bold; color: #1a1400; }
.shop-header-username { font-size: 13px; -unity-font-style: bold; color: #f0d27a; }

.shop2-rail-footer {
    margin-top: 10px;
    align-items: center;
}
.shop2-rail-footer-text {
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(122,138,176,0.55);
    -unity-text-align: middle-center;
}

/* ── STAGE ── */
.shop2-stage {
    flex-grow: 1;
    height: 100%;
    background-color: #050810;
    padding: 16px 16px 12px 16px;
    justify-content: flex-start;
    align-items: stretch;
}

/* ── HERO ── */
.shop2-hero {
    width: 100%;
    height: 220px;
    min-height: 220px;
    border-radius: 16px;
    background-color: #0a0f1e;
    border-width: 1px;
    border-color: rgba(122,138,176,0.18);
    overflow: hidden;
    margin-bottom: 14px;
    flex-shrink: 0;
    position: relative;
}
.shop2-hero-image {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}
.shop2-hero-scrim {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 72%;
    background-color: rgba(5,8,16,0.78);
}
.shop2-hero-content {
    position: absolute;
    left: 16px; right: 110px; bottom: 14px;
    align-items: flex-start;
}
.shop2-hero-kicker {
    font-size: 9px;
    letter-spacing: 2.5px;
    color: #c9a84a;
    margin-bottom: 6px;
}
.shop2-hero-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.85);
}
.shop2-hero-desc {
    font-size: 12px;
    color: #c8d3e8;
    white-space: normal;
    opacity: 0.9;
}
.shop2-hero-badge {
    position: absolute;
    top: 12px; right: 12px;
    background-color: #10b981;
    border-radius: 20px;
    padding: 5px 10px;
    align-items: center;
    justify-content: center;
}
.shop2-hero-badge.hidden { display: none; }
.shop2-hero-badge-label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #022c22;
    -unity-text-align: middle-center;
}

/* Legacy preview alias */
.bg-preview-panel { width: 100%; height: 220px; min-height: 220px; border-radius: 16px; background-color: #0a0f1e; border-width: 1px; border-color: rgba(122,138,176,0.18); overflow: hidden; margin-bottom: 14px; flex-shrink: 0; position: relative; }
.bg-preview-image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; }
.bg-preview-info { position: absolute; left: 16px; right: 110px; bottom: 14px; align-items: flex-start; }
.bg-preview-name { font-size: 22px; -unity-font-style: bold; color: #ffffff; margin-bottom: 4px; }
.bg-preview-desc { font-size: 12px; color: #c8d3e8; white-space: normal; }

/* ── CONNECTED ── */
/* Catálogo centrado verticalmente: con pocas cards el bloque queda en el
   centro del stage; con muchas, el scroll crece y la paginación reparte. */
.shop2-connected {
    flex-grow: 1;
    justify-content: center;
    align-items: stretch;
    min-height: 0;
}
.shop2-connected.hidden { display: none; }

.shop2-grid-scroll {
    flex-grow: 0;   /* abraza el contenido cuando es poco (queda arriba, compacto) */
    flex-shrink: 1;  /* si desborda, se amplía hasta la altura disponible y hace scroll */
    min-height: 0;
    background-color: transparent;
    margin-bottom: 10px;
}
/* Scrollbar eliminada (USS + vertical-scroller-visibility=Hidden en UXML):
   el catálogo pagina por espacio (ShopGridPager): solo desborda si no cabe */
.shop2-grid-scroll .unity-scroll-view__vertical-scroller,
.shop2-grid-scroll .unity-scroll-view__horizontal-scroller,
.shop2-grid-scroll > .unity-scroll-view__vertical-scroller,
.shop2-grid-scroll > .unity-scroll-view__horizontal-scroller,
.shop2-tabs-bar .unity-scroll-view__horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

/* Suelo ambiental: degrada la zona inferior para enmascarar el espacio muerto */
.shop2-catalog-fade {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 220px;
    -unity-background-scale-mode: stretch-to-fill;
}
.shop2-catalog-footer {
    position: absolute;
    left: 0; right: 0; bottom: 10px;
    font-size: 9px;
    letter-spacing: 3px;
    color: rgba(122, 138, 176, 0.4);
    -unity-text-align: middle-center;
}
.shop2-grid-scroll > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    padding: 2px;
}
.shop2-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
}
.shop2-empty {
    width: 100%;
    height: 120px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255,255,255,0.02);
    border-width: 1px;
    border-color: rgba(122,138,176,0.12);
    border-radius: 12px;
    padding: 16px;
}
.shop2-empty-title { font-size: 12px; -unity-font-style: bold; letter-spacing: 2px; color: #7a8ab0; margin-bottom: 6px; }
.shop2-empty-desc { font-size: 11px; color: #5a6a85; -unity-text-align: middle-center; white-space: normal; }

/* Legacy grid alias */
.shop-items-scrollview { flex-grow: 1; background-color: transparent; margin-bottom: 10px; }
.shop-items-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; width: 100%; }

/* ── CARDS — ATELIER FRAME ── */.bg-card {
    width: 176px;
    height: 236px;
    margin: 6px;
    padding: 7px;
    border-radius: 14px;
    background-color: #0e1430;
    border-width: 1.5px;
    border-color: rgba(122, 138, 176, 0.18);
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    position: relative;
    transition-property: border-color, background-color, scale, opacity, translate;
    transition-duration: 0.18s;
}
.bg-card.shop-card-enter {
    opacity: 0;
    translate: 0 8px;
}
.bg-card:focus {
    /* 'outline-width' no existe en USS: el foco se marca con el borde de abajo */
    border-color: #c9a84a;
}
.bg-card-selected {
    border-color: rgba(201, 168, 74, 0.9);
    background-color: #141a36;
}

.bg-card:hover {
    border-color: rgba(201,168,74,0.55);
    background-color: #121a38;
    scale: 1.025 1.025;
}
.bg-card-active {
    border-color: #c9a84a;
    background-color: #1a1608;
    border-width: 2px;
}
.bg-card-thumb {
    width: 100%;
    height: 122px;
    border-radius: 10px;
    background-color: #060a14;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    position: relative;
    border-width: 1px;
    border-color: rgba(122,138,176,0.12);
}
.bg-card-active .bg-card-thumb { border-color: rgba(201,168,74,0.35); }
.bg-card-thumb-img { width: 100%; height: 100%; }
.bg-card-thumb-placeholder { width: 100%; height: 100%; margin: 0; padding: 0; font-size: 28px; color: #5a6a85; opacity: 0.5; -unity-text-align: middle-center; }
.bg-card-thumb-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 28px;
    background-color: rgba(0,0,0,0.35);
}

/* ── Card de VARIANTE (02 VARIANTES): showcase del arte de la pieza ── */
.bg-card.bg-card-variant {
    width: 208px;
    height: 322px;
}
.bg-card.bg-card-variant .bg-card-thumb {
    height: 212px;
    background-color: #05070f; /* negro casi puro: el marfil/dorado resalta */
}
/* Halo suave detrás de la pieza (USS no admite degradados ni blur: dos elipses apiladas) */
.bg-card-thumb-glow {
    position: absolute;
    width: 180px;
    height: 140px;
    left: 50%;
    top: 52%;
    translate: -50% -50%;
    border-radius: 50%;
    background-color: rgba(212, 179, 106, 0.06);
}
.bg-card-thumb-glow-core {
    position: absolute;
    width: 116px;
    height: 96px;
    left: 50%;
    top: 56%;
    translate: -50% -50%;
    border-radius: 50%;
    background-color: rgba(240, 210, 122, 0.10);
}
.bg-card-badge {
    position: absolute;
    top: 6px; right: 6px;
    background-color: #c9a84a;
    color: #1a1400;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    padding: 3px 7px;
    border-radius: 6px;
}
.bg-card-name-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 2px;
    padding: 0 6px;
    flex-shrink: 0;
}
/* Fila propia de rareza: centrada, sin competir con el nombre */
.bg-card-rarity-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 7px;
    margin-bottom: 0;
    padding: 0 6px;
    flex-shrink: 0;
}
/* Nombre a ancho completo cuando la rareza va arriba */
.bg-card-name-row-single {
    margin-top: 4px;
}
.bg-card-name-row-single .bg-card-name {
    flex-grow: 1;
    width: 100%;
}
.bg-card-icon { font-size: 12px; margin-right: 5px; color: #c9a84a; -unity-text-align: middle-center; }
.bg-card-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: #e6dcc0;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}/* Botones de compra/equipar ahora viven en el panel de detalle (btn-detail-action) */

.bg-card-locked {
    opacity: 0.7;
}
.bg-card-lock-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0,0,0,0.55);
    align-items: center;
    justify-content: center;
}
.bg-card-lock-icon {
    width: 100%;
    margin: 0;
    padding: 0;
    font-size: 28px;
    -unity-text-align: middle-center;
}
/* Precio en píldora dorada (el CTA vive en el panel de detalle) */
.bg-card-price {
    width: auto;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: #f0d27a;
    background-color: rgba(201, 168, 74, 0.12);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.35);
    border-radius: 10px;
    padding: 3px 10px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-top: 4px;
    margin-bottom: 2px;
}
.bg-card-price-expensive {
    color: #f87171;
    background-color: rgba(248, 113, 113, 0.08);
    border-color: rgba(248, 113, 113, 0.35);
}

/* ── Pie fijo de card: precios y estados siempre a la misma altura ──
   Las cards del Atelier tienen alto fijo; el pie se ancla abajo para que
   GRATIS, un precio con icono o "EN EL INVENTARIO" no muevan la línea. */
.bg-card-footer {
    position: absolute;
    left: 7px;
    right: 7px;
    bottom: 7px;
    height: 26px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}
.bg-card-footer > .bg-card-price,
.bg-card-footer .gambits-inline-text.bg-card-price,
.bg-card-footer > .bg-card-state,
.bg-card-footer .bg-card-state {
    height: 24px;
    margin: 0;
    padding: 0 11px;
    -unity-text-align: middle-center;
}
.bg-card-footer .gambits-inline-row { height: 24px; }
.bg-card-footer .shop2-price-row { margin: 0; }
.bg-card-variant .bg-card-footer { left: 9px; right: 9px; bottom: 9px; }
.bg-card-variant .bg-card-footer > .bg-card-state,
.bg-card-variant .bg-card-footer .bg-card-state { padding: 0 9px; }

/* ── Pagination — dots ── */
.shop2-pagination {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 32px;
    margin-top: 4px;
}
.shop2-page-arrow {
    width: 32px; height: 32px;
    border-radius: 16px;
    background-color: rgba(255,255,255,0.04);
    border-width: 1px;
    border-color: rgba(122,138,176,0.18);
    color: #7a8ab0;
    font-size: 18px;
    padding: 0;
    -unity-text-align: middle-center;
}
.shop2-page-arrow:hover { border-color: #c9a84a; color: #f0d27a; background-color: rgba(201,168,74,0.1); }
.shop2-page-dots {
    flex-direction: row;
    align-items: center;
    margin: 0 12px;
}
.shop2-page-dot {
    width: 28px; height: 28px;
    border-radius: 14px;
    background-color: rgba(255,255,255,0.06);
    border-width: 1px;
    border-color: rgba(122,138,176,0.18);
    color: #7a8ab0;
    font-size: 12px;
    -unity-font-style: bold;
    margin: 0 3px;
    padding: 0;
    -unity-text-align: middle-center;
}
.shop2-page-dot:hover { border-color: rgba(201,168,74,0.4); color: #d6deee; }
.shop2-page-dot.page-active {
    width: 36px;
    background-color: #c9a84a;
    border-color: #f0d27a;
    color: #1a1400;
}

/* Legacy pagination alias */
.shop-pagination-row { flex-direction: row; align-items: center; justify-content: center; height: 32px; margin-top: 4px; }
.shop-pagination-pages { flex-direction: row; align-items: center; margin: 0 12px; }
.btn-pagination-arrow { width: 32px; height: 32px; border-radius: 16px; background-color: rgba(255,255,255,0.04); border-width: 1px; border-color: rgba(122,138,176,0.18); color: #7a8ab0; font-size: 18px; }
.btn-pagination-page { width: 28px; height: 28px; border-radius: 14px; background-color: rgba(255,255,255,0.06); border-width: 1px; border-color: rgba(122,138,176,0.18); color: #7a8ab0; font-size: 12px; -unity-font-style: bold; margin: 0 3px; }
.btn-pagination-page.page-active { width: 36px; background-color: #c9a84a; border-color: #f0d27a; color: #1a1400; }

/* ── LOGIN ── */
.shop2-login {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(5,8,16,0.88);
    justify-content: center;
    align-items: center;
    padding: 16px;
}
.shop2-login.hidden { display: none; }
.shop2-login-card {
    width: 420px;
    max-width: 92%;
    background-color: #0e1430;
    border-width: 1.5px;
    border-color: rgba(201,168,74,0.28);
    border-radius: 18px;
    padding: 22px 22px 16px 22px;
    align-items: center;
}
.shop2-login-icon-wrap {
    width: 48px; height: 48px;
    border-radius: 24px;
    background-color: rgba(201,168,74,0.12);
    border-width: 1px;
    border-color: rgba(201,168,74,0.35);
    align-items: center; justify-content: center;
    margin-bottom: 10px;
}
.shop2-login-icon { font-size: 22px; color: #f0d27a; -unity-text-align: middle-center; }
.shop2-login-kicker { font-size: 10px; letter-spacing: 3px; color: #c9a84a; margin-bottom: 4px; }
.shop2-login-title { font-size: 20px; -unity-font-style: bold; color: #ffffff; letter-spacing: 0.5px; margin-bottom: 6px; }
.shop2-login-desc { font-size: 12px; color: #8a9bb5; white-space: normal; -unity-text-align: middle-center; margin-bottom: 16px; padding: 0 10px; }

.shop2-field {
    width: 100%;
    margin-bottom: 12px;
    align-items: flex-start;
}
.shop2-field-label {
    font-size: 10px;
    letter-spacing: 1.8px;
    color: #7a8ab0;
    margin-bottom: 6px;
    -unity-font-style: bold;
}
.shop2-input {
    width: 100%;
}
.shop2-input > .unity-base-field__input {
    height: 42px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: rgba(122,138,176,0.22);
    background-color: #080c1a;
    color: #e6f0ff;
    font-size: 14px;
    padding-left: 14px;
    padding-right: 14px;
}
.shop2-input:focus > .unity-base-field__input {
    border-color: #c9a84a;
    background-color: #0a1024;
}

/* Legacy field alias */
.shop-text-field { width: 100%; }
.shop-text-field > .unity-base-field__input { height: 42px; border-radius: 10px; border-width: 1.5px; border-color: rgba(122,138,176,0.22); background-color: #080c1a; color: #e6f0ff; }
.shop-field-group { width: 100%; margin-bottom: 12px; align-items: flex-start; }
.shop-field-label { font-size: 10px; letter-spacing: 1.8px; color: #7a8ab0; margin-bottom: 6px; -unity-font-style: bold; }

.shop2-error {
    font-size: 11px;
    color: #f87171;
    background-color: rgba(239,68,68,0.08);
    border-width: 1px;
    border-color: rgba(239,68,68,0.22);
    border-radius: 8px;
    padding: 8px 10px;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    margin-bottom: 10px;
}
.shop2-error.hidden { display: none; }
.shop-error-label { font-size: 11px; color: #f87171; background-color: rgba(239,68,68,0.08); border-width: 1px; border-color: rgba(239,68,68,0.22); border-radius: 8px; padding: 8px 10px; white-space: normal; -unity-text-align: middle-center; width: 100%; margin-bottom: 10px; }
.shop-error-label.hidden { display: none; }

.shop2-login-actions {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    margin-top: 4px;
    margin-bottom: 10px;
}
.shop2-btn-primary {
    flex-grow: 1;
    height: 44px;
    background-color: #c9a84a;
    border-width: 1.5px;
    border-color: #f0d27a;
    border-radius: 10px;
    color: #1a1400;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 6px;
}
.shop2-btn-primary:hover { background-color: #f0d27a; border-color: #ffffff; }
.shop2-btn-ghost {
    flex-grow: 1;
    height: 44px;
    background-color: transparent;
    border-width: 1.5px;
    border-color: rgba(122,138,176,0.22);
    border-radius: 10px;
    color: #9aa8c7;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    margin-left: 6px;
}
.shop2-btn-ghost:hover { border-color: #c9a84a; color: #f0d27a; background-color: rgba(201,168,74,0.08); }

/* Botones sueltos que antes se armaban con style.* dentro del C# ───────────
   "▶ VISTA PREVIA" (ShopAnimationSelector) y "CERRAR" (ShopAnimationPreview) se
   construyen por codigo y traian todos sus estilos en linea. El estilo en linea
   gana contra cualquier regla de USS, asi que aunque se les agregara un :hover
   no se veria nada: por eso sus estilos viven aca y el C# solo pone la clase.
   El margin-top se queda en linea porque cada uno usa uno distinto. */
.btn-inline-gold {
    height: 40px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffd65e;
    background-color: #1a2133;
    border-width: 1.5px;
    border-color: #c9a84a;
    border-radius: 10px;
    transition-property: scale, translate, background-color, border-color, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}
.btn-inline-gold:hover {
    scale: 1.04 1.04;
    translate: 0 -2px;
    background-color: #26314d;
    border-color: #f0d27a;
    color: #fff3d0;
}
.btn-inline-gold:active {
    scale: 0.97 0.97;
    translate: 0 1px;
    background-color: #121829;
    border-color: #9a7e28;
}
/* La variante de "CERRAR" va en rojo apagado. Va despues a proposito: comparte
   especificidad con .btn-inline-gold:hover y gana por ir mas abajo. */
.btn-inline-gold-danger { background-color: #4a1212; }
.btn-inline-gold-danger:hover { background-color: #6b1d1d; }
.btn-inline-gold-danger:active { background-color: #330c0c; }

/* Legacy action alias */
.btn-shop-action { flex-grow: 1; height: 44px; border-radius: 10px; font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; }
.btn-shop-login { flex-grow: 1; height: 44px; background-color: #c9a84a; border-width: 1.5px; border-color: #f0d27a; border-radius: 10px; color: #1a1400; margin-right: 6px; }
.btn-shop-register { flex-grow: 1; height: 44px; background-color: transparent; border-width: 1.5px; border-color: rgba(122,138,176,0.22); border-radius: 10px; color: #9aa8c7; margin-left: 6px; }

.shop2-login-footnote {
    font-size: 9px;
    letter-spacing: 0.5px;
    color: #5a6a85;
    -unity-text-align: middle-center;
    white-space: normal;
}
.shop-coming-desc { font-size: 12px; color: #8a9bb5; white-space: normal; -unity-text-align: middle-center; margin-bottom: 12px; }

/* ── LOADING ──
   Skeletons arriba (space-between en columna), tarjeta de estado abajo.
   La animación concurrente (shimmer + barrido + contador) la ejecuta ShopModal. */
.shop2-loading {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(5,8,16,0.88);
    justify-content: space-between;
    align-items: stretch;
    padding: 26px 30px;
}
.shop2-loading.hidden { display: none; }
.shop2-loading-card {
    width: 100%;
    flex-shrink: 0;
    background-color: #0e1430;
    border-width: 1px;
    border-color: rgba(122,138,176,0.18);
    border-radius: 14px;
    padding: 16px 20px;
    align-items: stretch;
}
.shop2-loading-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}
.shop2-loading-icon { font-size: 22px; color: #c9a84a; margin-right: 10px; -unity-text-align: middle-center; }
.shop2-loading-text { font-size: 13px; -unity-font-style: bold; letter-spacing: 0.8px; color: #d6deee; }
.shop2-loading-percent {
    margin-left: auto;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #ffd75e;
}
.shop2-loading-bar {
    width: 100%;
    height: 6px;
    background-color: rgba(122,138,176,0.15);
    border-radius: 3px;
    overflow: hidden;
}
.shop2-loading-bar-fill {
    width: 100%;
    height: 100%;
    background-color: #c9a84a;
    border-radius: 3px;
    translate: -100% 0;
}
.shop-loading-icon { font-size: 28px; color: #c9a84a; margin-bottom: 10px; }
.shop-sub-view { width: 100%; align-items: center; }

/* Responsive — collapse rail to top on narrow */
/* Responsive: antes '@media (max-width: 900px)' - USS no soporta @media, ahora regla por clase .is-small */
  .is-small .shop2-window { flex-direction: column; height: 96%; max-height: none; }
  .is-small .shop2-topbar { flex-wrap: wrap; padding: 10px 12px; }
  .is-small .shop2-topbar .shop2-brand { display: none; }
  .is-small .shop2-topbar .shop2-rail-vault { margin-left: auto; }
  .is-small .shop2-topbar .shop2-profile-name,
  .is-small .shop2-topbar .shop2-profile-handle { display: none; }
  .is-small .shop2-topbar .shop2-balance-slot { padding: 5px 10px 5px 8px; }
  .is-small .shop2-topbar .shop2-balance-icon { width: 26px; height: 26px; border-radius: 13px; margin-right: 7px; }
  .is-small .shop2-topbar .shop2-balance-amount { font-size: 16px; }
  .is-small .shop2-tabs { height: 56px; padding: 0 6px; }
  .is-small .shop2-tab { height: 42px; padding: 0 15px; margin: 0 3px; }
  .is-small .shop2-tabs .shop2-tab { min-width: 100px; }
  .is-small .shop2-tab-index { display: none; }
  .is-small .shop2-tab-label { font-size: 10px; letter-spacing: 1px; }
  .is-small .shop2-tab-count { min-width: 20px; height: 17px; font-size: 9px; padding: 0 5px; margin-left: 6px; }
  .is-small .inv-tabs .shop2-tab { min-width: 150px; }
  .is-small .shop2-body { flex-direction: column; }
  .is-small .shop2-detail { width: 100%; max-width: none; min-width: 0; height: auto; border-left-width: 0; border-top-width: 1.5px; border-top-color: rgba(201,168,74,0.35); translate: 0 18px; }
  .is-small .shop2-detail.shop2-detail-open { translate: 0 0; }
  .is-small .shop2-stage { padding: 12px; }
  .is-small .shop2-hero { height: 160px; min-height: 160px; margin-bottom: 10px; }
  .is-small .shop2-hero-title { font-size: 18px; }
  .is-small .bg-card { width: 150px; height: 214px; margin: 4px; }
  .is-small .bg-card-thumb { height: 92px; }
  .is-small .bg-card.bg-card-variant { width: 168px; height: 290px; margin: 4px; }
  .is-small .bg-card.bg-card-variant .bg-card-thumb { height: 168px; }
/* Responsive: antes '@media (max-width: 600px)' - USS no soporta @media, ahora regla por clase .is-tiny */
  .is-tiny .shop2-window { width: 98%; height: 98%; border-radius: 16px; }
  .is-tiny .shop2-hero { height: 140px; min-height: 140px; }
  .is-tiny .shop2-hero-content { right: 16px; }
  .is-tiny .shop2-hero-badge { display: none; }
  .is-tiny .bg-card { width: 44%; height: 204px; }
  .is-tiny .bg-card.bg-card-variant { width: 44%; height: 276px; }
  .is-tiny .bg-card.bg-card-variant .bg-card-thumb { height: 156px; }
  .is-tiny .shop2-login-card { width: 94%; padding: 16px; }
  .is-tiny .shop2-login-actions { flex-direction: column; }
  .is-tiny .shop2-btn-primary { margin-right: 0; margin-bottom: 8px; width: 100%; }
  .is-tiny .shop2-btn-ghost { margin-left: 0; width: 100%; }

/* TUS PIEZAS & VARIANTES MODAL STYLES                                   */
/* ══════════════════════════════════════════════════════════════════════ */

.btn-pieces {
    background-color: #14482f;
    border-color: #23704a;
    border-width: 3px;
    color: #cfe2d6;
    /* 88px: cierra la cuenta de 400px de la banda con aires de 16px. */
    height: 88px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.7);
}

.btn-pieces .btn-label {
    font-size: 27px;
    letter-spacing: 5px;
}

.btn-pieces:hover {
    scale: 1.04 1.04;
    translate: 0 -3px;
    background-color: #1a5c3a;
    border-color: #2d8f5e;
    color: #f2fbf6;
}

.btn-pieces:active {
    scale: 0.97 0.97;
    translate: 0 1px;
    background-color: #0f3722;
    border-color: #1c5a3c;
}

/* ════════════════════════════════════════════════════════════
   TUS PIEZAS — VAULT PEDESTAL REWORK (FIX VISUAL GLITCHES)
   ════════════════════════════════════════════════════════════ */

/* Overlay que oscurece el menú — evita que WILDER GAMBIT se cuele */
.modal-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(2, 4, 10, 0.93);
    justify-content: center;
    align-items: center;
    padding: 16px;
}
.modal-overlay.hidden { display: none; }

/* Contenedor — sólido, sin transparencia que deje ver el fondo */
.your-pieces-modal-container,
.vault-pedestal-modal {
    /* Columna izquierda: sin cromo propio — la ventana la aporta el dual-container */
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    align-items: stretch;
    overflow: hidden;
    flex-direction: column;
}

/* Header pergamino */
.vault-header,
.your-pieces-header {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 20px 24px 16px 24px;
    background-color: #0e1426;
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 179, 106, 0.22);
    flex-shrink: 0;
}
.vault-header-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgba(212, 179, 106, 0.14);
    border-width: 1.5px;
    border-color: rgba(212, 179, 106, 0.45);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    flex-shrink: 0;
}
.vault-header-icon {
    font-size: 22px;
    -unity-text-align: middle-center;
}
.vault-header-texts {
    align-items: flex-start;
    justify-content: center;
}
.vault-title,
.your-pieces-title {
    font-size: 21px;
    -unity-font-style: bold;
    color: #f0d27a;
    letter-spacing: 2px;
    margin-bottom: 3px;
}
.vault-subtitle,
.your-pieces-subtitle {
    font-size: 14px;
    color: #9bb0cf;
    -unity-text-align: middle-left;
    white-space: normal;
}

/* Scroll interno — evita que el modal se desborde y tape el VOLVER */
.your-pieces-content-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    padding: 16px 20px 10px 20px;
    background-color: transparent;
}
.your-pieces-content-scroll > .unity-scroll-view__content-container {
    flex-direction: column;
    align-items: stretch;
    padding: 4px 2px;
}

/* Sección pedestales */
.pedestal-section {
    width: 100%;
    align-items: center;
    margin-bottom: 12px;
}
.pedestal-section-header {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}
.pedestal-header-line-left,
.pedestal-header-line-right {
    flex-grow: 1;
    height: 2px;
    background-color: rgba(212, 179, 106, 0.35);
}
.pedestal-header-line-left { margin-right: 14px; }
.pedestal-header-line-right { margin-left: 14px; }
.pedestal-title,
.variant-section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #d4b36a;
    letter-spacing: 1.6px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.pedestal-row,
.variant-cards-row {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    flex-wrap: nowrap; /* las dos variantes caben lado a lado */
}

/* ── Card pedestal — réplica del screenshot piedra + runas ── */
.pedestal-card,
.piece-variant-card {
    /* Las dos variantes se reparten el ancho lado a lado (sin apilarse ni cortarse) */
    flex: 1 1 0;
    width: auto;
    min-width: 0;
    max-width: none;
    background-color: #141a27;
    border-color: #2c384e;
    border-width: 2px;
    border-radius: 20px;
    padding: 0 0 16px 0;
    align-items: center;
    overflow: hidden;
    margin: 6px;
    position: relative;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.18s;
}
.pedestal-card:hover,
.piece-variant-card:hover {
    scale: 1.015 1.015;
    border-color: #3f5277;
}
.piece-variant-card-equipped,
.pedestal-card-necro.piece-variant-card-equipped {
    border-color: #10b981;
    background-color: #0f1e1a;
}
.pedestal-card-classic.piece-variant-card-idle {
    border-color: #2a3347;
}
.pedestal-card-necro.piece-variant-card-idle {
    border-color: #2a3347;
}

/* Franja de estado en la cima de la card (en flujo: no tapa la esquina redondeada) */
.pedestal-ribbon {
    position: relative;
    top: auto;
    left: auto;
    translate: 0 0;
    width: 100%;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    border-width: 0;
    border-bottom-width: 1.5px;
    flex-shrink: 0;
    margin-bottom: 4px;
}
.ribbon-silver {
    background-color: #2c3e50;
    border-color: #5a7a8e;
}
.ribbon-emerald {
    background-color: #0c2e24;
    border-color: #10b981;
}
.ribbon-label,
.variant-card-badge {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    color: #cbd5e1;
}
.ribbon-label-emerald {
    color: #6ee7b7;
}

/* Retrato — pedestal de piedra */
.pedestal-portrait,
.variant-portrait {
    width: 100%;
    height: 150px;
    background-color: transparent;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    position: relative;
    margin-top: 6px;
    margin-bottom: 6px;
    border-width: 0;
}

/* Glow halo detrás de la pieza */
.pedestal-glow,
.variant-portrait-glow {
    position: absolute;
    width: 132px;
    height: 74px;
    top: 18px;
    left: 50%;
    translate: -50% 0;
    border-radius: 16px;
    opacity: 0.55;
}
.glow-silver { background-color: rgba(90, 130, 170, 0.38); }
.glow-emerald { background-color: rgba(16, 185, 129, 0.42); }
.variant-portrait-classic .variant-portrait-glow { background-color: rgba(90, 130, 170, 0.38); }
.variant-portrait-necro .variant-portrait-glow { background-color: rgba(16, 185, 129, 0.42); }

/* Bloque pedestal piedra */
.pedestal-stone {
    position: absolute;
    bottom: 14px;
    left: 50%;
    translate: -50% 0;
    width: 138px;
    height: 16px;
    background-color: #20293c;
    border-width: 1px;
    border-color: #3a4a6e;
    border-radius: 4px;
    overflow: hidden;
    align-items: center;
    justify-content: flex-start;
}
.stone-necro {
    background-color: #16211d;
    border-color: #1e4a38;
}
.pedestal-stone-top,
.top-necro {
    width: 100%;
    height: 5px;
    background-color: #35425e;
    border-bottom-width: 0;
    flex-shrink: 0;
}
.top-necro {
    background-color: #2a4a3c;
    border-bottom-color: transparent;
}
.pedestal-stone-front,
.front-necro {
    flex-grow: 1;
    width: 100%;
    background-color: transparent;
    align-items: center;
    justify-content: center;
}
.front-necro {
    background-color: transparent;
}
/* Símbolo rúnico tenue en el pedestal */
.pedestal-stone-front::before { /* no soportado en USS, se simula con runas laterales */ }

/* Figura — pieza 3D sobre pedestal */
.pedestal-figure,
.variant-portrait-img {
    position: absolute;
    bottom: 26px;
    left: 50%;
    translate: -50% 0;
    width: 100px;
    height: 100px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Runas laterales talladas en la carta piedra */
.pedestal-rune {
    position: absolute;
    top: 50%;
    font-size: 24px;
    color: rgba(90, 101, 122, 0.25);
    -unity-text-align: middle-center;
    translate: 0 -50%;
}
.rune-left { left: 12px; }
.rune-right { right: 12px; scale: -1 1; }
.rune-emerald { color: rgba(16, 185, 129, 0.28); }

/* Textos bajo pedestal */
.pedestal-name,
.variant-card-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #d4b48c;
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-bottom: 2px;
}
.text-emerald,
.pedestal-card-necro .variant-card-title {
    color: #34d399;
}
.pedestal-role,
.variant-card-role {
    font-size: 12px;
    color: #8a9bb5;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}
.pedestal-divider,
.variant-card-divider {
    width: 76%;
    height: 1.5px;
    background-color: rgba(148, 163, 184, 0.25);
    margin-bottom: 12px;
}
.pedestal-desc,
.variant-card-desc {
    font-size: 13px;
    color: #cbd5e1;
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 0 14px;
    margin-bottom: 14px;
    min-height: 62px;
    /* 'line-height' no existe en USS: el aire vertical lo da min-height + margenes */
}

/* Botones pedestal */
.pedestal-btn,
.btn-variant-action {
    width: 180px;
    height: 42px;
    border-radius: 10px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    border-width: 1.5px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.15s;
}
.pedestal-btn-silver,
.btn-variant-equip {
    background-color: #1e2a3e;
    border-color: #3a4a6e;
    color: #8ab4d8;
}
.pedestal-btn-silver:hover,
.btn-variant-equip:hover {
    background-color: #24365a;
    border-color: #5a7a8e;
    color: #cbd5e1;
    scale: 1.03 1.03;
}
.pedestal-btn-emerald,
.btn-variant-equipped {
    background-color: #064e3b;
    border-color: #10b981;
    color: #6ee7b7;
}
.pedestal-btn-emerald:hover,
.btn-variant-equipped:hover {
    background-color: #065a44;
    border-color: #34d399;
    color: #ecfdf5;
}

/* ── Peón Lancero — acento dorado (variante V4) ── */
.ribbon-gold {
    background-color: #2e2510;
    border-color: #d4b36a;
}
.ribbon-label-gold {
    color: #f0d27a;
}
.glow-gold {
    background-color: rgba(212, 179, 106, 0.35);
}
.rune-gold {
    color: rgba(240, 210, 122, 0.30);
}
.text-gold {
    color: #f0d27a;
}
.stone-lancer {
    background-color: #241e12;
    border-color: #5c4a26;
}
.top-lancer {
    background-color: #4a3d20;
    border-bottom-color: transparent;
}
.front-lancer {
    background-color: transparent;
}
.pedestal-card-lancer.piece-variant-card-idle {
    border-color: #4f4526;
}
.pedestal-card-lancer.piece-variant-card-equipped {
    border-color: #f0d27a;
    background-color: #171306;
}
.pedestal-card-lancer:hover {
    border-color: #d4b36a;
}
.pedestal-btn-gold {
    background-color: rgba(212, 179, 106, 0.12);
    border-color: #d4b36a;
    color: #f0d27a;
}
.pedestal-btn-gold:hover {
    background-color: rgba(240, 210, 122, 0.22);
    border-color: #f0d27a;
    color: #fff7e0;
    scale: 1.03 1.03;
}

/* Tres variantes de Dama: los botones se ajustan al ancho de cada tarjeta */
.pedestal-row-three .pedestal-btn {
    width: 92%;
    max-width: 180px;
}

/* ── Reina Vampira — acento carmesí (variante de la velada) ── */
.ribbon-blood {
    background-color: #2a0d12;
    border-color: #b91c1c;
}
.ribbon-label-blood {
    color: #fca5a5;
}
.glow-blood {
    background-color: rgba(220, 38, 38, 0.35);
}
.rune-blood {
    color: rgba(248, 113, 113, 0.30);
}
.text-blood {
    color: #f87171;
}
.stone-vampire {
    background-color: #1f1013;
    border-color: #5c1f26;
}
.top-vampire {
    background-color: #4a1a20;
    border-bottom-color: transparent;
}
.front-vampire {
    background-color: transparent;
}
.pedestal-card-vampire.piece-variant-card-idle {
    border-color: #4f2026;
}
.pedestal-card-vampire.piece-variant-card-equipped {
    border-color: #ef4444;
    background-color: #1a0a0d;
}
.pedestal-card-vampire:hover {
    border-color: #b91c1c;
}
.pedestal-btn-blood {
    background-color: rgba(220, 38, 38, 0.12);
    border-color: #b91c1c;
    color: #fca5a5;
}
.pedestal-btn-blood:hover {
    background-color: rgba(248, 113, 113, 0.22);
    border-color: #ef4444;
    color: #fee2e2;
    scale: 1.03 1.03;
}

/* ── Divider entre bishop y skins ── */
.skins-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(148,163,184,0.16);
    margin: 10px 0 14px 0;
    flex-shrink: 0;
}

/* ── Skins Section — vault dentro de pedestal ── */
.skins-section {
    width: 100%;
    align-items: stretch;
    margin-bottom: 6px;
}
.skins-section-header {
    align-items: center;
    margin-bottom: 10px;
}
.skins-section-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #fbbf24;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}
.skins-section-subtitle {
    font-size: 12.5px;
    color: #7a8ab0;
    -unity-text-align: middle-center;
    white-space: normal;
}
.skins-filter-row {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
}
.skin-filter-btn {
    height: 26px;
    padding-left: 10px;
    padding-right: 10px;
    margin: 3px;
    border-radius: 13px;
    background-color: rgba(255,255,255,0.04);
    border-width: 1px;
    border-color: rgba(122,138,176,0.18);
    color: #7a8ab0;
    font-size: 12.5px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}
.skin-filter-btn:hover {
    border-color: rgba(212,179,106,0.32);
    color: #d6deee;
}
.skin-filter-active {
    background-color: rgba(212,179,106,0.16);
    border-color: #d4b36a;
    color: #f0d27a;
}

.skins-scroll {
    width: 100%;
    max-height: 340px;
    min-height: 180px;
    background-color: rgba(255,255,255,0.02);
    border-width: 1px;
    border-color: rgba(122,138,176,0.12);
    border-radius: 14px;
    padding: 8px;
    margin-bottom: 10px;
}
.skins-scroll > .unity-scroll-view__content-container {
    flex-direction: column;
    align-items: stretch;
}
.skins-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    padding: 2px;
}

.skin-card {
    width: 162px;
    height: 214px;
    margin: 6px;
    padding: 8px;
    border-radius: 14px;
    background-color: #151a28;
    border-width: 1.5px;
    border-color: rgba(122,138,176,0.18);
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.16s;
}
.skin-card:hover {
    border-color: rgba(212,179,106,0.42);
    scale: 1.02 1.02;
}
.skin-card-equipped {
    border-color: #10b981;
    background-color: #0f1e1a;
}
.skin-card-owned { border-color: rgba(122,138,176,0.28); }
.skin-card-locked { opacity: 0.88; }

.skin-portrait {
    width: 96px;
    height: 96px;
    border-radius: 12px;
    background-color: #0a0f1e;
    border-width: 1px;
    border-color: rgba(122,138,176,0.14);
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    overflow: hidden;
    position: relative;
}
.skin-portrait-glow {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    border-radius: 12px;
    opacity: 0.18;
}
.skin-portrait-img {
    width: 68px;
    height: 68px;
    -unity-background-scale-mode: scale-to-fit;
}
.skin-portrait-anim-pulse {
    position: absolute;
    width: 86px;
    height: 86px;
    border-radius: 12px;
    border-width: 1.5px;
    opacity: 0.42;
}
.skin-rarity-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    font-size: 7px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    padding: 2px 5px;
    border-radius: 5px;
    background-color: rgba(0,0,0,0.52);
    border-width: 1px;
}
.skin-card-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #e6f0ff;
    -unity-text-align: middle-center;
    margin-bottom: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
}
.skin-card-piece {
    font-size: 9px;
    color: #7a8ab0;
    letter-spacing: 0.6px;
    margin-bottom: 3px;
}
.skin-card-desc {
    font-size: 12.5px;
    color: #9aa8c7;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    height: 26px;
    overflow: hidden;
}
.skin-card-price {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}
.skin-card-price-affordable { color: #34d399; }
.skin-card-price-expensive { color: #f87171; }

.skin-card-btn {
    width: 100%;
    height: 28px;
    border-radius: 7px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    border-width: 1px;
    margin-top: auto;
}
.skin-btn-equip {
    background-color: transparent;
    border-color: rgba(122,138,176,0.22);
    color: #9aa8c7;
}
.skin-btn-equip:hover {
    background-color: rgba(212,179,106,0.12);
    border-color: #d4b36a;
    color: #f0d27a;
}
.skin-btn-equipped {
    background-color: #064e3b;
    border-color: #10b981;
    color: #6ee7b7;
}
.skin-btn-buy {
    background-color: #1a3d2e;
    border-color: #10b981;
    color: #a7f3d0;
}
.skin-btn-buy:hover {
    background-color: #145a3e;
    color: #ecfdf5;
}
.skin-btn-locked {
    background-color: #252a3a;
    border-color: #3a415c;
    color: #6a7288;
}

.skins-balance-bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(0,0,0,0.22);
    border-width: 1px;
    border-color: rgba(122,138,176,0.14);
    border-radius: 10px;
    padding: 8px 12px;
    flex-shrink: 0;
}
.skins-balance-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #fbbf24;
}
.skins-balance-hint {
    font-size: 9px;
    color: #5a6a85;
}

/* ── Enciclopedia — detalle mucho más que en partida ── */
.encyclopedia-section {
    width: 100%;
    background-color: rgba(255,255,255,0.02);
    border-width: 1px;
    border-color: rgba(122,138,176,0.12);
    border-radius: 14px;
    padding: 14px;
    margin-top: 10px;
    flex-direction: column;
    align-items: stretch;
}
.encyclopedia-header {
    align-items: center;
    margin-bottom: 12px;
}
.encyclopedia-title {
    font-size: 21px;
    -unity-font-style: bold;
    color: #f0d27a;
    letter-spacing: 1.8px;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}
.encyclopedia-subtitle {
    font-size: 14px;
    color: #9bb0cf;
    -unity-text-align: middle-center;
    white-space: normal;
}
.encyclopedia-filter-row {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 12px;
}
.ency-filter-btn {
    height: 32px;
    padding-left: 16px;
    padding-right: 16px;
    margin: 4px;
    border-radius: 8px;
    background-color: rgba(255,255,255,0.05);
    border-width: 1px;
    border-color: rgba(122,138,176,0.22);
    color: #8a9bb5;
    font-size: 13.5px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}
.ency-filter-btn:hover {
    border-color: rgba(212,179,106,0.35);
    color: #d6deee;
}
.ency-filter-btn.ency-filter-active {
    background-color: rgba(212,179,106,0.18);
    border-color: #f0d27a;
    color: #f0d27a;
}
.encyclopedia-grid {
    flex-direction: column;
    align-items: center;
    width: 100%;
}
.ency-card {
    width: 96%;
    max-width: 740px;
    background-color: #141a27;
    border-width: 1.5px;
    border-color: #2c384e;
    border-radius: 16px;
    padding: 16px;
    margin: 8px auto;
    flex-direction: column;
}
/* Header de card: placa ornamental centrada — sin emoji, tipografía + filo con rombo */
.ency-card-header {
    width: 100%;
    flex-direction: column;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(212, 179, 106, 0.16);
    border-top-width: 2px;
    border-top-color: rgba(212, 179, 106, 0.55);
    border-radius: 12px;
    padding-top: 14px;
    padding-right: 18px;
    padding-bottom: 12px;
    padding-left: 18px;
    margin-bottom: 12px;
}
.ency-rarity {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-top: 4px;
    padding-right: 14px;
    padding-bottom: 4px;
    padding-left: 14px;
    margin-bottom: 10px;
    border-radius: 6px;
    border-width: 1px;
    background-color: rgba(255, 255, 255, 0.05);
    -unity-text-align: middle-center;
}
.ency-name {
    font-size: 25px;
    -unity-font-style: bold;
    color: #f0d27a;
    letter-spacing: 3px;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.65);
}
.ency-type {
    font-size: 11px;
    color: #8a9bb5;
    letter-spacing: 2.5px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}
.ency-header-divider {
    flex-direction: row;
    align-items: center;
    width: 100%;
}
.ency-header-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(212, 179, 106, 0.35);
}
.ency-header-gem {
    font-size: 9px;
    color: #d4b36a;
    margin-left: 12px;
    margin-right: 12px;
    -unity-text-align: middle-center;
}
.ency-stats {
    flex-direction: row;
    justify-content: space-between;
    background-color: rgba(0,0,0,0.25);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 10px;
}
.ency-stat { align-items: center; flex: 1; }
.ency-stat-label {
    font-size: 11px;
    color: #6a7c9d;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}
.ency-stat-value {
    font-size: 13.5px;
    -unity-font-style: bold;
    color: #f0d27a;
    -unity-text-align: middle-center;
}
.ency-ability {
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(122,138,176,0.12);
    border-left-width: 3px;
    border-left-color: #f0d27a; /* pasiva: acento dorado */
    border-radius: 10px;
    padding: 9px 12px;
    margin-bottom: 8px;
}
.ency-ability.ency-ability-active {
    border-left-color: #10b981; /* activa: acento esmeralda */
}
.ency-ability-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #f0d27a;
    margin-bottom: 4px;
}
.ency-ability-desc {
    font-size: 14px;
    color: #cbd5e1;
    white-space: normal;
    /* 'line-height' no existe en USS: el aire vertical lo da el padding de la caja */
}
/* Lore y Consejo: el mismo lenguaje de caja que las habilidades (solo cambia el tono) */
.ency-lore,
.ency-tip-box {
    font-size: 13.5px;
    color: #8a9bb5;
    background-color: rgba(212,179,106,0.06);
    border-width: 1px;
    border-color: rgba(212,179,106,0.14);
    border-radius: 10px;
    padding: 9px 12px;
    white-space: normal;
    margin-top: 6px;
    /* 'line-height' no existe en USS */
}
.ency-tip-box {
    color: #9db8a8;
    background-color: rgba(16,185,129,0.06);
    border-color: rgba(16,185,129,0.16);
}
.ency-tip {
    font-size: 13px;
    color: #7a8ab0;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 10px;
}




/* Footer fijo */
.your-pieces-footer {
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 14px 0 18px 0;
    background-color: #0e1426;
    border-top-width: 1px;
    border-top-color: rgba(212,179,106,0.18);
    flex-shrink: 0;
}
.btn-your-pieces-back,
.vault-volver {
    width: 260px;
    height: 48px;
    border-radius: 12px;
    background-color: #8b6914;
    border-color: #d4b36a;
    border-width: 1.5px;
    color: #fff3d0;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}
.btn-your-pieces-back:hover,
.vault-volver:hover {
    background-color: #a07a18;
    border-color: #f0d27a;
    scale: 1.03 1.03;
}


/* ═════════════════════════════════════════════════════════════
   RESPONSIVE: TUS PIEZAS — móvil vertical / pantallas estrechas
   ═════════════════════════════════════════════════════════════ */
/* Responsive: antes '@media (max-width: 700px)' - USS no soporta @media, ahora regla por clase .is-tiny */
  .is-tiny .your-pieces-modal-container {
        width: 96%;
        padding: 18px 14px;
        border-radius: 14px;
    }

  .is-tiny .your-pieces-title {
        font-size: 19px;
        letter-spacing: 1px;
        -unity-text-align: middle-center;
    }

  .is-tiny .your-pieces-subtitle {
        font-size: 12px;
    }

  .is-tiny .variant-section-title {
        font-size: 14px;
        margin-bottom: 10px;
    }

    /* Apilar las tarjetas verticalmente */
  .is-tiny .variant-cards-row {
        flex-direction: column;
        align-items: stretch;
    }

  .is-tiny .piece-variant-card {
        flex: none; /* en columna no se reparte el alto */
        width: 100%;
        margin-bottom: 14px;
        padding: 12px 14px 16px 14px;
    }

  .is-tiny .pedestal-stone { width: 64px; height: 12px; }
  .is-tiny .pedestal-glow { width: 72px; height: 44px; }

    /* Retrato compacto y horizontal: sprite a la izquierda, texto a la derecha */
  .is-tiny .variant-portrait {
        width: 84px;
        height: 84px;
        margin-bottom: 8px;
        border-radius: 12px;
    }

  .is-tiny .variant-portrait-img {
        width: 68px;
        height: 68px;
    }

  .is-tiny .variant-card-title {
        font-size: 17px;
    }

  .is-tiny .variant-card-role {
        margin-bottom: 6px;
    }

  .is-tiny .variant-card-desc {
        font-size: 12px;
        min-height: 0;
        margin-bottom: 12px;
    }

    /* Botones a ancho completo y tamaño táctil */
  .is-tiny .btn-variant-action {
        width: 100%;
        height: 48px;
        font-size: 15px;
    }

  .is-tiny .btn-your-pieces-back {
        width: 100%;
        height: 50px;
    }

/* Móvil muy estrecho (por ejemplo 320px): compactar aún más */
/* Responsive: antes '@media (max-width: 400px)' - USS no soporta @media, ahora regla por clase .is-tiny */
  .is-tiny .your-pieces-modal-container {
        padding: 14px 10px;
    }

  .is-tiny .your-pieces-title {
        font-size: 17px;
    }

  .is-tiny .variant-portrait {
        width: 72px;
        height: 72px;
    }

  .is-tiny .variant-portrait-img {
        width: 58px;
        height: 58px;
    }

  .is-tiny .variant-card-desc {
        font-size: 11px;
    }

/* ═══════════════════════════════════════════════════════════════════ */
/* BOARD BACKGROUND — now handled by ATELIER NOIR (see SHOP2) */

/* ═══════════════════════════════════════════════════════════════════ */
/*  TIME CONTROL SELECTOR (Difficulty Screen)                        */
/* ═══════════════════════════════════════════════════════════════════ */

.time-control-section {
    width: 88%;
    max-width: 1760px;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 16px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.time-control-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(212, 175, 55, 0.8);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.time-control-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    /* gap removed */ margin: 4px;
}

.time-btn {
    width: 110px;
    height: 52px;
    border-radius: 10px;
    background-color: rgba(20, 28, 45, 0.85);
    border-width: 2px;
    border-color: rgba(70, 85, 120, 0.4);
    color: #c0bcc8;
    font-size: 12px;
    -unity-text-align: middle-center;
    padding: 4px 8px;
    white-space: normal;
}

.time-btn:hover {
    border-color: rgba(212, 175, 55, 0.6);
    background-color: rgba(35, 45, 70, 0.9);
}

.time-btn-active {
    border-color: #d4af37;
    background-color: rgba(212, 175, 55, 0.15);
    color: #d4af37;
    -unity-font-style: bold;
}


/* ── Dual Panel — Tus Piezas izquierda + Enciclopedia derecha ── */
.your-pieces-dual-container {
    /* Una sola ventana sólida: el menú ya no se ve por el hueco central */
    flex-direction: row;
    width: 95%;
    max-width: 1720px;
    height: 92%;
    max-height: 960px;
    /* 'gap' no existe en USS: el espaciado lo da el margin de los hijos */
    justify-content: center;
    align-items: stretch;
    background-color: #0a0f1e;
    border-width: 2px;
    border-color: #2c384e;
    border-radius: 24px;
    overflow: hidden;
    padding: 0;
}
.left-panel {
    flex: 1;
    max-width: 820px;
    min-width: 420px;
}
.dual-divider {
    width: 52px;
    margin: 0 12px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    align-self: center;
    height: 88%;
}
.dual-divider-cap {
    width: 14px;
    height: 3px;
    background-color: #d4b36a;
    border-radius: 2px;
    opacity: 0.85;
    margin: 2px 0;
}
.dual-divider-line {
    width: 2px;
    flex-grow: 1;
    background-color: #d4b36a;
    opacity: 0.65;
}
.dual-divider-node {
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    position: relative;
    margin: 12px 0;
    flex-shrink: 0;
}
.dual-divider-glow {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(212, 179, 106, 0.22);
}
.dual-divider-diamond {
    width: 20px;
    height: 20px;
    background-color: #0e1426;
    border-width: 2px;
    border-color: #f0d27a;
    rotate: 45deg;
}
.dual-divider-rune {
    position: absolute;
    font-size: 11px;
    color: #f0d27a;
    -unity-text-align: middle-center;
}
.encyclopedia-side-panel {
    flex: 1;
    max-width: 820px;
    min-width: 420px;
    background-color: transparent; /* el cromo lo da la ventana (dual-container) */
    border-width: 0;
    border-radius: 0;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
}
.encyclopedia-side-panel .encyclopedia-header {
    padding: 20px 24px 16px 24px;
    background-color: #0e1426;
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 179, 106, 0.22);
    align-items: center;
    flex-direction: row;
    justify-content: center;
    margin-bottom: 4px;
    flex-shrink: 0;
}
.encyclopedia-side-panel .encyclopedia-title {
    font-size: 21px;
    -unity-font-style: bold;
    color: #f0d27a;
    letter-spacing: 1.8px;
    -unity-text-align: middle-left;
    margin-bottom: 3px;
}
.encyclopedia-side-panel .encyclopedia-subtitle {
    font-size: 14px;
    color: #9bb0cf;
    -unity-text-align: middle-left;
    white-space: normal;
}
.encyclopedia-side-panel .encyclopedia-filter-row {
    padding: 12px 16px;
    background-color: transparent;
    flex-shrink: 0;
}
.encyclopedia-side-panel .encyclopedia-scroll {
    flex-grow: 1;
    padding: 0 10px 10px 10px;
}
.encyclopedia-side-panel .encyclopedia-grid {
    padding: 4px;
}
.encyclopedia-side-panel .ency-card {
    /* Cards a ancho completo del panel: sin flotar centradas con huecos raros */
    width: 100%;
    max-width: none;
    margin: 6px 0;
}
.encyclopedia-side-panel .encyclopedia-tip {
    padding: 12px 18px;
    background-color: #0e1426;
    border-top-width: 1px;
    border-top-color: rgba(212, 179, 106, 0.14);
    font-size: 13px;
    color: #8a9bb5;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
}

/* Scrollbar personalizada dark-gold */
.encyclopedia-side-panel .unity-scroller--vertical,
.your-pieces-content-scroll .unity-scroller--vertical {
    width: 8px;
}
.encyclopedia-side-panel .unity-base-slider__tracker,
.your-pieces-content-scroll .unity-base-slider__tracker {
    background-color: rgba(14, 20, 38, 0.6);
    border-width: 0;
    border-radius: 4px;
}
.encyclopedia-side-panel .unity-base-slider__dragger,
.your-pieces-content-scroll .unity-base-slider__dragger {
    background-color: rgba(212, 179, 106, 0.35);
    border-radius: 4px;
    border-width: 0;
}
.encyclopedia-side-panel .unity-base-slider__dragger:hover,
.your-pieces-content-scroll .unity-base-slider__dragger:hover {
    background-color: rgba(212, 179, 106, 0.65);
}
.encyclopedia-side-panel .unity-scroller__low-button,
.encyclopedia-side-panel .unity-scroller__high-button,
.your-pieces-content-scroll .unity-scroller__low-button,
.your-pieces-content-scroll .unity-scroller__high-button {
    display: none;
}

/* Responsive: antes '@media (max-width: 1100px)' - USS no soporta @media, ahora regla por clase .is-narrow */
  .is-narrow .your-pieces-dual-container {
        flex-direction: column;
        max-width: 560px;
        max-height: 94%;
        overflow: hidden;
    }
  .is-narrow .left-panel, .is-narrow .encyclopedia-side-panel {
        max-width: 100%;
        width: 100%;
    }
  .is-narrow .encyclopedia-side-panel {
        max-height: 42%;
        min-height: 280px;
    }

/* ============================================================
   ANIMACIONES & POLISH — fades de modal, foco y entrada escalonada
   (al final del archivo para ganar en orden a las reglas previas)
   ============================================================ */

/* -- Transiciones de modales (el fade in/out lo maneja C#) -- */
.modal-backdrop {
    transition-property: opacity;
    transition-duration: 0.22s;
}

.shop2-root {
    transition-property: opacity;
    transition-duration: 0.22s;
}

.modal-overlay {
    transition-property: opacity;
    transition-duration: 0.22s;
}

/* -- Estados de foco (gamepad / teclado) -- */
.menu-button:focus {
    translate: 0 -2px;
    border-color: #ffe08a;
}

.btn-danger:focus {
    border-color: #d76a6a;
}

.menu-tile:focus {
    translate: 0 -2px;
    border-color: #ffe08a;
}

.btn-back:focus {
    border-color: rgba(212, 179, 106, 0.6);
    color: #d6deee;
}

.time-btn:focus {
    border-color: rgba(212, 179, 106, 0.55);
}

.diff-card:focus {
    border-color: #d4b36a;
}

.cta-start:focus {
    border-color: #fff3b0;
}

/* -- Entrada escalonada (stagger): la transición vive en .stagger-item
   para que al añadirla mientras la vista sigue oculta no haya parpadeo -- */
.stagger-item {
    opacity: 0;
    translate: 0 18px;
    transition-property: opacity, translate;
    transition-duration: 0.55s;
    transition-timing-function: ease-out;
}

.stagger-in {
    opacity: 1;
    translate: 0 0;
}

/* ============================================================
   REWORK SELECTOR DE RIVAL — píldora de tiempo, tarjetas, récord
   ============================================================ */

/* -- 4 cards de control de tiempo (2 + divisor + 2) -- */
.time-cards-row {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    width: 100%;
    height: 124px;
    margin-top: 4px;
}

/* Drawers en las esquinas inferiores: aparcados fuera, salen con hover/foco/selección */
.time-cards-group {
    position: absolute;
    bottom: 16px;
    flex-direction: row;
    align-items: stretch;
    transition-property: translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

/* Estado por defecto = aparcado (peek en el borde); hover/foco y selección lo sacan desde C# */
.time-group-left { left: 0; }
.time-group-right { right: 0; }

.time-card {
    position: relative;
    flex-direction: column;
    flex-shrink: 0;
    width: 196px;
    height: 240px;
    translate: 0 205px;
    margin: 5px;
    border-radius: 12px;
    background-color: rgba(20, 26, 42, 0.75);
    border-width: 1.5px;
    border-color: rgba(122, 138, 176, 0.3);
    padding: 20px 14px 16px 14px;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color, opacity, scale, translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.time-card-head {
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.time-card-icon {
    width: 68px;
    height: 68px;
    margin-right: 0;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.time-card-texts {
    flex-direction: column;
    align-items: center;
    flex-grow: 0;
}

.time-card-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #d6deee;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.time-card-sub {
    font-size: 11px;
    color: #7a8ab0;
    margin-top: 2px;
    -unity-text-align: middle-center;
}

/* Info del modo: oculta, aparece al hover (y fija en la activa) */
.time-card-desc {
    font-size: 11px;
    color: #9aa8c7;
    white-space: normal;
    margin-top: 14px;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

/* Hover: la card se enciende y muestra su descripción */
.time-card:hover {
    border-color: rgba(212, 179, 106, 0.65);
    background-color: rgba(26, 33, 52, 0.92);
    translate: 0 -3px;
}

.time-card:hover .time-card-desc {
    opacity: 1;
}

/* Sprites de iconos de control de tiempo (Assets/_Project/Textures/UI/Icons) */
.icon-time-none   { background-image: url("project://database/Assets/_Project/Textures/UI/Icons/time-none.png"); }
.icon-time-bullet { background-image: url("project://database/Assets/_Project/Textures/UI/Icons/time-bullet.png"); }
.icon-time-blitz  { background-image: url("project://database/Assets/_Project/Textures/UI/Icons/time-blitz.png"); }
.icon-time-rapid  { background-image: url("project://database/Assets/_Project/Textures/UI/Icons/time-rapid.png"); }

/* Tintes por estado (sprite dorado: gris en apagadas, crema en la activa) */
.time-card-dimmed .time-card-icon { -unity-background-image-tint-color: rgba(130, 134, 144, 0.9); }
.time-card-dimmed:hover .time-card-icon { -unity-background-image-tint-color: rgba(255, 255, 255, 1); }
.time-card.time-btn-active .time-card-icon { -unity-background-image-tint-color: rgba(255, 244, 214, 1); }

/* No seleccionadas: gris semi-oscuro pero todavía visibles */
.time-card-dimmed {
    opacity: 0.55;
    background-color: rgba(38, 42, 52, 0.55);
    border-color: rgba(110, 116, 130, 0.3);
}

.time-card-dimmed .time-card-title { color: #9aa0ad; }
.time-card-dimmed .time-card-icon { color: #8a8f9c; }

.time-card-dimmed:hover {
    opacity: 0.92;
}

.time-card-dimmed:hover .time-card-title { color: #d6deee; }
.time-card-dimmed:hover .time-card-icon { color: #d4b36a; }

/* Seleccionada: oro + elevación (gana a .time-card-dimmed por orden) */
.time-card.time-btn-active {
    border-color: #d4b36a;
    border-width: 1.5px;
    background-color: rgba(212, 179, 106, 0.16);
    opacity: 1;
    translate: 0 -2px;
}

.time-card.time-btn-active .time-card-title { color: #f0d27a; }
.time-card.time-btn-active .time-card-sub { color: #c8b878; }
.time-card.time-btn-active .time-card-icon { color: #f0d27a; }
.time-card.time-btn-active .time-card-desc { opacity: 0.85; }

.time-card.time-btn-active:hover {
    border-color: #f0d27a;
    background-color: rgba(212, 179, 106, 0.22);
    translate: 0 -3px;
}

.time-card.time-btn-active:hover .time-card-desc { opacity: 1; }

/* Pop de selección (añadido y retirado desde C#) */
.time-card-pop {
    scale: 1.06 1.06;
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/* Pista central: tallo + "SELECCIONA UN MODO" + flecha hacia los drawers */
.time-mode-hint {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.time-hint-stem {
    width: 1.5px;
    height: 24px;
    background-color: rgba(212, 179, 106, 0.35);
    margin-bottom: 10px;
}

.time-hint-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.time-hint-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(212, 179, 106, 0.9);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin: 0 16px;
}

/* Flechas largas en diagonal hacia las esquinas inferiores (nunca hacia el CTA) */
.time-hint-arrow-wrap {
    flex-direction: row;
    align-items: center;
}

.time-hint-wrap-left { rotate: -22deg; }
.time-hint-wrap-right { rotate: 22deg; }

.time-hint-bar {
    width: 260px;
    height: 2px;
    background-color: rgba(212, 179, 106, 0.75);
    border-radius: 1px;
}

.time-hint-head {
    font-size: 16px;
    color: rgba(212, 179, 106, 0.95);
    -unity-text-align: middle-center;
    margin: 0 3px;
}

/* Fallback para pantallas medianas */
/* Responsive: antes '@media (max-width: 1100px)' - USS no soporta @media, ahora regla por clase .is-narrow */
  .is-narrow .time-control-section { width: 96%; }
  /* USS solo admite 'relative'/'absolute': sin 'static' el valor vuelve al default del USS (relative) */
  .is-narrow .time-cards-row { flex-wrap: wrap; justify-content: center; height: auto; }
  .is-narrow .time-cards-group { flex-wrap: wrap; justify-content: center; translate: 0 0; }
  .is-narrow .time-card { width: 150px; height: 190px; translate: 0 0; }
  .is-narrow .time-card-icon { width: 52px; height: 52px; }
  .is-narrow .time-cards-divider { display: none; }

/* -- Check de selección sobre el avatar -- */
.diff-check {
    position: absolute;
    right: -5px;
    bottom: -5px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: #d4b36a;
    border-width: 2px;
    border-color: #0e1320;
    color: #14100a;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 0.4 0.4;
    transition-property: opacity, scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.diff-card-selected .diff-check {
    opacity: 1;
    scale: 1 1;
}

/* -- Chip de récord V-E-D -- */
.diff-record {
    font-size: 10px;
    -unity-font-style: bold;
    color: #b8c4dd;
    background-color: rgba(122, 138, 176, 0.12);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.28);
    border-radius: 6px;
    padding: 3px 9px;
    letter-spacing: 0.6px;
    -unity-text-align: middle-center;
    margin-top: 6px;
}

/* -- Badge RECOMENDADO (visible con clase .diff-recommended) -- */
.diff-recommended-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 8px;
    -unity-font-style: bold;
    color: #1a1400;
    background-color: #d4b36a;
    border-radius: 4px;
    padding: 3px 7px;
    letter-spacing: 1px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.diff-recommended .diff-recommended-badge {
    opacity: 1;
}

/* -- Acentos de tier (identidad por nivel) -- */
.tier-1 .diff-avatar-wrap { border-color: rgba(126, 176, 96, 0.55); }
.tier-2 .diff-avatar-wrap { border-color: rgba(96, 148, 210, 0.55); }
.tier-3 .diff-avatar-wrap { border-color: rgba(212, 175, 55, 0.6); }
.tier-4 .diff-avatar-wrap { border-color: rgba(205, 92, 100, 0.55); }
.tier-5 .diff-avatar-wrap { border-color: rgba(156, 108, 224, 0.6); }

.tier-1.diff-card-selected { border-color: #7eb060; }
.tier-2.diff-card-selected { border-color: #6094d2; }
.tier-3.diff-card-selected { border-color: #d4b36a; }
.tier-4.diff-card-selected { border-color: #cd5c64; }
.tier-5.diff-card-selected { border-color: #9c6ce0; }

/* -- Glow del avatar al hover/foco (gana a los tiers por orden) -- */
.diff-card:hover .diff-avatar-wrap,
.diff-card:focus .diff-avatar-wrap {
    border-color: #d4b36a;
    background-color: rgba(212, 179, 106, 0.14);
}

.tier-1.diff-card-selected .diff-avatar-wrap { border-color: #7eb060; }
.tier-2.diff-card-selected .diff-avatar-wrap { border-color: #6094d2; }
.tier-3.diff-card-selected .diff-avatar-wrap { border-color: #d4b36a; }
.tier-4.diff-card-selected .diff-avatar-wrap { border-color: #cd5c64; }
.tier-5.diff-card-selected .diff-avatar-wrap { border-color: #9c6ce0; }

/* -- Pop de selección -- */
.diff-pop {
    scale: 1.05 1.05;
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/* ══════════════════════════════════════════════════════════════════
   VARIANTES DE PIEZAS — VISTA PREVIA DEL DETALLE (pestaña 02)
   El panel de detalle se comparte con Tableros. Cuando muestra una
   variante (.variant-detail) la pieza vive en su propio marco y los
   textos se apilan debajo: el arte deja de quedar bajo las letras.
   ══════════════════════════════════════════════════════════════════ */

/* Marco del arte del hero — en Tableros sigue cubriendo todo el panel */
.shop2-hero-art {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.shop2-hero-art-glow,
.shop2-hero-art-glow-core { display: none; }

/* ── Hero de variante: pieza enmarcada arriba, textos debajo ── */
.shop2-detail.variant-detail .shop2-hero {
    height: auto;
    min-height: 0;
    flex-direction: column;
    justify-content: flex-start;
    background-color: #070b16;
    border-color: rgba(201, 168, 74, 0.28);
    margin-bottom: 14px;
}
.shop2-detail.variant-detail .shop2-hero-art {
    position: relative;
    width: 100%;
    height: 168px;
    min-height: 104px;
    flex-shrink: 1;
    background-color: #04060d;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 74, 0.18);
}
.shop2-detail.variant-detail .shop2-hero-art-glow {
    display: flex;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 240px;
    height: 104px;
    border-radius: 50%;
    background-color: rgba(212, 179, 106, 0.05);
}
.shop2-detail.variant-detail .shop2-hero-art-glow-core {
    display: flex;
    position: absolute;
    left: 50%;
    top: 52%;
    translate: -50% -50%;
    width: 140px;
    height: 76px;
    border-radius: 50%;
    background-color: rgba(240, 210, 122, 0.09);
}
.shop2-detail.variant-detail .shop2-hero-scrim { display: none; }
.shop2-detail.variant-detail .shop2-hero-content {
    position: relative;
    left: 0; right: 0; bottom: 0;
    padding: 10px 12px 12px 12px;
}
.shop2-detail.variant-detail .shop2-hero-kicker {
    font-size: 9px;
    letter-spacing: 2.4px;
    margin-bottom: 4px;
}
.shop2-detail.variant-detail .shop2-hero-title {
    font-size: 19px;
    margin-bottom: 3px;
    /* 'text-shadow' no existe en USS: sin declaracion el titulo va sin sombra (valor 'none') */
}
.shop2-detail.variant-detail .shop2-hero-desc {
    font-size: 11px;
    color: #a9b7d0;
    opacity: 1;
}
.shop2-detail.variant-detail .shop2-hero-badge {
    top: 10px;
    right: 10px;
    background-color: #c9a84a;
}
.shop2-detail.variant-detail .shop2-hero-badge-label { color: #14100a; }

/* ── Ficha de la variante: precio y pasiva en bloques separados ── */
.shop2-detail.variant-detail .shop2-detail-pricerow { margin-bottom: 12px; }
.shop2-detail.variant-detail .shop2-detail-price { font-size: 19px; }
.shop2-detail.variant-detail .shop2-detail-stock {
    background-color: rgba(201, 168, 74, 0.14);
    color: #e8cf90;
}

/* Ficha de habilidad (caja dorada suave) — solo visible en variantes */
.shop2-detail-lorewrap { width: 100%; }
.shop2-detail-ability { display: none; }
.shop2-detail.variant-detail .shop2-detail-lorewrap {
    width: 100%;
    padding: 10px 12px;
    background-color: rgba(201, 168, 74, 0.05);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.16);
    border-radius: 10px;
}
.shop2-detail.variant-detail .shop2-detail-ability {
    display: flex;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #f0d27a;
    margin-bottom: 6px;
}
.shop2-detail.variant-detail .shop2-detail-hint { color: #9fadc6; }

/* ── Pie de card (variantes y paquetes): un solo rótulo de estado, siempre centrado ── */
.bg-card-state,
.bg-card-variant .bg-card-state,
.bg-card-pack .bg-card-state {
    width: auto;
    margin: 6px 0 0 0;
    padding: 4px 12px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.30);
    background-color: rgba(201, 168, 74, 0.10);
    color: #f0d27a;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.18s;
}
.bg-card-state-active,
.bg-card-variant .bg-card-state-active {
    border-color: rgba(16, 185, 129, 0.40);
    background-color: rgba(16, 185, 129, 0.12);
    color: #6ee7b7;
}
.bg-card-state-locked,
.bg-card-variant .bg-card-state-locked {
    border-color: rgba(248, 113, 113, 0.32);
    background-color: rgba(248, 113, 113, 0.08);
    color: #fca5a5;
}
.bg-card-state-action:hover,
.bg-card-variant .bg-card-state-action:hover {
    border-color: #c9a84a;
    background-color: rgba(201, 168, 74, 0.20);
    color: #ffe9ae;
    scale: 1.03 1.03;
}

/* ── Catálogo de variantes: la pieza se muestra centrada ── */
.shop2-grid.grid-variants { justify-content: center; }

/* -- Hint bajo el CTA -- */
.cta-hint {
    font-size: 11px;
    color: #8a9bb5;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

/* ════════════════════════════════════════════════════════════════
   PROGRESO — Gambits, barra del Atelier de 7 días, misiones y logros
   ════════════════════════════════════════════════════════════════ */

/* ── Botón PROGRESO del menú principal (ficha de media fila) ── */
/* La ficha comparte alto con el resto de la fila (80px). */
.btn-progress {
    height: 80px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    background-color: rgba(201, 168, 74, 0.07);
    border-width: 2px;
    border-color: rgba(201, 168, 74, 0.34);
}
.btn-progress:hover {
    background-color: rgba(201, 168, 74, 0.15);
    border-color: #c9a84a;
}
.btn-progress-icon {
    font-size: 20px;
    color: #f0d27a;
    margin-right: 10px;
}
.btn-progress-label {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #f0d27a;
}
.btn-progress-badge {
    min-width: 20px;
    height: 20px;
    margin-left: 10px;
    border-radius: 10px;
    background-color: #c9a84a;
    color: #0b1020;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0 4px;
}
.btn-progress-badge.hidden { display: none; }

/* ── Toast de Gambits ── */
.gambit-toast {
    position: absolute;
    right: 24px;
    bottom: 28px;
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    background-color: rgba(11, 16, 32, 0.94);
    border-width: 1.5px;
    border-color: #c9a84a;
    border-radius: 14px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
}
.gambit-toast.hidden {
    display: flex;
    opacity: 0;
    translate: 0 14px;
}
.gambit-toast-icon-wrap {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: rgba(201, 168, 74, 0.18);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.45);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}
.gambit-toast-icon {
    font-size: 15px;
    color: #f0d27a;
}
.gambit-toast-texts { flex-direction: column; }
.gambit-toast-text {
    font-size: 15px;
    -unity-font-style: bold;
    color: #ffe9ae;
}
.gambit-toast-sub {
    font-size: 11px;
    color: #8a9bb5;
}

/* ── Ventana de Progreso ──
   El modal se pensó para 1180px, pero en pantallas anchas (y en el Editor
   a resolucion libre) la ventana crece y el contenido debe estirar con
   ella: las tarjetas usan el ancho completo via .prog-content. */
.prog-window { max-width: 1600px; }

/* ── CAPA DE CARGA ──
   ProgressModal la pinta encima de la vista mientras espera el saldo de Surface
   (Render puede tardar en despertar). Tapa los números a medias y bloquea los clics. */
.prog-loading {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(3, 5, 12, 0.94);
}
.prog-loading.hidden { display: none; }
.prog-loading-card {
    flex-direction: column;
    align-items: center;
    min-width: 340px;
    max-width: 520px;
    background-color: #0e1430;
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.22);
    border-radius: 16px;
    padding: 26px 30px;
}
.prog-loading-icon { font-size: 34px; color: #c9a84a; }
.prog-loading-text {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #d6deee;
    margin-top: 12px;
}
.prog-loading-sub {
    font-size: 12px;
    color: #8a9bb5;
    margin-top: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.prog-loading-bar {
    width: 260px;
    height: 6px;
    margin-top: 18px;
    background-color: rgba(122, 138, 176, 0.15);
    border-radius: 3px;
    position: relative;
    overflow: hidden;
}
.prog-loading-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 32%;
    height: 100%;
    background-color: #c9a84a;
    border-radius: 3px;
}
.prog-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: #05080f;
}
/* El contenido ocupa TODO el ancho del ScrollView. Sin width/align-self
   aqui, .prog-content se dimensionaba a su contenido y las tarjetas
   quedaban flotando en el centro con ~500px muertos a cada lado. */
.prog-content {
    width: 100%;
    padding: 16px 18px 8px 18px;
}

/* ── Tarjetas ──
   Las tarjetas anchas van con el estilo plano del USS: los sprites de marco
   (card_large / card_week) tienen otra proporcion que el contenedor y el 9-slice
   deformaba las volutas. El filete dorado + el fondo oscuro dan la misma lectura. */
.prog-card {
    background-color: rgba(12, 21, 43, 0.85);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.22);
    border-radius: 16px;
    padding: 20px 22px 18px 22px;
    margin-bottom: 14px;
}
.prog-card-head { margin-bottom: 18px; }
.prog-kicker {
    font-size: 10px;
    letter-spacing: 3px;
    color: #c9a84a;
    -unity-font-style: bold;
    /* contorno oscuro: el marco ornamental de los contenedores de abajo (row_challenge)
       puede subir con su filigrana y tapar el título; el contorno lo despega y lo hace
       legible aunque algo dorado se le monte encima. */
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(4, 7, 16, 0.85);
}
.prog-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #f0d27a;
    margin-top: 3px;
    /* sombra suave: sobre la filigrana dorada el título plano se pierde */
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(4, 7, 16, 0.85);
}
.prog-sub {
    font-size: 12px;
    color: #8a9bb5;
    white-space: normal;
    margin-top: 4px;
    /* contorno oscuro: mismo motivo que el kicker, para que el subtítulo no lo tape
       la filigrana del contenedor de abajo. */
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(4, 7, 16, 0.7);
    /* 'line-height' no existe en USS */
}
.prog-reset {
    font-size: 11px;
    color: #7a8ab0;
    letter-spacing: 0.5px;
}
/* Las dos columnas se reparten el ancho, pero NO se estiran en alto:
   con align-items: stretch cada tarjeta cogía la altura de la más alta
   y las misiones quedaban con ~60% de aire muerto debajo. Ahora cada
   tarjeta mide lo que mide su contenido. */
.prog-columns { flex-direction: row; align-items: flex-start; }
.prog-col { flex-grow: 1; flex-basis: 0; }
/* USS no soporta ':first-child'/':last-child': el filete lo aplica ProgressModal
   por indice al construir los hijos (prog-first / prog-last). */
.prog-first { margin-right: 12px; }

/* Tarjetas de misiones con marco sprite card_week (aplicado desde ProgressModal):
   el sprite da fondo y borde, así que acá se le quita el fondo/borde plano (se
   duplicarían) y se SUBE el padding para despejar las volutas de las esquinas.
   card_week (2,41) es el marco menos ancho: en estas columnas angostas estira
   menos el centro que card_large. */
#prog-card-daily,
#prog-card-weekly {
    background-color: rgba(0, 0, 0, 0);   /* transparente: lo pinta el sprite */
    border-width: 0;
    /* padding-bottom 56px: la filigrana inferior de card_week (volutas de las
       esquinas + filete) se comía la última fila ("Constancia" quedaba montada
       sobre el marco) y el botón de cambiar misión. Con 22px el último
       contenido quedaba a nivel del borde; con 44px entraba pero justito, así
       que se deja aire de sobra. */
    padding: 28px 24px 56px 24px;
}
/* Head de las tarjetas de misiones CENTRADO: el kicker (MISIONES DIARIAS/SEMANALES)
   y el timer/reset debajo quedan al centro del marco, no a la izquierda. */
#prog-card-daily .prog-card-head,
#prog-card-weekly .prog-card-head {
    align-items: center;
}
#prog-card-daily .prog-kicker,
#prog-card-weekly .prog-kicker,
#prog-card-daily .prog-reset,
#prog-card-weekly .prog-reset {
    -unity-text-align: middle-center;
}
/* Tarjeta de RETOS con el mismo marco card_week: el sprite da fondo y borde, así
   que se le quita el plano (se duplicaría) y se le centra el head como a las de
   misiones, para que todas las tarjetas de Progreso se vean del mismo tamaño. */
#prog-card-challenges {
    background-color: rgba(0, 0, 0, 0);   /* transparente: lo pinta el sprite */
    border-width: 0;
    /* padding-top 54px: la filigrana superior de card_week (slice top 34px del
       sprite, escalado al ancho completo de la tarjeta) tapaba el kicker
       "RETOS DEL DÍA"; con 28px el título quedaba justo debajo del filete y la
       ornamentación lo opacaba. 54px lo baja a zona limpia. */
    padding: 54px 24px 34px 24px;   /* más aire abajo: la última fila no queda a nivel del borde */
}
#prog-card-challenges .prog-card-head { align-items: center; }
#prog-card-challenges .prog-kicker,
#prog-card-challenges .prog-sub {
    -unity-text-align: middle-center;
}
#prog-card-challenges .prog-sub { max-width: 640px; }

/* ── Barra del Atelier: 7 segmentos ──
   La tarjeta semanal lleva tambien el filete plano del USS. La cabecera se CENTRA
   sobre el ancho completo y el subtitulo se acota para que no choque con los remates. */
.prog-week-card {
    background-color: rgba(16, 26, 52, 0.92);
    border-color: rgba(201, 168, 74, 0.30);
    padding: 24px 26px 20px 26px;
}
.prog-week-card .prog-card-head {
    align-items: center;
    margin-left: 0;
}
.prog-week-card .prog-kicker,
.prog-week-card .prog-title,
.prog-week-card .prog-sub {
    -unity-text-align: middle-center;
}
.prog-week-card .prog-title { letter-spacing: 3px; }
.prog-week-card .prog-sub {
    max-width: 760px;
    -unity-text-align: middle-center;
}
.prog-week-bar {
    flex-direction: row;
    align-items: flex-end;
    height: 168px;
    margin: 4px 0 14px 0;
}
.prog-seg {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    /* El sprite seg_* lleva laurel arriba a la izquierda y moneda arriba a la derecha:
       el padding-top los despeja. Proporcion del sprite (0,5) ~ la de la celda (0,38). */
    padding: 22px 8px 12px 8px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.16);
    border-radius: 12px;
    transition-property: border-color, background-color;
    transition-duration: 0.18s;
}
/* USS no soporta ':last-child': el filete lo aplica ProgressModal por indice. */
.prog-last { margin-right: 0; }
.prog-seg-today {
    border-color: rgba(201, 168, 74, 0.55);
    background-color: rgba(201, 168, 74, 0.07);
}
.prog-seg-complete {
    border-color: rgba(94, 214, 149, 0.55);
    background-color: rgba(94, 214, 149, 0.09);
}
.prog-seg-missed { border-color: rgba(248, 113, 113, 0.35); background-color: rgba(248, 113, 113, 0.06); }
.prog-seg-future { opacity: 0.72; }
.prog-seg-head {
    flex-direction: row;
    align-items: center; /* USS no soporta 'baseline'; 'center' es el sustituto */
    justify-content: center;
    margin-bottom: 5px;
}
.prog-seg-day {
    font-size: 13px;
    -unity-font-style: bold;
    color: #cfd8ea;
    margin-right: 5px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(4, 7, 16, 0.7);
}
.prog-seg-num {
    font-size: 10px;
    color: #7a8ab0;
}
.prog-seg-track {
    width: 22px;
    flex-grow: 1;
    min-height: 44px;
    background-color: rgba(0, 0, 0, 0.42);
    border-radius: 11px;
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.18);
    /* el relleno sube desde abajo */
    flex-direction: column-reverse;
    overflow: hidden;
}
.prog-seg-fill {
    width: 100%;
    background-color: #2a9ad6;
    border-radius: 10px;
}
.prog-seg-today .prog-seg-fill { background-color: #c9a84a; }
.prog-seg-complete .prog-seg-fill { background-color: #5ed695; }
.prog-seg-missed .prog-seg-fill { background-color: rgba(248, 113, 113, 0.45); }
.prog-seg-future .prog-seg-fill { background-color: rgba(122, 138, 176, 0.35); }
.prog-seg-status {
    font-size: 10px;
    -unity-font-style: bold;
    color: #9aa8c7;
    margin-top: 5px;
}
.prog-seg-complete .prog-seg-status { color: #5ed695; }
.prog-seg-today .prog-seg-status { color: #f0d27a; }
.prog-seg-reward {
    font-size: 10px;
    color: #c9a84a;
    margin-top: 2px;
}
.prog-seg-complete .prog-seg-reward { color: #f0d27a; }
.prog-seg-paid .prog-seg-reward { color: #5ed695; }

/* ── Pie de la tarjeta semanal y cofre ──
   El cofre vive dentro de card_week: hereda el margen izquierdo grande,
   pero aquí se recupera algo de aire para que no quede descolgado. */
.prog-week-foot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 14px 0;
}
.prog-week-status {
    font-size: 12px;
    -unity-font-style: bold;
    color: #cfd8ea;
    letter-spacing: 0.5px;
}

/* ── Cofre ──
   Fila plana dentro de la tarjeta semanal: sin sprite de marco (otra proporcion). */
.prog-chest {
    flex-direction: row;
    align-items: center;
    padding: 16px 20px 16px 24px;
    background-color: rgba(0, 0, 0, 0.28);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.28);
    border-radius: 14px;
    margin: 0;
}
.prog-chest-ready {
    border-color: #c9a84a;
    background-color: rgba(201, 168, 74, 0.10);
}
/* ── Escenario del cofre: 8 capas de VFX detrás y el sprite delante ── */
/* La caja de una capa es 196 x 110 = 1,78, que es la proporción del encuadre 384x216 que
   comparten los 8 clips. Si se cambia el ancho hay que cambiar el alto con él, o las capas
   se deforman. No puede desbordar el escenario: el ScrollView del modal recorta. */
.prog-chest-stage {
    position: relative;
    width: 196px;
    height: 118px;
    flex-shrink: 0;
    margin-right: 12px;
    transition-property: scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
/* El escenario es clicable (ChestStage.cs) pero solo cuando hay algo que volver
   a ver: ya cobrado o cofre sin nada que cobrar. Cuando hay algo pendiente de
   cobrar el clic es del boton de al lado, asi que la clase -clickable (que
   ChestStage.cs apaga con la misma logica del handler) evita prometer una
   presion que no hace nada. No se escribe como :not(.prog-chest-stage-ready)
   porque USS no soporta :not(). La animacion de latido va sobre
   .prog-chest-art, no sobre el escenario, asi que este scale no pisa el pulso. */
.prog-chest-stage-clickable:hover {
    scale: 1.04 1.04;
}
.prog-chest-stage-clickable:active {
    scale: 0.97 0.97;
}
.prog-chest-fx {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
.prog-chest-fx-layer {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}
/* El cofre, centrado en el escenario. La caja es 104 x 94 (~1,11), la proporción de
   chest_small (256 x 230) y de chest_base (486 x 510): la misma para las dos poses. */
.prog-chest-art {
    position: absolute;
    left: 46px;
    top: 12px;
    width: 104px;
    height: 94px;
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: scale;
    transition-duration: 0.9s;
    transition-timing-function: ease-in-out;
}
/* Cuando hay algo que cobrar el cofre se enciende, para invitar al clic. */
.prog-chest-stage-ready .prog-chest-art {
    -unity-background-image-tint-color: rgb(255, 246, 220);
}

/* ── Carta de premio. La monta ChestStage.cs sobre el modal entero, no sobre el
   ScrollView: tiene que poder salir de la fila del cofre. ── */
.prog-reward-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
/* Centrado con margen negativo en vez de translate: no discute con el scale que
   escribe el código cada tic. */
.prog-reward-card {
    position: absolute;
    left: 50%; top: 50%;
    width: 140px;
    height: 173px;
    margin-left: -70px;
    margin-top: -86px;
}
.prog-reward-back,
.prog-reward-frame {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}
/* 62 px es el medallón del dorso (304 x 376) escalado a la caja de la carta. */
.prog-reward-emblem {
    position: absolute;
    left: 39px;
    top: 46px;
    width: 62px;
    height: 62px;
    -unity-background-scale-mode: stretch-to-fill;
}
.prog-reward-seal {
    position: absolute;
    right: -10px;
    bottom: -10px;
    width: 54px;
    height: 54px;
    -unity-background-scale-mode: stretch-to-fill;
}
.prog-reward-kind {
    position: absolute;
    left: 0; right: 0;
    top: 112px;
    -unity-text-align: middle-center;
    font-size: 9px;
    letter-spacing: 2px;
    color: #cbbf95;
}
.prog-reward-amount {
    position: absolute;
    left: 0; right: 0;
    top: 124px;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: #f0d27a;
}
.prog-chest-texts { flex-grow: 1; }
.prog-chest-kicker {
    font-size: 9px;
    letter-spacing: 2.5px;
    color: #7a8ab0;
}
.prog-chest-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #f0d27a;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(4, 7, 16, 0.8);
}
.prog-chest-sub {
    font-size: 11px;
    color: #8a9bb5;
    white-space: normal;
    /* 'line-height' no existe en USS */
}

/* ── Botones de cobro ──
   El marco lo da SOLO el sprite píldora (btn_claim_ready/locked/done, aplicado desde
   ProgressModal con SkinClaim). El sprite ya trae su borde dorado y su fondo, así que
   acá NO se pone borde ni fondo plano: se duplicarían y salía un doble marco roto
   (caja rectangular USS encima de la píldora). height sube a 40px: el sprite es una
   píldora de 68px con puntas de ~30px, y a 34px se aplastaba y el texto chocaba con el
   borde. El padding 0 30px despeja las puntas redondas para que la etiqueta no las pise. */
.prog-claim {
    height: 40px;
    min-width: 150px;
    padding: 0 30px;
    border-width: 0;                 /* el marco lo da el sprite, no el USS */
    background-color: rgba(0, 0, 0, 0); /* transparente: lo pinta el sprite */
    color: #ffe9ae;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    flex-shrink: 0;
    transition-property: scale;
    transition-duration: 0.16s;
}
.prog-claim:hover {
    scale: 1.02 1.02;
}
.prog-claim-locked {
    color: #6f7c96;
}
.prog-claim-locked:hover {
    scale: 1 1;
}
.prog-claim-done {
    color: #9be8bd;
}
.prog-claim-done:hover {
    scale: 1 1;
}

/* ── Lista de misiones ──
   El marco lo da el sprite 9-slice (row_mission / row_weekly), aplicado desde
   ProgressModal. Con slice las esquinas y la gema azul de la izquierda NO se
   estiran (solo el centro), así que no se deforma. El USS solo aporta el layout
   y el padding-left para despejar la gema (slice-left=34). Sin fondo ni borde
   planos: los daría el sprite y se duplicarían. */
.prog-list {
    flex-direction: column;
    align-self: center;      /* la lista se centra en el marco en vez de ir a los bordes */
    width: 100%;
    max-width: 400px;        /* filas más angostas: no estiran a todo el ancho del marco */
}
.prog-mission {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 10px 40px;
    margin-bottom: 8px;
    min-height: 56px;
    transition-property: border-color, background-color;
    transition-duration: 0.18s;
}
/* USS no soporta ':last-child': el filete lo aplica ProgressModal por indice. */
.prog-mission-last { margin-bottom: 0; }
/* El marco verde de la fila completada lo da el sprite row_mission_done; acá
   solo queda el tinte del icono (ver .prog-mission-done .prog-mission-icon-wrap). */
.prog-mission-icon-wrap {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: rgba(42, 154, 214, 0.12);
    border-width: 1px;
    border-color: rgba(42, 154, 214, 0.28);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    flex-shrink: 0;
}
.prog-mission-done .prog-mission-icon-wrap {
    background-color: rgba(94, 214, 149, 0.12);
    border-color: rgba(94, 214, 149, 0.35);
}
.prog-mission-icon { font-size: 14px; }
.prog-mission-texts { flex-grow: 1; min-width: 0; }
.prog-mission-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f0d27a;                     /* dorado: se lee sobre la filigrana del marco */
    letter-spacing: 0.3px;
    -unity-text-outline-width: 1px;     /* sombra suave para que no se funda con el marco */
    -unity-text-outline-color: rgba(4, 7, 16, 0.85);
}
.prog-mission-desc {
    font-size: 10px;
    color: #8a9bb5;
    white-space: normal;
}
.prog-mission-reward {
    font-size: 9px;
    color: #c9a84a;
    margin-top: 1px;
    letter-spacing: 0.3px;
}
.prog-mission-right {
    flex-direction: column;
    align-items: flex-end;
    min-width: 108px;
    margin-left: 10px;
    flex-shrink: 0;
}
.prog-bar {
    width: 100px;
    height: 5px;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 3px;
    flex-direction: row;
    overflow: hidden;
    margin-bottom: 4px;
}
.prog-bar-fill {
    height: 100%;
    background-color: #2a9ad6;
    border-radius: 3px;
}
.prog-mission-done .prog-bar-fill { background-color: #5ed695; }

/* ── Retos ──
   Marco sprite row_challenge (9-slice), aplicado desde ProgressModal a las DOS filas
   por igual (mismo sprite y slice). El sprite da fondo y borde, así que acá se le
   quita el fondo/borde plano (se duplicarían). El centro del sprite es LISO: al ser
   la fila real mucho más ancha solo se estira el centro, el filete no se deforma.
   Filas CORTAS (-30%): padding 2px/14px, icono de 24px, textos y botón
   reducidos SOLO acá dentro (.prog-challenge .prog-claim y títulos de reto):
   el botón base se queda en 40px para misiones y cofre. OJO: la píldora a 28px
   puede aplanar sus puntas (a 34px ya se deformaba con letra 11); si se ve mal,
   se sube a 30-32px. Así cada contenedor individual ocupa menos alto sin tocar
   la tarjeta principal.
   margin-top en la lista: separa el primer contenedor del head para que la filigrana del
   borde superior del sprite (row_challenge) no suba a tapar el título "RETOS DEL DÍA". */
.prog-challenges { flex-direction: column; margin-top: 4px; }
.prog-challenge {
    flex-direction: row;
    align-items: center;
    /* Fila compacta: título y descripción LADO A LADO en la misma línea
       (ver .prog-challenge-texts), ambos centrados verticalmente. El sprite
       row_challenge es 9-slice con centro liso: al angostarse (70%) solo se
       comprime el centro, las volutas de las puntas quedan intactas. */
    width: 70%;
    align-self: center;
    padding: 10px 14px 8px 14px;
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0);   /* transparente: lo pinta el sprite */
    border-width: 0;
}
/* USS no soporta ':last-child': el filete lo aplica ProgressModal por indice. */
.prog-challenge-last { margin-bottom: 0; }
.prog-challenge-icon-wrap {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgba(201, 168, 74, 0.12);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.30);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    flex-shrink: 0;
}
.prog-challenge-icon { font-size: 12px; }
/* Botón bajo SOLO dentro de las filas de retos: 28px en vez de 40px, con letra
   y padding lateral reducidos. Experimento acotado a estas dos filas. */
.prog-challenge .prog-claim {
    height: 28px;
    min-width: 0;
    padding: 0 20px;
    font-size: 9px;
    letter-spacing: 1px;
}
.prog-challenge-texts {
    flex-grow: 1;
    min-width: 0;
    /* Título y descripción en la MISMA línea: el título fijo a la izquierda
       y la descripción ocupando el resto, centrada. Ambos quedan centrados
       verticalmente por el align-items del contenedor. Robusto al wrap: si la
       descripción envuelve, la fila crece y todo sigue centrado. */
    flex-direction: row;
    align-items: center;
}
.prog-challenge-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #f0d27a;
    /* Fijo a la izquierda, sin encoger */
    flex-shrink: 0;
    margin-right: 12px;
}
.prog-challenge-sub {
    font-size: 9px;
    color: #8a9bb5;
    white-space: normal;
    /* Descripción CENTRADA en el espacio restante (el título va fijo a su
       izquierda): envuelve en varias líneas centradas cuando es larga. */
    -unity-text-align: middle-center;
    flex-grow: 1;
    /* 'line-height' no existe en USS */
}

/* ── Logros ──
   card_ach (482x108) lleva puntas a los lados (~10px de slice): el padding
   lateral las despeja para que el icono y el estado no las pisen. */
.prog-ach-grid { flex-direction: row; flex-wrap: wrap; }
.prog-ach {
    width: 48.5%;
    flex-direction: row;
    align-items: center;
    padding: 12px 20px 12px 20px;
    margin-right: 1.5%;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.16);
    border-radius: 12px;
}
.prog-ach-last { margin-right: 0; }
.prog-ach-unlocked {
    border-color: rgba(201, 168, 74, 0.45);
    background-color: rgba(201, 168, 74, 0.08);
}
.prog-ach-icon { font-size: 15px; margin-right: 10px; flex-shrink: 0; }
.prog-ach-texts { flex-grow: 1; min-width: 0; }
.prog-ach-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #dfe6f4;
}
.prog-ach-unlocked .prog-ach-title { color: #f0d27a; }
.prog-ach-desc {
    font-size: 10px;
    color: #8a9bb5;
    white-space: normal;
    /* 'line-height' no existe en USS */
}
.prog-ach-state {
    font-size: 10px;
    -unity-font-style: bold;
    color: #c9a84a;
    margin-left: 8px;
    flex-shrink: 0;
}

/* ── Catálogo de fuentes ──
   row_source (1123x108) lleva corona arriba y abajo al centro: el padding vertical
   la despeja. El lateral izquierdo despeja además los remaches de row_source_empty. */
.prog-sources { flex-direction: column; }
.prog-source {
    flex-direction: row;
    align-items: center;
    padding: 14px 16px 14px 22px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.02);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.14);
    border-radius: 10px;
}
/* USS no soporta ':last-child': el filete lo aplica ProgressModal por indice. */
.prog-source-last { margin-bottom: 0; }
.prog-source-exhausted { opacity: 0.55; }
.prog-source-icon { font-size: 14px; margin-right: 10px; flex-shrink: 0; }
.prog-source-texts { flex-grow: 1; min-width: 0; }
.prog-source-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #dfe6f4;
}
.prog-source-hint {
    font-size: 10px;
    color: #8a9bb5;
    white-space: normal;
    /* 'line-height' no existe en USS */
}
.prog-source-today {
    font-size: 11px;
    -unity-font-style: bold;
    color: #c9a84a;
    min-width: 92px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

/* ── Botón de cambiar misión ──
   Pastilla discreta integrada al pie de la tarjeta: fondo tenue + borde sutil
   + texto dorado, centrado. Antes era un enlace fantasma sin caja que quedaba
   aislado y flotando; así compite visualmente con las misiones sin robarles el
   protagonismo y se lee como una acción de la tarjeta, no como un texto suelto. */
.prog-ghost {
    height: 30px;
    margin-top: 12px;
    margin-bottom: 2px;
    align-self: center;
    padding: 0 22px;
    background-color: rgba(201, 168, 74, 0.08);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.28);
    border-radius: 15px;
    color: #c9a84a;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
    transition-property: color, background-color, border-color;
    transition-duration: 0.16s;
}
.prog-ghost:hover {
    color: #f0d27a;
    background-color: rgba(201, 168, 74, 0.16);
    border-color: rgba(240, 210, 122, 0.55);
}
.prog-ghost-disabled {
    opacity: 0.4;
    background-color: rgba(120, 130, 150, 0.06);
    border-color: rgba(120, 130, 150, 0.18);
    color: #8a9bb5;
}
.prog-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    background-color: #0a1226;
    border-top-width: 1px;
    border-top-color: rgba(201, 168, 74, 0.18);
    flex-shrink: 0;
}
.prog-footer-note {
    font-size: 10px;
    color: #6f7c96;
    letter-spacing: 0.6px;
}
.prog-footer-btn {
    width: auto;
    min-width: 140px;
    margin-bottom: 0;
    padding: 0 18px;
}

/* ══════════════════════════════════════════════════════════
   INVENTARIO — vitrina de la colección + modal de colección
   (el único sitio donde se equipa: ver InventoryModal.cs)
   ══════════════════════════════════════════════════════════ */

/* ── PASE DE TEMPORADA: tarjeta horizontal de la columna izquierda ──
   Ahora vive en el flujo (dentro de .menu-rail-left), apilada con el pase
   de Halloween y centrada contra la columna de acciones. La tarjeta entera
   va envuelta por el marco ornamental; dentro quedan la lámina y el rótulo,
   retirados 10 px para no pisar la filigrana. */
.menu-seasonpass-entry {
    width: 100%;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    margin-bottom: 16px;
    /* Sin borde ni radio propios: el contorno lo dibuja el marco PNG, que
       llega hasta la esquina. `overflow: visible` deja que la corona y los
       remates de las esquinas se salgan del rectángulo sin recortarse. */
    position: relative;
    border-width: 0;
    border-radius: 0;
    background-color: #0b1420;
    overflow: visible;
    transition-property: background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.menu-seasonpass-entry:hover {
    background-color: #101d31;
}
.menu-seasonpass-entry:active { background-color: #16273f; }
.menu-seasonpass-banner {
    /* 10 px de margen a cada lado para dejar ver el anillo del marco, que
       mide ~10 px de ancho en el tamaño de la tarjeta. */
    height: 125px;
    margin: 10px 10px 0 10px;
    flex-shrink: 0;
    position: relative;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/seasonpass_banner.jpg");
    -unity-background-scale-mode: scale-and-crop;
}
/* El rótulo es un PNG de 2182x199 (proporción 11:1). Ahora tiene que entrar
   entre los remates inferiores del marco, así que baja de 264x24 a 224x20. */
.menu-seasonpass-label {
    width: 224px;
    height: 20px;
    flex-shrink: 0;
    align-self: center;
    margin-top: 10px;
    margin-bottom: 12px;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/seasonpass_label.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ── PASE DE HALLOWEEN: la misma tarjeta, apilada DEBAJO ──
   Comparte ancho con la de temporada, pero la lámina es 5 px más alta y el
   rótulo casi el doble, porque el marco de plata deja menos hueco abajo. */
.menu-halloweenpass-entry {
    width: 100%;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    position: relative;
    border-width: 0;
    border-radius: 0;
    background-color: #120a1e;
    overflow: visible;
    transition-property: background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.menu-halloweenpass-entry:hover {
    background-color: #1a1030;
}
.menu-halloweenpass-entry:active { background-color: #241645; }
.menu-halloweenpass-banner {
    height: 130px;
    margin: 10px 10px 0 10px;
    flex-shrink: 0;
    position: relative;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/halloweenpass_banner.jpg");
    -unity-background-scale-mode: scale-and-crop;
}
/* Cintillo «PRÓXIMAMENTE» superpuesto al banner: informa sin
   sumar altura a la tarjeta ni romper la alineación con la de arriba. */
.menu-halloweenpass-soon {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 4px 10px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #f3e6ff;
    background-color: rgba(24, 10, 40, 0.82);
    border-width: 1px;
    border-color: rgba(186, 128, 255, 0.7);
    border-radius: 8px;
}
/* El rótulo de Halloween es un PNG de 2048x400 (proporción 5,1:1): baja a
   202x40 para librar los remates inferiores del marco, que en esta tarjeta
   son más grandes que en la de temporada. */
.menu-halloweenpass-label {
    width: 202px;
    height: 40px;
    flex-shrink: 0;
    align-self: center;
    margin-top: 12px;
    margin-bottom: 13px;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/halloweenpass_label.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ── MARCO ORNAMENTAL DE LOS DOS PASES ──
   El marco (Flow, Nano Banana) se genera HUECO: el centro sale blanco y se
   recorta a transparente, así que la lámina y el rótulo respiran por dentro.
   Ahora envuelve la tarjeta ENTERA (lámina + rótulo) y por eso cada pase
   tiene su propio PNG con la proporción exacta de su tarjeta: 600×354 para
   temporada (300×177) y 600×410 para Halloween (300×205). Se generó con el
   travesaño superior e inferior a tamaño natural y solo se estiró el tramo
   recto central, de modo que la corona y las esquinas no se deforman.
   El contenido se retira 10 px de cada borde para no pisar la filigrana. */
.menu-pass-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(235, 235, 235, 1);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.menu-seasonpass-entry:hover .menu-pass-frame,
.menu-halloweenpass-entry:hover .menu-pass-frame {
    -unity-background-image-tint-color: rgba(255, 255, 255, 1);
}
.menu-pass-frame-season {
    background-image: url("project://database/Assets/Resources/UI/Menu/wg_pass_season.png");
}
.menu-pass-frame-halloween {
    background-image: url("project://database/Assets/Resources/UI/Menu/wg_pass_halloween.png");
}

/* --- Columna derecha: vitrina del INVENTARIO ---
   Antes era un rail girado (una tira estrecha pegada a la botonera, con el
   texto en vertical). Ahora es una tarjeta de la columna derecha: macuto
   grande, rotulo horizontal y contador. Ocupa todo el alto libre de la banda
   para que el saldo quede anclado abajo, a la misma altura que los pases. */
.menu-inventory-rail {
    width: 100%;
    flex-shrink: 0;
    flex-grow: 1;
    min-height: 0;
}

.btn-inventory {
    width: 100%;
    height: 100%;
    /* El margen por defecto del Button la sacaba 3,8px del rail: la vitrina
       dejaba de estar a ras del saldo y de los pases. */
    margin: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.38);
    background-color: #0b1420;
    overflow: hidden;
    position: relative;
    transition-property: border-color, background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.btn-inventory:hover {
    border-color: rgba(240, 210, 122, 0.75);
    background-color: #101d31;
}
.btn-inventory:focus { border-color: #f0d27a; }
.btn-inventory:active { background-color: #16273f; }

/* Velo de luz: cubre toda la vitrina (no una franja) para que no quede una
   costura horizontal a media altura. */
.btn-inventory-halo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(74, 150, 196, 0.035);
}
.btn-inventory-art-wrap {
    width: 150px;
    height: 150px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    position: relative;
}
/* Si el PNG no está importado todavía, el emoji hace de marcador */
.btn-inventory-art-fallback {
    position: absolute;
    font-size: 40px;
    -unity-text-align: middle-center;
    opacity: 0.85;
}
.btn-inventory-art { width: 100%; height: 100%; }
.btn-inventory-art-fallback.hidden { display: none; }
/* Filete dorado que separa el macuto del rótulo */
.btn-inventory-rule {
    width: 52px;
    height: 1px;
    flex-shrink: 0;
    align-self: center;
    margin-top: 10px;
    margin-bottom: 8px;
    background-color: rgba(201, 168, 74, 0.30);
}
.btn-inventory-label-wrap {
    flex-shrink: 0;
    width: 100%;
    position: relative;
    align-items: center;
    justify-content: center;
}
/* Rótulo en horizontal: la vitrina tiene sitio de sobra y el texto en
   vertical (el «lomo» de antes) ya no se leía bien. */
.btn-inventory-label {
    translate: 0 0;
    rotate: 0deg;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: #d9c07a;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.btn-inventory-count {
    position: absolute;
    top: 8px;
    right: 8px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 10px;
    background-color: #c9a84a;
    border-width: 1px;
    border-color: #8a6f28;
    color: #1a1400;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.btn-inventory-count.hidden { display: none; }

/* ── SALDO: la divisa del juego, visible de un vistazo ── */
.menu-wallet {
    flex-direction: row;
    align-items: center;
    /* 90px: la placa wg_chip mide 320x96 (3,33:1); a 300x90 conserva su
       proporcion y el texto de dos lineas cabe dentro del plato central. */
    height: 90px;
    flex-shrink: 0;
    margin-top: 16px;
    padding: 8px 16px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.28);
    background-color: rgba(11, 20, 32, 0.78);
}
.menu-wallet-icon {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
}
.menu-wallet-texts {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-grow: 1;
}
.menu-wallet-value {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: #f0d27a;
}
.menu-wallet-label {
    margin-left: 8px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #7e8ea8;
}

/* ── Modal de INVENTARIO (ventana shop2, piel propia) ── */
/* El inventario necesita más aire que la tienda: la ventana se abre casi
   hasta los bordes y las cartas crecen con ella (4 columnas). */
.shop2-window.inv-window {
    width: 95%;
    max-width: 1780px;
    height: 96%;
    max-height: 1000px;
}
.inv-window { position: relative; }
/* En ventanas pequeñas mandan las reglas responsive: el inventario no
   impone ahí su tope de escritorio. */
.is-small .shop2-window.inv-window { max-height: none; }
.is-tiny .shop2-window.inv-window { width: 98%; height: 98%; max-width: none; max-height: none; }
/* Marca de agua: va antes del catálogo en el árbol y este tiene fondo
   transparente, así que se ve por los huecos de la rejilla. */
.inv-watermark {
    position: absolute;
    right: -34px;
    bottom: -46px;
    width: 330px;
    height: 560px;
    opacity: 0.13;
}
/* El emblema del macuto es cuadrado con esquinas redondeadas: el aro
   circular recortaba las asas y la base del PNG. */
.inv-crest {
    width: 46px;
    height: 46px;
    margin-left: 16px;
    margin-right: 12px;
    border-radius: 11px;
    background-color: rgba(201, 168, 74, 0.08);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.42);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
}
.inv-crest-icon { font-size: 22px; -unity-text-align: middle-center; }
.inv-crest-art { width: 38px; height: 38px; }
.inv-crest-art.hidden { display: none; }
.inv-crest-icon.hidden { display: none; }

/* La topbar de la tienda oculta los subtítulos; el inventario sí lo enseña,
   en columna bajo el título, para explicar de un vistazo qué se hace aquí. */
/* Barra superior del inventario: un punto más de aire para que el título,
   el subtítulo y los contadores no se toquen. */
.inv-window .shop2-topbar { padding: 16px 24px; }
.inv-window .shop2-topbar .shop2-brand {
    flex-direction: column;
    align-items: flex-start;
    margin-left: 0;
}
.inv-window .shop2-topbar .shop2-brand-title { margin-left: 0; }
.inv-window .shop2-topbar .shop2-brand-subtitle {
    display: flex;
    font-size: 12px;
    letter-spacing: 0.2px;
    color: #93a3bb;
    margin-top: 3px;
    max-width: 560px;
}
/* El ornato de la esquina izquierda del marco pisa el borde del botón:
   se separa lo justo para que la placa respire. */
.inv-window .shop2-topbar .shop2-back-btn { margin-left: 42px; }
.inv-window .shop2-topbar .shop2-rail-vault { margin-right: 6px; }

.chip-owned { border-color: rgba(122, 138, 176, 0.28); background-color: rgba(122, 138, 176, 0.07); }
.shop2-chip-icon-wrap-owned { background-color: rgba(122, 138, 176, 0.18); border-color: rgba(122, 138, 176, 0.35); }
.chip-owned .shop2-chip-icon { color: #d6deee; }

/* ── Contenedores de saldo del inventario ──
   Placa propia 9-slice (doble filete + laca azul medianoche) ceñida al
   contenido: 56px de alto en vez de los 82 que imponían las dos líneas con
   interlineado holgado. Gambits va en latón cálido; En posesión, en acero. */
.inv-window .shop2-chip {
    height: 74px;
    min-height: 74px;
    min-width: 160px;
    margin: 0 8px 0 0;
    padding: 11px 24px 11px 14px;
    border-width: 0;
    border-radius: 10px;
    background-color: transparent;
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.5px;
    -unity-background-scale-mode: stretch-to-fill;
}
.inv-window .shop2-chip.chip-gambits {
    background-image: url("project://database/Assets/Resources/UI/Wg/wg_inv_chip_gambits.png");
}
.inv-window .shop2-chip.chip-owned {
    background-image: url("project://database/Assets/Resources/UI/Wg/wg_inv_chip_owned.png");
}
.inv-window .shop2-chip-icon-wrap {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    margin-right: 12px;
}
.inv-window .shop2-chip-icon-wrap-gambit {
    background-color: rgba(201, 168, 74, 0.10);
    border-color: rgba(201, 168, 74, 0.32);
}
.inv-window .shop2-chip-icon-wrap-owned {
    background-color: rgba(159, 179, 207, 0.10);
    border-color: rgba(159, 179, 207, 0.30);
}
.inv-window .shop2-chip-icon.gambits-icon { width: 25px; height: 25px; }
.inv-window .shop2-chip-icon { font-size: 16px; }
.inv-window .shop2-chip-texts { justify-content: center; }
.inv-window .shop2-chip-amount { font-size: 17px; letter-spacing: 0.4px; margin: 0; }
.inv-window .shop2-chip-label { font-size: 8.5px; letter-spacing: 1.5px; margin: 0; }
.inv-window .chip-gambits .shop2-chip-amount { color: #f4e7c3; }
.inv-window .chip-gambits .shop2-chip-label { color: #b99a5b; }
.inv-window .chip-owned .shop2-chip-amount { color: #e8eefb; }
.inv-window .chip-owned .shop2-chip-label { color: #b9c8dd; }

.inv-tabs {
    flex-direction: row;
    align-items: center;
    padding: 14px 24px 6px 24px;
    flex-shrink: 0;
}
/* Las pestañas del inventario no crecen: el minimo les da aire para que la
   etiqueta no se corte con puntos suspensivos junto al contador. */
.inv-tabs .shop2-tab {
    min-width: 224px;
}
.inv-tab-hint {
    margin-left: auto;
    font-size: 10.5px;
    color: #7f8ca3;
    letter-spacing: 0.6px;
    white-space: normal;
    max-width: 420px;
    -unity-text-align: middle-right;
}
/* La cenefa dorada del marco ocupa el borde izquierdo del contenido: la
   fila arranca un poco más adentro para que FILTRAR no quede sobre el oro. */
.inv-filter-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 30px 10px 38px;
    flex-shrink: 0;
}
.inv-filter-row.hidden { display: none; }
.inv-filter-label {
    font-size: 11px;
    letter-spacing: 2px;
    color: #8b98b0;
    margin-right: 10px;
}
/* Los filtros del inventario van un punto por encima de los de TUS PIEZAS:
   la fila comparte el ancho de la rejilla y debe leerse sin esfuerzo. */
.inv-filter-row .skin-filter-btn {
    height: 28px;
    padding: 0 12px;
    margin: 3px;
    font-size: 13px;
}
.inv-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: transparent;
}
.inv-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 10px 22px 26px 22px;
}

/* Cabecera de sección dentro del catálogo (TODAS LAS VARIANTES / ASPECTOS / TABLEROS) */
.inv-section {
    width: 97.5%;
    flex-direction: row;
    align-items: center;
    margin: 12px 1% 6px 1%;
    padding-left: 12px;
}
.inv-section-title {
    flex-shrink: 0;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
    color: #d4b36a;
}
.inv-section-note {
    flex-shrink: 0;
    font-size: 10.5px;
    color: #8b98b0;
    letter-spacing: 0.3px;
}
.inv-section-rule {
    flex-grow: 1;
    height: 1px;
    margin: 0 12px;
    background-color: rgba(201, 168, 74, 0.18);
}

/* ── TU FORMACIÓN: tira compacta con las cinco piezas equipadas ── */
.inv-loadout {
    width: 97.5%;
    margin: 4px 1% 10px 1%;
    padding: 14px 16px 16px 16px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.24);
    background-color: rgba(201, 168, 74, 0.045);
    flex-shrink: 0;
}
.inv-loadout-head {
    width: 100%;
    flex-direction: row;
    align-items: center;
}
.inv-loadout-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
    color: #d4b36a;
}
.inv-loadout-note {
    margin-left: auto;
    font-size: 10px;
    color: #8b98b0;
    letter-spacing: 0.4px;
    -unity-text-align: middle-right;
}
.inv-loadout-slots {
    width: 100%;
    flex-direction: row;
    align-items: stretch;
    margin-top: 11px;
}
.inv-loadout-slot {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 70px;
    margin-right: 10px;
    padding: 8px 20px 8px 10px;
    flex-direction: row;
    align-items: center;
    position: relative;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.20);
    background-color: rgba(8, 16, 27, 0.55);
    overflow: hidden;
}
.inv-loadout-slot-last { margin-right: 0; }
.inv-loadout-art {
    width: 50px;
    height: 50px;
    margin-right: 10px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.22);
    background-color: #05070f;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
}
.inv-loadout-art-img { width: 100%; height: 100%; }
.inv-loadout-art-icon { font-size: 20px; color: #6f7c96; -unity-text-align: middle-center; }
.inv-loadout-texts {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
}
.inv-loadout-tag {
    font-size: 8.5px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: #7a8ab0;
}
.inv-loadout-name {
    margin-top: 1px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.3px;
    color: #e6dcc0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.inv-loadout-check {
    position: absolute;
    top: 6px;
    right: 7px;
    font-size: 9px;
    color: #6ee7b7;
    -unity-text-align: middle-center;
}

/* ── Píldora de estado de las cartas del inventario ──
   Anclada al pie y a ancho completo: todas las cartas cierran a la misma
   altura aunque el nombre o la nota ocupen más o menos. */
.inv-state {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 16px;
    height: 32px;
    margin: 0;
    padding: 0 12px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.25);
    background-color: rgba(122, 138, 176, 0.08);
    color: #9aa8c7;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.18s;
}
.inv-state-on {
    border-color: rgba(16, 185, 129, 0.42);
    background-color: rgba(16, 185, 129, 0.12);
    color: #6ee7b7;
}
.inv-state-act {
    border-color: rgba(201, 168, 74, 0.35);
    background-color: rgba(201, 168, 74, 0.10);
    color: #f0d27a;
}
.inv-state-act:hover {
    border-color: #c9a84a;
    background-color: rgba(201, 168, 74, 0.22);
    color: #ffe9ae;
    scale: 1.04 1.04;
}
.inv-state-off {
    border-color: rgba(248, 113, 113, 0.30);
    background-color: rgba(248, 113, 113, 0.08);
    color: #fca5a5;
}

/* Carta del inventario: placa de latón con doble filete (sprite 9-slice),
   ventana de arte hundida y pie fijo. El arte manda; el estado va al pie. */
/* La placa propia del inventario pisa el wg_card de la tienda (WgTheme se
   carga después, así que hace falta especificidad de dos clases). */
.bg-card.inv-card {
    background-image: url("project://database/Assets/Resources/UI/Wg/wg_inv_plate.png");
    background-color: #08101b;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.5px;
    -unity-background-scale-mode: stretch-to-fill;
}
.inv-card {
    width: 22.5%;
    height: 410px;
    margin: 1%;
    padding: 22px 22px 0 22px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.10);
    justify-content: flex-start;
    transition-property: border-color, scale, opacity, translate;
}
.inv-card.inv-card-wide { width: 22.5%; height: 410px; }
/* Ventana de arte: casi negro para que el marfil/dorado resalte, con un
   filete cálido que la separa del latón de la placa. */
.inv-card .bg-card-thumb,
.inv-card.inv-card-wide .bg-card-thumb {
    height: 248px;
    border-radius: 6px;
    background-color: #05080f;
    border-color: rgba(201, 168, 74, 0.14);
}
/* Halo radial detrás de la pieza (sprite, se tinta por rareza). */
.inv-card .bg-card-thumb-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border-radius: 0;
    background-color: transparent;
    background-image: url("project://database/Assets/Resources/UI/Wg/wg_inv_glow.png");
    -unity-background-scale-mode: stretch-to-fill;
}
/* Sombra de contacto bajo la pieza: la asienta en la vitrina. */
.inv-thumb-floor {
    position: absolute;
    left: 50%;
    bottom: 4px;
    width: 190px;
    height: 54px;
    translate: -50% 0;
    background-image: url("project://database/Assets/Resources/UI/Wg/wg_inv_floor.png");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.85;
}
/* Filete ornamental entre el arte y el nombre. */
.inv-card-rule {
    width: 100%;
    height: 20px;
    margin: 9px 0 0 0;
    background-image: url("project://database/Assets/Resources/UI/Wg/wg_inv_divider.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.72;
    flex-shrink: 0;
}
.inv-card .bg-card-name-row {
    height: 19px;
    margin: 1px 0 0 0;
    padding: 0 2px;
}
/* El nombre se mide por su contenido: con elipsis automática el último
   glifo se cortaba aunque la fila tuviera sitio de sobra. */
.inv-card .bg-card-name {
    font-size: 13.5px;
    letter-spacing: 0.4px;
    flex-shrink: 0;
    overflow: visible;
    text-overflow: clip;
}
/* Sin velo negro: el candado vive en la esquina y la píldora dice el precio. */
.inv-card.bg-card-locked { opacity: 0.78; }

/* Chapa de familia sobre el arte (ALFIL, CABALLO, PEÓN, DAMA, TORRE). */
.inv-type-chip {
    position: absolute;
    left: 26px;
    top: 26px;
    padding: 4px 10px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.30);
    background-color: rgba(8, 16, 27, 0.80);
    color: #e8c46a;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
}

/* Medallón de esquina: ✓ equipado, candado si falta comprarlo. */
.inv-mark {
    position: absolute;
    top: 26px;
    right: 26px;
    width: 26px;
    height: 26px;
    margin: 0;
    padding: 0;
    border-radius: 13px;
    border-width: 1px;
    font-size: 11.5px;
    -unity-text-align: middle-center;
}
.inv-mark-on {
    border-color: #a7f3d0;
    background-color: #6ee7b7;
    color: #042a1c;
}
.inv-mark-lock {
    border-color: rgba(248, 113, 113, 0.45);
    background-color: rgba(8, 16, 27, 0.86);
    color: #fca5a5;
}

.inv-card-note {
    width: 100%;
    height: 26px;
    font-size: 10.5px;
    color: #7f8ca3;
    -unity-text-align: middle-center;
    margin: 2px 0 0 0;
    padding: 0 2px;
    white-space: normal;
    overflow: hidden;
    flex-shrink: 0;
}
/* El pie comparte el margen de la rejilla para que la nota y el botón
   queden alineados con las cartas. */
.inv-window .prog-footer { padding: 14px 28px; }
.inv-window .prog-footer .prog-footer-note { font-size: 10.5px; color: #7f8ca3; }

.inv-empty {
    width: 100%;
    height: 120px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.02);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.12);
    border-radius: 12px;
    padding: 16px;
}
.inv-empty-title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #7a8ab0;
    margin-bottom: 6px;
}
.inv-empty-desc { font-size: 11px; color: #5a6a85; -unity-text-align: middle-center; white-space: normal; }

/* ── Rótulos de estado de «TUS PIEZAS» (catálogo) ──
   Esta sección ya no equipa: dice qué tienes y qué está puesto, y todo lo que
   se pone se hace desde el INVENTARIO (ver InventoryModal). */
.skin-btn-elsewhere,
.btn-variant-elsewhere {
    background-color: rgba(122, 138, 176, 0.10);
    border-color: rgba(122, 138, 176, 0.34);
    color: #9aa8c7;
}
.skin-btn-elsewhere:disabled,
.btn-variant-elsewhere:disabled,
.skin-btn-equipped:disabled {
    opacity: 0.85;
}

/* ── Rarezas del Atelier — píldoras con color por tier ──
   COMÚN gris · POCO COMÚN verde · RARA azul · ÉPICA púrpura ·
   LEGENDARIA amarilla · MÍTICA roja. El C# aplica además inline
   como respaldo, así que la USS es progresiva (no rompe si falta). */
.rarity-pill {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    padding-top: 2px; padding-bottom: 2px;
    padding-left: 7px; padding-right: 7px;
    margin-right: 0;
    border-width: 1px;
    border-radius: 6px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    white-space: nowrap;
}
.rarity-comun { color: #9ea6b2; background-color: rgba(158,166,178,0.14); border-color: rgba(158,166,178,0.65); }
.rarity-poco { color: #34d399; background-color: rgba(52,211,153,0.14); border-color: rgba(52,211,153,0.65); }
.rarity-rara { color: #59a6ff; background-color: rgba(89,166,255,0.14); border-color: rgba(89,166,255,0.65); }
.rarity-epica { color: #c061f2; background-color: rgba(192,97,242,0.15); border-color: rgba(192,97,242,0.70); }
.rarity-legendaria { color: #f2c733; background-color: rgba(242,199,51,0.15); border-color: rgba(242,199,51,0.70); }
.rarity-mitica { color: #ff4d45; background-color: rgba(255,77,69,0.15); border-color: rgba(255,77,69,0.70); }

/* ══════════════════════════════════════════════════════════
   PASE DE TEMPORADA — pantalla completa real (sin ventana flotante)
   Artes: banner (hero) · label (título) · bar (progreso) ·
   tier (medallón) · slots basic/premium (vías). Ver
   SeasonPassModal.cs + SeasonPassSprites.cs.
   SIN SCROLL VERTICAL: el cuerpo es una columna fija (banners +
   pista) y la pista se escala a la altura disponible desde código
   (SeasonPassModal.FitTrack) manteniendo la proporción de las
   cartas, así las dos vías caben siempre y solo se navega en
   horizontal. Regla anti-desborde: overflow hidden en el cuerpo y
   en cada columna de nivel.
   ══════════════════════════════════════════════════════════ */
/* Raíz a sangre: sin acolchado ni ventana flotante; fondo opaco */
.season-root { padding: 0; background-color: #04060d; }
.season-window {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border-radius: 0;
    border-width: 0;
    overflow: hidden;
}
.season-topbar { flex-wrap: wrap; padding: 8px 14px; }

/* ── Bloque de estado del topbar (NIVEL · XP) a la derecha ──
   Antes cada cifra tenía su placa y ambas se apoyaban en un tercer
   marco (la bóveda) con relleno cero: se veía un contorno suelto por
   fuera, los chips no compartían ancho y el conjunto quedaba pegado
   al borde. Aquí la bóveda pierde su marco y las dos placas gemelas
   comparten alto, ancho mínimo, relleno y separación; la última cierra
   el grupo contra el margen interior del topbar.

   La placa wg_chip es 320x96 (3,33:1) y se estira sin 9-slice. Con
   268x86 el ornamento se aplastaba y el rótulo de dos líneas caía
   sobre el remate inferior. 320x96 usa el tamaño nativo del arte sin
   deformarlo y deja el plato negro interior (≈29..290 x 18..77)
   libre para las dos líneas. El icono arranca dentro del plato, no
   encima del remate lateral. */
.season-topbar .shop2-rail-vault {
    margin-left: auto;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}
.season-topbar .shop2-vault-chips {
    flex-direction: row;
    align-items: center;
}
.season-topbar .shop2-chip {
    min-width: 320px;
    min-height: 96px;
    margin: 0 10px 0 0;
    padding: 0 16px 0 30px;
    border-width: 0;
}
.season-topbar .shop2-chip-icon-wrap {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    margin-right: 12px;
}
.season-topbar .shop2-chip-label {
    font-size: 10px;
    letter-spacing: 1.4px;
    margin-top: 0;
}
.season-topbar .season-chip-end { margin-right: 0; }

/* ── Hero: el rey ennegrecido a sangre completa (compacto: el
   cuerpo no tiene scroll vertical, cada píxel es para la pista) ── */
.season-hero {
    height: 120px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: 10px 16px;
    overflow: hidden;
    position: relative;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/seasonpass_banner.jpg");
    -unity-background-scale-mode: scale-and-crop;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 74, 0.35);
}
/* Velo oscuro para que el título dorado respire sobre el banner */
.season-hero-scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(3, 5, 12, 0.45);
}
.season-hero-content {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 16px;
}
/* Título diseñado (label.png) */
.season-title-art {
    width: 440px;
    max-width: 100%;
    height: 48px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/seasonpass_label.png");
    -unity-background-scale-mode: scale-to-fit;
}
.season-season-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #f0d27a;
    margin-top: 4px;
}
.season-timer-label {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #9aa8c7;
    margin-top: 2px;
    white-space: normal;
}
.season-premium-btn {
    flex-shrink: 0;
    padding: 10px 22px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    color: #1a1400;
    background-color: #c9a84a;
    border-width: 1px;
    border-color: #f0d27a;
    border-radius: 10px;
}
.season-premium-btn:hover { background-color: #f0d27a; }
.season-premium-btn:disabled { opacity: 0.55; }

/* ── Cuerpo: columna fija, SIN scroll vertical. El hijo pista
   (season-track-row) toma el alto sobrante y su contenido se
   escala desde código para que nunca desborde. ── */
.season-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    background-color: transparent;
}

/* ── Progreso: marco ornamental + pista interior para el relleno ── */
.season-progress {
    width: 100%;
    flex-direction: column;
    padding: 10px 20px 2px 20px;
    flex-shrink: 0;
    background-color: #0a1226;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 74, 0.16);
}
/* ── Nudo sobre la barra: la línea continua pasa por el medallón ── */
.season-node {
    width: 100%;
    height: 128px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}
/* Media-línea a cada lado del medallón: entre columnas se tocan y la
   barra queda continua pasando por todos los niveles */
.season-node-line {
    flex-grow: 1;
    min-width: 0;
    height: 6px;
    background-color: rgba(122, 138, 176, 0.35);
    border-radius: 3px;
}
.season-node-line-done { background-color: #e8a33d; }
.season-node-line-hidden { visibility: hidden; }
/* Tick vertical: une cada carta con la barra, centrado en la columna */
.season-tick {
    width: 3px;
    height: 22px;
    flex-shrink: 0;
    align-self: center;
    background-color: rgba(122, 138, 176, 0.45);
    border-radius: 2px;
}
.season-tick-done { background-color: #e8a33d; }
.season-legend {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
    padding-bottom: 8px;
}
.season-legend-item { flex-direction: row; align-items: center; margin-right: 16px; flex-shrink: 0; }
.season-dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 6px; flex-shrink: 0; }
.season-dot-basic { background-color: #7a8ab0; border-width: 1px; border-color: #aab6d0; }
.season-dot-premium { background-color: #c9a84a; border-width: 1px; border-color: #f0d27a; }
/* Banners de vía (estilo Clash: barra grande por fila). El libre en acero
   con el peón va sobre la fila gratuita; el real en dorado con el rey,
   bajo la fila premium. Ancho completo del viewport, no scrollean con
   la pista. */
.season-side-banner {
    flex-direction: row;
    align-items: center;
    height: 48px;
    flex-shrink: 0;
    margin: 6px 16px 4px 16px;
    padding: 0 14px 0 8px;
    border-width: 1px;
    border-radius: 10px;
    overflow: hidden;
}
.season-side-libre {
    background-color: rgba(26, 36, 56, 0.92);
    border-color: rgba(122, 138, 176, 0.65);
    border-left-width: 5px;
    border-left-color: #7a8ab0;
}
.season-side-real {
    background-color: rgba(36, 26, 6, 0.94);
    border-color: #c9a84a;
    border-left-width: 5px;
    border-left-color: #f0d27a;
    margin: 4px 16px 8px 16px;
}
.season-side-icon { width: 38px; height: 34px; flex-shrink: 0; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; }
.season-side-icon-libre { background-image: url("project://database/Assets/Resources/UI/SeasonPass/icon_gambito_libre.png"); }
.season-side-icon-real { background-image: url("project://database/Assets/Resources/UI/SeasonPass/icon_gambito_real.png"); }
.season-side-title {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    flex-shrink: 0;
    white-space: nowrap;
}
.season-side-title-libre { color: #c7d2e8; }
.season-side-title-real { color: #ffe9a8; }
.season-side-hint {
    font-size: 10px;
    letter-spacing: 1px;
    color: #5a6a85;
    margin-left: auto;
    padding-left: 12px;
    -unity-text-align: middle-right;
    white-space: normal;
    flex-shrink: 1;
}
.season-side-real .season-side-hint { color: rgba(240, 210, 122, 0.6); }
.season-legend-text { font-size: 10px; -unity-font-style: bold; letter-spacing: 1.6px; color: #9aa8c7; }
.season-legend-hint { font-size: 9px; letter-spacing: 1px; color: #5a6a85; margin-left: auto; }

/* ── Pista de niveles: carril horizontal ÚNICO (sin scroll vertical).
   50 columnas no caben en pantalla: el ScrollView horizontal es la
   navegación y las flechas lo aceleran. La fila ocupa el alto
   sobrante del cuerpo y estira el ScrollView para que el viewport
   sea exactamente el hueco disponible (FitTrack lo mide). */
.season-track-row {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}
/* Ocupa el hueco que dejan las flechas. `flex-basis: 0` es imprescindible:
   con `auto` el ScrollView pediría su ancho de contenido (50 columnas) y
   reventaría la fila. */
.season-track-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}
/* ── Scroll del carril ──
   Sigue siendo el Scroller nativo (mismos gestos: arrastrar el pulgar,
   clic en la pista, rueda, teclado) pero con la paleta del pase: barra
   de 14px (8px de pista) oscura y redondeada con pulgar dorado. Las
   flechas laterales desaparecen porque las da el par ← → de la fila,
   que es más grande y más claro. Selectores internos de UI Toolkit
   (ScrollView/Scroller/BaseSlider) con especificidad 0-2-0 para ganar
   al tema por defecto; se pinta el contenedor, no el interior, para
   que el resultado no dependa de cómo monte Unity el Scroller. */
.season-track-scroll .unity-scroller,
.season-track-scroll .unity-scroller--horizontal {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}
.season-track-scroll .unity-scroll-view__horizontal-scroller {
    height: 14px;
    min-height: 14px;
    max-height: 14px;
    padding: 2px 6px;
    background-color: rgba(6, 10, 22, 0.92);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.3);
    border-radius: 7px;
    overflow: hidden;
}
.season-track-scroll .unity-scroller__low-button,
.season-track-scroll .unity-scroller__high-button { display: none; }
.season-track-scroll .unity-scroller__slider,
.season-track-scroll .unity-base-slider__tracker,
.season-track-scroll .unity-base-slider__drag-container {
    background-color: transparent;
    border-width: 0;
    margin: 0;
}
.season-track-scroll .unity-base-slider__dragger-border { display: none; }
.season-track-scroll .unity-base-slider__dragger {
    background-color: #c9a84a;
    border-width: 0;
    border-radius: 4px;
    min-width: 56px;
}
.season-track-scroll .unity-base-slider__dragger:hover { background-color: #f0d27a; }
.season-track-nav {
    width: 42px;
    height: 42px;
    align-self: center;
    flex-shrink: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #f0d27a;
    background-color: rgba(201, 168, 74, 0.16);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.55);
    border-radius: 21px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.18s;
}
.season-track-nav:hover { background-color: rgba(201, 168, 74, 0.32); color: #ffe9a8; }
.season-track-nav:active { background-color: rgba(201, 168, 74, 0.45); }
.season-track-nav-prev { margin-left: 12px; }
.season-track-nav-next { margin-right: 12px; margin-left: 0; }
/* El padding vertical es el valor de diseño (k = 1): FitTrack lo
   multiplica por la escala para que la pista quepa siempre. */
.season-track {
    flex-direction: row;
    align-items: stretch;
    padding: 18px 16px 22px 16px;
}
.season-tier {
    width: 330px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
/* Medallón del nivel con su corona (tier.png) */
.season-medal {
    width: 128px;
    height: 128px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/seasonpass_tier.png");
    -unity-background-scale-mode: scale-to-fit;
}
.season-medal-num {
    /* Centro del vidrio ≈57% del PNG (corona arriba): relleno absoluto
       total + desplazamiento fijo (sobre el centro geométrico del
       medallón). Sin `translate` (frágil entre versiones de UIToolkit) y
       con ancho total para un centrado horizontal real. */
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin-top: 18px;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: #f0d27a;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
}
.season-medal-check {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 28px;
    height: 28px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #06130b;
    background-color: #34d399;
    border-radius: 14px;
    border-width: 1px;
    border-color: #a7f3d0;
}
.season-tier-locked .season-medal { opacity: 0.55; }
.season-tier-locked .season-medal-num { color: #7a8ab0; }
.season-tier-unlocked .season-medal-num { color: #ffe9a8; }

/* ── Cartas de recompensa sobre los slots: caja cerrada ──
   300×276 es la medida de diseño (k = 1) y FitTrack escala ancho y alto
   manteniendo la proporción. El relleno NO es decorativo: es la ventana
   segura de cada marco, medida píxel a píxel sobre los PNG (la corona
   arriba, el remate abajo y los bordes laterales del oro). Si el
   contenido entra en ese rectángulo, no se monta sobre la filigrana.
   Básico: ventana y≈5.8%..96% / x≈3.4%..96.6% → 16/25 y 24/24.
   Real:   ventana y≈20.2%..90.7% / x≈9.6%..90.8% → 56/26 y 35/35. */
.season-reward {
    width: 300px;
    height: 276px;
    margin-top: 14px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 16px 24px 25px 24px;
}
.season-reward-basic {
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/reward_slot_basic.png");
    -unity-background-scale-mode: scale-to-fit;
}
.season-reward-premium {
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/reward_slot_premium.png");
    -unity-background-scale-mode: scale-to-fit;
    /* Corona arriba (hasta el 20%) y barra dorada abajo (desde el 91%):
       la pila empieza en flex-start justo bajo la corona y la píldora
       termina sobre la barra. FitTrack reescribe estos rellenos con la
       escala vigente; los de aquí son el valor a k = 1. */
    padding-top: 56px;
    padding-bottom: 26px;
    padding-left: 35px;
    padding-right: 35px;
    justify-content: flex-start;
}
.season-reward-premium .season-reward-icon { font-size: 26px; height: 36px; min-height: 24px; flex-grow: 1; flex-shrink: 1; }
.season-reward-premium .season-reward-name { font-size: 13px; height: 20px; letter-spacing: 1px; }
.season-reward-premium .season-reward-amount { font-size: 20px; height: 24px; }
.season-reward-premium .season-claim { height: 26px; font-size: 11px; margin-top: 4px; }
/* Emoji grande cuando la categoría no trae miniatura. Crece con el hueco
   sobrante igual que el arte, para que nombre y píldora queden siempre
   anclados donde el marco del slot los espera. */
.season-reward-icon {
    font-size: 34px;
    height: 44px;
    min-height: 24px;
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
}
/* Miniatura del objeto regalado. Crece con el hueco que sobra: si el
   nombre es largo el arte cede antes que el texto. */
.season-reward-art {
    width: 100%;
    height: 96px;
    min-height: 20px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}
.season-reward-name {
    font-size: 14px;
    height: 20px;
    width: 100%;
    max-width: 100%;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    color: #9aa8c7;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
}
.season-reward-premium .season-reward-name { color: #f0d27a; }
.season-reward-amount {
    font-size: 21px;
    height: 26px;
    max-width: 100%;
    -unity-font-style: bold;
    color: #ffe9a8;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
}
/* Cuando la recompensa es un objeto, la línea dice categoría/rareza en
   vez de una cifra: se tiñe para que no parezca un precio. El bloque
   premium va después y con la misma especificidad para que gane el tamaño
   de la etiqueta también en la vía real. */
.season-reward-amount-tag {
    font-size: 14px;
    height: 22px;
    letter-spacing: 1.6px;
    color: #7a8ab0;
}
.season-reward-premium .season-reward-amount-tag {
    font-size: 14px;
    height: 22px;
    color: #c9a84a;
}
/* Píldora de cobro: altura fija para no empujar la caja */
.season-claim {
    height: 28px;
    min-height: 0;
    max-width: 100%;
    min-width: 0;
    align-self: center;
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 4px;
    border-radius: 14px;
    border-width: 1px;
}
.season-claim-ready {
    color: #1a1400;
    background-color: #c9a84a;
    border-color: #f0d27a;
}
.season-claim-ready:hover { background-color: #f0d27a; }
.season-claim-done {
    color: #a7f3d0;
    background-color: rgba(52, 211, 153, 0.14);
    border-color: rgba(52, 211, 153, 0.55);
}
.season-claim-locked {
    color: #7a8ab0;
    background-color: rgba(122, 138, 176, 0.10);
    border-color: rgba(122, 138, 176, 0.30);
}
.season-claim-premium {
    color: #f0d27a;
    background-color: rgba(201, 168, 74, 0.12);
    border-color: rgba(201, 168, 74, 0.55);
}
.season-reward-locked { opacity: 0.72; }
.season-reward-claimed .season-reward-icon { opacity: 0.7; }
.season-premium-on { color: #f0d27a; }
.season-footer { flex-shrink: 0; padding: 6px 16px; }

/* ── REWORK reward-tier premium (interior solamente) ──
   El contenedor NO se toca: ni width/height/padding/background del
   .season-reward-premium, ni .season-tier/track/FitTrack. Solo interior:
   velo tras el arte, nombre a 2 líneas con jerarquía por rareza,
   tag como cápsula sutil y acentos de estado en el interior. */
.season-reward-premium .season-reward-art-premium {
    background-color: rgba(3, 5, 12, 0.55);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.35);
}
.season-reward-premium.season-reward-ready .season-reward-art-premium { border-color: rgba(240, 210, 122, 0.9); }
.season-reward-premium.season-reward-claimed .season-reward-art-premium { opacity: 0.85; }
.season-reward-premium.season-reward-claimed .season-reward-icon { opacity: 0.7; }
.season-reward-premium .season-reward-name {
    font-size: 12px;
    height: 30px;
    letter-spacing: 0.8px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.season-reward-premium .season-name-gambits { color: #f0d27a; }
.season-reward-premium .season-name-reroll { color: #9aa8c7; }
.season-reward-premium .season-name-variant { color: #d9b8ff; }
.season-reward-premium .season-name-animation { color: #ffb066; }
.season-reward-premium .season-name-deco { color: #8fa3c7; }
.season-reward-premium .season-rarity-common { color: #9ea6b3; }
.season-reward-premium .season-rarity-uncommon { color: #33d699; }
.season-reward-premium .season-rarity-rare { color: #59a6ff; }
.season-reward-premium .season-rarity-epic { color: #bf61f2; }
.season-reward-premium .season-rarity-legendary { color: #ffc733; }
.season-reward-premium .season-rarity-mythic { color: #ff4d47; }
.season-reward-premium .season-reward-amount-tag {
    font-size: 11px;
    color: #e8cf8a;
    background-color: rgba(201, 168, 74, 0.12);
    border-radius: 11px;
    padding-left: 10px;
    padding-right: 10px;
}
.season-reward-premium .season-reward-icon { color: #ffe9a8; }

/* ── Icono Gambits (moneda-corona sin fondo) ──
   Reemplaza al emoji ♔ en UXML estáticos y filas generadas por código.
   .gambits-icon: VisualElements fijos del UXML con tamaño por contexto.
   .gambits-inline-row: filas icono + texto de GambitIcon.Row(). */
.gambits-icon {
    background-image: url("project://database/Assets/Resources/UI/gambits_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}
.shop2-chip-icon.gambits-icon { width: 20px; height: 20px; }
.shop2-balance-glyph.gambits-icon { width: 18px; height: 18px; }
.btn-progress-icon.gambits-icon { width: 22px; height: 22px; }
.gambit-toast-icon.gambits-icon { width: 18px; height: 18px; }
.gambits-inline-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.prog-mission-texts .gambits-inline-row { justify-content: flex-start; }
.prog-source .gambits-inline-row { justify-content: flex-end; }

/* ══════════════════════════════════════════════════════════════
   MODAL DE COMPRA — Gambito Libre vs Gambito Real
   Se superpone al pase (SeasonPassModal): dos banners con el hr
   ornamental en medio, precio en Tides que pinta el código con el
   valor que devuelve el servidor y pie con la sesión de Surface.
   ══════════════════════════════════════════════════════════════ */
.season-buy {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(3, 5, 12, 0.94);
    justify-content: center;
    align-items: center;
    padding: 16px;
    transition-property: opacity;
    transition-duration: 0.22s;
}
.season-buy-window {
    width: 94%;
    max-width: 900px;
    max-height: 96%;
    flex-direction: column;
    background-color: #070b18;
    border-width: 1.5px;
    border-color: #c9a84a;
    border-radius: 22px;
    overflow: hidden;
}

/* ── Cabecera ── */
.season-buy-head {
    flex-direction: row;
    align-items: center;
    padding: 14px 18px;
    background-color: #0c152b;
    border-bottom-width: 1.5px;
    border-bottom-color: rgba(201, 168, 74, 0.35);
    flex-shrink: 0;
}
.season-buy-head-texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.season-buy-kicker {
    font-size: 10px;
    letter-spacing: 3px;
    color: #7a8ab0;
}
.season-buy-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: #f0d27a;
    margin-top: 2px;
}
.season-buy-close {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.35);
    border-radius: 10px;
    color: #c9a84a;
    font-size: 15px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.18s;
}
.season-buy-close:hover {
    background-color: rgba(201, 168, 74, 0.14);
    border-color: #f0d27a;
    color: #ffe9a8;
}

/* ── Cuerpo: los dos banners + hr ── */
.season-buy-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 4px 0;
    overflow: hidden;
}
.season-buy-banner {
    margin: 12px 20px;
    padding: 14px 16px;
    border-width: 1px;
    border-radius: 14px;
}
.season-buy-banner-libre {
    background-color: rgba(20, 30, 50, 0.92);
    border-color: rgba(122, 138, 176, 0.55);
    border-left-width: 5px;
    border-left-color: #7a8ab0;
}
.season-buy-banner-real {
    background-color: rgba(44, 33, 8, 0.94);
    border-color: #c9a84a;
    border-left-width: 5px;
    border-left-color: #f0d27a;
}
.season-buy-banner-top {
    flex-direction: row;
    align-items: center;
}
.season-buy-icon {
    width: 48px;
    height: 44px;
    flex-shrink: 0;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}
.season-buy-banner-names {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}
.season-buy-banner-title {
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}
.season-buy-banner-libre .season-buy-banner-title { color: #c7d2e8; }
.season-buy-banner-real .season-buy-banner-title { color: #ffe9a8; }
.season-buy-banner-sub {
    font-size: 11px;
    letter-spacing: 1.2px;
    color: #9aa8c7;
    margin-top: 2px;
}
.season-buy-banner-real .season-buy-banner-sub { color: rgba(240, 210, 122, 0.75); }
.season-buy-tag {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: 5px 11px;
    border-radius: 11px;
    border-width: 1px;
    flex-shrink: 0;
    margin-left: 10px;
}
.season-buy-tag-libre {
    color: #c7d2e8;
    background-color: rgba(122, 138, 176, 0.14);
    border-color: rgba(122, 138, 176, 0.6);
}
.season-buy-tag-real {
    color: #ffe9a8;
    background-color: rgba(201, 168, 74, 0.18);
    border-color: #f0d27a;
}
.season-buy-banner-text {
    font-size: 12px;
    color: #aab6d0;
    margin-top: 10px;
    white-space: normal;
}
.season-buy-banner-real .season-buy-banner-text { color: rgba(255, 233, 168, 0.78); }

/* ── HR ornamental: línea + rombo + línea ── */
.season-buy-hr {
    flex-direction: row;
    align-items: center;
    margin: 2px 40px;
}
.season-buy-hr-line {
    flex-grow: 1;
    min-width: 0;
    height: 1px;
    background-color: rgba(201, 168, 74, 0.5);
}
.season-buy-hr-gem {
    font-size: 13px;
    color: #f0d27a;
    margin: 0 14px;
    -unity-text-align: middle-center;
}

/* ── Precio + CTA ── */
.season-buy-buyrow {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
}
.season-buy-pricebox { flex-direction: column; flex-shrink: 0; }
.season-buy-pricelabel {
    font-size: 9px;
    letter-spacing: 1.8px;
    color: rgba(240, 210, 122, 0.65);
}
.season-buy-price {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-top: 4px;
}
.season-buy-price-libre {
    font-size: 17px;
    color: #9aa8c7;
    margin-top: 8px;
}
.season-buy-price-real { color: #f0d27a; }
.season-buy-confirm {
    flex-shrink: 0;
    margin-left: 14px;
    padding: 13px 26px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    color: #1a1400;
    background-color: #c9a84a;
    border-width: 1px;
    border-color: #f0d27a;
    border-radius: 12px;
    transition-property: background-color, scale;
    transition-duration: 0.18s;
}
.season-buy-confirm:hover { background-color: #f0d27a; scale: 1.02 1.02; }
.season-buy-confirm:disabled { opacity: 0.55; }

/* ── Pie: sesión, saldo y error ── */
.season-buy-foot {
    flex-shrink: 0;
    padding: 12px 20px 16px 20px;
    background-color: #0a1226;
    border-top-width: 1px;
    border-top-color: rgba(201, 168, 74, 0.25);
}
.season-buy-account {
    flex-direction: row;
    align-items: center;
}
.season-buy-account-dot {
    font-size: 14px;
    margin-right: 8px;
    flex-shrink: 0;
}
.season-buy-account-text {
    font-size: 11px;
    color: #9aa8c7;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}
.season-buy-balance {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f0d27a;
    margin-left: 12px;
    flex-shrink: 0;
}
.season-buy-login {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}
.season-buy-input {
    flex-grow: 1;
    flex-basis: 120px;
    height: 34px;
    margin-right: 8px;
}
.season-buy-input > .unity-base-field__input {
    height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    color: #c7d2e8;
    background-color: #070b18;
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.4);
    border-radius: 8px;
}
.season-buy-input > .unity-base-field__input:focus {
    border-color: #c9a84a;
    background-color: #0a1024;
}
.season-buy-login-btn {
    height: 34px;
    flex-shrink: 0;
    padding: 0 20px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    color: #ffe9a8;
    background-color: rgba(201, 168, 74, 0.16);
    border-width: 1px;
    border-color: #c9a84a;
    border-radius: 8px;
    transition-property: background-color;
    transition-duration: 0.18s;
}
.season-buy-login-btn:hover { background-color: rgba(201, 168, 74, 0.32); }
.season-buy-login-btn:disabled { opacity: 0.55; }
.season-buy-error {
    font-size: 11px;
    color: #ff9a8a;
    margin-top: 8px;
    white-space: normal;
}

/* ══════════════════════════════════════════════════════════
   PASE DE HALLOWEEN — pantalla completa real (sin ventana flotante),
   misma receta que el pase de temporada: raíz a sangre sin acolchado
   y ventana al 100%, sin radio ni borde. El cuerpo de escritorio es
   una columna fija sin scroll vertical (la pista se mide y se escala
   para caber, HalloweenPassModal.FitTrack); el banner y el pie se
   quedan fijos arriba y abajo. Tono púrpura/violeta para que no se
   confunda con la estación en curso.
   ══════════════════════════════════════════════════════════ */
/* Raíz a sangre: sin acolchado ni ventana flotante; fondo opaco */
.halloween-root {
    padding: 0;
    background-color: #06030e;
}
.halloween-window {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border-radius: 0;
    border-width: 0;
    overflow: hidden;
}
.halloween-topbar { flex-wrap: wrap; padding: 8px 14px; }

/* ── Hero: banner + título + estado, con la estructura del pase de
   temporada. En vivo el cuerpo manda: el hero baja a 120px y el banner
   16:9 (2752×1536) recorta con scale-and-crop por arriba y por abajo.
   El resto lo comparten topbar, cuerpo y pie. ── */
.halloween-hero {
    height: 120px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: 10px 16px;
    position: relative;
    overflow: hidden;
    border-bottom-width: 1px;
    border-bottom-color: rgba(126, 60, 168, 0.55);
}
.halloween-banner-art {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/halloweenpass_banner.jpg");
    -unity-background-scale-mode: scale-and-crop;
}
/* Velo: oscurece el banner para que el título y el estado se lean */
.halloween-hero-scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(6, 3, 14, 0.34);
}
.halloween-hero-content {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 16px;
}
/* Título diseñado (label con alfa, recortado) */
.halloween-title-art {
    width: 440px;
    max-width: 100%;
    height: 48px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/halloweenpass_label.png");
    -unity-background-scale-mode: scale-to-fit;
}
/* Estado de la velada, en vivo: cuenta atrás antes del 20/10,
   «¡LA VELADA ESTÁ ABIERTA!» durante el evento y «LAS PUERTAS SE
   CERRARON» después. */
.halloween-hero-soon {
    margin-top: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #e3caff;
    white-space: normal;
}
.hw-timer {
    margin-top: 2px;
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #9c8bbd;
    white-space: normal;
}

/* ── Cuerpos: en escritorio manda el carril horizontal (columna fija,
      sin scroll vertical: la pista se escala para caber); en móvil
      vertical (.is-portrait, lo pone UiResponsive) manda la lista con
      scroll. El USS muestra uno y esconde el otro. ── */
.halloween-body-scroll { display: none; }
.halloween-body-desk {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}
.is-portrait .halloween-body-desk { display: none; }
.is-portrait .halloween-body-scroll {
    display: flex;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}
.halloween-body {
    flex-grow: 1;
    padding: 18px 24px 6px 24px;
    align-items: center;
}
/* ── Pie: el aviso a la izquierda y el botón a la derecha, con la base
      del pase de temporada (.prog-footer). El botón anula el ancho
      completo y el margen inferior de .shop2-back-btn (.prog-footer-btn). ── */
.halloween-footer {
    flex-shrink: 0;
    padding: 6px 16px;
}

/* ── PASE DE HALLOWEEN — móvil en vertical (.is-portrait)
   El hero crece y apila su contenido, los chips del topbar bajan a su
   propia línea y el camino de niveles pasa a lista vertical con scroll
   (la muestra el USS por la clase; el carril de escritorio se esconde). ── */
.is-portrait .halloween-topbar { padding: 12px 18px; }
.is-portrait .halloween-topbar .shop2-brand { display: none; }
.is-portrait .halloween-topbar .shop2-rail-vault { width: 100%; margin-left: 0; }
.is-portrait .halloween-topbar .shop2-vault-chips { flex-wrap: wrap; justify-content: center; }
.is-portrait .hw-sep { display: none; }
/* En vertical las dos puertas del pase (MISIONES y TIENDA) comparten la fila
   a lo ancho, una al lado de la otra: la tienda ya está viva. */
.is-portrait .hw-topbar-actions {
    width: 100%;
    margin-left: 0;
    margin-top: 8px;
}
.is-portrait .hw-missions-btn,
.is-portrait .hw-shop-btn {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    width: auto;
    margin-left: 0;
    height: 44px;
    font-size: 15px;
    letter-spacing: 3px;
    border-radius: 12px;
}
.is-portrait .hw-topbar-actions .hw-shop-btn { margin-left: 10px; }
.is-portrait .halloween-topbar .shop2-chip {
    min-height: 0;
    margin: 4px;
    padding: 8px 14px 8px 10px;
    border-radius: 16px;
}
.is-portrait .halloween-topbar .shop2-chip-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 10px;
}
.is-portrait .halloween-topbar .shop2-chip-icon { font-size: 26px; }
.is-portrait .halloween-topbar .shop2-chip-amount { font-size: 21px; }
.is-portrait .halloween-topbar .shop2-chip-label { font-size: 13px; letter-spacing: 1.4px; }
.is-portrait .hw-state-chip {
    margin: 4px;
    padding: 9px 18px;
    font-size: 14px;
    letter-spacing: 2px;
    border-radius: 16px;
}
.is-portrait .halloween-hero {
    height: auto;
    min-height: 340px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
    padding: 26px 24px 24px 24px;
}
.is-portrait .halloween-hero-content { flex-grow: 0; margin-right: 0; align-items: flex-start; }
.is-portrait .halloween-title-art { width: 100%; height: 104px; }
.is-portrait .halloween-hero-soon { font-size: 22px; letter-spacing: 3px; margin-top: 12px; }
.is-portrait .hw-timer { font-size: 17px; letter-spacing: 1.2px; margin-top: 6px; }
.is-portrait .halloween-body { padding: 14px 18px 6px 18px; }
.is-portrait .halloween-footer {
    flex-direction: column;
    align-items: stretch;
    padding: 14px 24px 22px 24px;
}
.is-portrait .halloween-footer .prog-footer-note {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 14px;
}
.is-portrait .halloween-footer .prog-footer-btn {
    width: 100%;
    min-width: 0;
    height: 76px;
    font-size: 24px;
    letter-spacing: 2px;
    border-radius: 14px;
}

/* ══════════════════════════════════════════════════════════
   PASE DE HALLOWEEN — cuerpo en vivo (velada 20/10 → 2/11)
   Escritorio: chips, misiones y carril HORIZONTAL con las dos
   vías (columna = carta Luna arriba, medallón sobre la línea al
   medio y carta Sangre abajo), con flechas y escala para caber.
   Móvil en vertical: la misma lista, en vertical y con scroll
   (medallón + carta Luna + carta Sangre por fila).
   ══════════════════════════════════════════════════════════ */
/* El topbar de la velada agrupa la fila de paneles a la IZQUIERDA: la
   marca se queda con su ancho natural y el conjunto NIVEL │ XP │ DULCES │
   estado se pega tras ella (las líneas .hw-sep ordenan la fila). El ancho
   restante queda libre para las acciones MISIONES / TIENDA, que cierran
   el topbar a la derecha. */
.halloween-topbar .shop2-rail-header { flex-grow: 0; }
.halloween-topbar .shop2-rail-vault {
    flex-grow: 1;
    min-width: 0;
    margin-left: 24px;
}
.hw-chips {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    flex-grow: 1;
    min-width: 0;
}
/* Línea separadora entre paneles del topbar: filete violeta de la velada
   (a tono con .hw-section-line), alto medio y centrada en la fila. */
.hw-sep {
    width: 1px;
    height: 48px;
    flex-shrink: 0;
    align-self: center;
    margin-left: 16px;
    margin-right: 16px;
    background-color: rgba(126, 60, 168, 0.5);
}
/* Acciones del topbar (MISIONES + TIENDA), ancladas a la derecha.
   MISIONES abre el modal del tablero de misiones; nace con el contador de
   cobros pendientes (HalloweenPassModal.RefreshMissionsButton). */
.hw-topbar-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 18px;
}
.hw-topbar-actions .hw-shop-btn { margin-left: 8px; }
.hw-missions-btn {
    flex-shrink: 0;
    align-self: center;
    margin-left: 0;
    height: 36px;
    padding: 0 16px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    color: #e3caff;
    background-color: rgba(126, 60, 168, 0.22);
    border-width: 1px;
    border-color: rgba(186, 128, 255, 0.5);
    border-radius: 8px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.18s;
}
.hw-missions-btn:hover {
    background-color: rgba(126, 60, 168, 0.38);
    border-color: #ba80ff;
    color: #f6eeff;
}
/* Con cobros pendientes la placa se enciende. */
.hw-missions-btn-ready {
    color: #fff3d6;
    background-color: rgba(201, 168, 74, 0.2);
    border-color: #e8c66a;
}
.hw-missions-btn-ready:hover {
    background-color: rgba(201, 168, 74, 0.34);
    border-color: #ffe09a;
}

/* Botón Tienda del topbar: mismo filete dorado que el VOLVER, compacto y
   anclado a la derecha. Abre la tienda de la velada (Dulces). */
.hw-shop-btn {
    flex-shrink: 0;
    align-self: center;
    margin-left: 18px;
    height: 36px;
    padding: 0 18px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    color: #c9a84a;
    background-color: rgba(201, 168, 74, 0.06);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.35);
    border-radius: 8px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.18s;
}
.hw-shop-btn:hover {
    background-color: rgba(201, 168, 74, 0.12);
    border-color: #c9a84a;
    color: #f0d27a;
}
.hw-shop-btn:disabled { opacity: 0.5; }

/* Los tres paneles del topbar llevan placa sprite (arte en
   Resources/UI/Halloween; canvas 374x180). El 9-slice de esquinas fijas lo
   aplica HalloweenSprites por código; las URLs del USS quedan de respaldo.
   Sin borde, sin radio y sin fondo propio: la placa es la piel del chip y
   el medallón y los textos se pintan encima. */
.halloween-topbar .shop2-chip {
    min-height: 78px;
    margin-right: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}
#hw-chip-nivel { background-image: url("project://database/Assets/Resources/UI/Halloween/chip_nivel.png"); }
#hw-chip-xp { background-image: url("project://database/Assets/Resources/UI/Halloween/chip_xp.png"); }
#hw-chip-dulces { background-image: url("project://database/Assets/Resources/UI/Halloween/chip_dulces.png"); }
.hw-state-chip {
    align-self: center;
    padding: 6px 16px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2.4px;
    color: #f3e6ff;
    background-color: rgba(58, 26, 96, 0.9);
    border-width: 1px;
    border-color: rgba(186, 128, 255, 0.75);
    border-radius: 14px;
}
.hw-section-row {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 8px;
}
.hw-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #e3caff;
    flex-shrink: 0;
}
.hw-section-line {
    flex-grow: 1;
    height: 1px;
    margin-left: 12px;
    background-color: rgba(126, 60, 168, 0.45);
}
/* Nota de la sección de misiones (escritorio): completadas y próxima tanda */
.hw-section-note {
    flex-shrink: 0;
    margin-left: 12px;
    font-size: 10px;
    letter-spacing: 1px;
    color: #a293c4;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

/* ── Misiones de la velada: fichas de resumen ──
   El detalle vive en el modal de misiones (VIEW 10); en el pase queda el
   estado de un vistazo en tres fichas —Luna, Sangre libre y Sangre
   premium— que abren el modal al tocarlas. */
.hw-missions {
    flex-direction: row;
    flex-wrap: wrap;
}
.hw-msum {
    flex-grow: 1;
    flex-basis: 300px;
    min-width: 240px;
    margin: 4px;
    padding: 8px 12px;
    background-color: rgba(28, 14, 48, 0.85);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.5);
    border-left-width: 4px;
    border-radius: 12px;
    transition-property: background-color, border-color;
    transition-duration: 0.16s;
}
.hw-msum:hover {
    background-color: rgba(46, 24, 76, 0.95);
    border-color: rgba(186, 128, 255, 0.8);
}
.hw-msum-luna { border-left-color: #8fa8dd; }
.hw-msum-sangre { border-left-color: #e0a17c; }
.hw-msum-premium { border-left-color: #b03a5e; }
.hw-msum-head {
    flex-direction: row;
    align-items: center;
}
.hw-msum-icon {
    font-size: 18px;
    margin-right: 8px;
    flex-shrink: 0;
}
.hw-msum-title {
    flex-grow: 1;
    min-width: 0;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #e3caff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.hw-msum-count {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #f6eeff;
}
.hw-msum-bar {
    height: 4px;
    margin-top: 6px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}
.hw-msum-fill {
    height: 4px;
    border-radius: 2px;
    background-color: #b98cf0;
}
.hw-msum-luna .hw-msum-fill { background-color: #8fa8dd; }
.hw-msum-sangre .hw-msum-fill { background-color: #e0a17c; }
.hw-msum-premium .hw-msum-fill { background-color: #d68254; }
.hw-msum-note {
    margin-top: 5px;
    font-size: 9px;
    letter-spacing: 1.1px;
    color: #a293c4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.hw-msum-note-ready {
    color: #ffd27a;
    -unity-font-style: bold;
}
.hw-mission-note {
    width: 100%;
    margin-top: 6px;
    font-size: 11px;
    color: #a293c4;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── Fichas de misiones, versión de escritorio: una fila de tres,
      compactas para no comerse el alto del carril. ── */
.hw-missions-block {
    flex-shrink: 0;
    padding: 8px 16px 0 16px;
}
.hw-missions-block .hw-section-row { margin-top: 2px; margin-bottom: 6px; }
.halloween-body-desk .hw-missions { flex-wrap: nowrap; }
.halloween-body-desk .hw-msum {
    flex-basis: 0;
    min-width: 0;
    margin: 0 4px;
    padding: 6px 10px;
}
.halloween-body-desk .hw-msum-title { font-size: 10px; letter-spacing: 1.4px; }
.halloween-body-desk .hw-msum-icon { font-size: 16px; margin-right: 6px; }
.halloween-body-desk .hw-msum-note { font-size: 8px; letter-spacing: 0.9px; }

/* ── Banners de vía: el de Luna va sobre la fila gratuita y el de Sangre
      bajo la fila premium; ancho completo del viewport, no scrollean con
      el carril. ── */
.hw-lane-banner {
    flex-direction: row;
    align-items: center;
    height: 48px;
    flex-shrink: 0;
    margin: 6px 16px 2px 16px;
    padding: 0 14px 0 12px;
    border-width: 1px;
    border-radius: 10px;
    overflow: hidden;
}
.hw-lane-banner-free {
    background-color: rgba(22, 28, 52, 0.92);
    border-color: rgba(126, 150, 220, 0.55);
    border-left-width: 5px;
    border-left-color: #8fa8dd;
}
.hw-lane-banner-sangre {
    background-color: rgba(48, 22, 32, 0.94);
    border-color: rgba(214, 130, 84, 0.7);
    border-left-width: 5px;
    border-left-color: #e0a17c;
    margin: 2px 16px 8px 16px;
}
.hw-lane-icon { font-size: 22px; flex-shrink: 0; margin-right: 10px; }
.hw-lane-title {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    flex-shrink: 0;
    white-space: nowrap;
}
.hw-lane-title-free { color: #c7d2e8; }
.hw-lane-title-sangre { color: #f3d3bd; }
.hw-lane-hint {
    font-size: 10px;
    letter-spacing: 1px;
    color: #6f7ba0;
    margin-left: auto;
    padding-left: 12px;
    -unity-text-align: middle-right;
    white-space: normal;
    flex-shrink: 1;
}
.hw-lane-banner-sangre .hw-lane-hint { color: rgba(224, 161, 124, 0.75); }

/* ── Carril horizontal (escritorio) ── */
.hw-track-row {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}
/* Ocupa el hueco que dejan las flechas. `flex-basis: 0` es imprescindible:
   con `auto` el ScrollView pediría su ancho de contenido (30 columnas) y
   reventaría la fila. */
.hw-track-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}
/* ── Scroll del carril ──
   Sigue siendo el Scroller nativo (mismos gestos: arrastrar el pulgar,
   clic en la pista, rueda, teclado) pero con la paleta de la velada: barra
   de 14px (8px de pista) oscura y redondeada con pulgar violeta. Las
   flechas laterales desaparecen porque las da el par ← → de la fila. */
.hw-track-scroll .unity-scroller,
.hw-track-scroll .unity-scroller--horizontal {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}
.hw-track-scroll .unity-scroll-view__horizontal-scroller {
    height: 14px;
    min-height: 14px;
    max-height: 14px;
    padding: 2px 6px;
    background-color: rgba(6, 10, 22, 0.92);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.3);
    border-radius: 7px;
    overflow: hidden;
}
.hw-track-scroll .unity-scroller__low-button,
.hw-track-scroll .unity-scroller__high-button { display: none; }
.hw-track-scroll .unity-scroller__slider,
.hw-track-scroll .unity-base-slider__tracker,
.hw-track-scroll .unity-base-slider__drag-container {
    background-color: transparent;
    border-width: 0;
    margin: 0;
}
.hw-track-scroll .unity-base-slider__dragger-border { display: none; }
.hw-track-scroll .unity-base-slider__dragger {
    background-color: #8e5cc9;
    border-width: 0;
    border-radius: 4px;
    min-width: 56px;
}
.hw-track-scroll .unity-base-slider__dragger:hover { background-color: #ba80ff; }
.hw-track-nav {
    width: 42px;
    height: 42px;
    align-self: center;
    flex-shrink: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #cbb6ec;
    background-color: rgba(126, 60, 168, 0.18);
    border-width: 1px;
    border-color: rgba(186, 128, 255, 0.5);
    border-radius: 21px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.18s;
}
.hw-track-nav:hover { background-color: rgba(126, 60, 168, 0.35); color: #f3e6ff; }
.hw-track-nav:active { background-color: rgba(126, 60, 168, 0.5); }
.hw-track-nav-prev { margin-left: 12px; }
.hw-track-nav-next { margin-right: 12px; margin-left: 0; }
/* El padding vertical es el valor de diseño (k = 1): FitTrack lo
   multiplica por la escala para que el carril quepa siempre. */
.hw-track-h { flex-direction: row; align-items: stretch; padding: 16px; }
.hw-col {
    width: 292px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
/* Tick vertical: une cada carta con la barra, centrado en la columna */
.hw-tick {
    width: 3px;
    height: 18px;
    flex-shrink: 0;
    align-self: center;
    background-color: rgba(122, 138, 176, 0.45);
    border-radius: 2px;
}
.hw-tick-done { background-color: #ba80ff; }
/* Nudo sobre la barra: la línea continua pasa por el medallón */
.hw-node {
    width: 100%;
    height: 112px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}
/* Media-línea a cada lado del medallón: entre columnas se tocan y la
   barra queda continua pasando por todos los niveles */
.hw-node-line {
    flex-grow: 1;
    min-width: 0;
    height: 5px;
    background-color: rgba(122, 138, 176, 0.3);
    border-radius: 3px;
}
.hw-node-line-done { background-color: #ba80ff; }
.hw-node-line-hidden { visibility: hidden; }
/* Medallón grande del carril (FitTrack fija el tamaño): mismo sprite que el
   pase de temporada; la corona sube por encima del vidrio, así que nada de
   radio ni borde. Sin alcanzar va atenuado, como el nivel bloqueado de T1. */
.hw-medal-lg {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    opacity: 0.62;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/seasonpass_tier.png");
    -unity-background-scale-mode: scale-to-fit;
}
.hw-medal-lg-on { opacity: 1; }
.hw-medal-lg-num {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    /* Centro del vidrio ≈57% (corona arriba): valor a k = 1; FitTrack lo
       reescribe con la escala vigente. */
    margin: 16px 0 0 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: #cbb6ec;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
}
.hw-medal-lg-on .hw-medal-lg-num { color: #f3e6ff; }
.hw-medal-lg-check {
    position: absolute;
    right: 7px;
    bottom: 7px;
    width: 24px;
    height: 24px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #06130b;
    background-color: #34d399;
    border-radius: 12px;
    border-width: 1px;
    border-color: #a7f3d0;
}

/* ── Carta del carril: arte, nombre, valor y cobro. Lleva los mismos marcos
      del pase de temporada (reward_slot_basic/premium.png): conserva su
      proporción 300×276 y el relleno (ventana interior del marco × k) lo
      reescribe FitTrack; aquí va el valor a k = 1. ── */
.hw-rw {
    width: 228px;
    height: 210px;
    margin-top: 10px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 12px 18px 19px 18px;
}
.hw-rw-free {
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/reward_slot_basic.png");
    -unity-background-scale-mode: scale-to-fit;
}
.hw-rw-sangre {
    /* El marco premium trae corona arriba: la pila arranca bajo ella. */
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/reward_slot_premium.png");
    -unity-background-scale-mode: scale-to-fit;
    padding: 43px 27px 20px 27px;
}
.hw-rw-claimed { opacity: 0.55; }
.hw-rw-locked { opacity: 0.8; }
/* Miniatura del objeto regalado; si su categoría no trae arte, cae al emoji */
.hw-rw-art {
    width: 100%;
    height: 70px;
    min-height: 20px;
    flex-shrink: 0;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}
.hw-rw-icon {
    width: 100%;
    height: 70px;
    font-size: 54px;
    flex-shrink: 0;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}
.hw-rw-name {
    width: 100%;
    height: 18px;
    flex-shrink: 0;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    color: #cbb6ec;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.hw-rw-sangre .hw-rw-name { color: #f0cfb6; }
.hw-rw-amount {
    width: 100%;
    height: 20px;
    flex-shrink: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: #c9a84a;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
/* Cuando el regalo es un objeto, la línea dice categoría/rareza en vez de
   una cifra: se tiñe para que no parezca un precio. */
.hw-rw-amount-tag { font-size: 11px; letter-spacing: 1.4px; color: #9aa8c7; }
/* Píldora de cobro del carril (misma paleta que la del móvil y los
   mismos resets que .season-claim: el tema del botón no la descuadra) */
.hw-claim {
    height: 26px;
    min-height: 0;
    min-width: 0;
    max-width: 100%;
    align-self: center;
    flex-shrink: 0;
    margin-top: 4px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-radius: 13px;
    border-width: 1px;
}
.hw-claim.hw-pill-done {
    color: #9fd6a8;
    border-color: rgba(114, 196, 128, 0.6);
    background-color: rgba(24, 60, 34, 0.55);
}
.hw-claim.hw-pill-locked {
    color: #a293c4;
    border-color: rgba(126, 60, 168, 0.45);
    background-color: rgba(24, 13, 42, 0.7);
}
.hw-claim.hw-pill-ready {
    color: #1a0f2e;
    border-color: #d9b6ff;
    background-color: #b98cf0;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.hw-claim.hw-pill-ready:hover { background-color: #d9b6ff; }

/* ── Pista del móvil: una fila por nivel ── */
.hw-track-v { width: 100%; }
.hw-row {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}
/* Mismo medallón que el carril (y que el pase de temporada): la corona manda,
   así que sin radio ni borde; sin alcanzar va atenuado. */
.hw-medal {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    position: relative;
    opacity: 0.75;
    background-image: url("project://database/Assets/Resources/UI/SeasonPass/seasonpass_tier.png");
    -unity-background-scale-mode: scale-to-fit;
}
.hw-medal-on { opacity: 1; }
.hw-medal-num {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    /* Centro del vidrio ≈57% (corona arriba), proporcional al medallón. */
    margin: 6px 0 0 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: #cbb6ec;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
}
.hw-medal-on .hw-medal-num { color: #f3e6ff; }

/* ── Cartas de recompensa: una por vía ── */
.hw-card {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 320px;
    min-width: 250px;
    margin-left: 8px;
    padding: 8px 10px;
    border-width: 1px;
    border-radius: 12px;
    background-color: rgba(24, 13, 42, 0.85);
}
.hw-card-free { border-color: rgba(126, 150, 220, 0.45); }
.hw-card-sangre { border-color: rgba(214, 130, 84, 0.45); }
.hw-card-ready {
    background-color: rgba(44, 22, 74, 0.92);
    border-color: rgba(186, 128, 255, 0.8);
}
.hw-card-claimed { opacity: 0.6; }
.hw-card-locked { opacity: 0.78; }
.hw-card-art {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}
.hw-card-icon {
    width: 34px;
    flex-shrink: 0;
    margin-right: 10px;
    font-size: 22px;
    -unity-text-align: middle-center;
}
.hw-card-info { flex-grow: 1; min-width: 0; }
.hw-card-lane {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.8px;
}
.hw-lane-free { color: #8fa8dd; }
.hw-lane-sangre { color: #e0a17c; }
.hw-card-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f3e6ff;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.hw-card-amount {
    font-size: 11px;
    -unity-font-style: bold;
    color: #c9a84a;
    margin-top: 2px;
}
.hw-pill {
    flex-shrink: 0;
    margin-left: 10px;
    padding: 5px 12px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
    border-radius: 9px;
    border-width: 1px;
}
.hw-pill-done {
    color: #9fd6a8;
    border-color: rgba(114, 196, 128, 0.6);
    background-color: rgba(24, 60, 34, 0.55);
}
.hw-pill-locked {
    color: #a293c4;
    border-color: rgba(126, 60, 168, 0.45);
    background-color: rgba(24, 13, 42, 0.7);
}
.hw-pill-ready {
    color: #1a0f2e;
    border-color: #d9b6ff;
    background-color: #b98cf0;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.hw-pill-ready:hover { background-color: #d9b6ff; }
/* Botón de la Vía Sangre: vive en el hero y usa la base dorada del pase de
   temporada, pero con la paleta de sangre de la velada. */
.hw-sangre-btn {
    flex-shrink: 0;
    padding: 12px 26px;
    font-size: 13px;
    letter-spacing: 1.4px;
    color: #ffeaf0;
    background-color: #8c2f4c;
    border-color: #d68254;
}
.hw-sangre-btn:hover { background-color: #b03a5e; }

/* Cintillo del menú por estado (MainMenuController lo reescribe) */
.menu-halloweenpass-soon.soon-active {
    color: #1a0f2e;
    background-color: #f0b95c;
    border-color: #ffe09a;
}
.menu-halloweenpass-soon.soon-ended {
    color: #b9a7da;
    background-color: rgba(20, 10, 36, 0.85);
    border-color: rgba(126, 60, 168, 0.5);
}

/* ══════════════════════════════════════════════════════════
   MODAL DE MISIONES DE LA VELADA (VIEW 10)
   Tablero completo que se abre por encima del pase: pestañas
   VÍA LUNA (3 diarias) y VÍA SANGRE (5 libres + 5 premium),
   con barra de progreso y cobro por misión.
   ══════════════════════════════════════════════════════════ */
.hwm-root {
    padding: 0;
    background-color: rgba(6, 3, 14, 0.82);
}
.hwm-window {
    width: 92%;
    max-width: 1180px;
    height: 90%;
    max-height: 820px;
    background-color: #0a0518;
    border-width: 1.5px;
    border-color: rgba(186, 128, 255, 0.55);
}
.hwm-topbar {
    background-color: #12082a;
    border-bottom-color: rgba(126, 60, 168, 0.45);
    padding: 10px 16px;
    flex-wrap: wrap;
}
.hwm-topbar .shop2-rail-header { flex-grow: 1; min-width: 0; }
.hwm-topbar .shop2-brand { min-width: 0; margin-left: 14px; }
.hwm-topbar .shop2-brand-title { font-size: 18px; letter-spacing: 2px; }

/* Chips de progreso (XP de la velada y Dulces), compactos */
.hwm-chips {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-left: auto;
}
.hwm-chip {
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin-left: 6px;
    padding: 0 10px;
    border-width: 1px;
    border-radius: 15px;
    background-color: rgba(24, 12, 44, 0.9);
    border-color: rgba(126, 60, 168, 0.5);
}
.hwm-chip-xp { border-color: rgba(186, 128, 255, 0.55); }
.hwm-chip-dulces { border-color: rgba(224, 161, 124, 0.55); }
.hwm-chip-icon {
    font-size: 13px;
    margin-right: 6px;
}
.hwm-chip-text {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: #f6eeff;
}
.hwm-topbar .hw-state-chip {
    margin-left: 8px;
    padding: 5px 12px;
    font-size: 10px;
    letter-spacing: 1.8px;
}

/* Hero: estado de la velada a la izquierda, pestañas a la derecha */
.hwm-hero {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 12px 18px 10px 18px;
    background-color: #0d0620;
    border-bottom-width: 1px;
    border-bottom-color: rgba(126, 60, 168, 0.32);
}
.hwm-hero-texts {
    flex-grow: 1;
    min-width: 0;
    margin-right: 16px;
}
.hwm-hero-kicker {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #b98cf0;
}
.hwm-hero-note {
    margin-top: 3px;
    font-size: 13px;
    color: #efe4ff;
    white-space: normal;
}
.hwm-hero-timer {
    margin-top: 2px;
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #8d7cb0;
    white-space: normal;
}
.hwm-tabs {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.hwm-tab {
    height: 34px;
    margin-left: 8px;
    padding: 0 16px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    color: #a293c4;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.35);
    border-radius: 17px;
    transition-property: background-color, border-color, color, opacity;
    transition-duration: 0.16s;
}
.hwm-tab:hover {
    background-color: rgba(126, 60, 168, 0.22);
    color: #e3caff;
}
.hwm-tab-active {
    color: #1a0f2e;
    background-color: #b98cf0;
    border-color: #e0c6ff;
}
.hwm-tab-sangre.hwm-tab-active {
    background-color: #d68254;
    border-color: #ffc9a3;
}

/* Cuerpo con scroll: una pestaña por vez */
.hwm-body-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}
/* Scroll del cuerpo: mismo criterio que la enciclopedia y el carril de la
   velada (Scroller nativo con la paleta oscura; las flechas laterales se
   ocultan porque alcanzan el pulgar, la rueda y el arrastre). Sin esto,
   Unity pinta el scrollbar claro por defecto y rompe el marco. */
.hwm-body-scroll .unity-scroller--vertical {
    width: 10px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}
.hwm-body-scroll .unity-base-slider__tracker {
    background-color: rgba(14, 8, 30, 0.65);
    border-width: 0;
    border-radius: 5px;
}
.hwm-body-scroll .unity-base-slider__dragger {
    background-color: rgba(142, 92, 201, 0.5);
    border-width: 0;
    border-radius: 5px;
}
.hwm-body-scroll .unity-base-slider__dragger:hover {
    background-color: rgba(186, 128, 255, 0.8);
}
.hwm-body-scroll .unity-scroller__low-button,
.hwm-body-scroll .unity-scroller__high-button {
    display: none;
}
/* El cuerpo ocupa todo el ancho útil de la ventana: el modal ya está
   acotado a 1180 y así las tarjetas alinean con el topbar. */
.hwm-body {
    flex-grow: 1;
    width: 100%;
    padding: 18px 22px 24px 22px;
}
.hwm-pane { flex-grow: 1; }
.hwm-pane.hidden { display: none; }
.hwm-section-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    margin-bottom: 0;
}
.hwm-section-title {
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3.2px;
    color: #e3caff;
}
.hwm-section-title-sangre { color: #f3d3bd; }
.hwm-section-line {
    flex-grow: 1;
    height: 1px;
    margin-left: 12px;
    background-color: rgba(126, 60, 168, 0.4);
}
.hwm-section-line-sangre { background-color: rgba(214, 130, 84, 0.4); }
/* La nota vive debajo del filete: explica el bloque sin apretar el renglón. */
.hwm-section-note {
    flex-shrink: 1;
    margin-top: 4px;
    margin-bottom: 2px;
    font-size: 11px;
    letter-spacing: 0.8px;
    color: #b3a4cf;
    -unity-text-align: middle-left;
    white-space: normal;
}
.hwm-section-row-sub { margin-top: 16px; }
.hwm-sub-title {
    flex-shrink: 0;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2.4px;
    color: #c8b3e8;
}
.hwm-sub-title-premium { color: #e0a17c; }

/* Lista y tarjeta de misión */
.hwm-list {
    flex-direction: column;
    margin-top: 8px;
}
.hwm-mission {
    flex-direction: row;
    align-items: center;
    min-height: 76px;
    margin: 4px 0;
    padding: 10px 16px;
    background-color: rgba(24, 13, 42, 0.85);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.35);
    border-left-width: 4px;
    border-left-color: rgba(126, 60, 168, 0.55);
    border-radius: 12px;
    transition-property: background-color, border-color;
    transition-duration: 0.16s;
}
.hwm-mission-luna { border-left-color: #8fa8dd; }
.hwm-mission-sangre { border-left-color: #d68254; }
.hwm-mission-premium { border-left-color: #b03a5e; }
.hwm-mission-ready {
    background-color: rgba(44, 22, 74, 0.95);
    border-color: rgba(186, 128, 255, 0.75);
}
.hwm-mission-claimed { opacity: 0.62; }
/* El emoji viaja en una ficha redonda para dialogar con el ornato del marco
   (los iconos pintados llegan en la Tanda 4). */
.hwm-mission-icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    margin-right: 12px;
    font-size: 19px;
    -unity-text-align: middle-center;
    background-color: rgba(10, 5, 24, 0.72);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.5);
    border-radius: 17px;
}
.hwm-mission-luna .hwm-mission-icon { border-color: rgba(143, 168, 221, 0.5); }
.hwm-mission-sangre .hwm-mission-icon { border-color: rgba(214, 130, 84, 0.5); }
.hwm-mission-premium .hwm-mission-icon { border-color: rgba(176, 58, 94, 0.6); }
.hwm-mission-body {
    flex-grow: 1;
    min-width: 0;
}
.hwm-mission-top {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}
.hwm-mission-title {
    flex-shrink: 1;
    min-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: #f6eeff;
    white-space: normal;
}
.hwm-mission-badge {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 1px 8px;
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    border-width: 1px;
    border-radius: 8px;
    color: #cbb8e8;
    border-color: rgba(126, 60, 168, 0.4);
    background-color: rgba(126, 60, 168, 0.14);
}
.hwm-badge-luna {
    color: #b9c8ea;
    border-color: rgba(143, 168, 221, 0.45);
    background-color: rgba(143, 168, 221, 0.12);
}
.hwm-badge-free {
    color: #f0c3a6;
    border-color: rgba(224, 161, 124, 0.45);
    background-color: rgba(224, 161, 124, 0.12);
}
.hwm-badge-premium {
    color: #ff9fb6;
    border-color: rgba(176, 58, 94, 0.6);
    background-color: rgba(176, 58, 94, 0.18);
}
.hwm-mission-desc {
    margin-top: 2px;
    font-size: 12px;
    color: #c3b2df;
    white-space: normal;
}
.hwm-mission-bar-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}
.hwm-mission-bar {
    flex-grow: 1;
    height: 5px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}
.hwm-mission-fill {
    height: 5px;
    border-radius: 3px;
    background-color: #b98cf0;
}
.hwm-mission-sangre .hwm-mission-fill { background-color: #d68254; }
.hwm-mission-count {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #d9c8ff;
}
.hwm-mission-reward {
    margin-bottom: 5px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
    color: #d8b95e;
    -unity-text-align: middle-right;
    white-space: nowrap;
}
.hwm-mission-action {
    flex-shrink: 0;
    width: 132px;
    align-items: flex-end;
    margin-left: 12px;
}
.hwm-claim {
    width: 100%;
    min-width: 0;
    height: 32px;
    padding: 0 14px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    color: #1a0f2e;
    background-color: #b98cf0;
    border-width: 1px;
    border-color: #e0c6ff;
    border-radius: 16px;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.hwm-claim:hover { background-color: #d9b6ff; }
.hwm-pill {
    width: 100%;
    min-width: 0;
    padding: 6px 10px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    border-width: 1px;
    border-radius: 14px;
}
.hwm-pill-done {
    color: #9fd6a8;
    border-color: rgba(114, 196, 128, 0.6);
    background-color: rgba(24, 60, 34, 0.55);
}
.hwm-pill-locked {
    color: #a293c4;
    border-color: rgba(126, 60, 168, 0.45);
    background-color: rgba(24, 13, 42, 0.7);
}
.hwm-pill-pending {
    color: #c8b3e8;
    border-color: rgba(126, 60, 168, 0.35);
    background-color: rgba(24, 13, 42, 0.6);
}

/* Banner de la Vía Sangre dentro de la pestaña de Sangre */
.hwm-banner {
    flex-direction: row;
    align-items: center;
    margin: 8px 0 6px 0;
    padding: 12px 16px;
    background-color: rgba(48, 22, 32, 0.75);
    border-width: 1px;
    border-color: rgba(214, 130, 84, 0.55);
    border-left-width: 4px;
    border-left-color: #b03a5e;
    border-radius: 10px;
}
.hwm-banner-open {
    background-color: rgba(24, 46, 32, 0.6);
    border-color: rgba(114, 196, 128, 0.55);
    border-left-color: #72c480;
}
.hwm-banner-texts {
    flex-grow: 1;
    min-width: 0;
    margin-right: 12px;
}
.hwm-banner-title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #f3d3bd;
}
.hwm-banner-open .hwm-banner-title { color: #9fd6a8; }
.hwm-banner-note {
    margin-top: 3px;
    font-size: 11px;
    color: #d8b8a8;
    white-space: normal;
}
.hwm-banner-btn {
    flex-shrink: 0;
    height: 32px;
    padding: 0 14px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    color: #ffeaf0;
    background-color: #8c2f4c;
    border-width: 1px;
    border-color: #d68254;
    border-radius: 16px;
}
.hwm-banner-btn:hover { background-color: #b03a5e; }
.hwm-banner-btn:disabled { opacity: 0.55; }

/* Estado vacío: fuera de la ventana no hay tanda que mostrar */
.hwm-empty {
    flex-direction: column;
    align-items: center;
    margin-top: 6px;
    padding: 28px 18px;
    background-color: rgba(18, 8, 36, 0.6);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.28);
    border-radius: 14px;
}
.hwm-empty-icon {
    font-size: 34px;
    margin-bottom: 8px;
}
.hwm-empty-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #efe4ff;
    -unity-text-align: middle-center;
    white-space: normal;
}
.hwm-empty-note {
    margin-top: 6px;
    font-size: 11px;
    color: #a293c4;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Pie de cada pestaña: cómo se gana el progreso y qué se cobra solo. */
.hwm-hint {
    margin-top: 14px;
    padding: 10px 12px;
    font-size: 11px;
    color: #9d8dbd;
    white-space: normal;
    background-color: rgba(18, 8, 36, 0.55);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.22);
    border-radius: 10px;
}

.hwm-footer {
    flex-shrink: 0;
    padding: 8px 18px;
    border-top-width: 1px;
    border-top-color: rgba(126, 60, 168, 0.3);
}
.hwm-footer .prog-footer-note {
    font-size: 11px;
    color: #a293c4;
}

/* ── Arte de la ventana (Resources/UI/Halloween/Missions): cuando el PNG está
      importado, el marco pintado reemplaza al borde USS y las bandas se aclaran
      para que el arco y las esquinas se vean detrás. El estilo de arriba queda
      de respaldo mientras falte el arte. ── */
.hwm-framed {
    border-width: 0;
    background-color: #0a0518;
}
.hwm-framed .hwm-topbar {
    background-color: rgba(10, 5, 24, 0.62);
    border-bottom-width: 0;
}
.hwm-framed .hwm-hero {
    background-color: rgba(10, 5, 24, 0.42);
    border-bottom-width: 0;
}
.hwm-framed .hwm-footer {
    background-color: rgba(10, 5, 24, 0.58);
    border-top-width: 0;
}
/* El cuerpo arranca más adentro para no pisar el ornato vertical del marco. */
.hwm-framed .hwm-body {
    padding-left: 34px;
    padding-right: 30px;
}
/* El texto se apoya en su propia sombra para no perderse sobre el ornato. */
.hwm-framed .shop2-brand-title,
.hwm-framed .shop2-brand-subtitle,
.hwm-framed .hwm-hero-kicker,
.hwm-framed .hwm-hero-note,
.hwm-framed .hwm-hero-timer,
.hwm-framed .hwm-section-title,
.hwm-framed .hwm-sub-title,
.hwm-framed .hwm-hint,
.hwm-framed .prog-footer-note {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
}

/* Tarjeta con marco pintado: el riel ocupa el carril izquierdo, así que el
   contenido arranca después (el icono ya no pisa el ornato). */
.hwm-mission-framed {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-left: 78px;
}
.hwm-mission-framed.hwm-mission-claimed { opacity: 0.9; }

/* Estandarte de la Vía Sangre con su arte (mismo criterio que las tarjetas). */
.hwm-banner-framed {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-left: 76px;
}

/* Botón COBRAR sobre la placa pintada: el texto oscuro queda sobre el brillo. */
.hwm-claim-framed {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}
.hwm-claim-framed:hover { -unity-background-image-tint-color: #cbb0ff; }

/* Emblema del hero e ilustración del estado vacío: los muestra el modal
   cuando el PNG está importado (si no, queda el emoji de respaldo). */
.hwm-crest {
    display: none;
    flex-shrink: 0;
    width: 62px;
    height: 66px;
    margin-right: 14px;
}
.hwm-empty-art { flex-shrink: 0; margin-bottom: 10px; }

/* ── Tanda 2: bandas, pestañas, chips y filetes pintados del modal. Con el PNG
      importado, hwm-skinned quita el chrome USS —fondo, borde y radio— porque
      el ornato ya lo dibuja; el padding se queda para que el texto viva dentro
      del marco. Si falta el arte, el elemento conserva el estilo de respaldo. ── */
.hwm-topbar.hwm-skinned,
.hwm-hero.hwm-skinned,
.hwm-footer.hwm-skinned,
.hwm-hint.hwm-skinned,
.hwm-chip.hwm-skinned,
.hwm-tab.hwm-skinned,
.hw-state-chip.hwm-skinned {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}
/* La pestaña con arte se ilumina al pasar el mouse en vez de cambiar de fondo. */
.hwm-tab.hwm-skinned:hover { -unity-background-image-tint-color: #dcc6ff; }
/* Apagada/encendida de un vistazo: la inactiva baja de opacidad y la activa
   queda a plena luz con un halo en el texto. */
.hwm-tab.hwm-skinned { opacity: 0.62; }
.hwm-tab.hwm-skinned:hover { opacity: 0.85; }
.hwm-tab.hwm-skinned.hwm-tab-active {
    opacity: 1;
    text-shadow: 0 0 10px rgba(255, 214, 255, 0.45);
}
.hwm-tab.hwm-skinned.hwm-tab-active:hover { opacity: 1; }

/* El filete pintado es más alto que la línea de 1 px: los márgenes negativos
   devuelven el alto al renglón, así el título no se mueve. */
.hwm-section-line.hwm-skinned {
    height: 15px;
    margin-top: -7px;
    margin-bottom: -7px;
    background-color: rgba(0, 0, 0, 0);
}

/* ══════════════════════════════════════════════════════════
   CONFIRMACIÓN DE LA VÍA SANGRE (overlay compartido)
   Se monta sobre el tablero de misiones o el pase; resume las
   5 misiones premium, el carril Sangre y el saldo resultante.
   ══════════════════════════════════════════════════════════ */
.hwc-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background-color: rgba(4, 2, 10, 0.8);
}
.hwc-panel {
    width: 560px;
    max-width: 92%;
    max-height: 88%;
    flex-direction: column;
    padding: 20px 22px 18px 22px;
    background-color: #0d0620;
    border-width: 1.5px;
    border-color: rgba(214, 130, 84, 0.7);
    border-radius: 16px;
    overflow: hidden;
}
.hwc-kicker {
    flex-shrink: 0;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #d68254;
}
.hwc-title {
    flex-shrink: 0;
    margin-top: 4px;
    font-size: 23px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    color: #f6eeff;
}
.hwc-sub {
    flex-shrink: 0;
    margin-top: 6px;
    font-size: 12px;
    color: #bda9d8;
    white-space: normal;
}
.hwc-scroll {
    flex-shrink: 1;
    max-height: 380px;
    margin-top: 12px;
}
.hwc-scroll .unity-scroller--vertical {
    width: 8px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}
.hwc-scroll .unity-base-slider__tracker {
    background-color: rgba(14, 8, 30, 0.65);
    border-width: 0;
    border-radius: 4px;
}
.hwc-scroll .unity-base-slider__dragger {
    background-color: rgba(142, 92, 201, 0.5);
    border-width: 0;
    border-radius: 4px;
}
.hwc-scroll .unity-scroller__low-button,
.hwc-scroll .unity-scroller__high-button { display: none; }

.hwc-section-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(126, 60, 168, 0.28);
}
.hwc-section-title {
    flex-shrink: 1;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #e3caff;
}
.hwc-section-total {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    color: #d8b95e;
}
.hwc-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(126, 60, 168, 0.14);
}
.hwc-row-icon {
    width: 22px;
    flex-shrink: 0;
    font-size: 13px;
}
.hwc-row-name {
    flex-grow: 1;
    min-width: 0;
    font-size: 11px;
    color: #d9c8f2;
    white-space: normal;
}
.hwc-row-pay {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #d8b95e;
}
.hwc-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}
.hwc-chip {
    margin: 3px 6px 0 0;
    padding: 2px 8px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.4px;
    color: #f0c3a6;
    background-color: rgba(224, 161, 124, 0.08);
    border-width: 1px;
    border-color: rgba(224, 161, 124, 0.4);
    border-radius: 8px;
}
.hwc-note {
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 0.3px;
    color: #8d7cb0;
    white-space: normal;
}
.hwc-price {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    padding: 9px 12px;
    background-color: rgba(48, 22, 32, 0.55);
    border-width: 1px;
    border-color: rgba(214, 130, 84, 0.45);
    border-radius: 10px;
}
.hwc-price-texts { flex-direction: column; }
.hwc-price-label {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    color: #d8b8a8;
}
.hwc-balance {
    margin-top: 2px;
    font-size: 10px;
    color: #a293c4;
}
.hwc-balance-low { color: #ff9fb6; }
.hwc-price-value {
    flex-shrink: 0;
    margin-left: 12px;
    font-size: 18px;
    -unity-font-style: bold;
    color: #ffd9a8;
}
.hwc-actions {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 14px;
}
.hwc-btn {
    height: 36px;
    margin-left: 8px;
    padding: 0 16px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    border-radius: 18px;
}
.hwc-cancel {
    color: #c8b3e8;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.5);
}
.hwc-cancel:hover { background-color: rgba(126, 60, 168, 0.18); }
.hwc-buy {
    color: #ffeaf0;
    background-color: #8c2f4c;
    border-width: 1px;
    border-color: #d68254;
}
.hwc-buy:hover { background-color: #b03a5e; }
.hwc-buy:disabled { opacity: 0.5; }

/* ── Ajustes de móvil en vertical para el cuerpo de la velada ── */
.is-portrait .hw-row { flex-wrap: wrap; }
.is-portrait .hw-medal { align-self: flex-start; }
.is-portrait .hw-card { flex-basis: 100%; margin-left: 0; margin-top: 6px; }
.is-portrait .hw-msum { flex-basis: 100%; min-width: 0; margin: 4px 0; }

/* ── Modal de misiones en vertical: ventana a sangre, topbar apilado,
      pestañas a lo ancho y la acción de cada misión debajo. ── */
.is-portrait .hwm-window {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border-radius: 0;
    border-width: 0;
}
.is-portrait .hwm-topbar { flex-wrap: wrap; padding: 12px 16px; }
.is-portrait .hwm-topbar .shop2-brand { display: none; }
.is-portrait .hwm-chips {
    width: 100%;
    margin-left: 0;
    margin-top: 8px;
    justify-content: center;
    flex-wrap: wrap;
}
.is-portrait .hwm-hero {
    flex-direction: column;
    align-items: stretch;
    padding: 12px 16px;
}
.is-portrait .hwm-hero-texts { margin-right: 0; }
.is-portrait .hwm-tabs { margin-top: 10px; }
.is-portrait .hwm-tab {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 6px;
}
.is-portrait .hwm-body { padding: 12px 14px 18px 14px; }
.is-portrait .hwm-mission { flex-wrap: wrap; }
.is-portrait .hwm-mission-action {
    width: 100%;
    align-items: stretch;
    margin-left: 0;
    margin-top: 8px;
}
.is-portrait .hwm-claim,
.is-portrait .hwm-pill {
    width: 100%;
    min-width: 0;
    -unity-text-align: middle-center;
}
.is-portrait .hwm-section-note { display: none; }
.is-portrait .hwm-banner { flex-wrap: wrap; }
.is-portrait .hwm-banner-texts { width: 100%; margin-right: 0; }
.is-portrait .hwm-banner-btn {
    width: 100%;
    margin-top: 8px;
}

/* Tipografía de móvil: el resto de modales crece ±1,5× en vertical
   (PROGRESO, pase de temporada); el tablero de misiones sigue la misma
   escala para que las tarjetas se lean en pantalla chica. */
.is-portrait .hwm-topbar .shop2-back-btn {
    height: 64px;
    padding: 0 22px;
    font-size: 20px;
    letter-spacing: 2px;
    border-radius: 12px;
}
.is-portrait .hwm-chip {
    height: 52px;
    margin: 4px;
    padding: 0 18px;
    border-radius: 26px;
}
.is-portrait .hwm-chip-icon { font-size: 20px; margin-right: 10px; }
.is-portrait .hwm-chip-text { font-size: 18px; }
.is-portrait .hwm-topbar .hw-state-chip {
    margin-top: 6px;
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 22px;
}
.is-portrait .hwm-hero-kicker { font-size: 14px; letter-spacing: 4px; }
.is-portrait .hwm-hero-note { font-size: 20px; }
.is-portrait .hwm-hero-timer { font-size: 15px; }
.is-portrait .hwm-tab {
    height: 56px;
    margin-bottom: 4px;
    font-size: 17px;
    letter-spacing: 2px;
    border-radius: 28px;
}
.is-portrait .hwm-section-title { font-size: 18px; }
.is-portrait .hwm-sub-title { font-size: 16px; }
.is-portrait .hwm-mission-icon { width: 52px; margin-right: 16px; font-size: 34px; }
.is-portrait .hwm-mission-title { font-size: 22px; }
.is-portrait .hwm-mission-desc { font-size: 17px; }
.is-portrait .hwm-mission-badge {
    padding: 2px 12px;
    font-size: 13px;
    border-radius: 12px;
}
.is-portrait .hwm-mission-count { font-size: 15px; }
.is-portrait .hwm-mission-reward {
    margin-top: 0;
    margin-bottom: 6px;
    font-size: 15px;
    -unity-text-align: middle-right;
}
.is-portrait .hwm-mission-bar,
.is-portrait .hwm-mission-fill { height: 9px; border-radius: 5px; }
.is-portrait .hwm-claim,
.is-portrait .hwm-pill {
    height: 56px;
    font-size: 16px;
    letter-spacing: 2px;
}
.is-portrait .hwm-banner-title { font-size: 18px; }
.is-portrait .hwm-banner-note { font-size: 16px; }
.is-portrait .hwm-banner-btn { height: 56px; font-size: 16px; }
.is-portrait .hwm-hint { font-size: 15px; }
.is-portrait .hwm-empty-icon { font-size: 48px; }
.is-portrait .hwm-empty-title { font-size: 20px; }
.is-portrait .hwm-empty-note { font-size: 16px; }
.is-portrait .hwm-footer .prog-footer-btn {
    height: 64px;
    font-size: 20px;
    letter-spacing: 2px;
}

/* Confirmación de la Vía Sangre en vertical: panel a lo ancho, tipografía
   grande y botones apilados. El resumen conserva el scroll. */
.is-portrait .hwc-panel {
    width: 100%;
    max-width: none;
    max-height: 92%;
    padding: 18px 16px;
}
.is-portrait .hwc-kicker { font-size: 12px; letter-spacing: 4px; }
.is-portrait .hwc-title { font-size: 28px; }
.is-portrait .hwc-sub { font-size: 16px; }
.is-portrait .hwc-scroll { max-height: 320px; }
.is-portrait .hwc-section-title,
.is-portrait .hwc-section-total { font-size: 14px; }
.is-portrait .hwc-row { padding: 8px 2px; }
.is-portrait .hwc-row-icon { width: 30px; font-size: 20px; }
.is-portrait .hwc-row-name { font-size: 17px; }
.is-portrait .hwc-row-pay { font-size: 14px; }
.is-portrait .hwc-chip { padding: 4px 10px; font-size: 13px; }
.is-portrait .hwc-note { font-size: 13px; }
.is-portrait .hwc-price-label { font-size: 12px; }
.is-portrait .hwc-balance { font-size: 14px; }
.is-portrait .hwc-price-value { font-size: 24px; }
.is-portrait .hwc-actions { flex-direction: column; margin-top: 12px; }
.is-portrait .hwc-btn {
    width: 100%;
    height: 54px;
    margin: 6px 0 0 0;
    font-size: 16px;
    border-radius: 27px;
}

/* ══════════════════════════════════════════════════════════
   MENÚ PRINCIPAL — móvil en vertical (.is-portrait, lo pone UiResponsive)
   Todo en una sola columna: título, botonera, INVENTARIO en barra
   horizontal y PASE DE TEMPORADA debajo, sin solaparse.
   ══════════════════════════════════════════════════════════ */
.is-portrait #main-menu-view {
    justify-content: center;
    padding: 40px 0 70px 0;
}
.is-portrait .header-section { margin-bottom: 44px; }
.is-portrait .title-crown { font-size: 64px; }
.is-portrait .main-title { font-size: 66px; letter-spacing: 8px; }
.is-portrait .title-separator { width: 70%; max-width: 520px; }
.is-portrait .main-subtitle { font-size: 20px; letter-spacing: 6px; }
.is-portrait .header-pieces-bg { width: 90%; max-width: 750px; }

.is-portrait .menu-columns {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    /* Una columna no tiene banda fija: el alto lo pone el contenido. */
    height: auto;
    margin-top: 34px;
}
.is-portrait .menu-rail {
    width: 88%;
    max-width: 780px;
    align-self: center;
}
.is-portrait .menu-rail-left { margin-right: 0; }
.is-portrait .menu-rail-right { margin-left: 0; margin-top: 20px; }

.is-portrait .menu-actions {
    width: 88%;
    max-width: 780px;
    align-self: center;
}
.is-portrait .menu-button { height: 104px; margin-top: 10px; }
.is-portrait .btn-primary { height: 128px; margin-top: 0; }
.is-portrait .btn-label { font-size: 32px; letter-spacing: 4px; }
.is-portrait .btn-primary .btn-label,
.is-portrait .btn-pieces .btn-label { font-size: 36px; letter-spacing: 5px; }
.is-portrait .btn-label-sm { font-size: 24px; letter-spacing: 3px; }
.is-portrait .btn-deco { width: 52px; height: 52px; }
.is-portrait .btn-deco-sm { width: 38px; height: 38px; }

.is-portrait .menu-action-row { margin: 12px 0 0 0; }
.is-portrait .menu-tile { height: 92px; margin-left: 0; margin-right: 0; }
.is-portrait .btn-shop { margin-right: 8px; }
.is-portrait .btn-secondary.menu-tile { margin-left: 8px; }

.is-portrait .btn-progress { height: 92px; padding: 0 18px; }
.is-portrait .btn-progress-icon { font-size: 34px; margin-right: 16px; width: 30px; height: 30px; }
.is-portrait .btn-progress-label { font-size: 22px; letter-spacing: 3px; }
.is-portrait .btn-progress-badge { min-width: 32px; height: 32px; border-radius: 16px; font-size: 18px; margin-left: 14px; }

.is-portrait .btn-danger { height: 92px; }
.is-portrait .btn-danger .btn-label-sm { font-size: 24px; letter-spacing: 3px; }

/* La vitrina del inventario pasa a ser una barra horizontal. */
.is-portrait .menu-inventory-rail {
    width: 100%;
    /* En vertical la vitrina es una barra de alto fijo: no debe estirarse. */
    flex-grow: 0;
}
.is-portrait .btn-inventory {
    height: 104px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 0 18px;
}
.is-portrait .btn-inventory-art-wrap { width: 118px; height: 100%; }
.is-portrait .btn-inventory-art { width: 78%; height: 84%; }
.is-portrait .btn-inventory-art-fallback { font-size: 44px; }
.is-portrait .btn-inventory-rule { width: 1px; height: 54%; margin-top: 0; margin-bottom: 0; }
.is-portrait .btn-inventory-label-wrap { height: 100%; width: auto; flex-grow: 1; }
.is-portrait .btn-inventory-label {
    rotate: 0deg;
    font-size: 26px;
    letter-spacing: 5px;
}
.is-portrait .btn-inventory-count {
    top: 50%;
    right: 24px;
    margin-top: -16px;
    min-width: 32px;
    height: 32px;
    border-radius: 16px;
    font-size: 17px;
}

.is-portrait .menu-wallet { width: 100%; justify-content: center; }
.is-portrait .menu-wallet-value { font-size: 22px; }
.is-portrait .menu-wallet-label { font-size: 12px; }

/* Los dos pases, uno al lado del otro y en fila. */
.is-portrait .menu-rail-left {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}
.is-portrait .menu-seasonpass-entry {
    width: 48%;
    margin-bottom: 0;
    margin-right: 12px;
}
.is-portrait .menu-halloweenpass-entry { width: 48%; }
.is-portrait .menu-seasonpass-banner { height: 205px; }
.is-portrait .menu-seasonpass-label { width: 320px; height: 29px; margin-top: 12px; margin-bottom: 12px; }
.is-portrait .menu-halloweenpass-banner { height: 205px; }
.is-portrait .menu-halloweenpass-label { width: 320px; height: 62px; margin-top: 12px; margin-bottom: 12px; }
.is-portrait .menu-halloweenpass-soon { font-size: 15px; padding: 6px 14px; }

.is-portrait .footer-badge { bottom: 24px; font-size: 13px; letter-spacing: 2px; }

/* ══════════════════════════════════════════════════════════
   MENÚ PRINCIPAL — pantalla estrecha en horizontal (.is-narrow)
   Las tres columnas no caben: los pases pasan debajo de la
   botonera y la vitrina del inventario se alinea con ellos.
   ══════════════════════════════════════════════════════════ */
.is-narrow .menu-main { padding: 16px 20px; }
.is-narrow .menu-columns {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: auto;
    margin-top: 20px;
}
.is-narrow .menu-rail {
    width: 100%;
    max-width: 520px;
    align-self: center;
}
.is-narrow .menu-rail-left { margin-right: 0; }
.is-narrow .menu-rail-right { margin-left: 0; margin-top: 16px; }
.is-narrow .menu-actions {
    width: 100%;
    max-width: 520px;
    align-self: center;
}
/* En una columna no hay banda de 400px que reparta el aire: los márgenes
   vuelven a ser explícitos para que los botones no queden pegados. */
.is-narrow .menu-button { margin-top: 12px; }
.is-narrow .btn-primary { margin-top: 0; }
.is-narrow .menu-action-row { margin: 12px 0 0 0; }
.is-narrow .menu-rail-left {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: 18px;
}
.is-narrow .menu-seasonpass-entry { width: 48%; margin-bottom: 0; margin-right: 12px; }
.is-narrow .menu-halloweenpass-entry { width: 48%; }
.is-narrow .menu-seasonpass-banner,
.is-narrow .menu-halloweenpass-banner { height: 135px; }
.is-narrow .menu-seasonpass-label { width: 210px; height: 19px; }
.is-narrow .menu-halloweenpass-label { width: 210px; height: 40px; }
.is-narrow .menu-inventory-rail { flex-grow: 0; }
.is-narrow .btn-inventory { height: 180px; }
.is-narrow .btn-inventory-art-wrap { width: 92px; height: 92px; }

/* ══════════════════════════════════════════════════════════
   PASE DE TEMPORADA — móvil en vertical (.is-portrait)
   La pista pasa a ser una columna de niveles con scroll vertical
   (carta libre · medallón · carta real) y todo el texto crece.
   Las medidas de cartas/medallón las fija SeasonPassModal.FitTrackVertical.
   ══════════════════════════════════════════════════════════ */
.is-portrait .season-topbar { padding: 18px 24px; flex-wrap: wrap; }
.is-portrait .season-topbar .shop2-brand { display: none; }
.is-portrait .season-topbar .shop2-back-btn {
    height: 68px;
    padding: 0 26px;
    font-size: 22px;
    letter-spacing: 2px;
    border-radius: 12px;
}
.is-portrait .season-topbar .shop2-rail-vault { margin-left: auto; }
.is-portrait .season-topbar .shop2-chip {
    min-width: 0;
    min-height: 0;
    padding: 10px 18px 10px 12px;
    margin-right: 0;
    margin-left: 12px;
    border-radius: 16px;
}
.is-portrait .season-topbar .shop2-chip-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin-right: 14px;
}
.is-portrait .season-topbar .shop2-chip-icon { font-size: 28px; }
.is-portrait .season-topbar .shop2-chip-amount { font-size: 26px; }
.is-portrait .season-topbar .shop2-chip-label { font-size: 16px; letter-spacing: 1.5px; margin-top: 2px; }

.is-portrait .season-hero {
    height: auto;
    min-height: 340px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
    padding: 26px 24px 24px 24px;
}
.is-portrait .season-hero-content {
    flex-grow: 0;
    margin-right: 0;
    align-items: flex-start;
}
.is-portrait .season-title-art { width: 100%; height: 104px; }
.is-portrait .season-season-label { font-size: 24px; letter-spacing: 3px; margin-top: 12px; }
.is-portrait .season-timer-label { font-size: 18px; letter-spacing: 1.2px; margin-top: 6px; }
.is-portrait .season-premium-btn {
    margin-top: 20px;
    height: 84px;
    padding: 0 24px;
    font-size: 24px;
    letter-spacing: 1.6px;
    border-radius: 14px;
}

.is-portrait .season-lane-head {
    flex-direction: row;
    justify-content: space-between;
    align-self: center;
    flex-shrink: 0;
    padding: 16px 0 10px 0;
}
.is-portrait .season-lane-head .season-side-banner {
    margin: 0;
    height: 88px;
    padding: 0 10px 0 8px;
    border-radius: 12px;
    flex-shrink: 0;
}
.is-portrait .season-side-icon { width: 54px; height: 48px; margin-right: 10px; }
.is-portrait .season-side-title { font-size: 23px; letter-spacing: 2px; }
.is-portrait .season-side-hint { display: none; }

.is-portrait .season-track-nav { display: none; }
.is-portrait .season-track-scroll .unity-scroll-view__vertical-scroller {
    width: 14px;
    min-width: 14px;
    max-width: 14px;
    margin: 0 4px;
    padding: 6px 2px;
    background-color: rgba(6, 10, 22, 0.92);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.3);
    border-radius: 7px;
    overflow: hidden;
}
.is-portrait .season-track-scroll .unity-base-slider__dragger {
    min-width: 0;
    min-height: 64px;
}

.is-portrait .season-track {
    flex-direction: column;
    align-items: center;
    padding: 10px 0 24px 0;
}
.is-portrait .season-tier {
    width: 772px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
}
.is-portrait .season-node {
    width: 128px;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.is-portrait .season-node-line {
    width: 6px;
    height: auto;
    min-height: 0;
    flex-grow: 1;
}
.is-portrait .season-tick { width: 22px; height: 3px; align-self: center; }
.is-portrait .season-reward { margin-top: 0; }

.is-portrait .season-footer {
    flex-direction: column;
    align-items: stretch;
    padding: 14px 24px 22px 24px;
}
.is-portrait .season-footer .prog-footer-note {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 14px;
}
.is-portrait .season-footer .prog-footer-btn {
    width: 100%;
    min-width: 0;
    height: 76px;
    font-size: 24px;
    letter-spacing: 2px;
    border-radius: 14px;
}

/* ── Modal de compra del Gambito Real, más grande en móvil ── */
.is-portrait .season-buy-window { width: 94%; max-width: 940px; }
.is-portrait .season-buy-head { padding: 22px 24px; }
.is-portrait .season-buy-kicker { font-size: 15px; letter-spacing: 3px; }
.is-portrait .season-buy-title { font-size: 32px; margin-top: 4px; }
.is-portrait .season-buy-close { width: 68px; height: 68px; font-size: 24px; border-radius: 14px; }
.is-portrait .season-buy-banner { margin: 14px 22px; padding: 20px 22px; border-radius: 16px; }
.is-portrait .season-buy-icon { width: 68px; height: 62px; margin-right: 16px; }
.is-portrait .season-buy-banner-title { font-size: 28px; letter-spacing: 3px; }
.is-portrait .season-buy-banner-sub { font-size: 17px; margin-top: 4px; }
.is-portrait .season-buy-tag { font-size: 15px; padding: 7px 16px; border-radius: 16px; }
.is-portrait .season-buy-banner-text { font-size: 19px; margin-top: 14px; }
.is-portrait .season-buy-price-libre { font-size: 26px; margin-top: 12px; }
.is-portrait .season-buy-hr-gem { font-size: 18px; }
.is-portrait .season-buy-buyrow { flex-direction: column; align-items: stretch; margin-top: 18px; }
.is-portrait .season-buy-pricelabel { font-size: 14px; }
.is-portrait .season-buy-price { font-size: 38px; }
.is-portrait .season-buy-confirm {
    margin-left: 0;
    margin-top: 16px;
    padding: 0 28px;
    height: 84px;
    font-size: 24px;
    letter-spacing: 2px;
    border-radius: 14px;
    -unity-text-align: middle-center;
}
.is-portrait .season-buy-foot { padding: 18px 22px 24px 22px; }
.is-portrait .season-buy-account-dot { font-size: 22px; }
.is-portrait .season-buy-account-text { font-size: 18px; }
.is-portrait .season-buy-balance { font-size: 21px; }
.is-portrait .season-buy-login { flex-direction: column; align-items: stretch; margin-top: 14px; }
.is-portrait .season-buy-input { height: 64px; flex-basis: auto; margin-right: 0; margin-bottom: 10px; }
.is-portrait .season-buy-input > .unity-base-field__input { height: 64px; font-size: 20px; padding-left: 16px; padding-right: 16px; border-radius: 12px; }
.is-portrait .season-buy-login-btn { height: 68px; font-size: 20px; letter-spacing: 2px; border-radius: 12px; }
.is-portrait .season-buy-error { font-size: 18px; margin-top: 10px; }
/* ══════════════════════════════════════════════════════════
   PROGRESO — móvil en vertical (.is-portrait)
   Ventana a pantalla completa, una sola columna y todo el
   texto/botones más grandes para que se lea y se toque bien.
   ══════════════════════════════════════════════════════════ */
.is-portrait .prog-window {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border-radius: 0;
}
.is-portrait .prog-window .shop2-topbar { padding: 18px 24px; flex-wrap: wrap; }
.is-portrait .prog-window .shop2-brand { display: none; }
.is-portrait .prog-window .shop2-back-btn {
    height: 68px;
    padding: 0 26px;
    font-size: 22px;
    letter-spacing: 2px;
    border-radius: 12px;
}
.is-portrait .prog-window .shop2-rail-vault { margin-left: auto; }
.is-portrait .prog-window .shop2-chip {
    padding: 10px 18px 10px 12px;
    margin-right: 0;
    margin-left: 12px;
    border-radius: 16px;
}
.is-portrait .prog-window .shop2-chip-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin-right: 14px;
}
.is-portrait .prog-window .shop2-chip-icon { font-size: 28px; }
.is-portrait .prog-window .shop2-chip-amount { font-size: 26px; }
.is-portrait .prog-window .shop2-chip-label { font-size: 15px; letter-spacing: 1.2px; margin-top: 2px; }

.is-portrait .prog-content { padding: 22px 22px 12px 22px; }
.is-portrait .prog-card {
    padding: 24px 22px 20px 22px;
    margin-bottom: 22px;
    border-radius: 20px;
}
.is-portrait .prog-card-head { margin-bottom: 16px; }
.is-portrait .prog-kicker { font-size: 17px; letter-spacing: 3px; }
.is-portrait .prog-title { font-size: 36px; margin-top: 4px; }
.is-portrait .prog-sub { font-size: 19px; margin-top: 6px; }
.is-portrait .prog-reset { font-size: 18px; margin-top: 4px; }

.is-portrait .prog-columns { flex-direction: column; }
.is-portrait .prog-col { flex-basis: auto; flex-grow: 0; }
/* USS no soporta ':first-child': el filete lo aplica ProgressModal por indice. */
.is-portrait .prog-col.prog-first { margin-right: 0; }

/* Barra semanal */
.is-portrait .prog-week-bar { height: auto; min-height: 340px; align-items: stretch; margin: 10px 0 20px 0; }
.is-portrait .prog-seg { margin-right: 8px; padding: 24px 8px 16px 8px; border-radius: 14px; flex-shrink: 1; min-width: 0; }
.is-portrait .prog-seg-day { font-size: 24px; margin-right: 4px; }
.is-portrait .prog-seg-num { font-size: 15px; }
.is-portrait .prog-seg-track { width: 34px; min-height: 130px; border-radius: 17px; margin-top: 6px; }
.is-portrait .prog-seg-fill { border-radius: 16px; }
.is-portrait .prog-seg-status { font-size: 17px; margin-top: 10px; flex-shrink: 0; }
.is-portrait .prog-seg-reward { font-size: 16px; margin-top: 6px; flex-shrink: 0; }
.is-portrait .prog-week-foot { flex-wrap: wrap; margin-bottom: 18px; }
.is-portrait .prog-week-status { font-size: 20px; white-space: normal; margin-bottom: 6px; }
.is-portrait .prog-week-reset { font-size: 18px; }

/* Cofre: escenario centrado y ampliado, textos y botón debajo */
.is-portrait .prog-chest {
    flex-direction: column;
    align-items: stretch;
    padding: 20px;
    border-radius: 18px;
}
.is-portrait .prog-chest-stage {
    align-self: center;
    margin-right: 0;
    margin-top: 28px;
    margin-bottom: 34px;
    scale: 1.45 1.45;
}
.is-portrait .prog-chest-texts { flex-grow: 0; align-items: center; }
.is-portrait .prog-chest-kicker { font-size: 16px; letter-spacing: 3px; -unity-text-align: middle-center; }
.is-portrait .prog-chest-title { font-size: 38px; margin-top: 4px; -unity-text-align: middle-center; }
.is-portrait .prog-chest-sub { font-size: 19px; margin-top: 8px; -unity-text-align: middle-center; }
.is-portrait .prog-chest .prog-claim {
    width: 100%;
    height: 84px;
    font-size: 23px;
    margin-top: 22px;
}

/* Botones de cobro */
.is-portrait .prog-claim {
    height: 68px;
    min-width: 200px;
    padding: 0 40px;
    font-size: 19px;
    letter-spacing: 1.5px;
    border-radius: 14px;
}
.is-portrait .prog-ghost {
    height: 68px;
    margin-top: 12px;
    font-size: 19px;
    border-radius: 14px;
}

/* Misiones */
.is-portrait .prog-mission {
    padding: 14px 16px;
    margin-bottom: 12px;
    border-radius: 16px;
}
.is-portrait .prog-mission-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin-right: 16px;
    flex-shrink: 0;
}
.is-portrait .prog-mission-icon { font-size: 26px; }
.is-portrait .prog-mission-texts { flex-shrink: 1; min-width: 0; }
.is-portrait .prog-mission-title { font-size: 22px; }
.is-portrait .prog-mission-desc { font-size: 17px; margin-top: 2px; }
.is-portrait .prog-mission-reward { font-size: 16px; margin-top: 4px; }
.is-portrait .prog-mission-right { min-width: 180px; margin-left: 12px; flex-shrink: 0; }
.is-portrait .prog-bar { width: 170px; height: 12px; border-radius: 6px; margin-bottom: 8px; }
.is-portrait .prog-bar-fill { border-radius: 6px; }

/* Retos: el botón baja a su propia línea a todo el ancho */
.is-portrait .prog-challenge {
    width: 100%;   /* en vertical las filas siguen a ancho completo */
    flex-wrap: wrap;
    padding: 16px 18px;
    margin-bottom: 12px;
    border-radius: 16px;
}
.is-portrait .prog-challenge-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    margin-right: 16px;
    flex-shrink: 0;
}
.is-portrait .prog-challenge-icon { font-size: 28px; }
.is-portrait .prog-challenge-texts { flex-basis: 0; flex-shrink: 1; min-width: 0; }
/* En vertical los textos vuelven apilados (título sobre descripción) */
.is-portrait .prog-challenge-texts { flex-direction: column; }
.is-portrait .prog-challenge-title {
    font-size: 22px;
    letter-spacing: 1px;
    margin-right: 0;
}
.is-portrait .prog-challenge-sub { font-size: 17px; margin-top: 2px; }
.is-portrait .prog-challenge .prog-claim { width: 100%; margin-top: 16px; }

/* Logros: una columna */
.is-portrait .prog-ach {
    width: 100%;
    padding: 16px 22px;
    margin-right: 0;
    margin-bottom: 12px;
    border-radius: 16px;
}
.is-portrait .prog-ach-icon { font-size: 30px; margin-right: 14px; }
.is-portrait .prog-ach-title { font-size: 21px; }
.is-portrait .prog-ach-desc { font-size: 16px; margin-top: 2px; }
.is-portrait .prog-ach-state { font-size: 16px; margin-left: 10px; }

/* Fuentes de Gambits */
.is-portrait .prog-source {
    padding: 16px 18px 16px 24px;
    margin-bottom: 10px;
    border-radius: 14px;
}
.is-portrait .prog-source-icon { font-size: 26px; margin-right: 14px; }
.is-portrait .prog-source-label { font-size: 20px; }
.is-portrait .prog-source-hint { font-size: 16px; margin-top: 2px; }
.is-portrait .prog-source-today { font-size: 18px; min-width: 130px; }

/* Pie */
.is-portrait .prog-footer {
    flex-direction: column;
    align-items: stretch;
    padding: 14px 24px 22px 24px;
}
.is-portrait .prog-footer .prog-footer-note {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 14px;
}
.is-portrait .prog-footer .prog-footer-btn {
    width: 100%;
    min-width: 0;
    height: 76px;
    font-size: 24px;
    letter-spacing: 2px;
    border-radius: 14px;
}

/* Capa de carga */
.is-portrait .prog-loading-card { min-width: 560px; padding: 40px 44px; border-radius: 22px; }
.is-portrait .prog-loading-icon { font-size: 54px; }
.is-portrait .prog-loading-text { font-size: 24px; margin-top: 18px; }
.is-portrait .prog-loading-sub { font-size: 18px; margin-top: 12px; }
.is-portrait .prog-loading-bar { width: 420px; height: 8px; margin-top: 26px; border-radius: 4px; }
/* ══════════════════════════════════════════════════════════
   TIENDA · INVENTARIO · TUS PIEZAS — móvil en vertical (.is-portrait)
   Ventanas a pantalla completa, tarjetas de 3 por fila y textos
   mucho más grandes. Tus Piezas pasa a una sola columna con
   pestañas (Tus piezas / Enciclopedia).
   ══════════════════════════════════════════════════════════ */

/* ── Ventanas shop2 (tienda e inventario) ── */
.is-portrait #shop-modal-view,
.is-portrait #inventory-modal-view { padding: 0; }
.is-portrait #shop-modal-view .shop2-window,
.is-portrait #inventory-modal-view .shop2-window {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border-radius: 0;
}

/* Barra superior */
.is-portrait #shop-modal-view .shop2-topbar,
.is-portrait #inventory-modal-view .shop2-topbar { padding: 18px 24px; flex-wrap: wrap; }
.is-portrait #shop-modal-view .shop2-brand,
.is-portrait #inventory-modal-view .shop2-brand { display: none; }
.is-portrait #shop-modal-view .shop2-back-btn,
.is-portrait #inventory-modal-view .shop2-back-btn {
    height: 68px;
    padding: 0 26px;
    font-size: 22px;
    letter-spacing: 2px;
    border-radius: 12px;
    margin-left: 0;
}
.is-portrait #shop-modal-view .shop2-rail-vault,
.is-portrait #inventory-modal-view .shop2-rail-vault {
    margin-left: auto;
    flex-wrap: wrap;
    justify-content: flex-end;
}
.is-portrait #inventory-modal-view .shop2-chip {
    height: 108px;
    min-height: 108px;
    min-width: 236px;
    padding: 16px 32px 16px 22px;
    margin-right: 0;
    margin-left: 12px;
    border-radius: 18px;
    -unity-slice-scale: 0.75px;
}
.is-portrait #inventory-modal-view .shop2-chip-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin-right: 16px;
}
.is-portrait #inventory-modal-view .shop2-chip-icon { font-size: 24px; }
.is-portrait #inventory-modal-view .shop2-chip-icon.gambits-icon { width: 40px; height: 40px; }
.is-portrait #inventory-modal-view .shop2-chip-amount { font-size: 25px; margin: 0; }
.is-portrait #inventory-modal-view .shop2-chip-label { font-size: 13.5px; letter-spacing: 1.4px; margin: 0; }

.is-portrait #shop-modal-view .shop2-balance-card { padding: 6px; margin-right: 0; margin-left: 12px; border-radius: 16px; }
.is-portrait #shop-modal-view .shop2-balance-slot { padding: 10px 16px 10px 12px; }
.is-portrait #shop-modal-view .shop2-balance-icon { width: 52px; height: 52px; border-radius: 26px; margin-right: 12px; }
.is-portrait #shop-modal-view .shop2-balance-glyph,
.is-portrait #shop-modal-view .shop2-balance-icon--tides .shop2-balance-glyph,
.is-portrait #shop-modal-view .shop2-balance-icon--gambits .shop2-balance-glyph { font-size: 26px; }
.is-portrait #shop-modal-view .shop2-balance-amount { font-size: 26px; }
.is-portrait #shop-modal-view .shop2-balance-caption { font-size: 14px; letter-spacing: 1.6px; margin-top: 2px; }
.is-portrait #shop-modal-view .shop2-balance-divider { height: 50px; }
.is-portrait #shop-modal-view .shop2-profile-card { margin-left: 12px; margin-top: 0; padding: 8px 14px 8px 10px; border-radius: 16px; }
.is-portrait #shop-modal-view .shop2-profile-avatar { width: 52px; height: 52px; border-radius: 26px; margin-right: 12px; }
.is-portrait #shop-modal-view .shop2-profile-avatar-letter { font-size: 24px; }
.is-portrait #shop-modal-view .shop2-profile-name,
.is-portrait #shop-modal-view .shop2-profile-handle { display: flex; }
.is-portrait #shop-modal-view .shop2-profile-name { font-size: 20px; }
.is-portrait #shop-modal-view .shop2-profile-handle { font-size: 15px; }
.is-portrait #shop-modal-view .shop2-profile-logout { width: 104px; height: 52px; font-size: 18px; border-radius: 12px; }

/* Pestañas */
.is-portrait .shop2-tabs { height: 108px; padding: 0 18px; }
.is-portrait .shop2-tab {
    height: 68px;
    padding: 0 26px;
    margin: 0 6px;
    border-radius: 0;
}
.is-portrait .shop2-tabs .shop2-tab { min-width: 172px; }
.is-portrait .shop2-tab-index { font-size: 14px; margin-right: 10px; }
.is-portrait .shop2-tab-label { font-size: 21px; letter-spacing: 1.5px; }
.is-portrait .shop2-tab-count { min-width: 30px; height: 30px; font-size: 16px; padding: 2px 10px; margin-left: 10px; border-radius: 15px; }
.is-portrait .shop2-tab-indicator { width: 10px; height: 10px; bottom: -5px; }
.is-portrait .inv-tabs { flex-wrap: wrap; padding: 22px 22px 6px 22px; }
.is-portrait .inv-tabs .shop2-tab { height: 64px; padding: 0 22px; margin: 0 6px 0 0; min-width: 240px; }
.is-portrait .inv-tab-hint {
    width: 100%;
    max-width: none;
    margin-left: 0;
    margin-top: 14px;
    font-size: 18px;
    letter-spacing: 0.5px;
    -unity-text-align: middle-left;
}
.is-portrait .inv-filter-row { flex-wrap: wrap; padding: 8px 22px 10px 22px; }
.is-portrait .inv-filter-label { font-size: 16px; margin-right: 12px; }
.is-portrait .skin-filter-btn {
    height: 56px;
    padding: 0 22px;
    margin: 5px;
    border-radius: 28px;
    font-size: 19px;
    letter-spacing: 0.8px;
}

/* Catálogo de la tienda */
.is-portrait #shop-modal-view .shop2-body { position: relative; }
.is-portrait #shop-modal-view .shop2-stage { padding: 22px 16px 14px 16px; }
.is-portrait #shop-modal-view .shop2-catalog-footer { display: none; }
.is-portrait .shop2-empty-title { font-size: 22px; }
.is-portrait .shop2-empty-desc { font-size: 18px; }

/* Tarjetas (tienda e inventario): 3 por fila */
.is-portrait .bg-card {
    width: 284px;
    height: 410px;
    margin: 8px;
    padding: 10px;
    border-radius: 20px;
    border-width: 2px;
}
.is-portrait .bg-card-thumb { height: 230px; border-radius: 14px; }
.is-portrait .bg-card.bg-card-variant { width: 284px; height: 520px; }
.is-portrait .bg-card.bg-card-variant .bg-card-thumb { height: 330px; }
.is-portrait .bg-card-thumb-glow,
.is-portrait .bg-card-thumb-glow-core { scale: 1.6 1.6; }
.is-portrait .bg-card-thumb-placeholder { font-size: 52px; }
.is-portrait .bg-card-name-row { margin-top: 12px; padding: 0 8px; }
.is-portrait .bg-card-name-row-single { margin-top: 8px; }
.is-portrait .bg-card-rarity-row { margin-top: 10px; padding: 0 8px; }
.is-portrait .bg-card-icon { font-size: 20px; margin-right: 8px; }
.is-portrait .bg-card-name { font-size: 20px; letter-spacing: 0.8px; }
.is-portrait .bg-card-badge { top: 10px; right: 10px; font-size: 14px; padding: 5px 11px; border-radius: 9px; }
.is-portrait .bg-card-lock-icon { font-size: 48px; }
.is-portrait .bg-card-price {
    font-size: 18px;
    padding: 6px 18px;
    border-radius: 16px;
    margin-top: 10px;
    margin-bottom: 4px;
}
.is-portrait .bg-card-state,
.is-portrait .bg-card-variant .bg-card-state,
.is-portrait .bg-card-pack .bg-card-state {
    font-size: 17px;
    padding: 7px 18px;
    border-radius: 14px;
    margin-top: 10px;
}
.is-portrait .rarity-pill {
    font-size: 15px;
    padding: 4px 12px;
    border-radius: 10px;
}

/* Paginación */
.is-portrait .shop2-pagination { height: 72px; margin-top: 10px; }
.is-portrait .shop2-page-arrow { width: 64px; height: 64px; border-radius: 32px; font-size: 32px; }
.is-portrait .shop2-page-dots { margin: 0 16px; }
.is-portrait .shop2-page-dot { width: 56px; height: 56px; border-radius: 28px; font-size: 22px; margin: 0 6px; }
.is-portrait .shop2-page-dot.page-active { width: 76px; }

/* Panel de detalle: hoja que sube desde abajo */
.is-portrait #shop-modal-view .shop2-detail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    min-width: 0;
    max-width: none;
    height: auto;
    max-height: 82%;
    padding: 24px;
    border-left-width: 0;
    border-top-width: 2px;
    border-top-color: rgba(201, 168, 74, 0.55);
    translate: 0 40px;
}
.is-portrait #shop-modal-view .shop2-detail.shop2-detail-open { translate: 0 0; }
.is-portrait #shop-modal-view .shop2-detail .shop2-hero {
    height: 300px;
    min-height: 300px;
    margin-bottom: 18px;
    border-radius: 20px;
}
.is-portrait #shop-modal-view .shop2-hero-content { left: 22px; right: 130px; bottom: 20px; }
.is-portrait #shop-modal-view .shop2-hero-kicker,
.is-portrait #shop-modal-view .shop2-detail.variant-detail .shop2-hero-kicker { font-size: 14px; letter-spacing: 2.5px; margin-bottom: 8px; }
.is-portrait #shop-modal-view .shop2-hero-title,
.is-portrait #shop-modal-view .shop2-detail.variant-detail .shop2-hero-title { font-size: 34px; margin-bottom: 6px; }
.is-portrait #shop-modal-view .shop2-hero-desc,
.is-portrait #shop-modal-view .shop2-detail.variant-detail .shop2-hero-desc { font-size: 19px; }
.is-portrait #shop-modal-view .shop2-hero-badge,
.is-portrait #shop-modal-view .shop2-detail.variant-detail .shop2-hero-badge { top: 16px; right: 16px; padding: 8px 16px; border-radius: 24px; }
.is-portrait #shop-modal-view .shop2-hero-badge-label { font-size: 16px; }
.is-portrait #shop-modal-view .shop2-detail-kicker { font-size: 15px; letter-spacing: 2.5px; margin-bottom: 12px; }
.is-portrait #shop-modal-view .shop2-detail-pricerow { margin-bottom: 14px; }
.is-portrait #shop-modal-view .shop2-detail-price,
.is-portrait #shop-modal-view .shop2-detail.variant-detail .shop2-detail-price { font-size: 34px; margin-right: 14px; }
.is-portrait #shop-modal-view .shop2-detail-stock { font-size: 16px; padding: 5px 14px; border-radius: 14px; }
.is-portrait #shop-modal-view .shop2-detail-hint { font-size: 19px; }
.is-portrait #shop-modal-view .shop2-detail.variant-detail .shop2-detail-ability { font-size: 16px; letter-spacing: 2px; margin-bottom: 8px; }
.is-portrait #shop-modal-view .shop2-detail.variant-detail .shop2-detail-lorewrap { padding: 16px 18px; border-radius: 14px; }
.is-portrait #shop-modal-view .shop2-detail-actions { margin-top: 18px; }
.is-portrait #shop-modal-view .shop2-detail .shop2-detail-cta {
    height: 88px;
    font-size: 24px;
    letter-spacing: 1.5px;
    border-radius: 16px;
}
.is-portrait #shop-modal-view .shop2-detail-close {
    height: 76px;
    margin-top: 16px;
    font-size: 20px;
    letter-spacing: 2px;
    border-radius: 16px;
}

/* Inicio de sesión de Surface y carga */
.is-portrait #shop-modal-view .shop2-login-card { width: 90%; max-width: 880px; padding: 34px 32px 26px 32px; border-radius: 24px; }
.is-portrait #shop-modal-view .shop2-login-icon-wrap { width: 88px; height: 88px; border-radius: 44px; margin-bottom: 16px; }
.is-portrait #shop-modal-view .shop2-login-icon { font-size: 40px; }
.is-portrait #shop-modal-view .shop2-login-kicker { font-size: 16px; letter-spacing: 3px; margin-bottom: 8px; }
.is-portrait #shop-modal-view .shop2-login-title { font-size: 36px; margin-bottom: 10px; }
.is-portrait #shop-modal-view .shop2-login-desc { font-size: 20px; margin-bottom: 24px; }
.is-portrait #shop-modal-view .shop2-field { margin-bottom: 18px; }
.is-portrait #shop-modal-view .shop2-field-label { font-size: 16px; letter-spacing: 2px; margin-bottom: 8px; }
.is-portrait #shop-modal-view .shop2-input > .unity-base-field__input {
    height: 76px;
    font-size: 24px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 14px;
}
.is-portrait #shop-modal-view .shop2-error { font-size: 18px; padding: 12px 14px; border-radius: 12px; }
.is-portrait #shop-modal-view .shop2-btn-primary,
.is-portrait #shop-modal-view .shop2-btn-ghost { height: 84px; font-size: 22px; letter-spacing: 1.2px; border-radius: 16px; }
.is-portrait #shop-modal-view .shop2-login-actions { margin-top: 8px; margin-bottom: 16px; }
.is-portrait #shop-modal-view .shop2-login-footnote { font-size: 14px; }
.is-portrait #shop-modal-view .shop2-loading-icon { font-size: 36px; margin-right: 14px; }
.is-portrait #shop-modal-view .shop2-loading-text { font-size: 22px; }
.is-portrait #shop-modal-view .shop2-loading-percent { font-size: 22px; }

/* ── Inventario ── */
.is-portrait .inv-watermark { width: 560px; height: 950px; right: -50px; bottom: -70px; }
.is-portrait .inv-crest { width: 66px; height: 66px; border-radius: 15px; margin-left: 14px; margin-right: 10px; }
.is-portrait .inv-crest-icon { font-size: 30px; }
.is-portrait .inv-crest-art { width: 56px; height: 56px; }
.is-portrait .inv-grid { padding: 4px 22px 26px 22px; }
.is-portrait .inv-card,
.is-portrait .inv-card.inv-card-wide {
    width: 31.5%;
    height: 344px;
    margin: 0.75%;
    padding: 18px 18px 0 18px;
}
.is-portrait .inv-card .bg-card-thumb,
.is-portrait .inv-card.inv-card-wide .bg-card-thumb { height: 200px; }
.is-portrait .inv-card-rule { height: 18px; margin-top: 7px; }
.is-portrait .inv-card .bg-card-name-row { height: 18px; margin-top: 1px; padding: 0 4px; }
.is-portrait .inv-card .bg-card-name { font-size: 13px; letter-spacing: 0.5px; }
.is-portrait .inv-card-note { height: 26px; font-size: 10px; margin-top: 3px; }
.is-portrait .inv-state { left: 20px; right: 20px; bottom: 15px; height: 32px; font-size: 11px; border-radius: 9px; }
.is-portrait .inv-mark { top: 24px; right: 24px; width: 26px; height: 26px; border-radius: 13px; font-size: 12px; }
.is-portrait .inv-type-chip { font-size: 9px; padding: 4px 9px; }
.is-portrait .inv-section { margin: 14px 0.75% 6px 0.75%; }
.is-portrait .inv-section-title { font-size: 11px; letter-spacing: 3px; }
.is-portrait .inv-section-note { font-size: 10px; }
.is-portrait .inv-loadout { padding: 12px; }
.is-portrait .inv-loadout-title { font-size: 11px; }
.is-portrait .inv-loadout-note { font-size: 10px; }
.is-portrait .inv-loadout-slots { margin-top: 10px; }
.is-portrait .inv-loadout-slot { height: 68px; }
.is-portrait .inv-loadout-art { width: 48px; height: 48px; }
.is-portrait .inv-loadout-name { font-size: 12px; }
.is-portrait .inv-empty { height: 220px; padding: 24px; border-radius: 18px; }
.is-portrait .inv-empty-title { font-size: 22px; margin-bottom: 10px; }
.is-portrait .inv-empty-desc { font-size: 18px; }

/* Pantallas estrechas: 3 columnas. Estas reglas van después de los tamaños
   genéricos de la tienda para que las cartas del inventario no hereden
   150x214 ni 284x520: la rejilla debe seguir siendo regular. */
.is-small .inv-tabs,
.is-tiny .inv-tabs { flex-wrap: wrap; padding: 10px 12px 4px 12px; }
.is-small .inv-tabs .shop2-tab,
.is-tiny .inv-tabs .shop2-tab { min-width: 130px; height: 42px; margin: 0 4px 4px 0; }
.is-small .inv-tab-hint,
.is-tiny .inv-tab-hint { display: none; }
.is-small .inv-filter-row,
.is-tiny .inv-filter-row { flex-wrap: wrap; padding: 4px 12px 6px 24px; }
.is-small .inv-filter-label,
.is-tiny .inv-filter-label { font-size: 10px; margin-right: 6px; }
.is-small .inv-filter-row .skin-filter-btn,
.is-tiny .inv-filter-row .skin-filter-btn { height: 26px; padding: 0 10px; font-size: 11px; }
.is-small .inv-window .prog-footer,
.is-tiny .inv-window .prog-footer { padding: 8px 12px; }
.is-small .inv-window .shop2-topbar .shop2-back-btn,
.is-tiny .inv-window .shop2-topbar .shop2-back-btn { margin-left: 0; }
.is-small .inv-grid { padding: 4px 12px 18px 12px; }
.is-small .inv-card,
.is-small .inv-card.inv-card-wide {
    width: 31.5%;
    height: 302px;
    margin: 0.75%;
    padding: 15px 15px 0 15px;
}
.is-small .inv-card .bg-card-thumb,
.is-small .inv-card.inv-card-wide .bg-card-thumb { height: 172px; }
.is-small .inv-card-rule { height: 16px; margin-top: 6px; }
.is-small .inv-card .bg-card-name-row { height: 16px; margin-top: 1px; padding: 0 2px; }
.is-small .inv-card .bg-card-name { font-size: 11px; }
.is-small .inv-card-note { height: 22px; font-size: 8.5px; margin-top: 2px; }
.is-small .inv-state { left: 17px; right: 17px; bottom: 12px; height: 28px; font-size: 9px; }
.is-small .inv-mark { top: 20px; right: 20px; width: 22px; height: 22px; border-radius: 11px; font-size: 10px; }
.is-small .inv-type-chip { left: 20px; top: 20px; padding: 2px 7px; font-size: 8px; }
.is-small .inv-loadout { padding: 8px 10px 10px 10px; }
.is-small .inv-loadout-slot { height: 54px; margin-right: 6px; padding: 5px 16px 5px 7px; }
.is-small .inv-loadout-art { width: 36px; height: 36px; margin-right: 7px; }
.is-small .inv-loadout-name { font-size: 10px; }
.is-small .inv-loadout-tag { font-size: 7.5px; letter-spacing: 1.2px; }
.is-small .inv-loadout-note { display: none; }

/* Ventanas pequeñas: 2 columnas y tipografía compacta. */
.is-tiny .inv-card,
.is-tiny .inv-card.inv-card-wide {
    width: 48.5%;
    height: 292px;
    padding: 14px 14px 0 14px;
}
.is-tiny .inv-card .bg-card-thumb,
.is-tiny .inv-card.inv-card-wide .bg-card-thumb { height: 164px; }
.is-tiny .inv-card-rule { height: 15px; margin-top: 5px; }
.is-tiny .inv-card .bg-card-name-row { height: 16px; margin-top: 1px; }
.is-tiny .inv-card .bg-card-name { font-size: 11px; }
.is-tiny .inv-card-note { height: 20px; font-size: 8.5px; margin-top: 1px; }
.is-tiny .inv-state { left: 16px; right: 16px; bottom: 11px; height: 26px; font-size: 9px; }
.is-tiny .inv-mark { top: 19px; right: 19px; width: 21px; height: 21px; border-radius: 11px; font-size: 10px; }
.is-tiny .inv-type-chip { left: 19px; top: 19px; padding: 2px 6px; font-size: 8px; }
.is-tiny .inv-loadout-slot { height: 50px; margin-right: 5px; padding: 4px 14px 4px 6px; }
.is-tiny .inv-loadout-art { width: 32px; height: 32px; margin-right: 6px; }
.is-tiny .inv-loadout-name { font-size: 9px; }
.is-tiny .inv-loadout-tag { font-size: 7px; letter-spacing: 1px; }

/* ── TUS PIEZAS: una columna con pestañas ── */
.is-portrait #your-pieces-modal-view { padding: 0; }
.is-portrait .your-pieces-dual-container {
    flex-direction: column;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border-width: 0;
    border-radius: 0;
}
.is-portrait .dual-divider { display: none; }

.ypm-tabs {
    display: none;
    flex-direction: row;
    flex-shrink: 0;
    background-color: #0a0f1e;
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 179, 106, 0.22);
}
.is-portrait .ypm-tabs { display: flex; }
.ypm-tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 88px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: transparent;
    border-radius: 0;
    background-color: transparent;
    color: #8a9bb5;
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}
.ypm-tab-active {
    color: #f0d27a;
    border-bottom-color: #f0d27a;
    background-color: rgba(212, 179, 106, 0.10);
}

.ypm-tab:hover {
    color: #cddcf0;
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(212, 179, 106, 0.45);
}

.ypm-tab.ypm-tab-active:hover {
    color: #f0d27a;
    background-color: rgba(212, 179, 106, 0.18);
    border-bottom-color: #f0d27a;
}

.ypm-tab:active {
    scale: 0.97 0.97;
}

.is-portrait .left-panel,
.is-portrait .encyclopedia-side-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: 100%;
    min-width: 0;
    max-width: none;
    min-height: 0;
    max-height: none;
}
.is-portrait .encyclopedia-side-panel { display: none; }
.is-portrait .show-ency .encyclopedia-side-panel { display: flex; }
.is-portrait .show-ency .left-panel { display: none; }

.is-portrait .your-pieces-header { padding: 26px 28px 22px 28px; }
.is-portrait .vault-header-icon-wrap { width: 76px; height: 76px; border-radius: 38px; margin-right: 20px; }
.is-portrait .vault-header-icon { font-size: 36px; }
.is-portrait .your-pieces-title { font-size: 34px; letter-spacing: 2px; margin-bottom: 6px; }
.is-portrait .your-pieces-subtitle { font-size: 20px; }
.is-portrait .your-pieces-content-scroll { padding: 24px 24px 10px 24px; }

.is-portrait .pedestal-section { margin-bottom: 22px; }
.is-portrait .pedestal-section-header { margin-bottom: 20px; }
.is-portrait .pedestal-title,
.is-portrait .variant-section-title { font-size: 22px; letter-spacing: 1.6px; }
.is-portrait .pedestal-row,
.is-portrait .variant-cards-row { flex-direction: column; align-items: stretch; }

.is-portrait .pedestal-card,
.is-portrait .piece-variant-card {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 100%;
    margin: 10px 0;
    padding: 0 0 28px 0;
    border-radius: 26px;
    border-width: 3px;
}
.is-portrait .pedestal-ribbon { height: 58px; margin-bottom: 8px; }
.is-portrait .ribbon-label,
.is-portrait .variant-card-badge { font-size: 22px; letter-spacing: 2px; }
.is-portrait .pedestal-portrait,
.is-portrait .variant-portrait { height: 340px; margin-top: 8px; margin-bottom: 8px; }
.is-portrait .pedestal-glow,
.is-portrait .variant-portrait-glow { width: 320px; height: 170px; top: 40px; border-radius: 28px; }
.is-portrait .pedestal-stone { bottom: 26px; width: 300px; height: 34px; border-radius: 8px; }
.is-portrait .pedestal-stone-top,
.is-portrait .top-necro { height: 10px; }
.is-portrait .pedestal-figure,
.is-portrait .variant-portrait-img { bottom: 56px; width: 230px; height: 230px; }
.is-portrait .pedestal-rune { font-size: 56px; }
.is-portrait .rune-left { left: 28px; }
.is-portrait .rune-right { right: 28px; }
.is-portrait .pedestal-name,
.is-portrait .variant-card-title { font-size: 38px; margin-top: 14px; margin-bottom: 4px; }
.is-portrait .pedestal-role,
.is-portrait .variant-card-role { font-size: 21px; letter-spacing: 1.5px; margin-bottom: 14px; }
.is-portrait .pedestal-divider,
.is-portrait .variant-card-divider { width: 70%; height: 2px; margin-bottom: 20px; }
.is-portrait .pedestal-desc,
.is-portrait .variant-card-desc {
    font-size: 23px;
    padding: 0 36px;
    margin-bottom: 26px;
    min-height: 0;
}
.is-portrait .pedestal-btn,
.is-portrait .btn-variant-action {
    width: 82%;
    height: 92px;
    border-radius: 16px;
    font-size: 26px;
    letter-spacing: 1.5px;
    border-width: 2px;
}

.is-portrait .your-pieces-footer { padding: 18px 24px 26px 24px; }
.is-portrait .btn-your-pieces-back,
.is-portrait .vault-volver {
    width: 100%;
    height: 84px;
    border-radius: 16px;
    font-size: 26px;
    letter-spacing: 2px;
}

/* Enciclopedia */
.is-portrait .encyclopedia-side-panel .encyclopedia-header { padding: 26px 28px 22px 28px; }
.is-portrait .encyclopedia-side-panel .encyclopedia-title { font-size: 34px; letter-spacing: 2px; margin-bottom: 6px; }
.is-portrait .encyclopedia-side-panel .encyclopedia-subtitle { font-size: 20px; }
.is-portrait .encyclopedia-side-panel .encyclopedia-filter-row { padding: 18px 20px; }
.is-portrait .ency-filter-btn {
    height: 68px;
    padding: 0 28px;
    margin: 6px;
    border-radius: 16px;
    font-size: 22px;
    letter-spacing: 1px;
}
.is-portrait .encyclopedia-side-panel .encyclopedia-scroll { padding: 0 20px 14px 20px; }
.is-portrait .encyclopedia-side-panel .ency-card { margin: 10px 0; padding: 24px; border-radius: 24px; }
.is-portrait .ency-card-header { padding: 20px 22px 18px 22px; border-radius: 16px; margin-bottom: 18px; }
.is-portrait .ency-rarity { font-size: 17px; padding: 6px 18px; margin-bottom: 14px; border-radius: 10px; }
.is-portrait .ency-name { font-size: 38px; letter-spacing: 3px; margin-bottom: 8px; }
.is-portrait .ency-type { font-size: 17px; letter-spacing: 2.5px; margin-bottom: 16px; }
.is-portrait .ency-header-gem { font-size: 14px; }
.is-portrait .ency-stats { padding: 14px 16px; margin-bottom: 16px; border-radius: 12px; }
.is-portrait .ency-stat-label { font-size: 17px; margin-bottom: 4px; }
.is-portrait .ency-stat-value { font-size: 21px; }
.is-portrait .ency-ability { padding: 16px 18px; margin-bottom: 12px; border-radius: 14px; border-left-width: 5px; }
.is-portrait .ency-ability-title { font-size: 23px; margin-bottom: 6px; }
.is-portrait .ency-ability-desc { font-size: 20px; }
.is-portrait .ency-lore,
.is-portrait .ency-tip-box { font-size: 19px; padding: 16px 18px; margin-top: 10px; border-radius: 14px; }
.is-portrait .ency-tip { font-size: 18px; }
.is-portrait .encyclopedia-side-panel .encyclopedia-tip { padding: 18px 24px; font-size: 17px; }
/* Móvil: las tarjetas de tiempo salen del cajón de las esquinas y quedan debajo
   en cuadrícula, así que las flechas diagonales (que apuntaban a las esquinas) se
   cambian por flechas hacia abajo, hacia las tarjetas. */
.time-hint-down { display: none; }
.is-narrow .time-hint-arrow-wrap { display: none; }
.is-narrow .time-hint-stem { display: none; }
.is-narrow .time-hint-down {
    display: flex;
    font-size: 22px;
    color: rgba(212, 179, 106, 0.95);
    -unity-text-align: middle-center;
}
.is-narrow .time-hint-label { margin: 0 18px; }
.is-portrait .time-hint-down { font-size: 30px; }
.is-portrait .time-hint-label { font-size: 20px; letter-spacing: 3px; }
.is-portrait .time-control-title { font-size: 22px; }

/* ── Feedback de click global ─────────────────────────────────────────────
   Muchos botones de la UI solo tenian :hover y nada al presionar, asi que
   al hacer click seguian viendo el estado "hover" (mas grande) en vez de
   hundirse. Esta regla cubre los que no definen su propio :active.

   Se escribe Button:hover:active y no solo Button:active a proposito: al
   mantener pulsado un boton con hover estan activas las dos pseudo-clases, y
   Button:active (0,1,1) perderia contra un .clase:hover (0,2,0), dejando el
   boton enlargementado durante el click. Con las dos pseudo-clases la
   especificidad sube a (0,2,1) y gana siempre.

   Solo toca `scale`, que es el idioma que ya usa el resto del archivo
   (.btn-primary:active, .btn-secondary:active, .btn-danger:active), asi que
   no pelea con los colores de ningun boton. */
Button:hover:active {
    scale: 0.97 0.97;
}

/* ── Feedback de click de los pseudo-botones ──────────────────────────────
   Los selectores de arriba son del tipo literal Button, asi que no alcanzan a
   las tarjetas que se comportan como boton sin serlo: son VisualElement con un
   ClickEvent y no un Button, y por eso se les quedaba enganchado el estado
   hover (mas grandes) mientras se las mantenia presionadas, en vez de hundirse. */
.diff-card:hover:active,
.bg-card:hover:active {
    scale: 0.98 0.98;
}
/* La .diff-card ademas se levanta 4px al pasar el cursor: al presionar tiene
   que volver a su sitio, o el salto de "sube" a "baja" queda a medio camino. */
.diff-card:hover:active {
    translate: 0 0;
}

/* ══════════════════════════════════════════════════════════
   TIENDA DE LA VELADA (VIEW 11)
   El destino de los Dulces de Halloween: pestañas GAMBITS /
   NIVELES / SKINS / VARIANTES, con fichas compactas y CTA de
   estado (comprar si alcanza, «en tu inventario» si ya es
   tuya). La tienda vende; el inventario equipa.
   ══════════════════════════════════════════════════════════ */
.hwshop-root {
    padding: 0;
    background-color: rgba(6, 3, 14, 0.82);
}
.hwshop-window {
    width: 92%;
    max-width: 1080px;
    height: 90%;
    max-height: 800px;
    background-color: #0a0518;
    border-width: 1.5px;
    border-color: rgba(201, 168, 74, 0.5);
}
.hwshop-topbar {
    background-color: #12082a;
    border-bottom-color: rgba(126, 60, 168, 0.45);
    padding: 10px 16px;
}
.hwshop-chips {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
}
.hwshop-chip {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin-left: 8px;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 16px;
    background-color: rgba(24, 12, 44, 0.9);
    border-color: rgba(126, 60, 168, 0.5);
}
.hwshop-chip-dulces  { border-color: rgba(224, 161, 124, 0.55); }
.hwshop-chip-gambits { border-color: rgba(186, 128, 255, 0.55); }
.hwshop-chip-icon {
    font-size: 13px;
    margin-right: 6px;
}
/* El chip de Gambits lleva la moneda-corona (sprite), no un glifo. */
.hwshop-chip-icon.gambits-icon { width: 16px; height: 16px; }
.hwshop-chip-text {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    color: #f6eeff;
}
.hwshop-topbar .hw-state-chip { margin-left: 10px; }

/* Pestañas: la activa se enciende en dorado de la velada. */
.hwshop-tabs {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 10px 18px 0 18px;
}
.hwshop-tab {
    height: 34px;
    margin: 0 8px 0 0;
    padding: 0 16px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    color: #a293c4;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.35);
    border-radius: 17px;
    transition-property: background-color, border-color, color, opacity;
    transition-duration: 0.16s;
}
.hwshop-tab:hover {
    background-color: rgba(126, 60, 168, 0.22);
    color: #e3caff;
}
.hwshop-tab-active {
    color: #1a0f2e;
    background-color: #c9a84a;
    border-color: #f0d27a;
}

/* Cuerpo con scroll: una pestaña por vez. */
.hwshop-body-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}
.hwshop-body-scroll .unity-scroller--vertical {
    width: 10px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}
.hwshop-body-scroll .unity-base-slider__tracker {
    background-color: rgba(14, 8, 30, 0.65);
    border-width: 0;
    border-radius: 5px;
}
.hwshop-body-scroll .unity-base-slider__dragger {
    background-color: rgba(142, 92, 201, 0.5);
    border-width: 0;
    border-radius: 5px;
}
.hwshop-body-scroll .unity-base-slider__dragger:hover {
    background-color: rgba(186, 128, 255, 0.8);
}
.hwshop-body-scroll .unity-scroller__low-button,
.hwshop-body-scroll .unity-scroller__high-button {
    display: none;
}
.hwshop-body {
    flex-grow: 1;
    padding: 12px 22px 22px 22px;
}
.hwshop-pane { flex-grow: 1; }
.hwshop-pane.hidden { display: none; }

.hwshop-section-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    margin-bottom: 2px;
}
.hwshop-section-title {
    flex-shrink: 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: #e3caff;
}
.hwshop-section-line {
    flex-grow: 1;
    height: 1px;
    margin-left: 12px;
    background-color: rgba(201, 168, 74, 0.35);
}
.hwshop-section-note {
    flex-shrink: 1;
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 0.8px;
    color: #a293c4;
    -unity-text-align: middle-left;
    white-space: normal;
}
.hwshop-list {
    flex-direction: column;
    margin-top: 6px;
}

/* Ficha de la tienda */
.hwshop-card {
    flex-direction: row;
    align-items: center;
    margin: 5px 0;
    padding: 12px 16px;
    background-color: rgba(24, 13, 42, 0.85);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.35);
    border-left-width: 4px;
    border-left-color: rgba(201, 168, 74, 0.55);
    border-radius: 12px;
    transition-property: background-color, border-color;
    transition-duration: 0.16s;
}
.hwshop-card:hover {
    background-color: rgba(34, 18, 58, 0.95);
    border-color: rgba(186, 128, 255, 0.55);
}
/* «Completar todo el pase»: el atajo de lujo, en ascuas. */
.hwshop-card-complete {
    background-color: rgba(42, 19, 26, 0.9);
    border-left-color: #e0a17c;
}
.hwshop-card-complete:hover {
    background-color: rgba(56, 26, 34, 0.95);
    border-color: rgba(224, 161, 124, 0.6);
}
.hwshop-card-equipped { opacity: 0.72; }
.hwshop-thumb {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 5, 24, 0.72);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.5);
    border-radius: 12px;
}
.hwshop-thumb-img {
    width: 86%;
    height: 86%;
}
.hwshop-thumb-icon {
    font-size: 26px;
    -unity-text-align: middle-center;
}
.hwshop-card-body {
    flex-grow: 1;
    min-width: 0;
}
.hwshop-card-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #f6eeff;
    white-space: normal;
}
.hwshop-card-note {
    margin-top: 2px;
    font-size: 11px;
    color: #a293c4;
    white-space: normal;
}
.hwshop-card-price {
    margin-top: 4px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    color: #f0d27a;
}
.hwshop-card-price-lux { color: #f3b58a; }

/* ── Visor de vista previa (pestaña SKINS) ──────────────────────────────
   La única mejora extra de la tienda: las dos caras de la escultura
   elegida, con tipo, rareza y precio. No compra ni equipa. ── */
.hwshop-preview {
    margin: 10px 0 6px 0;
    padding: 14px 16px 12px 16px;
    background-color: rgba(18, 8, 34, 0.92);
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.36);
    border-left-width: 4px;
    border-left-color: rgba(201, 168, 74, 0.62);
    border-radius: 14px;
}
.hwshop-preview.hidden { display: none; }
.hwshop-preview-head {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
}
.hwshop-preview-kicker {
    margin-right: 12px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #c9a84a;
}
.hwshop-preview-name {
    margin-right: 12px;
    font-size: 19px;
    -unity-font-style: bold;
    color: #f6eeff;
    white-space: normal;
}
.hwshop-preview-meta {
    font-size: 10px;
    letter-spacing: 0.8px;
    color: #a293c4;
    white-space: normal;
}
.hwshop-preview-stage {
    flex-direction: row;
    margin-top: 10px;
}
.hwshop-preview-side {
    flex-grow: 1;
    flex-basis: 0;
    height: 210px;
    margin: 0 5px;
    padding: 8px;
    align-items: center;
    background-color: rgba(8, 4, 18, 0.66);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.42);
    border-radius: 10px;
}
.hwshop-preview-side.hidden { display: none; }
.hwshop-preview-caption {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2.4px;
    color: #8d7cb0;
}
.hwshop-preview-art {
    flex-grow: 1;
    width: 100%;
    margin-top: 4px;
}
.hwshop-preview-art.hidden { display: none; }
.hwshop-preview-empty {
    flex-grow: 1;
    font-size: 30px;
    color: #6b5a8e;
    -unity-text-align: middle-center;
}
.hwshop-preview-empty.hidden { display: none; }
.hwshop-preview-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}
.hwshop-preview-chip {
    height: 26px;
    margin: 4px 6px 0 0;
    padding: 0 12px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    color: #a293c4;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.35);
    border-radius: 13px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.16s;
}
.hwshop-preview-chip:hover {
    background-color: rgba(126, 60, 168, 0.22);
    color: #e3caff;
}
.hwshop-preview-chip-active {
    color: #1a0f2e;
    background-color: #c9a84a;
    border-color: #f0d27a;
}

/* CTA: comprar (botón dorado) o estado (etiqueta) */
.hwshop-cta {
    flex-shrink: 0;
    align-self: center;
    margin-left: 14px;
    height: 40px;
    padding: 0 18px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    color: #1a0f2e;
    background-color: #c9a84a;
    border-width: 1px;
    border-color: #f0d27a;
    border-radius: 10px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.16s;
}
.hwshop-cta:hover {
    background-color: #e8c66a;
    border-color: #ffe9ae;
}
.hwshop-state {
    flex-shrink: 0;
    align-self: center;
    margin-left: 14px;
    padding: 8px 14px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    color: #a293c4;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(126, 60, 168, 0.35);
    border-radius: 9px;
    white-space: normal;
}
.hwshop-state-on {
    color: #b6f0c8;
    background-color: rgba(40, 90, 60, 0.25);
    border-color: rgba(110, 220, 150, 0.5);
}
.hwshop-state-owned {
    color: #e3caff;
    background-color: rgba(126, 60, 168, 0.2);
    border-color: rgba(186, 128, 255, 0.5);
}
.hwshop-state-off {
    color: #e0a17c;
    border-color: rgba(224, 161, 124, 0.45);
}
.hwshop-state-locked { color: #8d7cb0; }

.hwshop-hint {
    margin: 12px 2px 0 2px;
    font-size: 10px;
    letter-spacing: 0.4px;
    color: #7d6ba3;
    white-space: normal;
}
.hwshop-footer {
    flex-shrink: 0;
    padding: 6px 16px;
}

/* ── TIENDA DE LA VELADA — móvil en vertical (.is-portrait)
   Misma receta que el pase: tipografías grandes, fichas apiladas y
   la acción a lo ancho para el pulgar. ── */
.is-portrait .hwshop-window {
    width: 96%;
    height: 92%;
    max-height: none;
}
.is-portrait .hwshop-topbar { flex-wrap: wrap; padding: 12px 16px; }
.is-portrait .hwshop-topbar .shop2-brand { display: none; }
.is-portrait .hwshop-chips {
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
    margin-left: 0;
    margin-top: 8px;
}
.is-portrait .hwshop-chip {
    height: 40px;
    margin: 4px;
    padding: 0 16px;
    border-radius: 20px;
}
.is-portrait .hwshop-chip-icon { font-size: 20px; margin-right: 8px; }
.is-portrait .hwshop-chip-icon.gambits-icon { width: 22px; height: 22px; }
.is-portrait .hwshop-chip-text { font-size: 18px; }
.is-portrait .hwshop-tabs { padding: 10px 12px 0 12px; }
.is-portrait .hwshop-tab {
    height: 44px;
    margin: 4px 6px 0 0;
    padding: 0 16px;
    font-size: 14px;
    letter-spacing: 1.6px;
    border-radius: 22px;
}
.is-portrait .hwshop-body { padding: 12px 14px 18px 14px; }
.is-portrait .hwshop-section-title { font-size: 18px; }
.is-portrait .hwshop-section-note { display: none; }
.is-portrait .hwshop-card { flex-wrap: wrap; padding: 14px 16px; }
.is-portrait .hwshop-card-body { min-width: 140px; }
.is-portrait .hwshop-card-title { font-size: 20px; }
.is-portrait .hwshop-card-note { font-size: 15px; }
.is-portrait .hwshop-card-price { font-size: 17px; }
.is-portrait .hwshop-preview { padding: 14px; }
.is-portrait .hwshop-preview-kicker { font-size: 13px; letter-spacing: 2px; }
.is-portrait .hwshop-preview-name { font-size: 24px; }
.is-portrait .hwshop-preview-meta { font-size: 14px; }
.is-portrait .hwshop-preview-side { height: 250px; }
.is-portrait .hwshop-preview-caption { font-size: 13px; }
.is-portrait .hwshop-preview-empty { font-size: 40px; }
.is-portrait .hwshop-preview-chip {
    height: 40px;
    padding: 0 16px;
    font-size: 15px;
    border-radius: 20px;
}
.is-portrait .hwshop-thumb {
    width: 72px;
    height: 72px;
    margin-right: 16px;
    border-radius: 16px;
}
.is-portrait .hwshop-thumb-icon { font-size: 38px; }
.is-portrait .hwshop-cta {
    width: 100%;
    margin: 12px 0 0 0;
    height: 56px;
    font-size: 17px;
    border-radius: 12px;
}
.is-portrait .hwshop-state {
    width: 100%;
    margin: 12px 0 0 0;
    padding: 14px;
    -unity-text-align: middle-center;
    font-size: 15px;
    border-radius: 12px;
}
.is-portrait .hwshop-hint { font-size: 14px; }
.is-portrait .hwshop-footer {
    flex-direction: column;
    align-items: stretch;
    padding: 14px 24px 22px 24px;
}
.is-portrait .hwshop-footer .prog-footer-note {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 14px;
}
.is-portrait .hwshop-footer .prog-footer-btn {
    width: 100%;
    min-width: 0;
    height: 76px;
    font-size: 24px;
    letter-spacing: 2px;
    border-radius: 14px;
}

/* ═══════════════════════════════════════════════════════════════════════
   CARRITO DEL ATELIER
   Botón del topbar, CTA secundario del detalle y overlay de compra.
   ═══════════════════════════════════════════════════════════════════════ */

/* ── Botón del topbar (icono + rótulo + contador) ── */
.shop2-cart-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 52px;
    min-width: 106px;
    padding: 0 14px;
    margin-right: 12px;
    background-color: rgba(201, 168, 74, 0.06);
    border-width: 1.5px;
    border-color: rgba(201, 168, 74, 0.42);
    border-radius: 12px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.18s;
}
.shop2-cart-btn:hover {
    background-color: rgba(201, 168, 74, 0.14);
    border-color: #c9a84a;
    scale: 1.02 1.02;
}
.shop2-cart-btn.has-items {
    background-color: rgba(201, 168, 74, 0.13);
    border-color: #c9a84a;
}
.shop2-cart-icon {
    font-size: 18px;
    margin-right: 7px;
}
.shop2-cart-label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    color: #c9a84a;
}
.shop2-cart-count {
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    margin-left: 8px;
    border-radius: 11px;
    background-color: #c9a84a;
    color: #1a1400;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── CTA secundario del panel de detalle ── */
.shop2-detail .shop2-detail-cart {
    width: 100%;
    flex-grow: 0;
    height: 38px;
    margin: 8px 0 0 0;
    font-size: 11px;
    letter-spacing: 1px;
}
.shop2-detail .shop2-detail-cart:disabled {
    opacity: 0.72;
    color: #8fbfa0;
    border-color: rgba(143, 191, 160, 0.45);
    background-color: rgba(143, 191, 160, 0.08);
}

/* ── Overlay ── */
.shop-cart-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    padding: 24px;
    background-color: rgba(3, 5, 12, 0.88);
}
.shop-cart-window {
    width: 54%;
    min-width: 420px;
    max-width: 640px;
    height: 78%;
    min-height: 360px;
    max-height: 660px;
    flex-direction: column;
    background-color: #0a1122;
    border-width: 1.5px;
    border-color: #c9a84a;
    border-radius: 18px;
    padding: 18px;
    overflow: hidden;
}
.shop-cart-head {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    flex-shrink: 0;
    padding-bottom: 12px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 168, 74, 0.22);
}
.shop-cart-head-texts {
    flex-grow: 1;
    flex-direction: column;
}
.shop-cart-kicker {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #f0d27a;
    margin-bottom: 4px;
}
.shop-cart-subtitle {
    font-size: 11px;
    color: #8a9bb5;
    white-space: normal;
}
.shop-cart-close {
    width: 34px;
    height: 34px;
    margin-left: 12px;
    padding: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(224, 124, 124, 0.45);
    background-color: transparent;
    color: #e07c7c;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.shop-cart-close:hover {
    background-color: rgba(224, 124, 124, 0.14);
    border-color: #e07c7c;
}

/* ── Lista ── */
.shop-cart-scroll {
    flex-grow: 1;
    width: 100%;
    min-height: 80px;
}
.shop-cart-list {
    width: 100%;
    padding: 6px 2px 2px 2px;
}
.shop-cart-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding: 9px 10px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(122, 138, 176, 0.16);
    border-radius: 12px;
}
.shop-cart-thumb {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-color: #070d1c;
    border-width: 1px;
    border-color: rgba(201, 168, 74, 0.20);
    border-radius: 10px;
    overflow: hidden;
}
.shop-cart-thumb-img {
    width: 100%;
    height: 100%;
}
.shop-cart-thumb-icon {
    font-size: 26px;
    color: #c9a84a;
    -unity-text-align: middle-center;
}
.shop-cart-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    margin-left: 12px;
}
.shop-cart-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: #f2ead4;
    white-space: normal;
}
.shop-cart-kind {
    font-size: 9px;
    letter-spacing: 1.4px;
    color: #7a8ab0;
    margin-top: 3px;
}
.shop-cart-price-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 10px;
}
.shop-cart-price {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f0d27a;
    flex-shrink: 0;
}
.shop-cart-price-tides {
    color: #6fc3e8;
    margin-left: 10px;
}
.shop-cart-remove {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-left: 10px;
    padding: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(224, 124, 124, 0.40);
    background-color: transparent;
    color: #e07c7c;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.shop-cart-remove:hover {
    background-color: rgba(224, 124, 124, 0.16);
    border-color: #e07c7c;
}

/* ── Vacío ── */
.shop-cart-empty {
    flex-grow: 1;
    width: 100%;
    justify-content: center;
    align-items: center;
    padding: 18px;
}
.shop-cart-empty-icon {
    font-size: 44px;
    color: rgba(201, 168, 74, 0.55);
    margin-bottom: 10px;
}
.shop-cart-empty-title {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #f0d27a;
    margin-bottom: 8px;
}
.shop-cart-empty-desc {
    font-size: 11px;
    color: #8a9bb5;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 360px;
    margin-bottom: 18px;
}
.shop-cart-browse {
    width: 210px;
    flex-grow: 0;
    margin-left: 0;
}

/* ── Estado / errores ── */
.shop-cart-status {
    width: 100%;
    flex-shrink: 0;
    margin-top: 8px;
    padding: 9px 12px;
    border-radius: 10px;
    background-color: rgba(111, 195, 232, 0.10);
    border-width: 1px;
    border-color: rgba(111, 195, 232, 0.35);
}
.shop-cart-status-error {
    background-color: rgba(224, 124, 124, 0.12);
    border-color: rgba(224, 124, 124, 0.50);
}
.shop-cart-status-label {
    font-size: 11px;
    color: #9ecfe6;
    white-space: normal;
}
.shop-cart-status-error .shop-cart-status-label {
    color: #f0a0a0;
}

/* ── Pie: total y acciones ── */
.shop-cart-foot {
    flex-direction: row;
    align-items: center;
    width: 100%;
    flex-shrink: 0;
    margin-top: 10px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(201, 168, 74, 0.22);
}
.shop-cart-total-wrap {
    flex-grow: 1;
    flex-direction: column;
}
.shop-cart-total-kicker {
    font-size: 9px;
    letter-spacing: 2px;
    color: #7a8ab0;
    margin-bottom: 2px;
}
.shop-cart-total {
    flex-direction: row;
    align-items: center;
}
.shop-cart-total-row {
    flex-direction: row;
    align-items: center;
}
.shop-cart-total-text {
    font-size: 20px;
    -unity-font-style: bold;
    color: #f0d27a;
}
.shop-cart-clear {
    width: 86px;
    flex-grow: 0;
    margin: 0 10px 0 0;
    height: 44px;
    font-size: 11px;
}
.shop-cart-pay {
    flex-grow: 1;
    height: 46px;
    margin-left: 0;
}
.shop-cart-pay:disabled {
    opacity: 0.45;
}
.shop-cart-footnote {
    font-size: 9px;
    color: #6b7897;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 8px;
    flex-shrink: 0;
}

/* ── Aviso flotante de la tienda ── */
.shop-toast {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 26px;
    padding: 11px 16px;
    border-radius: 12px;
    background-color: #0c152b;
    border-width: 1.5px;
    border-color: #c9a84a;
    color: #f0d27a;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}
.shop-toast-error {
    border-color: #e07c7c;
    color: #f0a0a0;
}

/* ── Ajustes para pantallas verticales ── */
.is-portrait .shop2-cart-btn {
    min-width: 0;
    height: 44px;
    padding: 0 10px;
    margin-right: 8px;
}
.is-portrait .shop2-cart-label { display: none; }
.is-portrait .shop2-cart-icon { margin-right: 0; }
.is-portrait .shop-cart-window {
    width: 100%;
    min-width: 0;
    max-width: none;
    height: 88%;
    max-height: none;
    padding: 14px;
}
.is-portrait .shop-cart-row { padding: 8px; }
.is-portrait .shop-cart-thumb { width: 52px; height: 52px; }
.is-portrait .shop-cart-name { font-size: 16px; }
.is-portrait .shop-cart-kind { font-size: 11px; }
.is-portrait .shop-cart-price { font-size: 15px; }
.is-portrait .shop-cart-remove { width: 38px; height: 38px; }
.is-portrait .shop-cart-foot {
    flex-direction: column;
    align-items: stretch;
}
.is-portrait .shop-cart-total-wrap {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}
.is-portrait .shop-cart-clear {
    width: 100%;
    margin: 0 0 8px 0;
    height: 50px;
}
.is-portrait .shop-cart-pay { height: 54px; }
.is-portrait .shop-toast { left: 6%; right: 6%; font-size: 14px; }