  m_Script: {fileID: 11500000, guid: 60c2b4bf9302e2549a0bee3849d65e00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WildWeapon.UI.MenuModeInfo
  modes:
  - title: DUELO 1 VS 1
    blurb: "Dos jugadores en la misma arena, mejor de tres rondas. A los 75 segundos entra el Overdrive y el da\xF1o se multiplica x1.5 hasta que alguien caiga."
    chips:
    - "LOCAL \xB7 2 JUGADORES"
    - MEJOR DE 3
    - OVERDRIVE x1.5
    accent: {r: 0.26, g: 0.88, b: 1, a: 1}
  - title: PVP ONLINE
    blurb: "Emparejamiento en vivo contra otro jugador. El servidor arbitra las rondas y comparte la semilla, as\xED los dos pelean exactamente la misma arena."
    chips:
    - ONLINE 1 VS 1
    - EL SERVIDOR ARBITRA
    - MISMA SEMILLA
    accent: {r: 0.72, g: 0.45, b: 1, a: 1}
  - title: SUPERVIVENCIA VS BOTS
    blurb: "Oleadas cada vez m\xE1s duras: drones sierra, androides lanceros y caballeros pesados. Entre oleada y oleada recuper\xE1s vida y arranca la siguiente."
    chips:
    - OLEADAS CRECIENTES
    - 3 ARQUETIPOS
    - +30 DE VIDA
    accent: {r: 1, g: 0.62, b: 0.18, a: 1}
  - title: SALIR
    blurb: "Cerr\xE1s el juego y volv\xE9s al escritorio. Adentro de la arena pod\xE9s volver a este men\xFA cuando quieras con Esc."
    chips:
    - "ESC \xB7 VOLVER AL MEN\xDA"
    - CIERRA EL JUEGO
    accent: {r: 0.62, g: 0.68, b: 0.78, a: 1}
  group: {fileID: 1679906534}
