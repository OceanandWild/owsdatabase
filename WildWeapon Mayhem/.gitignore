# Unity - carpetas generadas, nunca se versionan
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Los .meta SÍ se versionan (sin ellos Unity pierde el GUID de cada asset).
!/[Aa]ssets/**/*.meta

# Soluciones y proyectos autogenerados por Unity
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Reportes de crash
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# IDE
.vs/
.idea/

# Sistema
.DS_Store
Thumbs.db
.studio/
node_modules
.git.studio-backup
dist/
output/
.env
.playwright-cli/

# Tooling local (Aura) - no pertenece al juego
/.Aura/
/studio.json
/Packages/Aura/

# Unity: carpeta de recuperacion de escenas tras un crash
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
