                            <ui:VisualElement class="variant-cards-row pedestal-row pedestal-row-three">

                                <!-- CARD 1: DAMA CLÁSICA — bloque mármol -->
                                <ui:VisualElement name="card-queen-classic" class="piece-variant-card pedestal-card pedestal-card-classic">
