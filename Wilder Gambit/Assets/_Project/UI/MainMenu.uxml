<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="MainMenu.uss" />
    <ui:Style src="CandyMode.uss" />
    <ui:Style src="WgTheme.uss" />
    <ui:VisualElement name="root-container" class="root-container">
        <!-- Vignette cinematográfico (textura radial generada por MainMenuController) -->
        <ui:VisualElement name="menu-vignette" class="menu-vignette" picking-mode="Ignore" />

        <!-- Partículas de fondo: polvo dorado + brasas de fuego que ascienden -->
        <ui:VisualElement name="main-menu-particles" class="main-menu-particles" picking-mode="Ignore" />

        <!-- Toast de Gambits: aviso flotante al cobrar cualquier recompensa -->
        <ui:VisualElement name="gambit-toast" class="gambit-toast hidden" picking-mode="Ignore">
            <ui:VisualElement class="gambit-toast-icon-wrap">
                <ui:VisualElement class="gambit-toast-icon gambits-icon" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="gambit-toast-texts">
                <ui:Label name="gambit-toast-text" text="+0 Gambits" class="gambit-toast-text" />
                <ui:Label name="gambit-toast-sub" text="" class="gambit-toast-sub" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 1: MAIN MENU                                   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="main-menu-view" class="view-panel menu-main">
            <!-- ═══ ETAPA: cabecera + cuerpo. Todo el menú vive aquí y se centra
                 como un bloque único (antes el título, la botonera y las tarjetas
                 de pase vivían sueltos y no compartían ninguna guía). ═══ -->
            <ui:VisualElement class="menu-stage">
                <ui:VisualElement class="header-section">
                    <!-- Piezas de ajedrez decorativas de fondo -->
                    <ui:VisualElement class="header-pieces-bg">
                        <ui:VisualElement class="bg-piece bg-piece-rook-left" />
                        <ui:VisualElement class="bg-piece bg-piece-knight-left" />
                        <ui:VisualElement class="bg-piece bg-piece-king" />
                        <ui:VisualElement class="bg-piece bg-piece-queen" />
                        <ui:VisualElement class="bg-piece bg-piece-knight-right" />
                        <ui:VisualElement class="bg-piece bg-piece-rook-right" />
                    </ui:VisualElement>

                    <!-- Corona decorativa superior -->
                    <ui:Label text="♛" class="title-crown" />

                    <ui:VisualElement class="title-wrap">
                        <ui:Label text="WILDER GAMBIT" class="main-title title-glow" picking-mode="Ignore" />
                        <ui:Label text="WILDER GAMBIT" class="main-title" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <!-- Separador dorado decorativo -->
                    <ui:VisualElement class="title-separator">
                        <ui:VisualElement class="separator-line-left" />
                        <ui:VisualElement class="separator-diamond" />
                        <ui:VisualElement class="separator-line-right" />
                    </ui:VisualElement>

                    <ui:Label text="EL DESAFÍO TÁCTICO" class="main-subtitle" />
                </ui:VisualElement>

                <!-- ═══ CUERPO EN TRES COLUMNAS ═══
                     Columna izquierda: los pases (promos del Atelier).
                     Columna central: las acciones del juego.
                     Columna derecha: la colección y el saldo.
                     Las tres comparten la misma altura y la misma guía vertical. -->
                <ui:VisualElement class="menu-columns">

                    <!-- ── COLUMNA IZQUIERDA: PASES ── -->
                    <ui:VisualElement class="menu-rail menu-rail-left">
                        <!-- PASE DE TEMPORADA: banner + rótulo, todo el marco es clicable -->
                        <ui:VisualElement name="seasonpass-entry" class="menu-seasonpass-entry">
                            <ui:VisualElement name="seasonpass-banner" class="menu-seasonpass-banner" picking-mode="Ignore" />
                            <ui:VisualElement name="seasonpass-label" class="menu-seasonpass-label" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- PASE DE HALLOWEEN: misma tarjeta, apilada DEBAJO. El cintillo
                             «PRÓXIMAMENTE» va superpuesto al banner y cambia de estado
                             en vivo: cuenta atrás antes del 20/10, «¡ACTIVO!» durante la
                             velada y «TERMINADO» después. -->
                        <ui:VisualElement name="halloweenpass-entry" class="menu-halloweenpass-entry">
                            <ui:VisualElement name="halloweenpass-banner" class="menu-halloweenpass-banner" picking-mode="Ignore">
                                <ui:Label name="halloweenpass-soon" text="PRÓXIMAMENTE" class="menu-halloweenpass-soon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="halloweenpass-label" class="menu-halloweenpass-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── COLUMNA CENTRAL: ACCIONES ── -->
                    <ui:VisualElement class="menu-actions">
                        <!-- JUGAR: Knight sprites decorativos -->
                        <ui:Button name="btn-play" class="menu-button btn-primary">
                            <ui:VisualElement class="btn-shine" picking-mode="Ignore" />
                            <ui:Image class="btn-deco btn-deco-knight-mirror" />
                            <ui:Label text="JUGAR" class="btn-label" />
                            <ui:Image class="btn-deco btn-deco-knight" />
                        </ui:Button>

                        <!-- TUS PIEZAS: King sprites decorativos -->
                        <ui:Button name="btn-your-pieces" class="menu-button btn-pieces">
                            <ui:Image class="btn-deco btn-deco-king" />
                            <ui:Label text="TUS PIEZAS" class="btn-label" />
                            <ui:Image class="btn-deco btn-deco-king" />
                        </ui:Button>

                        <!-- Fila de atajos: Cacería temporal + Tienda + Ajustes -->
                        <ui:VisualElement class="menu-action-row">
                            <ui:Button name="btn-candy-mode" class="menu-tile btn-candy">
                                <ui:VisualElement class="btn-candy-texts" picking-mode="Ignore">
                                    <ui:Label text="CACERÍA" class="btn-label-sm" picking-mode="Ignore" />
                                    <ui:Label text="DE DULCES" class="btn-candy-sub" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="btn-shop" class="menu-tile btn-shop">
                                <ui:Image class="btn-deco-sm btn-deco-rook" />
                                <ui:Label text="TIENDA" class="btn-label-sm" />
                            </ui:Button>
                            <ui:Button name="btn-settings" class="menu-tile btn-secondary">
                                <ui:Image class="btn-deco-sm btn-deco-bishop" />
                                <ui:Label text="AJUSTES" class="btn-label-sm" />
                            </ui:Button>
                        </ui:VisualElement>

                        <!-- Fila de estado: Progreso + salida -->
                        <ui:VisualElement class="menu-action-row">
                            <!-- PROGRESO: misiones diarias, barra semanal y logros -->
                            <ui:Button name="btn-progress" class="menu-tile btn-progress">
                                <ui:VisualElement class="btn-progress-icon gambits-icon" picking-mode="Ignore" />
                                <ui:Label text="PROGRESO" class="btn-progress-label" picking-mode="Ignore" />
                                <ui:Label name="btn-progress-badge" text="✓" class="btn-progress-badge hidden" picking-mode="Ignore" />
                            </ui:Button>

                            <!-- SALIR: Pawn sprite (humilde, se retira) -->
                            <ui:Button name="btn-quit" class="menu-tile btn-danger">
                                <ui:Image class="btn-deco-sm btn-deco-pawn" />
                                <ui:Label text="SALIR" class="btn-label-sm" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── COLUMNA DERECHA: COLECCIÓN Y SALDO ── -->
                    <ui:VisualElement class="menu-rail menu-rail-right">
                        <!-- INVENTARIO: vitrina de la colección (el único sitio donde
                             se equipa). Antes era un rail vertical pegado a la
                             botonera; ahora es una tarjeta de la columna derecha. -->
                        <ui:VisualElement name="menu-inventory-rail" class="menu-inventory-rail">
                            <ui:Button name="btn-inventory" class="btn-inventory">
                                <ui:VisualElement class="btn-inventory-halo" picking-mode="Ignore" />
                                <ui:VisualElement class="btn-inventory-art-wrap" picking-mode="Ignore">
                                    <ui:Label name="btn-inventory-art-fallback" text="🎒" class="btn-inventory-art-fallback" picking-mode="Ignore" />
                                    <ui:Image name="btn-inventory-art" class="btn-inventory-art" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="btn-inventory-rule" picking-mode="Ignore" />
                                <ui:VisualElement class="btn-inventory-label-wrap" picking-mode="Ignore">
                                    <ui:Label text="INVENTARIO" class="btn-inventory-label" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:Label name="btn-inventory-count" text="0" class="btn-inventory-count hidden" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>

                        <!-- SALDO: la divisa del juego, visible de un vistazo -->
                        <ui:VisualElement class="menu-wallet">
                            <ui:VisualElement class="menu-wallet-icon gambits-icon" picking-mode="Ignore" />
                            <ui:VisualElement class="menu-wallet-texts" picking-mode="Ignore">
                                <ui:Label name="menu-gambits-value" text="0 Gambits" class="menu-wallet-value" />
                                <ui:Label text="SALDO" class="menu-wallet-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 2: DIFFICULTY SELECTOR (5 REWORKED CARDS)      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="difficulty-view" class="view-panel hidden">
            <ui:VisualElement class="difficulty-header">
                <ui:Label text="SELECCIONA TU RIVAL" class="difficulty-title" />
                <ui:Label text="Elige el nivel de IA contra el que deseas combatir" class="difficulty-subtitle" />
            </ui:VisualElement>

            <!-- Sugerencia Dinámica (Phase 8.2) -->
            <ui:VisualElement name="difficulty-suggestion" class="difficulty-suggestion hidden">
                <ui:VisualElement class="suggestion-icon-wrap">
                    <ui:Label name="suggestion-icon" text="🔥" class="suggestion-icon" />
                </ui:VisualElement>
                <ui:VisualElement class="suggestion-texts">
                    <ui:Label name="suggestion-title" text="¡Racha de 3 victorias!" class="suggestion-title" />
                    <ui:Label name="suggestion-subtitle" text="Te recomendamos probar Maestro (ELO ~1800)" class="suggestion-subtitle" />
                    <ui:Label name="suggestion-streak" text="¡Primera partida! • Sugerido: Maestro" class="suggestion-streak" />
                </ui:VisualElement>
                <ui:VisualElement class="suggestion-actions">
                    <ui:Button name="btn-suggestion-accept" text="PROBAR →" class="btn-suggestion-accept" />
                    <ui:Button name="btn-suggestion-dismiss" text="✕" class="btn-suggestion-dismiss" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="difficulty-cards-row">
                
                <!-- CARD 1: PRINCIPIANTE — Avatar Peón -->
                <ui:VisualElement name="card-novice" class="diff-card tier-1">
                    <ui:Label text="RECOMENDADO" class="diff-recommended-badge" picking-mode="Ignore" />
                    <ui:VisualElement class="diff-avatar-wrap">
                        <ui:Image class="diff-avatar-img avatar-pawn" />
                        <ui:Label text="✓" class="diff-check" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label text="PRINCIPIANTE" class="diff-name" />
                    <ui:Label text="ELO ~600" class="diff-elo" />
                    <ui:Label text="Piezas básicas y descuidos. Ideal para aprender." class="diff-desc" />
                    <ui:Label name="lbl-record-1" text="" class="diff-record hidden" />
                </ui:VisualElement>

                <!-- CARD 2: APRENDIZ — Caballo -->
                <ui:VisualElement name="card-apprentice" class="diff-card tier-2">
                    <ui:Label text="RECOMENDADO" class="diff-recommended-badge" picking-mode="Ignore" />
                    <ui:VisualElement class="diff-avatar-wrap">
                        <ui:Image class="diff-avatar-img avatar-knight" />
                        <ui:Label text="✓" class="diff-check" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label text="APRENDIZ" class="diff-name" />
                    <ui:Label text="ELO ~1000" class="diff-elo" />
                    <ui:Label text="Conoce el valor de las piezas y el enroque." class="diff-desc" />
                    <ui:Label name="lbl-record-2" text="" class="diff-record hidden" />
                </ui:VisualElement>

                <!-- CARD 3: CABALLERO — Alfil -->
                <ui:VisualElement name="card-knight" class="diff-card tier-3">
                    <ui:Label text="RECOMENDADO" class="diff-recommended-badge" picking-mode="Ignore" />
                    <ui:VisualElement class="diff-avatar-wrap">
                        <ui:Image class="diff-avatar-img avatar-bishop" />
                        <ui:Label text="✓" class="diff-check" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label text="CABALLERO" class="diff-name" />
                    <ui:Label text="ELO ~1400" class="diff-elo" />
                    <ui:Label text="Aperturas agresivas y presión táctica constante." class="diff-desc" />
                    <ui:Label name="lbl-record-3" text="" class="diff-record hidden" />
                </ui:VisualElement>

                <!-- CARD 4: MAESTRO — Reina -->
                <ui:VisualElement name="card-master" class="diff-card tier-4">
                    <ui:Label text="RECOMENDADO" class="diff-recommended-badge" picking-mode="Ignore" />
                    <ui:VisualElement class="diff-avatar-wrap">
                        <ui:Image class="diff-avatar-img avatar-queen" />
                        <ui:Label text="✓" class="diff-check" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label text="MAESTRO" class="diff-name" />
                    <ui:Label text="ELO ~1800" class="diff-elo" />
                    <ui:Label text="Cálculo posicional y ataque implacable." class="diff-desc" />
                    <ui:Label name="lbl-record-4" text="" class="diff-record hidden" />
                </ui:VisualElement>

                <!-- CARD 5: GRAN MAESTRO — Rey -->
                <ui:VisualElement name="card-grandmaster" class="diff-card tier-5">
                    <ui:Label text="RECOMENDADO" class="diff-recommended-badge" picking-mode="Ignore" />
                    <ui:VisualElement class="diff-avatar-wrap">
                        <ui:Image class="diff-avatar-img avatar-king" />
                        <ui:Label text="✓" class="diff-check" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label text="GRAN MAESTRO" class="diff-name" />
                    <ui:Label text="ELO ~2200" class="diff-elo" />
                    <ui:Label text="Sin descuidos: sacrificios y mates precisos." class="diff-desc" />
                    <ui:Label name="lbl-record-5" text="" class="diff-record hidden" />
                </ui:VisualElement>

            </ui:VisualElement>

            <ui:VisualElement class="section-divider" />

            <!-- Time Control — 4 cards (2+2), hover con info y selección visible -->
            <ui:VisualElement class="time-control-section">
                <ui:Label text="CONTROL DE TIEMPO" class="time-control-title" />
                <ui:VisualElement class="time-cards-row">
                    <ui:VisualElement class="time-mode-hint">
                        <ui:VisualElement class="time-hint-stem" picking-mode="Ignore" />
                        <ui:VisualElement class="time-hint-row">
                            <ui:VisualElement class="time-hint-arrow-wrap time-hint-wrap-left" picking-mode="Ignore">
                                <ui:Label text="◀" class="time-hint-head" picking-mode="Ignore" />
                                <ui:VisualElement class="time-hint-bar" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label text="▼" class="time-hint-down" picking-mode="Ignore" />
                            <ui:Label text="SELECCIONA UN MODO" class="time-hint-label" picking-mode="Ignore" />
                            <ui:Label text="▼" class="time-hint-down" picking-mode="Ignore" />
                            <ui:VisualElement class="time-hint-arrow-wrap time-hint-wrap-right" picking-mode="Ignore">
                                <ui:VisualElement class="time-hint-bar" picking-mode="Ignore" />
                                <ui:Label text="▶" class="time-hint-head" picking-mode="Ignore" />                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>


            </ui:VisualElement>


            <!-- Drawers del control de tiempo: 2 tarjetas por esquina inferior (hijos directos de la vista) -->
            <ui:VisualElement class="time-cards-group time-group-left">
                <ui:Button name="btn-time-none" class="time-card time-card-left time-btn-active">
                    <ui:VisualElement class="time-card-head">
                        <ui:Image class="time-card-icon icon-time-none" picking-mode="Ignore" />
                        <ui:VisualElement class="time-card-texts">
                            <ui:Label text="Sin Límite" class="time-card-title" />
                            <ui:Label text="Partida casual" class="time-card-sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="Sin reloj: aprende y experimenta a tu ritmo." class="time-card-desc" />
                </ui:Button>
                <ui:Button name="btn-time-bullet" class="time-card time-card-left time-card-dimmed">
                    <ui:VisualElement class="time-card-head">
                        <ui:Image class="time-card-icon icon-time-bullet" picking-mode="Ignore" />
                        <ui:VisualElement class="time-card-texts">
                            <ui:Label text="BULLET" class="time-card-title" />
                            <ui:Label text="1 min" class="time-card-sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="Un minuto de pura supervivencia y reflejos." class="time-card-desc" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="time-cards-group time-group-right">
                <ui:Button name="btn-time-blitz" class="time-card time-card-right time-card-dimmed">
                    <ui:VisualElement class="time-card-head">
                        <ui:Image class="time-card-icon icon-time-blitz" picking-mode="Ignore" />
                        <ui:VisualElement class="time-card-texts">
                            <ui:Label text="BLITZ" class="time-card-title" />
                            <ui:Label text="3 + 2" class="time-card-sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="3 minutos con incremento de 2s. Ritmo tenso." class="time-card-desc" />
                </ui:Button>
                <ui:Button name="btn-time-rapid" class="time-card time-card-right time-card-dimmed">
                    <ui:VisualElement class="time-card-head">
                        <ui:Image class="time-card-icon icon-time-rapid" picking-mode="Ignore" />
                        <ui:VisualElement class="time-card-texts">
                            <ui:Label text="RAPID" class="time-card-title" />
                            <ui:Label text="10 min" class="time-card-sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="10 minutos para pensar con calma." class="time-card-desc" />
                </ui:Button>
            </ui:VisualElement>

            <!-- CTA Único -->
            <ui:Button name="btn-start-game" text="SELECCIONA UN RIVAL" class="cta-start cta-disabled" />
            <ui:Label name="cta-hint" text="" class="cta-hint" picking-mode="Ignore" />

            <ui:VisualElement class="bottom-bar">
                <ui:Button name="btn-back-to-main" text="←  VOLVER AL MENÚ" class="btn-back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 3: SETTINGS MODAL                              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="settings-modal-view" class="modal-backdrop hidden">
            <ui:VisualElement class="modal-dialog settings-modal-dialog">
                <ui:Label text="⚙️  AJUSTES DEL JUEGO" class="modal-title" />

                <!-- SECCIÓN: GENERAL -->
                <ui:Label text="GENERAL" class="settings-section-title" />

                <ui:VisualElement class="setting-card">
                    <!-- Cinemáticas de Ataque -->
                    <ui:VisualElement class="setting-item-row">
                        <ui:VisualElement class="setting-text-col">
                            <ui:Label text="Cinemáticas de Ataque" class="setting-label" />
                            <ui:Label text="Reproduce videos de ataques y capturas especiales." class="setting-desc" />
                        </ui:VisualElement>
                        <ui:Button name="btn-toggle-cinematics" text="ACTIVADO" class="btn-toggle active" />
                    </ui:VisualElement>

                    <!-- Música del Juego (Master Toggle) -->
                    <ui:VisualElement class="setting-item-row" style="border-top-width: 1px; border-top-color: rgba(148, 163, 184, 0.14); padding-top: 15px;">
                        <ui:VisualElement class="setting-text-col">
                            <ui:Label text="Música del Juego" class="setting-label" />
                            <ui:Label text="Activa o silencia toda la música ambiental y de combate." class="setting-desc" />
                        </ui:VisualElement>
                        <ui:Button name="btn-toggle-music" text="ACTIVADO" class="btn-toggle active" />
                    </ui:VisualElement>

                    <!-- Pantalla completa -->
                    <ui:VisualElement class="setting-item-row" style="border-top-width: 1px; border-top-color: rgba(148, 163, 184, 0.14); padding-top: 15px;">
                        <ui:VisualElement class="setting-text-col">
                            <ui:Label text="Pantalla Completa" class="setting-label" />
                            <ui:Label text="Juego sin bordes a la resolución del monitor. F11 o Alt+Enter para alternar." class="setting-desc" />
                        </ui:VisualElement>
                        <ui:Button name="btn-toggle-fullscreen" text="ACTIVADO" class="btn-toggle active" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SECCIÓN: PREFERENCIAS DE MÚSICA -->
                <ui:Label text="PREFERENCIAS DE MÚSICA" class="settings-section-title" style="margin-top: 14px;" />

                <ui:VisualElement class="setting-card">
                    <!-- Música del Menú Principal -->
                    <ui:VisualElement class="setting-item-row">
                        <ui:VisualElement class="setting-text-col">
                            <ui:Label text="Música del Menú" class="setting-label" />
                            <ui:Label text="Pista ambiental para el menú y tienda." class="setting-desc" />
                        </ui:VisualElement>
                        <ui:VisualElement class="music-picker-control">
                            <ui:Button name="btn-menu-music-prev" text="◀" class="btn-picker-arrow" />
                            <ui:Button name="btn-menu-music-open" text="🔍 Sovereign Gambit ▾" class="btn-picker-dropdown" />
                            <ui:Button name="btn-menu-music-next" text="▶" class="btn-picker-arrow" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Música de Partida -->
                    <ui:VisualElement class="setting-item-row" style="border-top-width: 1px; border-top-color: rgba(148, 163, 184, 0.14); padding-top: 15px;">
                        <ui:VisualElement class="setting-text-col">
                            <ui:Label text="Música en Partida" class="setting-label" />
                            <ui:Label text="Tema durante el combate de ajedrez." class="setting-desc" />
                        </ui:VisualElement>
                        <ui:VisualElement class="music-picker-control">
                            <ui:Button name="btn-battle-music-prev" text="◀" class="btn-picker-arrow" />
                            <ui:Button name="btn-battle-music-open" text="🔍 Alternar pistas ▾" class="btn-picker-dropdown" />
                            <ui:Button name="btn-battle-music-next" text="▶" class="btn-picker-arrow" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button name="btn-close-settings" text="CERRAR" class="btn-modal-close" style="margin-top: 18px;" />
            </ui:VisualElement>

            <!-- ── MODAL FLOTANTE DE BÚSQUEDA Y SELECCIÓN DE PISTAS ── -->
            <ui:VisualElement name="music-search-popup" class="music-search-popup hidden">
                <ui:VisualElement class="music-search-dialog">
                    <ui:Label name="lbl-music-search-title" text="🎵  SELECCIONAR PISTA" class="music-search-title" />
                    <ui:Label name="lbl-music-search-subtitle" text="Busca y elige una pista musical para reproducir." class="music-search-subtitle" />

                    <ui:TextField name="input-music-search" placeholder-text="🔍  Escribe para buscar..." class="music-search-input" />

                    <ui:ScrollView name="scroll-music-tracks" class="music-tracks-scroll" mode="Vertical">
                        <!-- Las opciones se generan dinámicamente aquí -->
                    </ui:ScrollView>

                    <ui:Button name="btn-close-music-search" text="VOLVER" class="btn-close-music-search" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 4: SHOP VIEW — ATELIER NOIR / VAULT EDITION   -->
        <!-- Rework total: layout split rail + stage             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ui:VisualElement name="shop-modal-view" class="shop2-root hidden">
            <ui:VisualElement class="shop2-backdrop">
                <ui:VisualElement class="shop2-window">

                    <!-- ── TOPBAR SUPERIOR ── -->
                    <ui:VisualElement class="shop2-topbar">
                        <ui:VisualElement class="shop2-rail-header">
                            <ui:Button name="btn-close-shop" text="←  VOLVER" class="shop2-back-btn" />
                            <ui:VisualElement class="shop2-brand">
                                <ui:Label text="ATELIER" class="shop2-brand-kicker" />
                                <ui:Label text="COLECCIÓN" class="shop2-brand-title" />
                                <ui:VisualElement class="shop2-brand-line" />
                                <ui:Label text="Tableros artesanales para tu tablero de combate." class="shop2-brand-subtitle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Tabs movidos a la barra scrolleable inferior al topbar -->

                        <ui:VisualElement class="shop2-rail-vault">
                            <ui:VisualElement class="shop2-vault-head">
                                <ui:Label text="BÓVEDA" class="shop2-vault-eyebrow" />
                                <ui:Label text="Saldo Ocean Pay" class="shop2-vault-sub" />
                            </ui:VisualElement>
                            <!-- BÓVEDA V2: rework robusto anti-descentrado (nombres intactos para C#) -->
                            <ui:VisualElement name="shop-wallet" class="shop2-balance-card">
                                <ui:VisualElement name="shop-slot-tides" class="shop2-balance-slot">
                                    <ui:VisualElement class="shop2-balance-icon shop2-balance-icon--tides">
                                        <ui:Label text="💧" class="shop2-balance-glyph" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-balance-texts">
                                        <ui:Label name="shop-tides-label" text="61,18K" class="shop2-balance-amount shop2-balance-amount--tides" />
                                        <ui:Label text="TIDES" class="shop2-balance-caption" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="shop2-balance-divider" picking-mode="Ignore" />

                                <ui:VisualElement name="shop-slot-gambits" class="shop2-balance-slot">
                                    <ui:VisualElement class="shop2-balance-icon shop2-balance-icon--gambits">
                                        <ui:VisualElement class="shop2-balance-glyph gambits-icon" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="shop2-balance-texts">
                                        <ui:Label name="shop-gambits-label" text="0" class="shop2-balance-amount shop2-balance-amount--gambits" />
                                        <ui:Label text="GAMBITS" class="shop2-balance-caption" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- PERFIL V2: misma lógica robusta -->
                            <ui:VisualElement name="shop-header-user-area" class="shop2-profile-card hidden">
                                <ui:VisualElement class="shop2-profile-avatar">
                                    <ui:Label name="shop-avatar-initial" text="O" class="shop2-profile-avatar-letter" />
                                </ui:VisualElement>
                                <ui:VisualElement class="shop2-profile-texts">
                                        <ui:Label name="shop-header-username" text="Invitado" class="shop2-profile-name" />
                                    <ui:Label name="shop-username-label" text="Invitado" class="shop2-profile-handle" />
                                </ui:VisualElement>
                                <ui:Button name="btn-shop-logout" text="Salir" class="shop2-profile-logout" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="shop2-rail-footer">
                            <ui:Label text="WILDER GAMBIT — ATELIER NOIR" class="shop2-rail-footer-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ── TABS DE CATEGORÍAS (scrolleables horizontalmente) ── -->
                    <ui:ScrollView class="shop2-tabs-bar" mode="Horizontal">
                        <ui:VisualElement class="shop2-tabs">
                            <ui:Button name="tab-boards" class="shop2-tab shop-tab-active shop2-nav-active">
                                <ui:Label text="TABLEROS" class="shop2-tab-label" />
                                <ui:Label text="10" class="shop2-tab-count" />
                            </ui:Button>
                            <ui:Button name="tab-animations" class="shop2-tab">
                                <ui:Label text="ANIMACIONES" class="shop2-tab-label" />
                                <ui:Label text="4" class="shop2-tab-count" />
                            </ui:Button>
                            <ui:Button name="tab-fonds" class="shop2-tab">
                                <ui:Label text="FONDOS" class="shop2-tab-label" />
                                <ui:Label text="10" class="shop2-tab-count" />
                            </ui:Button>
                            <ui:Button name="tab-variants" class="shop2-tab">
                                <ui:Label text="VARIANTES DE PIEZAS" class="shop2-tab-label" />
                                <ui:Label text="3" class="shop2-tab-count" />
                            </ui:Button>
                            <ui:Button name="tab-skins" class="shop2-tab">
                                <ui:Label text="SKINS" class="shop2-tab-label" />
                                <ui:Label text="15" class="shop2-tab-count" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:ScrollView>

                    <!-- ── BODY: catálogo (izquierda) + panel de detalle (derecha) ── -->
                    <ui:VisualElement class="shop2-body">
                        <ui:VisualElement class="shop2-stage shop2-catalog">

                        <!-- Suelo ambiental: degrada la zona inferior para enmascarar el espacio -->
                        <ui:VisualElement name="shop-catalog-fade" class="shop2-catalog-fade" picking-mode="Ignore" />
                        <ui:Label text="WILDER GAMBIT — ATELIER NOIR" class="shop2-catalog-footer" picking-mode="Ignore" />

                        <!-- CONTENEDOR CONECTADO: Grid + Paginación -->
                        <ui:VisualElement name="shop-connected-view" class="shop2-connected hidden">                                <ui:ScrollView name="shop-items-scroll" class="shop2-grid-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                                <ui:VisualElement name="shop-items-grid" class="shop2-grid">
                                    <ui:VisualElement class="shop2-empty">
                                        <ui:Label text="◈  COLECCIÓN VACÍA" class="shop2-empty-title" />
                                        <ui:Label text="Los tableros artesanales aparecerán aquí." class="shop2-empty-desc" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:ScrollView>
                            <ui:VisualElement class="shop2-pagination">
                                <ui:Button name="btn-page-prev" text="‹" class="shop2-page-arrow" />
                                <ui:VisualElement class="shop2-page-dots">
                                    <ui:Button name="btn-page-1" text="1" class="shop2-page-dot page-active" />
                                    <ui:Button name="btn-page-2" text="2" class="shop2-page-dot" />
                                    <ui:Button name="btn-page-3" text="3" class="shop2-page-dot" />
                                </ui:VisualElement>
                                <ui:Button name="btn-page-next" text="›" class="shop2-page-arrow" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- LOGIN OVERLAY (centrado sobre el stage) -->
                        <ui:VisualElement name="shop-login-view" class="shop2-login hidden">
                            <ui:VisualElement class="shop2-login-card">
                                <ui:VisualElement class="shop2-login-icon-wrap">
                                    <ui:Label text="◈" class="shop2-login-icon" />
                                </ui:VisualElement>
                                <ui:Label text="BÓVEDA PRIVADA" class="shop2-login-kicker" />
                                <ui:Label text="Accede a tu colección" class="shop2-login-title" />
                                <ui:Label text="Inicia sesión con Ocean Pay para desbloquear tus tableros y saldo." class="shop2-login-desc" />
                                <ui:VisualElement class="shop2-field">
                                    <ui:Label text="USUARIO" class="shop2-field-label" />
                                    <ui:TextField name="shop-input-username" class="shop2-input" placeholder-text="tu usuario Ocean Pay" />
                                </ui:VisualElement>
                                <ui:VisualElement class="shop2-field">
                                    <ui:Label text="CONTRASEÑA" class="shop2-field-label" />
                                    <ui:TextField name="shop-input-password" class="shop2-input" placeholder-text="••••••••" password="true" />
                                </ui:VisualElement>
                                <ui:Label name="shop-error-label" text="" class="shop2-error hidden" />
                                <ui:VisualElement class="shop2-login-actions">
                                    <ui:Button name="btn-shop-login" text="INICIAR SESIÓN" class="shop2-btn-primary" />
                                    <ui:Button name="btn-shop-register" text="CREAR CUENTA" class="shop2-btn-ghost" />
                                </ui:VisualElement>
                                <ui:Label text="Al continuar aceptas los términos de Ocean Pay • Cifrado SSL" class="shop2-login-footnote" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- LOADING -->
                        <ui:VisualElement name="shop-loading-view" class="shop2-loading hidden">
                            <!-- Skeleton ARRIBA: cards fantasma mientras carga la sesión -->
                            <ui:VisualElement class="shop2-skeleton-row">
                                <ui:VisualElement class="shop2-skeleton-card"><ui:VisualElement class="shop2-skeleton-thumb" /><ui:VisualElement class="shop2-skeleton-line" /><ui:VisualElement class="shop2-skeleton-line short" /></ui:VisualElement>
                                <ui:VisualElement class="shop2-skeleton-card"><ui:VisualElement class="shop2-skeleton-thumb" /><ui:VisualElement class="shop2-skeleton-line" /><ui:VisualElement class="shop2-skeleton-line short" /></ui:VisualElement>
                                <ui:VisualElement class="shop2-skeleton-card"><ui:VisualElement class="shop2-skeleton-thumb" /><ui:VisualElement class="shop2-skeleton-line" /><ui:VisualElement class="shop2-skeleton-line short" /></ui:VisualElement>
                                <ui:VisualElement class="shop2-skeleton-card"><ui:VisualElement class="shop2-skeleton-thumb" /><ui:VisualElement class="shop2-skeleton-line" /><ui:VisualElement class="shop2-skeleton-line short" /></ui:VisualElement>
                                <ui:VisualElement class="shop2-skeleton-card"><ui:VisualElement class="shop2-skeleton-thumb" /><ui:VisualElement class="shop2-skeleton-line" /><ui:VisualElement class="shop2-skeleton-line short" /></ui:VisualElement>
                                <ui:VisualElement class="shop2-skeleton-card"><ui:VisualElement class="shop2-skeleton-thumb" /><ui:VisualElement class="shop2-skeleton-line" /><ui:VisualElement class="shop2-skeleton-line short" /></ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Estado ABAJO: mensaje + % y barra de progreso animadas en paralelo -->
                            <ui:VisualElement class="shop2-loading-card">
                                <ui:VisualElement class="shop2-loading-head">
                                    <ui:Label text="◍" class="shop2-loading-icon" />
                                    <ui:Label text="Sincronizando bóveda..." class="shop2-loading-text" />
                                    <ui:Label text="0%" class="shop2-loading-percent" />
                                </ui:VisualElement>
                                <ui:VisualElement class="shop2-loading-bar">
                                    <ui:VisualElement class="shop2-loading-bar-fill" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ── PANEL DE DETALLE (derecha del catálogo, solo con selección) ── -->
                        <ui:VisualElement name="shop2-detail" class="shop2-detail hidden">
                        <ui:VisualElement name="bg-preview-panel" class="shop2-hero bg-preview-panel">
                            <ui:VisualElement class="shop2-hero-art">
                                <ui:VisualElement class="shop2-hero-art-glow" picking-mode="Ignore" />
                                <ui:VisualElement class="shop2-hero-art-glow-core" picking-mode="Ignore" />
                                <ui:Image name="bg-preview-image" class="shop2-hero-image" />
                            </ui:VisualElement>
                            <ui:VisualElement class="shop2-hero-scrim" />
                            <ui:VisualElement class="shop2-hero-content">
                                <ui:Label name="shop-hero-kicker" text="VISTA PREVIA  •  EDICIÓN ARTESANAL" class="shop2-hero-kicker" />
                                <ui:Label name="bg-preview-name" text="—" class="shop2-hero-title" />
                                <ui:Label name="bg-preview-desc" text="Selecciona una card para ver los detalles del objeto." class="shop2-hero-desc" />
                            </ui:VisualElement>
                            <ui:VisualElement class="shop2-hero-badge">
                                <ui:Label text="●  ACTIVO" class="shop2-hero-badge-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="shop2-detail-info">
                            <ui:Label text="TABLERO  •  EDICIÓN ATELIER" class="shop2-detail-kicker" />
                            <ui:VisualElement class="shop2-detail-pricerow">
                                <ui:Label name="shop-detail-price" text="—" class="shop2-detail-price" />
                                <ui:Label name="shop-detail-offer" text="" class="shop2-detail-offer hidden" picking-mode="Ignore" />
                                <ui:Label name="shop-detail-stock" text="" class="shop2-detail-stock" />
                            </ui:VisualElement>
                            <ui:VisualElement class="shop2-detail-lorewrap">
                                <ui:Label name="shop-detail-ability" text="PASIVA • LANZA" class="shop2-detail-ability" />
                                <ui:Label name="shop-detail-lore" text="Cada tablero es una pieza artesanal: cambia la atmósfera de toda tu arena de combate. Al comprarlo entra en tu INVENTARIO, donde se equipa." class="shop2-detail-hint" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="shop2-detail-actions">
                            <ui:Button name="btn-detail-action" text="EQUIPAR" class="shop2-btn-primary shop2-detail-cta" />
                        </ui:VisualElement>
                        <ui:Button name="btn-detail-close" text="CERRAR" class="shop2-detail-close" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- VIEW 5: TUS PIEZAS / VARIANTES MODAL — DUAL PANEL (izquierda: Tus Piezas, derecha: Enciclopedia) -->
        <ui:VisualElement name="your-pieces-modal-view" class="modal-overlay hidden">
